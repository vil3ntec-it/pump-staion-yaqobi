# وابستگی‌های نصبی — هرگز داخل گیت نروند (با npm install ساخته می‌شوند)
node_modules/
**/node_modules/
# ⚠️ بی‌سلش هم لازم است: دو الگوی بالا فقط **پوشه** را می‌گیرند. ابزارهای
# اندازه‌گیریِ سایت (‎measure-site.mjs‎ و ‎shot-site.mjs‎) گاهی یک **پیوند**
# به همین نام کنارِ ریشه می‌سازند تا node بسته‌ها را پیدا کند، و آن پیوند از
# لای الگوهای سلش‌دار رد می‌شد و هر بار در «فایل‌های ردیابی‌نشده» می‌نشست.
node_modules

# خروجی‌های ساخت
desktop/dist/
desktop/app/
dist/
build/

# فایل‌های نصب و نسخه — هنگام دیپلوی خودکار ساخته می‌شوند، نه دستی
downloads/
version.json

# فایل‌های موقت سیستم
.DS_Store
Thumbs.db
*.log
undefined/
