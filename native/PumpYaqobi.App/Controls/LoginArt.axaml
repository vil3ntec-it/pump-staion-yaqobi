<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PumpYaqobi.App.Controls.LoginArt"
             FlowDirection="LeftToRight">

  <!-- ══════════════════════════════════════════════════════════════════════
       🧑‍🤝‍🧑 آدمک‌های صفحهٔ ورود — **برداری**، با رنگ و تمِ خودِ برنامه
       ══════════════════════════════════════════════════════════════════════
       خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۶/۲۹، با عکس و دورِ زردِ کشیده دورِ
       عکس): «اون آدمک‌ها رو باسازی کن و بک‌گراندشو درست کن و با رنگ و تمِ
       خودِ برنامه باشه و همه‌چی با کیفیتِ خیلی بالا درست کن.»

       پس عکسِ JPEG برداشته شد و همان صحنه **از نو و برداری** کشیده شد:

       ⚠️ **چرا برداری «کیفیتِ خیلی بالا» است**: عکسِ ۳۶۸×۳۹۶ روی کارتی که
       تا ۵۶۰ پیکسل باز می‌شود کشیده و نرم می‌شد. نقشهٔ برداری در هر اندازه
       و روی هر صفحه‌ای (۴K هم) دقیقاً تیز است، چون در همان لحظه با همان
       اندازه کشیده می‌شود.
       ⚠️ **و هیچ وزنی ندارد**: نه فایلی خوانده می‌شود، نه JPEGی باز
       می‌شود، نه حافظه‌ای برای بیت‌مپ می‌رود. سنجهٔ `loginart` عددش را
       می‌گیرد.
       ⛔ **هیچ رنگِ خامی این‌جا برای کادرها نیست**: هر سطحِ صحنه از خودِ تم
       می‌آید (`Pump.Accent`، `Pump.Info`، `Pump.Card`، `Pump.Border`…)، پس
       با آبی و طلایی هر دو درست است و با عوض شدنِ تم خودش عوض می‌شود.
       تنها رنگ‌های ثابت، رنگِ پوست و مو و کفش‌اند — این‌ها رنگِ تم نیستند.
       ⛔ و پس‌زمینهٔ سفیدِ داخلِ عکسِ قدیمی (همان کادرِ سفیدِ توی کادرِ
       بنفش که صاحب ریپو دورش خط کشید) دیگر وجود ندارد: بوم **شفاف** است.

       بوم ۳۶۰×۳۹۰ است و `Viewbox` هر اندازه‌ای را نگه می‌دارد. -->

  <Viewbox Stretch="Uniform">
    <Canvas Width="360" Height="390" Background="Transparent">

      <!-- ══ سایهٔ زیرِ پا — دو بیضیِ نرم ══ -->
      <Ellipse Canvas.Left="30" Canvas.Top="336" Width="110" Height="24"
               Fill="{DynamicResource Pump.IconBadge}" Opacity="0.85" />
      <Ellipse Canvas.Left="240" Canvas.Top="336" Width="108" Height="24"
               Fill="{DynamicResource Pump.IconBadge}" Opacity="0.85" />

      <!-- ══ کارتِ نمودار — بالا چپ ══ -->
      <Rectangle Canvas.Left="6" Canvas.Top="58" Width="118" Height="82" RadiusX="16" RadiusY="16"
                 Fill="{DynamicResource Pump.Card}" Stroke="{DynamicResource Pump.Border}" StrokeThickness="1.5" />
      <Rectangle Canvas.Left="22" Canvas.Top="104" Width="14" Height="22" RadiusX="6" RadiusY="6"
                 Fill="{DynamicResource Pump.ChartPoint}" />
      <Rectangle Canvas.Left="44" Canvas.Top="88" Width="14" Height="38" RadiusX="6" RadiusY="6"
                 Fill="{DynamicResource Pump.ChartLine}" />
      <Rectangle Canvas.Left="66" Canvas.Top="96" Width="14" Height="30" RadiusX="6" RadiusY="6"
                 Fill="{DynamicResource Pump.ChartPoint}" />
      <Rectangle Canvas.Left="88" Canvas.Top="76" Width="14" Height="50" RadiusX="6" RadiusY="6"
                 Fill="{DynamicResource Pump.Accent}" />
      <Rectangle Canvas.Left="22" Canvas.Top="72" Width="42" Height="7" RadiusX="3.5" RadiusY="3.5"
                 Fill="{DynamicResource Pump.Border}" />

      <!-- ══ کارتِ خطِ رو به بالا — بالا راست ══ -->
      <Rectangle Canvas.Left="228" Canvas.Top="18" Width="120" Height="68" RadiusX="16" RadiusY="16"
                 Fill="{DynamicResource Pump.Card}" Stroke="{DynamicResource Pump.Border}" StrokeThickness="1.5" />
      <Polyline Points="244,66 268,48 292,56 318,32"
                Stroke="{DynamicResource Pump.ChartLine}" StrokeThickness="3.5"
                StrokeLineCap="Round" StrokeJoin="Round" />
      <Ellipse Canvas.Left="313" Canvas.Top="27" Width="10" Height="10"
               Fill="{DynamicResource Pump.Accent}" />
      <Ellipse Canvas.Left="263" Canvas.Top="43" Width="10" Height="10"
               Fill="{DynamicResource Pump.ChartPoint}" />

      <!-- ══ کارتِ قطرهٔ تیل — کنارِ کارتِ خط ══ -->
      <Rectangle Canvas.Left="296" Canvas.Top="104" Width="56" Height="56" RadiusX="16" RadiusY="16"
                 Fill="{DynamicResource Pump.Card}" Stroke="{DynamicResource Pump.Border}" StrokeThickness="1.5" />
      <Path Data="M 324,116 C 334,130 340,136 340,143 A 16,16 0 0 1 308,143 C 308,136 314,130 324,116 Z"
            Fill="{DynamicResource Pump.Accent}" Opacity="0.9" />

      <!-- ══ صفحهٔ وسط — همان «چک‌لیستِ» عکسِ مرجع ══
           گرادیانِ تاکیدِ خودِ تم، پس در آبی آبی است و در طلایی طلایی. -->
      <Rectangle Canvas.Left="136" Canvas.Top="72" Width="116" Height="212" RadiusX="26" RadiusY="26"
                 Fill="{DynamicResource Pump.AccentGrad}" />

      <!-- نشانِ تیکِ بالای صفحه -->
      <Ellipse Canvas.Left="176" Canvas.Top="98" Width="36" Height="36"
               Fill="{DynamicResource Pump.Card}" />
      <Polyline Points="185,116 192,123 204,109"
                Stroke="{DynamicResource Pump.Accent}" StrokeThickness="4"
                StrokeLineCap="Round" StrokeJoin="Round" />

      <!-- سه ردیفِ چک‌لیست -->
      <Ellipse Canvas.Left="152" Canvas.Top="158" Width="16" Height="16"
               Fill="{DynamicResource Pump.OnAccent}" Opacity="0.92" />
      <Rectangle Canvas.Left="176" Canvas.Top="162" Width="58" Height="9" RadiusX="4.5" RadiusY="4.5"
                 Fill="{DynamicResource Pump.OnAccent}" Opacity="0.55" />
      <Ellipse Canvas.Left="152" Canvas.Top="196" Width="16" Height="16"
               Fill="{DynamicResource Pump.OnAccent}" Opacity="0.92" />
      <Rectangle Canvas.Left="176" Canvas.Top="200" Width="44" Height="9" RadiusX="4.5" RadiusY="4.5"
                 Fill="{DynamicResource Pump.OnAccent}" Opacity="0.55" />
      <Ellipse Canvas.Left="152" Canvas.Top="234" Width="16" Height="16"
               Fill="{DynamicResource Pump.OnAccent}" Opacity="0.92" />
      <Rectangle Canvas.Left="176" Canvas.Top="238" Width="58" Height="9" RadiusX="4.5" RadiusY="4.5"
                 Fill="{DynamicResource Pump.OnAccent}" Opacity="0.55" />

      <!-- ══════════════════════════════════════════════════════════════════
           آدمکِ چپ — ایستاده، رو به صفحه، یک دست به طرفِ آن
           ══════════════════════════════════════════════════════════════════ -->

      <!-- موی بلندِ پشت — یک سیلوئتِ **توپُر**
           ⚠️ شکلِ قبلی وسطش بریده بود و رنگِ پس‌زمینه از آن بریدگی دیده
           می‌شد — یک کادرِ روشنِ بی‌جا وسطِ مو. حالا یک‌تکه است و صورت و
           تن‌پوش رویش می‌نشینند. -->
      <Path Data="M 84,124 C 104,124 112,146 110,170 L 110,214 C 110,222 102,226 96,222 L 96,206 L 72,206 L 72,222 C 66,226 58,222 58,214 L 58,170 C 56,146 64,124 84,124 Z"
            Fill="#38304f" />
      <!-- کفش -->
      <Rectangle Canvas.Left="58" Canvas.Top="326" Width="26" Height="12" RadiusX="6" RadiusY="6" Fill="#3b3252" />
      <Rectangle Canvas.Left="84" Canvas.Top="326" Width="26" Height="12" RadiusX="6" RadiusY="6" Fill="#3b3252" />
      <!-- پاها -->
      <Rectangle Canvas.Left="66" Canvas.Top="266" Width="14" Height="64" RadiusX="7" RadiusY="7" Fill="#f0c3a1" />
      <Rectangle Canvas.Left="88" Canvas.Top="266" Width="14" Height="64" RadiusX="7" RadiusY="7" Fill="#f0c3a1" />
      <!-- دامن -->
      <Path Data="M 69,212 L 99,212 L 110,266 C 111,272 106,276 99,276 L 69,276 C 62,276 57,272 58,266 Z"
            Fill="{DynamicResource Pump.Accent}" />
      <!-- تن‌پوش -->
      <Path Data="M 84,180 C 93,180 100,187 100,197 L 100,216 C 100,220 97,222 93,222 L 75,222 C 71,222 68,220 68,216 L 68,197 C 68,187 75,180 84,180 Z"
            Fill="{DynamicResource Pump.Info}" />
      <!-- دستِ رو به صفحه -->
      <Polyline Points="98,200 120,208 134,192"
                Stroke="#f0c3a1" StrokeThickness="11" StrokeLineCap="Round" StrokeJoin="Round" />
      <!-- دستِ دیگر -->
      <Polyline Points="71,190 62,222 65,246"
                Stroke="#f0c3a1" StrokeThickness="11" StrokeLineCap="Round" StrokeJoin="Round" />
      <!-- گردن -->
      <Rectangle Canvas.Left="79" Canvas.Top="170" Width="10" Height="16" RadiusX="5" RadiusY="5" Fill="#e8b492" />
      <!-- صورت -->
      <Ellipse Canvas.Left="66" Canvas.Top="138" Width="36" Height="40" Fill="#f0c3a1" />
      <!-- موی جلو — روی پیشانی می‌نشیند، بی فاصله -->
      <Path Data="M 64,154 C 62,134 72,124 84,124 C 96,124 106,134 104,154 C 99,143 93,139 84,139 C 75,139 69,143 64,154 Z"
            Fill="#38304f" />
      <!-- چشم و لبخند — ریز و ساده، مثلِ همان سبکِ تخت -->
      <Ellipse Canvas.Left="75" Canvas.Top="155" Width="4" Height="4" Fill="#3a3247" />
      <Ellipse Canvas.Left="89" Canvas.Top="155" Width="4" Height="4" Fill="#3a3247" />
      <Path Data="M 79,165 C 82,168 86,168 89,165" Stroke="#c98a6a" StrokeThickness="1.8"
            StrokeLineCap="Round" />

      <!-- ══════════════════════════════════════════════════════════════════
           آدمکِ راست — رو به صفحه، دست روی آن
           ══════════════════════════════════════════════════════════════════ -->

      <!-- کفش -->
      <Rectangle Canvas.Left="266" Canvas.Top="326" Width="26" Height="12" RadiusX="6" RadiusY="6" Fill="#2f3a52" />
      <Rectangle Canvas.Left="294" Canvas.Top="326" Width="26" Height="12" RadiusX="6" RadiusY="6" Fill="#2f3a52" />
      <!-- شلوار -->
      <Path Data="M 272,258 L 316,258 L 314,330 L 296,330 L 294,286 L 292,330 L 274,330 Z"
            Fill="{DynamicResource Pump.Accent}" />
      <!-- پیراهن — شانه‌ها گِرد، بی گوشهٔ تیز -->
      <Path Data="M 294,196 C 308,196 318,205 318,218 L 318,258 C 318,263 314,266 308,266 L 280,266 C 274,266 270,263 270,258 L 270,218 C 270,205 280,196 294,196 Z"
            Fill="{DynamicResource Pump.Info}" />
      <!-- دستِ روی صفحه -->
      <Polyline Points="274,214 254,226 240,206"
                Stroke="#eeb994" StrokeThickness="11" StrokeLineCap="Round" StrokeJoin="Round" />
      <!-- دستِ دیگر — کنارِ تن، نرم -->
      <Polyline Points="310,206 320,238 316,262"
                Stroke="#eeb994" StrokeThickness="11" StrokeLineCap="Round" StrokeJoin="Round" />
      <!-- گردن -->
      <Rectangle Canvas.Left="288" Canvas.Top="186" Width="11" Height="16" RadiusX="5.5" RadiusY="5.5" Fill="#e0aa86" />
      <!-- صورت -->
      <Ellipse Canvas.Left="275" Canvas.Top="154" Width="38" Height="40" Fill="#eeb994" />
      <!-- مو — روی خودِ سر، هم‌مرکز با صورت -->
      <!-- ⚠️ نیمهٔ **بالای** خودِ بیضیِ سر است، پس مو مو‌به‌مو به سر
           می‌چسبد. `sweep = 1` از **روی** سر می‌رود و `0` از زیرِ آن (و آن
           وقت مو کلِ صورت را می‌پوشاند — یک بار همین شد). ضخامتِ مو از
           فاصلهٔ کمان با خمِ برگشت می‌آید. -->
      <Path Data="M 275,174 A 19,20 0 0 1 313,174 C 310,166 303,161 294,161 C 285,161 278,166 275,174 Z"
            Fill="#2f3a52" />
      <!-- چشم و لبخند -->
      <Ellipse Canvas.Left="286" Canvas.Top="170" Width="4" Height="4" Fill="#3a3247" />
      <Ellipse Canvas.Left="300" Canvas.Top="170" Width="4" Height="4" Fill="#3a3247" />
      <Path Data="M 290,180 C 293,183 297,183 300,180" Stroke="#c07f5f" StrokeThickness="1.8"
            StrokeLineCap="Round" />

    </Canvas>
  </Viewbox>
</UserControl>
