<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>PumpYaqobi</AssemblyName>

    <!-- ══ چهرهٔ برنامه در خودِ ویندوز ═══════════════════════════════════════
         بدونِ این‌ها، فایلِ اجرایی آیکونِ خالیِ پیش‌فرض می‌گیرد و در «جزئیات»
         و نوارِ وظیفه بی‌نام می‌ماند — همان چیزی که برنامه را «نصفه» نشان
         می‌داد. آیکون چند اندازه دارد تا دسکتاپ، نوارِ وظیفه و فهرستِ
         برنامه‌ها هر کدام اندازهٔ خودشان را بردارند. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>پمپ یعقوبی</Product>
    <AssemblyTitle>پمپ یعقوبی</AssemblyTitle>
    <Description>حسابداریِ پمپ یعقوبی</Description>
    <Company>پمپ یعقوبی</Company>
    <Copyright>© پمپ یعقوبی</Copyright>
    <RootNamespace>PumpYaqobi.App</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- شمارهٔ نسخه. ساختِ خودکارِ گیت‌هاب این را با عددِ همان ساخت جا‌به‌جا
         می‌کند (‎native/VERSION‎)، پس هر انتشار عددِ بزرگ‌تری می‌گیرد و
         به‌روزرسانیِ داخلِ برنامه می‌فهمد نسخهٔ تازه‌ای آمده.
         این عدد همان نسخهٔ آغازِ برنامهٔ نیتیو است و برای ساختِ دستی/محلی
         به کار می‌آید؛ در انتشار جا‌به‌جا می‌شود. -->
    <Version>3.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- ══ مایکروفون ══════════════════════════════════════════════════════
         فقط ‎NAudio.WinMM‎ (نه بستهٔ کاملِ NAudio): تنها چیزی که لازم داریم
         ‎WaveInEvent‎ است و بقیه‌اش — میدی، ASIO، فرم‌های ویندوزی — بی‌مصرف
         است و حجمِ نصاب را بی‌جهت بالا می‌برد.

         روی لینوکس فقط **ساخته** می‌شود (آزمون‌های CI آن‌جا اجرا می‌شوند و به
         مایکروفون دست نمی‌زنند)؛ اجرای واقعی‌اش ویندوز است. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />

    <!-- ══ پخشِ زندهٔ RTSP و HLS — بندِ ۱۵ ══════════════════════════════════
         دوربینِ مداربستهٔ واقعی (و هر NVR/DVR) تصویرش را با ‎rtsp://‎ می‌دهد.
         بی این، برنامه چنین لینکی را فقط به پخش‌کنندهٔ ویندوز می‌سپرد — یعنی
         کاربر برای دیدنِ دوربینش باید از برنامه بیرون می‌رفت.

         ‎LibVLCSharp‎ فقط پوستهٔ مدیریت‌شده است (چند صد کیلوبایت) و همیشه
         ساخته می‌شود؛ کتابخانهٔ بومیِ VLC فقط در ساختِ **ویندوز** می‌آید.

         ⚠️ شرطِ ‎Windows_NT‎ عمدی است: آزمون‌های CI روی لینوکس اجرا می‌شوند و
         بی این شرط، هر اجرای آزمون ۱۲۰ مگابایت فایلِ ویندوزی دانلود می‌کرد
         که آن‌جا هیچ استفاده‌ای ندارد. کدِ برنامه هم به نبودنش آماده است:
         ‎VlcVideoFeed.Available‎ خاموش می‌ماند و کارتِ دوربین به همان رفتارِ
         قبلی برمی‌گردد. -->
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21"
                      Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PumpYaqobi.Domain\PumpYaqobi.Domain.csproj" />
    <ProjectReference Include="..\PumpYaqobi.Application\PumpYaqobi.Application.csproj" />
    <ProjectReference Include="..\PumpYaqobi.Persistence\PumpYaqobi.Persistence.csproj" />
    <ProjectReference Include="..\PumpYaqobi.Infrastructure\PumpYaqobi.Infrastructure.csproj" />
    <ProjectReference Include="..\PumpYaqobi.Reporting\PumpYaqobi.Reporting.csproj" />
    <ProjectReference Include="..\PumpYaqobi.Services\PumpYaqobi.Services.csproj" />
  </ItemGroup>

</Project>
