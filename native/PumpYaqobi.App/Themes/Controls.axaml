<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PumpYaqobi.App.Controls"
        xmlns:th="using:PumpYaqobi.App.Themes">
  <Styles.Resources>
    <!-- فونتِ برنامه + پشتیبانِ ایموجیِ سیستم. Vazirmatn ایموجی ندارد؛ روی
         ویندوز «Segoe UI Emoji» و روی لینوکس «Noto Color Emoji» جایش را پر
         می‌کنند، وگرنه نشانه‌ها (⛽ 🟤 💵) خالی دیده می‌شوند. -->
    <FontFamily x:Key="Pump.Font">avares://PumpYaqobi/Assets/Vazirmatn.ttf#Vazirmatn, Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji</FontFamily>
  </Styles.Resources>
  <!-- ══ سبکِ مشترکِ برنامه ═══════════════════════════════════════════════
       همه‌چیز از {DynamicResource Pump.*} رنگ می‌گیرد، پس تعویضِ تم آنی است.
       هیچ سایه/تاریِ سنگینی نیست (خواستهٔ صریحِ صاحب ریپو) — عمق با
       لبه و اختلافِ سطح ساخته می‌شود، نه با blur.                        -->

  <!-- ══ مقیاسِ نوشته ═══════════════════════════════════════════════════════
       اندازه‌ها از خودِ CSSِ نسخهٔ وب (شاخهٔ دسکتاپش) برداشته شده‌اند:
         .stat-label 1rem · .stat-value 1.55rem · .card-title 1.05rem
         .nav-btn 1rem   · .tbl 1.08rem
       با پایهٔ ۱۶ پیکسلِ مرورگر. پیش از این همه حدودِ ۸۰٪ِ این عددها بودند و
       برنامه کنارِ نسخهٔ وب «ریز و فشرده» دیده می‌شد.                       -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="FlowDirection" Value="RightToLeft" />
    <Setter Property="Background" Value="{DynamicResource Pump.AppBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- ══ همهٔ نوشته‌ها وسطِ کادرِ خودشان ═════════════════════════════════════
       خواستهٔ صریحِ صاحب ریپو: «همه نوشته‌ها، همه همه همه نوشته‌ها باید تو
       کادرهاشون وسط‌چین باشن، تو همه بخش‌ها.»

       در سایت هم هر خانهٔ هر جدول وسط‌چین است — بی استثنا:
           .tbl th{text-align:center}   .tbl td{text-align:center}
           .xls-tbl th{text-align:center}  .xls-tbl td{text-align:center}
           .ro-tbl th/td, .safe-tbl, .rasid-tbl, .att-tbl … همه center
       و کادرهای تایپِ داخلِ خانه‌ها هم:
           .ro-tbl td input/textarea/select{text-align:center}

       پیش از این پیش‌فرضِ اینجا ‎Right‎ بود (شروعِ RTL)، پس هر نوشته‌ای که
       خودش صریحاً وسط نشده بود، به لبه می‌چسبید. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- ══ برچسبِ کادرها ═══════════════════════════════════════════════════════
       گزارشِ صاحب ریپو: «چرا همه عددها انقدر کوچک، همه کلمات هم همین‌طور —
       می‌خواهم همه یک اندازه و کلفت باشند.»

       هدف همان چیزی است که خودِ بالای همین فایل نوشته و از سایت گرفته شده:
       ‎.stat-label 1rem‎ با پایهٔ ۱۶ پیکسل ⇒ ۱۶، نه ۱۴. و ‎font-weight:700‎ی
       سایت ⇒ ‎Bold‎، نه وزنِ عادی که کنارِ عددهای ۱۷ و ۱۹ نازک دیده می‌شد.
       حالا برچسب و خانهٔ جدول هر دو ۱۶ به بالا هستند و هم‌خانواده دیده می‌شوند. -->
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- ‎.card-title‎ — عنوانِ سربرگِ کادر: پررنگ و به رنگِ اکسنت، مثلِ نسخهٔ وب -->
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- ══ کارت — ‎.card‎ نسخهٔ وب ══
       ⚠️ عددها از خودِ **مرورگر** آمده‌اند، نه از متنِ CSS. در CSS نوشته
       ‎border:1.5px; border-radius:14px‎ ولی مقدارِ محاسبه‌شدهٔ واقعی روی هر
       ۳۵ کارتِ صفحه ‎2px‎ و ‎18px‎ است — همان تله‌ای که در سربرگِ
       ‎SiteMetricsTests‎ هشدارش داده شده و این‌جا خودمان در آن افتاده بودیم.

       لبه از ‎Pump.Border‎ می‌آید نه ‎ChromeBorder‎: دومی رنگِ لبهٔ نوارهای
       بالای پنجره است و روی کارت‌ها یک درجه پررنگ‌تر از نسخهٔ وب می‌افتاد. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- کارتِ بیرونیِ یک بخش: بی‌بالشتک، تا سربرگِ رنگی به لبهٔ کارت بچسبد.
       ⚠️ نوشتنِ ‎Padding="0"‎ روی همان ‎Border‎ داخلِ ‎ControlTemplate‎ کار نمی‌کند:
       مقدارهای داخلِ قالب اولویتِ ‎Template‎ دارند و سبکِ ‎Border.card‎ از آن
       بالاتر است، پس ۱۴ پیکسلِ سبک برنده می‌شد. نتیجه‌اش یک نوارِ خالیِ بی‌دلیل
       بالای عنوانِ هر بخش بود و بدنه هم ۲۸ پیکسل تورفتگی می‌گرفت. -->
  <Style Selector="Border.card.flush">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- دکمه‌ها -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Selected}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.OnAccent}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.info">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Info}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Info}" />
  </Style>
  <!-- کارتی که خودش کلیک‌پذیر است: در نسخهٔ وب ‎card.onclick‎ حساب را باز
       می‌کند، پس کارت داخلِ یک دکمهٔ بی‌چهره می‌نشیند. دکمه‌های درونِ کارت
       (✕ و کیوآر) کلیکشان را خودشان مصرف می‌کنند و به این‌جا نمی‌رسد. -->
  <Style Selector="Button.card-shell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.card-shell /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
  </Style>

  <!-- ══ کارتِ لینکِ زیربخش — ‎.tool-link-card‎ نسخهٔ وب ══════════════════════
       نوشته سمتِ راست، فلشِ «‹» سمتِ چپ، و کلِ کارت کلیک‌پذیر. همان کادری که
       در سایت «قرض‌های کهنه»، «تخلیهٔ تانکر»، «گزارش پایان ماه»، «تاریخچهٔ نرخ»،
       «حساب‌های چکنه» و «مدیریت داده‌ها» را باز می‌کند.

       ‎min-height:44px‎ و ‎border-radius:11px‎ از خودِ CSS برداشته شده‌اند. -->
  <Style Selector="Button.tool-link">
    <Setter Property="Background" Value="{DynamicResource Pump.Dark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.tool-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- دکمه‌های ناوبری -->
  <!-- نوارِ بخش‌ها افقی است، پس دکمه‌ها به اندازهٔ نوشتهٔ خودشان‌اند و کشیده نمی‌شوند -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
  </Style>

  <!-- ══ کپسول‌های سربرگ ══════════════════════════════════════════════════
       ‎.role-badge‎ و ‎#lockBtn‎ در نسخهٔ وب هر دو ‎border-radius:999px‎ اند و
       اندازه‌گیری‌شان ۶۳×۳۰ و ۶۵×۴۰ در می‌آید. شعاعِ بزرگ در Avalonia همان
       کپسول را می‌سازد. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill-btn">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill-btn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>

  <!-- ══ ورودی‌ها ═══════════════════════════════════════════════════════════
       قدِ همهٔ کادرها و دکمه‌ها یکی است (۳۶ پیکسل) تا در یک ردیف هم‌تراز
       بنشینند — همان چیزی که یک فرمِ مرتب را از یک فرمِ شلخته جدا می‌کند.
       حلقهٔ فوکوس هم‌رنگِ برند است، مثلِ ‎.xls-in:focus‎ نسخهٔ وب. -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- کادرهای تایپ هم وسط‌چین‌اند، مثلِ ‎.xls-in‎ و
         ‎.ro-tbl td input{text-align:center}‎ی سایت. -->
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Pump.Selected}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="BorderThickness" Value="1.6" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- جدول -->
  <Style Selector="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Pump.GridLine}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Pump.GridLine}" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>
  <!-- دکمهٔ درونِ خانهٔ جدول (حذف، ثبت، …) وسطِ خانه بنشیند و از آن بیرون
       نزند. پیش از این دکمهٔ «حذف» از لبهٔ جدول بیرون می‌افتاد و روی خطِ
       کادر می‌نشست — در هر جدولی که ستونِ حذف داشت. -->
  <Style Selector="DataGridCell Button">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0" />
  </Style>
  <!-- ══ نشانگرِ ماوس روی جدول: «به‌علاوه»ی اکسل ═══════════════════════════
       گزارشِ صاحب ریپو: «ماوس هم باید شکلِ مثبت می‌داشت، اگر جست‌وجو بکنی تو
       سایت و پیدا کنی.» پیدا شد — خطِ ۱۰۴۸ی ‎index.html‎:

           .tbl td,.tbl th,.xls-tbl td,.xls-tbl th,
           .ro-tbl td,.ro-tbl th{ cursor:cell; ... }
           .xls-tbl td input:not(:focus){ cursor:cell }

       ‎cursor:cell‎ همان به‌علاوهٔ باریکِ اکسل است. نزدیک‌ترین چیزِ آوالونیا
       ‎StandardCursorType.Cross‎ است.
       ⚠️ کادرِ تایپ وقتی روی آن ایستاده‌ای هم همین را می‌گیرد (نه ‎IBeam‎)،
       چون سایت هم ‎:not(:focus)‎ گذاشته: تا وارد نشده‌ای، خانه است نه متن. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Cursor" Value="Cross" />
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource Pump.GridLine}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="Cursor" Value="Cross" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- نوشتهٔ داخلِ خانه هم واقعاً وسط بنشیند: ‎HorizontalContentAlignment‎ی
       خانه فقط وقتی اثر دارد که خودِ نوشته ‎Stretch‎ نباشد، و ‎DataGridTextColumn‎
       متنش را ‎Stretch‎ می‌سازد. -->
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DataGridCell TextBox">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Pump.Hover}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Pump.Selected}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ══ قالبِ مشترکِ بخش‌ها ═══════════════════════════════════════════════
       ساختار مو‌به‌مو همان چیزی است که هر بخش در نسخهٔ وب دارد:

           .card            ← یک کادرِ گِرد که کلِ بخش داخلش است
             .card-head     ← عنوانِ رنگی راست، دکمه‌های کار چپ
             (padding:14px) ← فیلتر، جمع‌ها، بدنه، پانویس

       اسکرول اصلاً مالِ بخش نیست. یکی است و مالِ کلِ پنجره
       (‎PageScroll‎ در ‎MainWindow‎) — مثلِ سایت: کلِ صفحه می‌لغزد، سربرگ و
       نوارِ آمار هم با آن بالا می‌روند و فقط نوارِ بخش‌ها سرِ صفر قفل می‌شود.
       بخش هیچ سقفی ندارد و فقط به بلندیِ محتوایش کِش می‌آید.

       ⚠️ اگر روزی وسوسه شدی این‌جا یا در یکی از بخش‌ها ‎ScrollViewer‎ بگذاری:
       نگذار. صاحب ریپو دو بار همین را رد کرد — «تا وقتی نوارِ بخش‌ها به سقف
       نچسبیده، محتوای بخش نباید تکان بخورد». هر اسکرولِ درونی همان قاعده را
       می‌شکند، چون چرخِ ماوس اول آن را می‌لغزاند نه صفحه را. سنجشِ اسکرول
       (سنجشِ اسکرول، حالتِ ‎scroll‎) همین را می‌پاید و اگر برگردد قرمز
       می‌شود.                                                              -->
  <Style Selector="c|SectionPage">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="card flush" Margin="16,14">
          <Grid RowDefinitions="Auto,*">

            <!-- ══ سربرگِ کادر ══ -->
            <Border Grid.Row="0" Classes="card-head">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Header}" Classes="card-title" />
                  <TextBlock Text="{TemplateBinding SubHeader}" Classes="muted"
                             TextWrapping="Wrap"
                             IsVisible="{TemplateBinding SubHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Toolbar}"
                                  VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </Border>

            <!-- ══ بدنهٔ کادر ══ -->
            <!-- ردیفِ اول تازه است: کارت‌های زیربخش. بقیه همان چهارتای
                 همیشگی‌اند و همه ‎Auto‎ می‌مانند — با اسکرولِ واحدِ کلِ صفحه،
                 بخش باید به اندازهٔ محتوایش بلند شود، نه به اندازهٔ قاب. -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="14">

              <!-- ══ کارت‌های زیربخش ══════════════════════════════════════
                   بخشی که زیربخش دارد (قرض‌داران، مخزن، مفاد/ضرر، تنظیمات،
                   رسید قرض‌داران، حاضری) کارت‌هایشان همین بالا می‌آیند — مثلِ
                   ‎.tool-link-card‎ نسخهٔ وب. بخشی که ندارد، این ردیف را
                   اصلاً نمی‌بیند.

                   ‎x:CompileBindings="False"‎ لازم است: داخلِ ControlTemplate
                   نوعِ DataContext معلوم نیست، و این‌جا DataContext همان
                   ViewModelِ بخش است که به SectionPage رسیده. -->
              <ItemsControl Grid.Row="0" x:CompileBindings="False"
                            ItemsSource="{Binding SubSections}"
                            IsVisible="{Binding ShowSubLinkCards, FallbackValue=False}"
                            Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Button Classes="tool-link" Margin="0,0,10,8" MinWidth="230"
                            Command="{Binding ParentSection.ShowSubCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding LinkTitle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="‹" FontSize="17" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Opacity="0.7" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

                <Border Grid.Row="1" Classes="panel" Padding="12,9" Margin="0,0,0,12"
                        IsVisible="{TemplateBinding Filters, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ContentPresenter Content="{TemplateBinding Filters}" />
                </Border>

                <ContentPresenter Grid.Row="2" Content="{TemplateBinding Summary}" Margin="0,0,0,12"
                                  IsVisible="{TemplateBinding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <ContentPresenter Grid.Row="3" Content="{TemplateBinding Body}" />

                <ContentPresenter Grid.Row="4" Content="{TemplateBinding Footer}" Margin="0,12,0,0"
                                  IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- ══ «📝 یادداشت این بخش» — ‎.sec-note-box‎ی نسخهٔ وب ═══════
                     در سایت پایینِ چهارده بخش هست و در برنامهٔ نیتیو هیچ‌جا نبود.
                     گزارشِ صاحب ریپو: «تو سایت بخش نوت هم داشت، آن چه شد؟»

                     این‌جا در قالبِ مشترک نشسته، نه در تک‌تکِ ویوها: هر بخشی که
                     ‎Notes‎ی خودش را بسازد، خودبه‌خود این کادر را می‌گیرد و هر
                     تغییرِ ظاهری در همه‌شان با هم اعمال می‌شود.

                     ‎x:CompileBindings="False"‎ مثلِ کارت‌های زیربخشِ بالا لازم
                     است: داخلِ ControlTemplate نوعِ DataContext معلوم نیست. -->
                <StackPanel Grid.Row="5" Margin="0,14,0,0" Spacing="8"
                            x:CompileBindings="False"
                            IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull},
                                        FallbackValue=False}"
                            DataContext="{Binding Notes}">
                  <TextBlock Text="📝 یادداشت این بخش" Classes="label" />
                  <TextBox Text="{Binding Draft}" AcceptsReturn="True" MinHeight="62"
                           TextWrapping="Wrap" Watermark="یادداشت شما…" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="ghost info" Content="📨 فرستادن به صندوق نوت‌ها"
                            Command="{Binding SendCommand}" />
                    <Button Classes="ghost" Content="{Binding ListToggleText}"
                            Command="{Binding ToggleListCommand}" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsListOpen}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="panel" Padding="10,8" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding DateShamsi}"
                                       Classes="muted" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="4" Classes="ghost danger" Content="حذف"
                                    Padding="8,3" FontSize="12"
                                    Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ══ کادرِ عددِ خلاصه — ‎.stat-box‎ نسخهٔ وب ═══════════════════════════
       ‎background:var(-dark); border:1px solid var(-border);
        border-radius:10px; padding:14px; text-align:center;
        min-height:86px; justify-content:center‎

       نکتهٔ مهم «وسط‌چین» است: تا امروز برچسب و عدد راست‌چین بودند و در یک
       کادرِ کشیده، نوشته به یک گوشه می‌چسبید و سمتِ دیگر خالی می‌ماند —
       همان چیزی که کادرها را ناجور نشان می‌داد.                            -->
  <!-- ‎.stat-box‎ — شعاعِ محاسبه‌شده روی هر ۱۷ کادر ‎13px‎ است، نه ۱۰. -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource Pump.Dark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="MinHeight" Value="86" />
  </Style>
  <!-- فاصلهٔ بینِ کادرهای یک ردیفِ خلاصه. ‎UniformGrid‎ خودش فاصله ندارد، پس
       هر کادر نصفِ فاصله را از هر طرف می‌گیرد و کادرهای دو سر با حاشیهٔ منفیِ
       خودِ ردیف به لبه می‌چسبند. -->
  <Style Selector="UniformGrid.stats">
    <Setter Property="Margin" Value="-6,0" />
  </Style>
  <Style Selector="UniformGrid.stats > Border.stat">
    <Setter Property="Margin" Value="6,0" />
  </Style>

  <!-- محتوای کادر وسطِ آن می‌نشیند و نوشته‌هایش وسط‌چین‌اند -->
  <Style Selector="Border.stat > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.stat TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- تب‌های حساب: چیپ، نه فهرستِ ساده -->
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>

  <!-- ══ کارتِ شیفتِ پارچه — همان چیدمانِ نسخهٔ وب ══ -->
  <Style Selector="Border.shift-card">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.shift-header">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="13,13,0,0" />
  </Style>
  <!-- روز: نارنجی · شب: بنفش — همان دو رنگِ نسخهٔ وب -->
  <Style Selector="Border.shift-header.day">
    <Setter Property="Background" Value="#f0952b" />
  </Style>
  <Style Selector="Border.shift-header.day TextBlock">
    <Setter Property="Foreground" Value="#1a1102" />
  </Style>
  <Style Selector="Border.shift-header.night">
    <Setter Property="Background" Value="#7c4dbe" />
  </Style>
  <Style Selector="Border.shift-header.night TextBlock">
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>

  <Style Selector="TextBlock.fld">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- خانهٔ «خودکار» — خوانده می‌شود، تایپ نمی‌شود -->
  <Style Selector="Border.calc">
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <Style Selector="Border.saved-badge">
    <Setter Property="Background" Value="#2038a169" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Ok}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.saved-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ok}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Button.save-btn">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.save-btn.day /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0952b" />
    <Setter Property="TextBlock.Foreground" Value="#1a1102" />
  </Style>
  <Style Selector="Button.save-btn.night /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#7c4dbe" />
    <Setter Property="TextBlock.Foreground" Value="#ffffff" />
  </Style>

  <!-- ══ سربرگِ داخلِ کارت — ‎.card-head‎ ══
       ‎padding:12px 16px; border-bottom:1px solid var(-border)‎
       زمینه یک پله تیره‌تر از خودِ کارت است تا سربرگ از بدنه جدا دیده شود —
       همان کاری که در نسخهٔ وب اختلافِ ‎-panel‎ و ‎-card‎ می‌کرد. -->
  <!-- ‎.card-head‎ — مقدارِ محاسبه‌شدهٔ مرورگر روی هر ۳۵ سربرگ: ‎15.84px 22px‎
       (یعنی افقی ۲۲، عمودی ۱۵٫۸۴). پیش از این ۱۶/۱۲ بود و عنوانِ هر کارت
       شش پیکسل به لبه نزدیک‌تر می‌نشست. -->
  <Style Selector="Border.card-head">
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="22,16" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Pump.Dark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ══ کارتِ قرض‌دار — رنگِ کارت از حالِ حساب می‌آید ══ -->
  <Style Selector="Border.person-card">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,10,12,12" />
  </Style>
  <Style Selector="Border.person-card.out">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
  </Style>
  <Style Selector="Border.person-card.low">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Warn}" />
  </Style>
  <Style Selector="Border.person-card.ok">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Ok}" />
  </Style>

  <!-- دکمهٔ ✕ گوشهٔ کارت -->
  <!-- دکمه‌های ریزِ داخلِ جدول/کارت از قاعدهٔ «۳۶ پیکسل» مستثنایند -->
  <Style Selector="Button.card-x, Button.qr, Button.seg, Button.nav-edge">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.card-x">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Danger}" />
  </Style>
  <Style Selector="Button.card-x /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- دکمهٔ «کیوآر کد» — کادرِ آبیِ خالی، مثلِ نسخهٔ وب -->
  <Style Selector="Button.qr">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Info}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Info}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Button.qr /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ‎.pname‎ — نامِ کارت. جای نام همیشه دو خط است (‎min-height:66px‎ در CSS)
       تا کارت‌های یک ردیف هم‌قد بمانند، و همهٔ نام‌ها یک اندازه‌اند: نامِ بلندتر
       ریز نمی‌شود، با «…» کوتاه می‌شود. -->
  <Style Selector="TextBlock.pname">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Margin" Value="4,6,4,0" />
  </Style>

  <!-- ‎.cmp-fig‎ — کادرِ «دالر» و «الباقی» کارتِ شرکت: بی‌خط، وسط‌چین، هم‌قد -->
  <Style Selector="TextBlock.cmp-fig">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- ══ نوارِ بخش‌ها ═══════════════════════════════════════════════════════
       ارتفاع ثابت است و نوارِ لغزش پنهان — وگرنه نوارِ لغزشِ افقی از پایین
       ارتفاع را می‌خورد و زیرِ نوشتهٔ دکمه‌ها بریده می‌شد. دو دکمهٔ «‹ ›» فقط
       وقتی پیدا می‌شوند که واقعاً بخشی بیرونِ قاب مانده باشد. -->
  <Style Selector="c|NavStrip">
    <Setter Property="Height" Value="52" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- فلش‌ها بیرونِ ناحیهٔ لغزش‌اند، نه رویش. اگر رویش باشند، بخشِ فعالی
             که تازه به لبه آمده زیرشان نیمه‌پنهان می‌ماند. ستونِ Auto با پنهان
             شدنِ دکمه خودش صفر می‌شود، پس وقتی لغزشی در کار نیست هیچ جایی
             هدر نمی‌رود. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Name="PART_Prev" Classes="nav-edge" Content="›" IsVisible="False" />

          <ScrollViewer Grid.Column="1" Name="PART_Scroll"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <!-- ⚠️ فاصلهٔ دو سرِ نوار «حاشیهٔ محتوا» است نه ‎Padding‎ِ خودِ
                 ScrollViewer: بالشتکِ ScrollViewer بیرونِ اندازهٔ محتوا می‌ماند،
                 پس دکمهٔ آخر — که همیشه بخشِ «تاریخچه‌ها» بود — ده پیکسل بیرونِ
                 دامنهٔ لغزش می‌افتاد و نصفه بریده می‌شد. -->
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                              Margin="10,0" />
          </ScrollViewer>

          <Button Grid.Column="2" Name="PART_Next" Classes="nav-edge" Content="‹" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.nav-edge">
    <Setter Property="Width" Value="26" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
  </Style>
  <Style Selector="Button.nav-edge /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.NavBg}" />
  </Style>
  <Style Selector="Button.nav-edge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>

  <!-- ‎.dash-seg‎ — دکمه‌های کوچکِ «همه/پطرول/دیزل» و «روزانه/هفتگی/…» -->
  <Style Selector="Button.seg">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- ستونِ نمودارِ فروشِ داشبورد -->
  <Style Selector="Border.db-bar">
    <Setter Property="Background" Value="{DynamicResource Pump.Info}" />
    <Setter Property="Opacity" Value="0.62" />
  </Style>
  <Style Selector="Border.db-bar.sel">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- خانهٔ کارتِ خرید — برچسب بالا، مقدار پایین -->
  <Style Selector="StackPanel.cell">
    <Setter Property="Width" Value="126" />
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,12,10" />
  </Style>
  <!-- خانهٔ فرم داخلِ ردیفِ پخش‌شده پهنای ثابتِ ‎.cell‎ را کنار می‌گذارد و
       عرضش را از خودِ ردیف می‌گیرد؛ وگرنه ۱۲۶ پیکسل می‌ماند و وسطِ خانه‌اش
       شناور می‌شود. (‎NaN‎ در Avalonia یعنی «خودکار».) -->
  <Style Selector="UniformGrid.stats > StackPanel.cell">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Margin" Value="6,0" />
  </Style>


  <!-- ══ جانِ حرکت ═══════════════════════════════════════════════════════════
       نسخهٔ وب همه‌جا ‎transition‎ داشت و نسخهٔ نیتیو هیچ: دکمه‌ها آنی رنگ عوض
       می‌کردند و کارت‌ها به لمسِ ماوس واکنشی نشان نمی‌دادند. همان زمان‌بندی‌های
       خودِ CSS این‌جا آمده — نه بیشتر، تا برنامه «شلوغ» نشود:

         دکمه   ‎transform .15s · background .2s‎ ، فشار ‎scale(.95)‎
         ناوبری ‎.2s‎ ، فشار ‎scale(.93)‎
         کارت   ‎border-color .3s‎ و روشن‌تر شدنِ لبه زیرِ ماوس

       هیچ سایه/تاری اضافه نشده (خواستهٔ صریحِ صاحب ریپو) — حرکت از تغییرِ
       اندازه و رنگِ لبه می‌آید، نه از blur.                                -->
  <Style Selector="Button">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="Button.nav:pressed">
    <Setter Property="RenderTransform" Value="scale(0.93)" />
  </Style>

  <!-- فقط رنگِ لبه نرم می‌شود، نه زمینه.
       خودِ CSS هم همین است: ‎transition: transform .3s, box-shadow .3s,
       border-color .3s‎ — زمینه در فهرست نیست. یک‌بار زمینه را هم گذاشتم و
       نتیجه‌اش این شد که کارت‌ها هنگامِ باز شدنِ بخش از رنگِ اولیه به رنگِ
       خودشان «محو» می‌شدند و صفحه یک لحظه مه‌آلود دیده می‌شد. -->
  <Style Selector="Border.card, Border.person-card, Border.shift-card, Border.stat">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.person-card:pointerover, Border.shift-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- ورودی‌ها هم نرم روشن شوند، نه پرشی -->
  <Style Selector="TextBox">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ══ ردیفِ «جمله»ی ته جدول ═══════════════════════════════════════════════
       همتای ‎<tfoot class="xls-foot">‎ی سایت: نوارِ تیره‌تر با خطِ بالای پررنگ،
       خانهٔ اولش «جمله» و بقیه جمعِ هر ستون. با ‎c:TotalsBar‎ زیرِ هر جدول
       گذاشته می‌شود؛ هیچ‌وقت داخلِ خودِ جدول نمی‌رود (توضیحِ چرایی در
       ‎Controls/TotalsBar.cs‎). -->
  <Style Selector="c|TotalsBar">
    <Setter Property="Margin" Value="0,-1,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Pump.Panel}"
                BorderBrush="{DynamicResource Pump.Border}"
                BorderThickness="1,2,1,1"
                CornerRadius="0,0,10,10" Padding="12,9">
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="{TemplateBinding Title}" FontWeight="ExtraBold" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Pump.Text}" />
            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}" x:CompileBindings="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1" Margin="0,0,20,0" MinWidth="76">
                    <TextBlock Text="{Binding Label}" FontSize="11"
                               Foreground="{DynamicResource Pump.Muted}" />
                    <TextBlock Text="{Binding Value}" FontWeight="ExtraBold" FontSize="14"
                               Foreground="{Binding BrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

</Styles>
