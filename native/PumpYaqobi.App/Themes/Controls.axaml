<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PumpYaqobi.App.Controls"
        xmlns:th="using:PumpYaqobi.App.Themes"
        xmlns:vm="using:PumpYaqobi.App.ViewModels">
  <Styles.Resources>
    <!-- ══ گزینهٔ کشوی ماه/سال با نقطهٔ سرخِ «ماهِ تازه» ════════════════════
         خواستهٔ صاحب ریپو (۱۴۰۵/۰۷/۱۳): «رویش که زد، همان ماهی که قبلاً بود
         را با یک نقطهٔ سرخ نشان بدهد.» شرحش بالای ‎MonthDot‎. یک قالب برای
         همهٔ کشوی‌های ماه و سال، نه یکی در هر نما. -->
    <DataTemplate x:Key="Pump.MonthDotItem" x:DataType="vm:YearMonthItem">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        <Ellipse Classes="monthdot" IsVisible="{Binding Dot}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <!-- فونتِ برنامه + پشتیبانِ ایموجیِ سیستم. Vazirmatn ایموجی ندارد؛ روی
         ویندوز «Segoe UI Emoji» و روی لینوکس «Noto Color Emoji» جایش را پر
         می‌کنند، وگرنه نشانه‌ها (⛽ 🟤 💵) خالی دیده می‌شوند. -->
    <FontFamily x:Key="Pump.Font">avares://PumpYaqobi/Assets/Vazirmatn.ttf#Vazirmatn, Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji</FontFamily>
  </Styles.Resources>
  <!-- ══ سبکِ مشترکِ برنامه ═══════════════════════════════════════════════
       همه‌چیز از {DynamicResource Pump.*} رنگ می‌گیرد، پس تعویضِ تم آنی است.
       هیچ سایه/تاریِ سنگینی نیست (خواستهٔ صریحِ صاحب ریپو) — عمق با
       لبه و اختلافِ سطح ساخته می‌شود، نه با blur.                        -->

  <!-- ══ مقیاسِ نوشته ═══════════════════════════════════════════════════════
       اندازه‌ها از خودِ CSSِ نسخهٔ وب (شاخهٔ دسکتاپش) برداشته شده‌اند:
         .stat-label 1rem · .stat-value 1.55rem · .card-title 1.05rem
         .nav-btn 1rem   · .tbl 1.08rem
       با پایهٔ ۱۶ پیکسلِ مرورگر. پیش از این همه حدودِ ۸۰٪ِ این عددها بودند و
       برنامه کنارِ نسخهٔ وب «ریز و فشرده» دیده می‌شد.                       -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="FlowDirection" Value="RightToLeft" />
    <Setter Property="Background" Value="{DynamicResource Pump.AppBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- ══ همهٔ نوشته‌ها وسطِ کادرِ خودشان ═════════════════════════════════════
       خواستهٔ صریحِ صاحب ریپو: «همه نوشته‌ها، همه همه همه نوشته‌ها باید تو
       کادرهاشون وسط‌چین باشن، تو همه بخش‌ها.»

       در سایت هم هر خانهٔ هر جدول وسط‌چین است — بی استثنا:
           .tbl th{text-align:center}   .tbl td{text-align:center}
           .xls-tbl th{text-align:center}  .xls-tbl td{text-align:center}
           .ro-tbl th/td, .safe-tbl, .rasid-tbl, .att-tbl … همه center
       و کادرهای تایپِ داخلِ خانه‌ها هم:
           .ro-tbl td input/textarea/select{text-align:center}

       پیش از این پیش‌فرضِ اینجا ‎Right‎ بود (شروعِ RTL)، پس هر نوشته‌ای که
       خودش صریحاً وسط نشده بود، به لبه می‌چسبید. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- ══ برچسبِ کادرها ═══════════════════════════════════════════════════════
       گزارشِ صاحب ریپو: «چرا همه عددها انقدر کوچک، همه کلمات هم همین‌طور —
       می‌خواهم همه یک اندازه و کلفت باشند.»

       هدف همان چیزی است که خودِ بالای همین فایل نوشته و از سایت گرفته شده:
       ‎.stat-label 1rem‎ با پایهٔ ۱۶ پیکسل ⇒ ۱۶، نه ۱۴. و ‎font-weight:700‎ی
       سایت ⇒ ‎Bold‎، نه وزنِ عادی که کنارِ عددهای ۱۷ و ۱۹ نازک دیده می‌شد.
       حالا برچسب و خانهٔ جدول هر دو ۱۶ به بالا هستند و هم‌خانواده دیده می‌شوند. -->
  <!-- ⚠️ این برچسب عمداً **وسط** است و سرِ خط نیست.
       یک‌بار سرِ خط شد و گزارشِ صاحب ریپو این بود: «بعضی سربرگ‌ها خراب شدند و
       نوشته‌ها را بردند یک کنج». درست هم بود: ‎.label‎ هم بالای کادرهای فرم
       به کار می‌رود و هم داخلِ کادرهای خلاصه و سربرگ‌ها.
       برچسبِ **فرم‌ها** ‎.fld‎ است و همان سرِ خط می‌نشیند. -->
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- ‎.card-title‎ — عنوانِ سربرگِ کادر: پررنگ و به رنگِ اکسنت، مثلِ نسخهٔ وب -->
  <!-- ⚠️ عنوانِ بخش دیگر به رنگِ تاکید نیست. رنگِ تاکید باید خسیس خرج شود —
       تبِ فعال، دکمهٔ اصلی، و عددهای کلیدی. وقتی عنوانِ هر بخش هم همان رنگ
       باشد، تاکید معنایش را از دست می‌دهد و صفحه یکدست جیغ می‌شود. -->
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="17.5" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Accent}" />
  </Style>
  <!-- عددِ دوم (دالر کنارِ افغانی): همان وزن، کمی کوچک‌تر — نه ریز و کم‌رنگ.
       گزارشِ صاحب ریپو: «دالر رو تو سربرگ خیلی کوچیک و بی‌اهمیت نشون میده.» -->
  <Style Selector="TextBlock.num2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Info}" />
  </Style>

  <!-- ══ کارت — ‎.card‎ نسخهٔ وب ══
       ⚠️ عددها از خودِ **مرورگر** آمده‌اند، نه از متنِ CSS. در CSS نوشته
       ‎border:1.5px; border-radius:14px‎ ولی مقدارِ محاسبه‌شدهٔ واقعی روی هر
       ۳۵ کارتِ صفحه ‎2px‎ و ‎18px‎ است — همان تله‌ای که در سربرگِ
       ‎SiteMetricsTests‎ هشدارش داده شده و این‌جا خودمان در آن افتاده بودیم.

       لبه از ‎Pump.Border‎ می‌آید نه ‎ChromeBorder‎: دومی رنگِ لبهٔ نوارهای
       بالای پنجره است و روی کارت‌ها یک درجه پررنگ‌تر از نسخهٔ وب می‌افتاد. -->
  <!-- ⚠️ خطِ کادر از ۲ به ۱ آمد و گوشه از ۱۸ به ۱۴ — و این **عمدی** است، نه
       بی‌دقتی در بازخوانیِ سایت: صاحب ریپو از روی نمونه‌ها تصمیم گرفت ظاهرِ
       برنامه دیگر کپیِ سایت نباشد. خطِ ۲ پیکسلی روی ده‌ها کادرِ یک صفحه، صفحه
       را قفس‌مانند می‌کرد؛ خطِ ۱ پیکسلی همان جدایی را می‌سازد بی آن‌که فریاد
       بزند. (آزمونِ ‎SiteMetricsTests‎ هم با همین توضیح به‌روز شد.) -->
  <!-- ══ نورِ لبه + سایه (‎Pump.CardShadow‎) ═══════════════════════════════════
       خواستهٔ صاحب ریپو با دو عکسِ مرجع: «یک Border ساده نمی‌خواهم — خطِ باریکِ
       آبی روی لبه، هالهٔ نورِ بسیار ملایم نزدیکِ لبه، و سایهٔ تیره بیرون.» رشته‌اش
       در خودِ تم است (‎PumpTheme.CardShadow‎) و زیرِ ماوس کمی پررنگ‌تر می‌شود.
       ⚠️ ‎ClipToBounds‎ برداشته شد: سایه بیرونِ کادر کشیده می‌شود و کلیپ آن را
       می‌بُرید. گوشهٔ گردِ سربرگِ کارت با ‎card-head‎ی خودش گرد است. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.CardShadow}" />
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.CardShadowHover}" />
  </Style>
  <!-- کارتِ بیرونیِ یک بخش: بی‌بالشتک، تا سربرگِ رنگی به لبهٔ کارت بچسبد.
       ⚠️ نوشتنِ ‎Padding="0"‎ روی همان ‎Border‎ داخلِ ‎ControlTemplate‎ کار نمی‌کند:
       مقدارهای داخلِ قالب اولویتِ ‎Template‎ دارند و سبکِ ‎Border.card‎ از آن
       بالاتر است، پس ۱۴ پیکسلِ سبک برنده می‌شد. نتیجه‌اش یک نوارِ خالیِ بی‌دلیل
       بالای عنوانِ هر بخش بود و بدنه هم ۲۸ پیکسل تورفتگی می‌گرفت. -->
  <Style Selector="Border.card.flush">
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- بدنهٔ کادرِ بخش: یک پله بینِ بوم و کارت‌های داخلی (‎Pump.Section‎)، تا
       کارتِ داخلی و جای خالیِ دورش یک رنگ نباشند — شرحش در ‎PumpTheme.SectionBg‎. -->
  <!-- ⚠️ بدنهٔ بخش صفحه‌قد است و سایهٔ **بی‌محو** می‌گیرد (‎Pump.SectionShadow‎):
       سایهٔ محو روی کادری به بلندیِ کلِ صفحه با هر فریمِ اسکرول از نو کشیده
       می‌شد و هر چرخِ ماوس را ~۳۰ میلی‌ثانیه گران می‌کرد (سنجشِ ‎scrollperf‎؛
       شرحش بالای ‎PumpTheme.SectionShadowOrCard‎). زیرِ ماوس هم همان می‌ماند،
       وگرنه با ماوسِ روی صفحه — یعنی همیشه — سایهٔ محوِ ‎hover‎ برمی‌گشت. -->
  <Style Selector="Border.card.section">
    <Setter Property="Background" Value="{DynamicResource Pump.Section}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.SectionShadow}" />
  </Style>
  <Style Selector="Border.card.section:pointerover">
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.SectionShadow}" />
  </Style>
  <!-- ══ کارتِ بزرگ (‎.calm‎): همان کارت، سایهٔ **بی‌محو** ═══════════════════════
       گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۱۳): «داشبورد و مفاد/ضرر خیلی سنگین اسکرول
       می‌شوند.» همان قاعدهٔ ‎Border.card.section‎: سایهٔ محو با هر فریمِ اسکرول
       از نو کشیده می‌شود و هزینه‌اش با **مساحت** بالا می‌رود (‎scrollperf why‎:
       هر شعاعِ محوی ~۳۰ms برای یک کادرِ صفحه‌قد، همان سایه بی محو صفر).
       کارت‌های ۹۰۰×۴۴۰ی داشبورد و کارت‌های تمام‌عرضِ مفاد/ضرر «کارتِ کوچک»
       نیستند — ‎CardShadow‎ی محو فقط برای کارت‌های کوچک (‎.stat‎، پنج کارتِ
       آماری) می‌ماند. زیرِ ماوس هم همان می‌ماند، وگرنه با ماوسِ روی صفحه —
       یعنی همیشه — محو برمی‌گشت. -->
  <Style Selector="Border.card.calm">
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.SectionShadow}" />
  </Style>
  <Style Selector="Border.card.calm:pointerover">
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.SectionShadow}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <!-- ══ خطِ برجستگی ═══════════════════════════════════════════════════════
         بندِ ۳ی «پرامپت کیفیت بصری»: یک خطِ ۱px سفید با آلفای ۶٪ فقط روی
         لبهٔ **بالاییِ داخلِ** کادر. کادر را «بلند» نشان می‌دهد بی هیچ سایه‌ای
         — و بندِ ۳ صریح گفته کادرِ ثابت هرگز سایه ندارد.
         با ‎inset‎ کشیده می‌شود، نه با یک ‎Border‎ی تودرتو: بندِ ۸ بوردرِ
         تودرتو را هم ممنوع کرده. -->
    <!-- ⚠️ پنل‌ها گاهی صفحه‌قدند (دورِ جدول‌ها)، پس سایهٔ بی‌محو — همان قاعدهٔ
         ‎Border.card.section‎. کارت‌های کوچکِ ‎.stat‎ و ‎.card‎ سایهٔ محو را دارند. -->
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.SectionShadow}" />
  </Style>

  <!-- دکمه‌ها -->
  <!-- ══ سبکِ پایهٔ دکمه ═══════════════════════════════════════════════════
       ⛔ زمینه‌اش **`Pump.Input`** است، نه `Pump.Card`.
       گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۰۶): «دکمهٔ دیدنِ این‌که به‌روزرسانی است را
       اصلاً نمی‌بینم، آن دکمه‌اش کجا شده؟» — دکمه سرِ جایش بود: در تمِ آبی
       `Pump.Card` **سفیدِ خالص** است و `Border.panel` هم همان سفید، پس
       دکمهٔ بی‌کلاس می‌شد سفید روی سفید با یک خطِ ۱ پیکسلیِ کم‌رنگ.
       دیده نمی‌شد چون هیچ اختلافی نداشت، نه چون نبود.
       ⚠️ همان قاعدهٔ کلیدهای ماشین‌حساب از ۱۴۰۵/۰۶/۲۵: «کلیدها `Pump.Input`
       تا از کارت جدا باشند». این‌جا هم همان است، برای هر دکمهٔ بی‌کلاس در
       کلِ برنامه (۴۵ تا). `accent` و `ghost` و بقیه دست‌نخورده‌اند. -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Selected}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.OnAccent}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.info">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Info}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Info}" />
  </Style>
  <!-- کارتی که خودش کلیک‌پذیر است: در نسخهٔ وب ‎card.onclick‎ حساب را باز
       می‌کند، پس کارت داخلِ یک دکمهٔ بی‌چهره می‌نشیند. دکمه‌های درونِ کارت
       (✕ و کیوآر) کلیکشان را خودشان مصرف می‌کنند و به این‌جا نمی‌رسد. -->
  <!-- ⚠️ کارت باید تمامِ خانهٔ هم‌اندازهٔ ‎UniformGridLayout‎ را پر کند، وگرنه
       کارتِ کم‌محتوا کوچک می‌ماند و ردیف ناهموار دیده می‌شود — همان چیزی که در
       عکسِ صاحب ریپو بود. -->
  <Style Selector="Button.card-shell">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.card-shell /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
  </Style>

  <!-- ══ کارتِ لینکِ زیربخش — ‎.tool-link-card‎ نسخهٔ وب ══════════════════════
       نوشته سمتِ راست، فلشِ «‹» سمتِ چپ، و کلِ کارت کلیک‌پذیر. همان کادری که
       در سایت «قرض‌های کهنه»، «تخلیهٔ تانکر»، «گزارش پایان ماه»، «تاریخچهٔ نرخ»،
       «حساب‌های چکنه» و «مدیریت داده‌ها» را باز می‌کند.

       ‎min-height:44px‎ و ‎border-radius:11px‎ از خودِ CSS برداشته شده‌اند. -->
  <Style Selector="Button.tool-link">
    <Setter Property="Background" Value="{DynamicResource Pump.Dark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <!-- هم‌قد و هم‌قلمِ کادرِ جست‌وجوی بغلش (خواستهٔ صاحب ریپو) -->
    <Setter Property="FontSize" Value="14.5" />
  </Style>
  <Style Selector="Button.tool-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.Ink.Accent}" />
  </Style>

  <!-- دکمه‌های ناوبری -->
  <!-- نوارِ بخش‌ها افقی است، پس دکمه‌ها به اندازهٔ نوشتهٔ خودشان‌اند و کشیده نمی‌شوند -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{DynamicResource Pump.NavActiveFg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.NavActiveBg}" />
  </Style>
  <!-- ⚠️ سبکِ سراسریِ ‎TextBlock‎ رنگِ ‎Pump.Text‎ را روی خودِ نوشته می‌گذارد و
       ‎Foreground‎ِ دکمه به آن نمی‌رسد؛ پس در تمِ تیره نوشتهٔ تبِ فعال سفید روی
       زرد می‌ماند (گزارشِ ۱۴۰۵/۰۷/۱۴). نوشته خودش ‎NavActiveFg‎ می‌گیرد. -->
  <Style Selector="Button.nav.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Pump.NavActiveFg}" />
  </Style>
  <!-- نشانِ گردِ پشتِ آیکونِ بخش در نوار (زمینه از ‎IconColorConverter‎، پارامترِ badge) -->
  <Style Selector="Border.icon-badge">
    <Setter Property="Width" Value="27" />
    <Setter Property="Height" Value="27" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.icon-badge > Path">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ══ دکمه‌های «یکی از چند تا» — همان رادیوییِ سایت ═══════════════════════
       گزارشِ صاحب ریپو: «مثلِ اون دکمهٔ رادیو باشه که یکی انتخاب بشه.»

       در سایت ‎همه │ پطرول │ دیزل‎ یک گروهِ رادیویی است و انتخاب‌شده پررنگ
       می‌ماند. در برنامه هر سه دکمهٔ ساده بودند و هیچ‌کدام نشان نمی‌داد کدام
       فعال است — آدم نمی‌فهمید فیلتر روشن است یا نه.

       ‎ToggleButton‎ نشد چون هر سه باید هم‌زمان یک حالت داشته باشند و حالت
       در ویومدل است (‎IsFilterAll/Petrol/Diesel‎)؛ پس دکمهٔ معمولی با کلاسِ
       ‎active‎ که از همان ویومدل بسته می‌شود. -->
  <Style Selector="Button.seg">
    <Setter Property="Padding" Value="13,5" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
  </Style>
  <Style Selector="Button.seg /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- ══ کپسولِ نوعِ تیل داخلِ ردیف ═══════════════════════════════════════
       کوچک، بی پس‌زمینه، با لبه و نوشتهٔ هم‌رنگِ خودِ تیل — همان ‎.ft-opt‎ی
       سایت:  ‎font-size:0.88rem; font-weight:700; border-radius:6px;
               padding:3px 7px; border:1px solid‎ -->
  <!-- ══ کپسولِ «قرض ⇄ مصرف» و «پطرول ⇄ دیزل» ═══════════════════════════════
       گزارشِ صاحب ریپو (۱۴۰۵/۰۶/۲۷): «اون قرض و مصرف رفته داخلِ کادر، کمی
       کم‌پیدا است.» حق داشت: کپسول پس‌زمینهٔ شفاف داشت و روی خانهٔ سفید فقط
       یک خطِ یک‌پیکسلی بود. حالا سطحِ خودش را دارد (‎Pump.Input‎، همان سطحی
       که کادرهای تایپ دارند) و خطش کمی پررنگ‌تر است — رنگِ نوشته و خط مثلِ
       قبل از خودِ ردیف می‌آید (سبزِ پطرول، کهربایِ دیزل، سرخِ قرض، بنفشِ
       مصرف)، پس معنی‌شان عوض نشده، فقط دیده می‌شوند. -->
  <Style Selector="Button.fuelchip">
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1.4" />
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="MinWidth" Value="62" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.fuelchip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
  </Style>
  <Style Selector="Button.fuelchip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>

  <!-- کپسولِ **قفل‌شده** — همان شکل، ولی دکمه نیست: تیلِ پایه‌ای که از پارچه
       آمده این‌جا عوض نمی‌شود (۱۴۰۵/۰۷/۱۲). خطِ نقطه‌چین یعنی «فقط دیدنی». -->
  <Style Selector="Border.fuelchip.locked">
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1.4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="62" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.fuelchip.locked TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ══ کپسول‌های سربرگ ══════════════════════════════════════════════════
       ‎.role-badge‎ و ‎#lockBtn‎ در نسخهٔ وب هر دو ‎border-radius:999px‎ اند و
       اندازه‌گیری‌شان ۶۳×۳۰ و ۶۵×۴۰ در می‌آید. شعاعِ بزرگ در Avalonia همان
       کپسول را می‌سازد. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill-btn">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill-btn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>
  <!-- دکمهٔ پشتیبانی رنگِ تاکید، نه سرخ — سرخ مالِ «قفل» است -->
  <Style Selector="Button.pill-btn.support">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="Button.pill-btn.support /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- دکمهٔ پروفایل رنگِ برند (‎Pump.Info‎)، نه سرخ و نه تاکید — تا سه دکمهٔ
       سربرگ از هم جدا باشند -->
  <Style Selector="Button.pill-btn.profile">
    <Setter Property="Background" Value="{DynamicResource Pump.Info}" />
  </Style>
  <Style Selector="Button.pill-btn.profile /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Info}" />
  </Style>

  <!-- ══ ورودی‌ها ═══════════════════════════════════════════════════════════
       قدِ همهٔ کادرها و دکمه‌ها یکی است (۳۶ پیکسل) تا در یک ردیف هم‌تراز
       بنشینند — همان چیزی که یک فرمِ مرتب را از یک فرمِ شلخته جدا می‌کند.
       حلقهٔ فوکوس هم‌رنگِ برند است، مثلِ ‎.xls-in:focus‎ نسخهٔ وب. -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- کادرهای تایپ هم وسط‌چین‌اند، مثلِ ‎.xls-in‎ و
         ‎.ro-tbl td input{text-align:center}‎ی سایت. -->
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Pump.Selected}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="BorderThickness" Value="1.6" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- جدول -->
  <!-- ══ جدولِ چسبان: نوارِ لغزشِ خودش دیده نمی‌شود ══════════════════════
       جدولِ بلند قابش عمداً یک صفحه است (‎ExcelGrid‎ ⇒ پنجرهٔ چسبان) ولی
       کاربر یک جدولِ بلند می‌بیند که با **صفحه** می‌لغزد. نوارِ لغزشِ خودِ
       جدول آن‌جا دروغ است: گسترهٔ یک صفحه را نشان می‌دهد و کاربر را به
       اسکرولِ دوم دعوت می‌کند. پس پهنایش صفر می‌شود تا جایی هم نگیرد. -->
  <Style Selector="DataGrid.sticky /template/ ScrollBar#PART_VerticalScrollbar">
    <Setter Property="Width" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource Pump.Font}" />
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <!-- ══ خطِ جدول — افقی و عمودی، و واقعاً دیده‌شونده ═══════════════════
         گزارشِ صاحب ریپو: «خط‌های جدول‌ها نیست و دیده نمی‌شه.»

         دو اشتباه پشتِ هم بود، هر دو مالِ خودم:

         ۱) «پرامپت کیفیت بصری» گفته بود «هیچ خط عمودی»، و من همان را
            گذاشتم. ولی خودِ سایت خطِ عمودی **دارد** — ‎.xls-tbl td‎:
                border-bottom:1px solid var(‹border›);
                border-left:1px solid var(‹border›);
            یعنی هم افقی هم عمودی. حرفِ صاحب ریپو و خودِ سایت بر آن سند
            مقدم است، پس خطِ عمودی برگشت.

         ۲) رنگش ‎Pump.GridLine‎ بود که ‎Mix(Card, Border, 0.75)‎ است — یعنی
            سه‌چهارم به رنگِ خودِ جدول نزدیک، و عملاً نامرئی. سایت خودِ
            ‎var(‑‑border)‎ را می‌گذارد، نه نسخهٔ کم‌رنگش. پس ‎Pump.Border‎.

         ۳) و از امروز رنگ و ضخامتش دیگر همین‌جا سفت نوشته نمی‌شود: هر دو از
            «تنظیمات ← ظاهرِ جدول‌ها» می‌آیند (‎Pump.Table.…‎ در
            ‎Themes/TableStyle.cs‎). خواستهٔ صریحِ صاحب ریپو بود:
            «نباید Hard-coded باشد؛ در تنظیمات، و روی همهٔ جدول‌ها.»
            پیش‌فرضش همان رنگِ ‎Pump.Border‎ی تم است، پس ظاهرِ امروز عوض نمی‌شود.

         ⚠️ این را دوباره «افقیِ تنها» نکنید، به ‎Pump.GridLine‎ برنگردانید، و
            رنگ/ضخامت را دوباره این‌جا ثابت ننویسید. -->
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Pump.Table.Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Pump.Table.Border}" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>
  <!-- دکمهٔ درونِ خانهٔ جدول (حذف، ثبت، …) وسطِ خانه بنشیند و از آن بیرون
       نزند. پیش از این دکمهٔ «حذف» از لبهٔ جدول بیرون می‌افتاد و روی خطِ
       کادر می‌نشست — در هر جدولی که ستونِ حذف داشت. -->
  <!-- ⚠️ ‎MinHeight="0"‎ هم لازم است، نه فقط وسط‌چینی: پیش‌فرضِ ۳۲ی دکمه با
       بالشتکِ خودش ۴۴ پیکسل می‌خواست و ردیفِ جدول ۳۶ پیکسل جا داشت، پس دکمه
       از بالا و پایین بریده می‌شد. سنجشِ ‎look‎ همین را در «رسید قرض‌داران»
       گرفت. همین برای چک‌باکس هم هست (ستونِ «دفتر برابر شود» در مخزن). -->
  <Style Selector="DataGridCell Button">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="DataGridCell CheckBox">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- ══ نشانگرِ ماوس روی جدول: «به‌علاوه»ی اکسل ═══════════════════════════
       گزارشِ صاحب ریپو: «ماوس هم باید شکلِ مثبت می‌داشت، اگر جست‌وجو بکنی تو
       سایت و پیدا کنی.» پیدا شد — خطِ ۱۰۴۸ی ‎index.html‎:

           .tbl td,.tbl th,.xls-tbl td,.xls-tbl th,
           .ro-tbl td,.ro-tbl th{ cursor:cell; ... }
           .xls-tbl td input:not(:focus){ cursor:cell }

       ‎cursor:cell‎ همان به‌علاوهٔ **کلفتِ** اکسل است — سفید با دورِ سیاه.
       ‎StandardCursorType.Cross‎ی آوالونیا یک ضربدرِ نازکِ نخی است و صاحب ریپو
       گفت «شبیهِ اکسل نیست». پس همان شکل در ‎Controls/ExcelCursor.cs‎ کشیده
       می‌شود و ‎App.OnFrameworkInitializationCompleted‎ آن را با کلیدِ
       ‎Pump.CellCursor‎ ثبت می‌کند.
       ⚠️ کادرِ تایپ وقتی روی آن ایستاده‌ای هم همین را می‌گیرد (نه ‎IBeam‎)،
       چون سایت هم ‎:not(:focus)‎ گذاشته: تا وارد نشده‌ای، خانه است نه متن. -->
  <!-- ⚠️ پس‌زمینه ‎Pump.HeadBand‎ است نه ‎Pump.Panel‎: خواستهٔ صریحِ صاحب ریپو
       روی نمونه — «سر جدول رنگ تیره نیست، این هم تیره می‌شد عالی». همان رنگ
       روی ستونِ «#» و ردیفِ «جمله» هم می‌نشیند تا جدول از هر سه طرف قاب بگیرد.
       خودِ رنگ در ‎PumpTheme‎ است، پس «کمی صاف‌ترش کن» یک عدد است نه بازنویسی. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Cursor" Value="{DynamicResource Pump.CellCursor}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Pump.HeadBand}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnHeadBand}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource Pump.Table.Border}" />
    <!-- ‎border-bottom:2px solid var(‑‑border)‎ی ‎.xls-tbl th‎ — ضخامتش از تنظیمات -->
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Table.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Pump.Table.HeadUnderline}" />
  </Style>

  <!-- ══ ضخامتِ خودِ خط‌ها ═══════════════════════════════════════════════════
       ‎DataGrid‎ رنگِ خط‌ها را از ‎HorizontalGridLinesBrush‎/‎Vertical…‎ می‌گیرد
       ولی ضخامتشان در قالبِ خودش ۱ پیکسل نوشته شده. آن سه مستطیل این‌ها
       هستند و ضخامتشان از «تنظیمات ← ظاهرِ جدول‌ها» می‌آید:

         ‎PART_BottomGridLine‎  خطِ افقیِ زیرِ هر ردیف
         ‎PART_RightGridLine‎   خطِ عمودیِ کنارِ هر خانه
         ‎VerticalSeparator‎    جداکنندهٔ سربرگ‌ها -->
  <Style Selector="DataGridRow /template/ Rectangle#PART_BottomGridLine">
    <Setter Property="Height" Value="{DynamicResource Pump.Table.Line}" />
  </Style>
  <Style Selector="DataGridCell /template/ Rectangle#PART_RightGridLine">
    <Setter Property="Width" Value="{DynamicResource Pump.Table.Line}" />
  </Style>
  <Style Selector="DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
    <Setter Property="Width" Value="{DynamicResource Pump.Table.HeadLine}" />
  </Style>

  <!-- ══ چرا نوشتهٔ سرستون‌ها وسط نبود ═══════════════════════════════════════
       گزارشِ صاحب ریپو: «سرِ جدول‌ها هنوز وسط نیستن.» و حق داشت — سنجش
       (حالتِ ‎chrome‎ی ‎PumpYaqobi.UiTests‎) نشان داد در **هر**
       بخش و **هر** ستون، نوشته دقیقاً ۱۶٫۵ پیکسل از مرکز دور است.

       ریشه‌اش ‎HorizontalContentAlignment‎ نبود (آن از قبل ‎Center‎ بود). گریدِ
       داخلیِ قالبِ ‎DataGridColumnHeader‎ دو ستون دارد و ستونِ دومش جای فلشِ
       مرتب‌سازی است:

           cols=[1*→13 | Auto→32]

       یعنی ۳۲ پیکسل برای فلش کنار گذاشته می‌شود **حتی وقتی فلش نامرئی است**،
       و نوشته در ۱۳ پیکسلِ باقی‌مانده می‌نشیند — نیمِ آن ۳۲ پیکسل همان
       ۱۶ پیکسلِ انحراف است.

       آن ۳۲ پیکسل از ‎MinWidth‎ی خودِ ستونِ قالبِ آوالونیا می‌آید و از استایل
       دست‌نیافتنی است (‎Width‎ و ‎MinWidth‎ی خودِ فلش را صفر کردیم و ستون باز هم
       ۳۲ ماند). پس قالب را خودمان می‌نویسیم — با همان نام‌های قالبِ اصلی، تا
       فلشِ مرتب‌سازی و کادرِ فوکوس سرِ جایشان بمانند — و تنها فرقش این است که
       فلش **روی** نوشته می‌نشیند نه کنارش، پس جا نمی‌گیرد و نوشته وسط می‌ماند.
       در سایت هم استثنا ندارد: ‎.xls-tbl th{text-align:center}‎. -->
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="HeaderBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <Grid Name="PART_ColumnHeaderRoot" ColumnDefinitions="*,Auto">
            <Panel Grid.Column="0" Margin="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Path Name="SortIcon"
                    Width="8" Height="6" Stretch="Fill" IsVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Fill="{TemplateBinding Foreground}"
                    Data="F1 M 0,0 L 8,0 L 4,6 Z" />
            </Panel>
            <Rectangle Name="VerticalSeparator" Grid.Column="1"
                       Width="{DynamicResource Pump.Table.HeadLine}"
                       VerticalAlignment="Stretch"
                       Fill="{TemplateBinding SeparatorBrush}"
                       IsVisible="{TemplateBinding AreSeparatorsVisible}" />
            <Grid Name="FocusVisual" Grid.Column="0" IsHitTestVisible="False" IsVisible="False">
              <Rectangle Name="FocusVisualPrimary" StrokeThickness="2"
                         Stroke="{DynamicResource Pump.Accent}" IsHitTestVisible="False" />
              <Rectangle Name="FocusVisualSecondary" StrokeThickness="1"
                         Stroke="{DynamicResource Pump.Table.Border}" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- ⚠️ ‎HorizontalContentAlignment‎ی خودِ سرستون کافی نبود: نوشتهٔ داخلش را
       خودِ ‎DataGrid‎ می‌سازد و ‎Stretch‎ می‌گذارد، پس «تاریخ»، «نام»، «حواله» و
       بقیه به لبه می‌چسبیدند. گزارشِ صاحب ریپو: «اون تاریخ اسم حواله یا هر چی
       اون بالای جدول که هستن … نوشته‌هاشون رو وسط بذار.»
       در سایت هم استثنا ندارد: ‎.xls-tbl th{text-align:center}‎. -->
  <!-- ══ ستونِ «#» — شمارهٔ ردیف ═══════════════════════════════════════════
       در سایت ستونِ اولِ هر جدول ‎#‎ است (‎td.xls-num‎) و شمارهٔ ردیف را نشان
       می‌دهد؛ در برنامه هیچ جدولی نداشت. این‌جا سرستونِ ردیفِ خودِ جدول به
       همان شکل درمی‌آید: باریک، وسط‌چین، کم‌رنگ و با همان خطِ جدول. -->
  <Style Selector="DataGridRowHeader">
    <Setter Property="Background" Value="{DynamicResource Pump.HeadBand}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnHeadBandMuted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinWidth" Value="42" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource Pump.Table.Border}" />
    <Setter Property="Cursor" Value="{DynamicResource Pump.CellCursor}" />
  </Style>
  <Style Selector="DataGridRowHeader /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ⚠️ نوشتهٔ سرستون را خودِ ‎ContentPresenter‎ می‌سازد، یعنی **داخلِ قالب**.
       قاعدهٔ بی ‎/template/‎ به آن نمی‌رسد و سربرگ‌ها به لبه می‌چسبیدند —
       همان «بالای جدول‌ها اسم‌ها وسطِ کادرشان نیستند». -->
  <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridColumnHeader /template/ TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGridColumnHeader TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DataGridCell">
    <!-- ══ چرا افقی صفر است ═══════════════════════════════════════════════════
         گزارشِ صاحب ریپو با عکس (۱۴۰۵/۰۶/۲۷): بالای ورق، «شروع» و «ختمِ
         پایه‌ها» از کادرشان بیرون زده و «…» می‌شوند.

         اندازه‌گیری (بندِ «نوشتهٔ خانه» در ‎parcha‎) ریشه را داد:
         ‎DataGridTextColumn‎ی آوالونیا خودش روی نوشتهٔ هر خانه
         ‎Margin="12,0,12,0"‎ می‌گذارد — یک مقدارِ **محلی** که هیچ سبکی
         نمی‌تواند عوضش کند. پهنای طبیعیِ ستون هم از همان اندازه درمی‌آید،
         یعنی «نوشته + ۲۴». حالا اگر خودِ خانه هم ۱۰+۱۰ ‎Padding‎ داشته
         باشد، جای نوشته می‌شود «ستون − ۴۴» و ۲۰ پیکسل کم می‌آورد: نوشته
         بریده می‌شود، هرچند ستون به‌ظاهر جا دارد. در جدولِ پایه‌های ورق،
         خانهٔ ۶۱ پیکسلی فقط ۱۶ پیکسل به نوشته می‌داد.

         پس فاصلهٔ افقی یک بار شمرده می‌شود (همان ۱۲ی خودِ آوالونیا) و
         فاصلهٔ عمودی سرِ جایش می‌ماند. -->
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="Cursor" Value="{DynamicResource Pump.CellCursor}" />
    <!-- ⚠️ ‎Stretch‎ است نه ‎Center‎ — و وسط‌چینی از ‎TextAlignment‎ی نوشته
         می‌آید، نه از این. با ‎Center‎، ‎ContentPresenter‎ی خانه به اندازهٔ
         محتوا جمع می‌شد و کادرِ تایپ **۴ پیکسل** پهنا می‌گرفت وسطِ خانهٔ ۴۴۲
         پیکسلی: همان «توی کادر یک کادرِ دیگر» که صاحب ریپو با عکس نشان داد.
         سنجشِ ‎cells‎ همین ۴ پیکسل را گرفت. -->
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <!-- عمودی هم وسط — خواستهٔ صریحِ صاحب ریپو: «تمام Cellها از نظر افقی و
         عمودی دقیقاً Center شوند.» -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- نوشتهٔ داخلِ خانه هم واقعاً وسط بنشیند: ‎HorizontalContentAlignment‎ی
       خانه فقط وقتی اثر دارد که خودِ نوشته ‎Stretch‎ نباشد، و ‎DataGridTextColumn‎
       متنش را ‎Stretch‎ می‌سازد. -->
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- متنِ بلند ردیف را بلند نکند و خطوط را نشکند — همان کاری که خانهٔ
         اکسل می‌کند: نوشته بریده می‌شود، نه این‌که جدول به‌هم بریزد. -->
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="1" />
    <!-- ⚠️ نوشتهٔ فارسیِ بلند با ‎CharacterEllipsis‎ کلاً «…» می‌شد (باگِ آوالونیا
         ۱۱.۲.۳) — ‎RtlTrim‎ برای همان نوشته‌ها خطِ اول را نشان می‌دهد. -->
    <Setter Property="c:RtlTrim.Enabled" Value="True" />
  </Style>
  <!-- ══ کادرِ تایپِ داخلِ خانه — ‎.xls-in‎ی سایت ═══════════════════════════
       گزارشِ صاحب ریپو: «توی کادرهای جدول وقتی می‌خوام چیزی بنویسم کادر سفید
       می‌شه و بک‌گراندِ مدلِ دیگه‌ای است و شبیه‌اش نیست.»

       حق داشت: ‎TextBox‎ی آوالونیا در حالتِ ویرایش پس‌زمینهٔ روشن و لبهٔ خودش
       را می‌گیرد، پس خانه وسطِ جدولِ تیره سفید می‌شد. سایت چنین نیست:

           .xls-in{ width:100%; background:transparent; border:none;
                    color:var(‹txt›); font-weight:700; padding:8px 7px }

       یعنی کادر اصلاً دیده نمی‌شود؛ فقط نوشته است و خطوطِ خودِ خانه.
       ‎:focus‎ و ‎:pointerover‎ هم جدا نوشته شده‌اند، وگرنه سبکِ پیش‌فرضِ
       ‎TextBox‎ در همان دو حالت دوباره سفید می‌کرد. -->
  <!-- ⚠️ اندازه و قلمِ کادرِ تایپ هم باید همانِ خانه باشد، نه پیش‌فرضِ
       ‎TextBox‎. گزارشِ صاحب ریپو: «نباید یک Input کوچک و سفید داخل Cell ظاهر
       شود… باید دقیقاً اندازهٔ همان Cell باشد و با Background، Border، Font و
       Padding جدول هماهنگ.»

       سبکِ عمومیِ ‎TextBox‎ی برنامه ‎MinHeight="34"‎ و گوشهٔ گرد و حاشیهٔ خودش
       را دارد؛ داخلِ خانهٔ ۴۴ پیکسلی این یعنی یک کادرِ کوچک‌ترِ تودرتو با
       قلمِ ریزتر. پس همه‌شان این‌جا صفر/هم‌اندازهٔ خانه می‌شوند:
       بلندی و پهنای کمینه صفر، گوشه بی‌گردی، ‎Padding‎ صفر (فاصله را خودِ
       خانه می‌دهد)، و قلم دقیقاً همان ۱۷ِ خانه.

       ‎AcceptsReturn="False"‎ و ‎TextWrapping="NoWrap"‎ هم عمدی‌اند: متنِ بلند
       نباید ردیف را بلند کند و خطوطِ جدول را بشکند. -->
  <Style Selector="DataGridCell TextBox">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MaxLines" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <Setter Property="FontWeight" Value="Bold" />
    <!-- ⚠️ ‎Margin‎ی صفر لازم است: بی آن، کادرِ ویرایشی چند پیکسل تو می‌رفت و
         به‌صورتِ یک «کادرِ کوچکِ جدا» وسطِ خانه دیده می‌شد — همان چیزی که در
         عکسِ صاحب ریپو بود. و نشانگر و انتخاب باید دیده شوند، وگرنه معلوم
         نیست کجای متن هستی. -->
    <Setter Property="Margin" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Pump.Selected}" />
  </Style>
  <!-- ══ تکملهٔ خودکار: خاکستری، نه هم‌رنگِ نوشتهٔ خودِ کاربر ══════════════
       گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۱۲): «پیشنهادی‌هایی که میاد خیلی تیره‌اند،
       هم‌رنگِ نوشته‌هایی که من می‌نویسم؛ تشخیص داده نمی‌شه که این تکمیل است
       یا پیشنهاد.» تکمله همان تکهٔ «انتخاب‌شده»ی کادر است، و انتخاب با رنگِ
       همان نوشته کشیده می‌شد. ‎Suggest‎ تا تکمله دیده می‌شود کلاسِ ‎ghost‎ را
       روی کادر می‌گذارد: زمینهٔ انتخاب برداشته و خودِ تکمله کم‌رنگ
       (‎Pump.Ghost‎ — نیمه‌راهِ کارت و ‎Muted‎، شبیهِ نوشتهٔ راهنمای کادر).
       ⚠️ باید **پس از** دو سبکِ بالا بیاید: در آوالونیا سبکِ بعدی برنده است. -->
  <Style Selector="TextBox.ghost">
    <Setter Property="SelectionBrush" Value="Transparent" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Pump.Ghost}" />
  </Style>
  <!-- ══ صفرِ دیده‌شونده که وجود ندارد ══════════════════════════════════════
       گزارشِ صاحب ریپو، بارِ دوم و روشن‌تر: «وقتی گفتم صفر نامرئی باشد، منظورم
       این بود که صفر دیده بشود ولی صفری وجود نداشته باشد؛ وقت چیزی می‌نویسم
       هیچی از آن نباشد.»

       یعنی دقیقاً همان ‎placeholder‎ی سایت:
           &lt;input class="xls-in" value="${x||''}" placeholder="0"&gt;
       عدد صفر ⇒ خانه خالی است (‎MoneyOrBlank‎)، و یک «۰»ی کم‌رنگ رویش دیده
       می‌شود که با اولین حرفی که تایپ شود می‌رود.

       ⚠️ فقط روی ستون‌های عددی، نه همه: ستونِ عددی با
       ‎CellStyleClasses="num"‎ علامت خورده. روی «نام» و «تاریخ» صفر بی‌معناست. -->
  <Style Selector="DataGridCell.num TextBox">
    <Setter Property="Watermark" Value="0" />
  </Style>

  <Style Selector="DataGridCell TextBox:focus, DataGridCell TextBox:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- ══ و همین برای حالتِ فوکوس و ماوس، جداگانه ═════════════════════════
       ⚠️ بی این دو قاعده، لبه و پس‌زمینه **برمی‌گشتند**. علتش ترتیبِ سبک‌ها
       در آوالونیا است: قاعدهٔ عمومیِ ‎TextBox:focus /template/
       Border#PART_BorderElement‎ (بالاتر در همین فایل) با فوکوس گرفتن
       **دیرتر** فعال می‌شود و روی قاعدهٔ بی‌حالتِ پایین‌تر می‌نشیند. سنجشِ
       ‎cells‎ عددش را داد: لبهٔ ‎1.6‎ پیکسل و پس‌زمینهٔ **سفید** — همان کادرِ
       سرخِ تودرتو در عکسِ صاحب ریپو.
       پس حالت در برابرِ حالت: این دو باید بمانند. -->
  <Style Selector="DataGridCell TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridCell TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridCell TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ══ تایپ داخلِ خانه، مثلِ اکسل ═══════════════════════════════════════════
       گزارشِ صاحب ریپو با عکس: «موقعِ تایپ نمی‌خواهم آن چهارگوش باشد … چیزی که
       می‌نویسم چیزی نمی‌فهمم. می‌خواهم خیلی حرفه‌ای باشد، مثلِ اکسل.»

       در عکس، نوشته داخلِ یک کادرِ کوچکِ چسبیده به متن بود، وسطِ خانه‌ای که
       بزرگ‌تر است — و دورش هم یک خطِ نازکِ اضافه. دو چیز با هم:

       ۱) کادرِ ویرایشی تمامِ خانه را نمی‌گرفت. ‎DataGrid‎ برای ستونِ متنی خودش
          یک ‎TextBox‎ی به نامِ ‎PART_EditingElement‎ می‌سازد و آن از قاعدهٔ
          عمومیِ بالا ‎HorizontalAlignment‎ را نمی‌گرفت.
       ۲) دو مستطیلِ خودِ خانه (‎CurrencyVisual‎ و ‎FocusVisual‎) روی آن کشیده
          می‌شدند — همان «چهارگوش».

       در اکسل چیزی که دیده می‌شود این است: خانهٔ فعال یک **قابِ ضخیمِ رنگی**
       دورِ خودِ خانه دارد، و متن تمامِ خانه را می‌گیرد. حالا همان. -->
  <!-- ⚠️ قاعدهٔ نام‌دارِ ‎#PART_EditingElement‎ برداشته شد: نامِ اجزای قالبِ
       ‎DataGrid‎ در نسخه‌های آوالونیا عوض می‌شود و اگر نامی نگیرد، قاعده
       بی‌صدا هیچ کاری نمی‌کند. همهٔ آن تنظیم‌ها بالاتر روی
       ‎DataGridCell TextBox‎ نشسته‌اند که به **نوع** بند است، نه به نام —
       پس کادرِ ویرایشی هم همان‌ها را می‌گیرد. -->

  <!-- ══ خانهٔ فعال: قابِ اکسل، روی خودِ خانه ═══════════════════════════════
       ‎CurrencyVisual‎ همان مستطیلی است که ‎DataGrid‎ دورِ «خانهٔ جاری»
       می‌کشد. پنهانش نمی‌کنیم — همان را به قابِ اکسل تبدیل می‌کنیم: بی‌رنگ
       از تو، با خطِ ضخیمِ رنگی دورِ تمامِ خانه.

       ⚠️ پیش از این ‎DataGridCell:current‎ی با ‎BorderThickness‎ گذاشته بودم؛
       آن به این بند بود که قالبِ خانه اصلاً ‎BorderBrush‎ را بکشد — و
       نمی‌کشید. این‌جا خودِ همان مستطیلِ قالب تنظیم می‌شود، پس قطعی است. -->
  <!-- ⚠️ اندازه‌گیری‌شده، تا کسی دوباره رویش وقت نگذارد: این مستطیل در عمل
       **کشیده نمی‌شود**. چهار نمونه با ضخامت و پرکردنِ متفاوت رندر شد و هر
       چهارتا مو‌به‌مو یکی درآمدند (حالتِ cellshot). ‎IsVisible‎ی این‌جا در
       برابرِ اتصالِ خودِ قالب می‌بازد. پس قابِ «خانهٔ فعال» عملاً نداریم و
       چیزی که دیده می‌شود فقط رنگِ ردیفِ انتخاب‌شده است. اگر روزی قاب لازم شد،
       راهش قالبِ خودِ ‎DataGridCell‎ است، نه این ‎Setter‎ها. -->
  <Style Selector="DataGridCell /template/ Rectangle#CurrencyVisual">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource Pump.Accent}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="RadiusX" Value="0" />
    <Setter Property="RadiusY" Value="0" />
  </Style>
  <!-- ══ خانهٔ مشکل‌دار: خطِ خودِ خانه سرخ و ضخیم (۱۴۰۵/۰۷/۱۲) ══════════════
       ‎IssueTextColumn‎ کلاسِ ‎issue‎ را روی خودِ ‎DataGridCell‎ می‌گذارد. ⛔ کادرِ
       دومی داخلِ خانه نمی‌کشیم — صاحب ریپو با عکس گفت «خودِ خطِ جدول، چهارگوشِ
       کادرش قرمز شود». ‎CellBorder‎ی قالب ‎BorderBrush‎/‎BorderThickness‎ را از
       خودِ خانه می‌گیرد، و خطِ عمودیِ کنارِ خانه هم همان رنگ می‌شود. -->
  <Style Selector="DataGridCell.issue">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="BorderThickness" Value="2.5" />
    <Setter Property="Background" Value="#1FE53E3E" />
  </Style>
  <Style Selector="DataGridCell.issue /template/ Rectangle#PART_RightGridLine">
    <Setter Property="Fill" Value="{DynamicResource Pump.Danger}" />
  </Style>

  <!-- مستطیلِ نقطه‌چینِ فوکوس کنارِ آن اضافه است و همان «چهارگوشِ» عکس -->
  <Style Selector="DataGridCell /template/ Rectangle#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- کشویی و رادیوییِ داخلِ خانه هم همان‌طور — نه کادرِ سفیدِ جدا -->
  <Style Selector="DataGridCell ComboBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
    <!-- مثلِ کادرِ تایپ: هم‌اندازهٔ خانه، نه کادرِ کوچکِ تودرتو -->
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- ══ اندازهٔ کشوییِ داخلِ خانه ══════════════════════════════════════════
       پیش از این هر بخش خودش ‎Margin="4,1" MinHeight="0" Padding="7,2"
       FontSize="14"‎ می‌نوشت — یازده جا، و هر یازده‌تا نوشته را یک درجه
       کوچک‌تر از کادرهای تایپیِ همان ردیف می‌کرد. حالا یک کلاس، یک جا. -->
  <Style Selector="ComboBox.incell">
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="17" />
  </Style>

  <!-- ══ کشوییِ داخلِ خانه: فلش هست ولی جا نمی‌گیرد ═════════════════════════

       گزارشِ صاحب ریپو: «اون علامتِ ⌄ جوری است که فقط جا اضافه گرفته … اونو
       حذف کن که نباشه … ولی وقتی رو اون کادر کشویی بزنم باز بشه، یعنی اون
       باشه ولی تو جدول‌ها دیده نشه و جا نگیره.»

       اندازه‌گیری حق را داد. قالبِ پیش‌فرضِ ‎ComboBox‎ی آوالونیا این است:

           Grid cols=[1*→46 | 32→32]

       یعنی از ۷۸ پیکسلِ خانه، ۳۲ تا سهمِ فلش است و نوشته با ۳۲ پیکسل در
       ۴۶ پیکسل می‌چپد. آن ۳۲ یک ‎ColumnDefinition‎ی ثابت داخلِ قالب است و از
       هیچ ‎Setter‎ی دست‌یافتنی نیست — درست همان تلهٔ سرستون‌ها.

       پس قالبِ خودمان: یک لایه، بی ستونِ فلش. کشویی همان‌جور با کلیک باز
       می‌شود (خودِ ‎ComboBox‎ این کار را می‌کند، نه فلش) و اندازهٔ خط از خودِ
       کادر می‌آید نه از پیش‌فرضِ ۱۴ی تم.

       ⚠️ ‎PART_Popup‎ و ‎PART_ItemsPresenter‎ نام‌های اجباری‌اند؛ عوضشان کنی
       کشویی باز نمی‌شود. -->
  <Style Selector="DataGridCell ComboBox">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Background"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <ContentControl Name="ContentPresenter"
                          Content="{TemplateBinding SelectionBoxItem}"
                          ContentTemplate="{TemplateBinding ItemTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          FontSize="{TemplateBinding FontSize}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                 IsLightDismissEnabled="True"
                 InheritsTransform="True"
                 WindowManagerAddShadowHint="False">
            <Border Background="{DynamicResource Pump.Card}"
                    BorderBrush="{DynamicResource Pump.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="2">
              <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ══ خانه‌های داخلِ کادرِ چندانتخابی ═══════════════════════════════════
       ‎DataGrid‎ فقط «ردیف» را انتخاب می‌کند. کادرِ خانه‌به‌خانه‌ای که با
       ‎Shift+فلش‎ ساخته می‌شود، از ‎ExcelGrid.PaintRange‎ این کلاس را می‌گیرد. -->
  <Style Selector="DataGridCell.rangesel">
    <Setter Property="Background" Value="{DynamicResource Pump.Selected}" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Pump.Hover}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Pump.Selected}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ══ قالبِ مشترکِ بخش‌ها ═══════════════════════════════════════════════
       ساختار مو‌به‌مو همان چیزی است که هر بخش در نسخهٔ وب دارد:

           .card            ← یک کادرِ گِرد که کلِ بخش داخلش است
             .card-head     ← عنوانِ رنگی راست، دکمه‌های کار چپ
             (padding:14px) ← فیلتر، جمع‌ها، بدنه، پانویس

       اسکرول اصلاً مالِ بخش نیست. یکی است و مالِ کلِ پنجره
       (‎PageScroll‎ در ‎MainWindow‎) — مثلِ سایت: کلِ صفحه می‌لغزد، سربرگ و
       نوارِ آمار هم با آن بالا می‌روند و فقط نوارِ بخش‌ها سرِ صفر قفل می‌شود.
       بخش هیچ سقفی ندارد و فقط به بلندیِ محتوایش کِش می‌آید.

       ⚠️ اگر روزی وسوسه شدی این‌جا یا در یکی از بخش‌ها ‎ScrollViewer‎ بگذاری:
       نگذار. صاحب ریپو دو بار همین را رد کرد — «تا وقتی نوارِ بخش‌ها به سقف
       نچسبیده، محتوای بخش نباید تکان بخورد». هر اسکرولِ درونی همان قاعده را
       می‌شکند، چون چرخِ ماوس اول آن را می‌لغزاند نه صفحه را. سنجشِ اسکرول
       (سنجشِ اسکرول، حالتِ ‎scroll‎) همین را می‌پاید و اگر برگردد قرمز
       می‌شود.                                                              -->
  <Style Selector="c|SectionPage">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="card flush section" Margin="16,14">
          <Grid RowDefinitions="Auto,*">

            <!-- ══ سربرگِ کادر ══ -->
            <Border Grid.Row="0" Classes="card-head">
              <!-- ══ عنوان ‎Auto‎، ابزار ‎*‎ — و چرا این ترتیب ══════════════════
                   پیش از این عنوان ‎*‎ بود و ابزار ‎Auto‎. ستونِ ‎Auto‎ به فرزندش
                   پهنای **دلخواهِ خودش** را می‌دهد، یعنی اندازه‌گیری با پهنای
                   بی‌نهایت. نتیجه: هر ‎WrapPanel‎ی در نوارِ ابزار هیچ‌وقت
                   نمی‌شکست و فقط از پنجره بیرون می‌زد — سنجشِ ‎UiTests person‎
                   همین را گرفت («بازگشت به فهرست» در ‎x −5…135‎).

                   حالا ابزار در ستونِ ‎*‎ است، پس پهنای واقعی و محدود می‌گیرد و
                   ‎WrapPanel‎ش درست می‌شکند. عنوان ‎Auto‎ است و به اندازهٔ
                   خودش جا می‌گیرد. -->
              <!-- ══ یک نوار، نه سه نوار ═══════════════════════════════════
                   گزارشِ صاحب ریپو: «بعضی کادرها صفحه را بزرگ کرده‌اند —
                   قرض‌های کهنه و مدت عضویت و جست‌وجو هر کدام یک بخشِ جدا
                   شده‌اند؛ همین‌ها می‌توانند بغلِ همان کادرِ اسکنِ کیو‌آر
                   بنشینند … این‌ها همه‌شان کادرهایی دارند که یکی این‌جاست و
                   یکی آن‌جا.»

                   پس نوارِ ابزار، کارت‌های زیربخش و کادرهای فیلتر همه در
                   **یک** نوارِ شکننده کنارِ هم نشستند. جای عمودی‌ای که آزاد
                   می‌شود مالِ خودِ جدول است. -->
              <Grid ColumnDefinitions="Auto,Auto,*">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Header}" Classes="card-title" />
                  <TextBlock Text="{TemplateBinding SubHeader}" Classes="muted"
                             TextWrapping="Wrap" MaxWidth="250"
                             IsVisible="{TemplateBinding SubHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- ══ ‎A−‎ / ‎A+‎ / ‎↺‎ِ همین بخش ═════════════════════════════
                     همتای ‎.sec-font-ctrl‎ی نسخهٔ وب، که کنارِ عنوانِ **هر**
                     بخش می‌نشیند. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            x:CompileBindings="False"
                            IsVisible="{Binding FontSmallerCommand, Converter={x:Static ObjectConverters.IsNotNull},
                                        FallbackValue=False}">
                  <Button Classes="seg" Content="A-" Command="{Binding FontSmallerCommand}"
                          ToolTip.Tip="نوشتهٔ این بخش کوچک‌تر" />
                  <Button Classes="seg" Content="A+" Command="{Binding FontBiggerCommand}"
                          ToolTip.Tip="نوشتهٔ این بخش بزرگ‌تر" />
                  <Button Classes="seg" Content="↺" Command="{Binding FontResetCommand}"
                          ToolTip.Tip="برگشت به اندازهٔ عادی" />
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                           Classes="sec-tools"
                           VerticalAlignment="Center" x:CompileBindings="False">
                  <ContentPresenter Content="{TemplateBinding Toolbar}" VerticalAlignment="Center"
                                    Margin="0,3" />

                  <!-- ══ کارت‌های زیربخش، کنارِ همان دکمه‌ها ═══════════════
                       بخشی که زیربخش دارد (قرض‌داران، مخزن، مفاد/ضرر، …)
                       دکمه‌هایش همین‌جا کنارِ نوارِ ابزار می‌آیند — نه یک
                       ردیفِ جدا بالای جدول. -->
                  <ItemsControl ItemsSource="{Binding SubSections}"
                                IsVisible="{Binding ShowSubLinkCards, FallbackValue=False}"
                                Margin="6,3,0,3">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Button Classes="tool-link" Margin="0,0,6,0"
                                Command="{Binding ParentSection.ShowSubCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path Grid.Column="0" Data="{Binding IconKey, Converter={x:Static th:IconLookupConverter.Instance}}"
                                  Stroke="{Binding IconKey, Converter={x:Static th:IconColorConverter.Instance}}"
                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding LinkTitle}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="‹" FontSize="17" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Opacity="0.7" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- کادرهای کوچکِ همین نوار — بعد از کارت‌های زیربخش (جست‌وجوی قرض‌داران) -->
                  <ContentPresenter Content="{TemplateBinding Inline}" VerticalAlignment="Center"
                                    Margin="6,3,0,3" />

                  <!-- کادرهای فیلتر (ماه، جست‌وجو، …) هم همین‌جا -->
                  <ContentPresenter Content="{TemplateBinding Filters}" VerticalAlignment="Center"
                                    Margin="10,3,0,3"
                                    IsVisible="{TemplateBinding Filters, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </WrapPanel>
              </Grid>
            </Border>

            <!-- ══ بدنهٔ کادر ══ -->
            <!-- ⚠️ فقط پنج ردیف مانده: کارت‌های زیربخش و نوارِ فیلتر رفتند
                 بالا، کنارِ نوارِ ابزار. -->
            <LayoutTransformControl Grid.Row="1" x:CompileBindings="False"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                    LayoutTransform="{Binding FontScale,
                                                      Converter={x:Static th:FontScaleConverter.Instance},
                                                      FallbackValue={x:Null}}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="14">

                <ContentPresenter Grid.Row="0" Content="{TemplateBinding Summary}" Margin="0,0,0,12"
                                  IsVisible="{TemplateBinding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <ContentPresenter Grid.Row="1" Content="{TemplateBinding Body}" />

                <ContentPresenter Grid.Row="2" Content="{TemplateBinding Footer}" Margin="0,12,0,0"
                                  IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- ══ «📝 یادداشت این بخش» — ‎.sec-note-box‎ی نسخهٔ وب ═══════
                     در سایت پایینِ چهارده بخش هست و در برنامهٔ نیتیو هیچ‌جا نبود.
                     گزارشِ صاحب ریپو: «تو سایت بخش نوت هم داشت، آن چه شد؟»

                     این‌جا در قالبِ مشترک نشسته، نه در تک‌تکِ ویوها: هر بخشی که
                     ‎Notes‎ی خودش را بسازد، خودبه‌خود این کادر را می‌گیرد و هر
                     تغییرِ ظاهری در همه‌شان با هم اعمال می‌شود.

                     ‎x:CompileBindings="False"‎ مثلِ کارت‌های زیربخشِ بالا لازم
                     است: داخلِ ControlTemplate نوعِ DataContext معلوم نیست. -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="8"
                            x:CompileBindings="False"
                            IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull},
                                        FallbackValue=False}"
                            DataContext="{Binding Notes}">
                  <!-- ══ سربرگِ کادرِ یادداشت، با ‎A−/A+‎ِ خودش ═══════════════
                       سایت این دو دکمه را جدا از ‎A−/A+‎ِ بخش گذاشته و دلیلش را
                       هم نوشته: اندازهٔ یادداشت‌ها نباید با بزرگ شدنِ جدول‌ها
                       عوض شود. پس این‌جا هم جداست و روی همهٔ بخش‌ها با هم
                       می‌نشیند. -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📝 یادداشت این بخش" Classes="label"
                               VerticalAlignment="Center" />
                    <Button Classes="seg" Content="A-" Command="{Binding Font.SmallerCommand}"
                            ToolTip.Tip="نوشتهٔ یادداشت‌ها کوچک‌تر" />
                    <Button Classes="seg" Content="A+" Command="{Binding Font.BiggerCommand}"
                            ToolTip.Tip="نوشتهٔ یادداشت‌ها بزرگ‌تر" />
                  </StackPanel>
                  <TextBox Text="{Binding Draft}" AcceptsReturn="True" MinHeight="62"
                           FontSize="{Binding Font.Size}"
                           TextWrapping="Wrap" Watermark="یادداشت شما…" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="ghost info" Content="📨 فرستادن به صندوق نوت‌ها"
                            Command="{Binding SendCommand}" />
                    <Button Classes="ghost" Content="{Binding ListToggleText}"
                            Command="{Binding ToggleListCommand}" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsListOpen}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Classes="panel" Padding="10,8" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding DateShamsi}"
                                       Classes="muted" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"
                                       FontSize="{Binding $parent[ItemsControl].DataContext.Font.Size}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="4" Classes="ghost danger" Content="حذف"
                                    Padding="8,3" FontSize="12"
                                    Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- ══ «➕ ردیف» و «➕➕ چندتایی» ═══════════════════════════════
                     بخشی که ردیفِ دستی دارد (مصارف، گاوصندوق، صرافی، چکنه،
                     رسید پارچه‌ها) ‎RowAddCommand‎ش را می‌دهد و همین‌جا نوارش
                     را می‌گیرد؛ بقیه هیچ چیزِ اضافه‌ای نمی‌بینند.
                     جایش هم همان‌جای سایت است: زیرِ جدول و زیرِ کادرِ یادداشت. -->
                <c:RowAddBar Grid.Row="4" Margin="0,12,0,0" x:CompileBindings="False"
                             Host="{Binding}" AddRowCommand="{Binding RowAddCommand}"
                             IsVisible="{Binding RowAddCommand, Converter={x:Static ObjectConverters.IsNotNull},
                                         FallbackValue=False}" />
            </Grid>
            </LayoutTransformControl>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ══ کادرِ عددِ خلاصه — ‎.stat-box‎ نسخهٔ وب ═══════════════════════════
       ‎background:var(-dark); border:1px solid var(-border);
        border-radius:10px; padding:14px; text-align:center;
        min-height:86px; justify-content:center‎

       نکتهٔ مهم «وسط‌چین» است: تا امروز برچسب و عدد راست‌چین بودند و در یک
       کادرِ کشیده، نوشته به یک گوشه می‌چسبید و سمتِ دیگر خالی می‌ماند —
       همان چیزی که کادرها را ناجور نشان می‌داد.                            -->
  <!-- ‎.stat-box‎ — شعاعِ محاسبه‌شده روی هر ۱۷ کادر ‎13px‎ است، نه ۱۰. -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource Pump.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.CardShadow}" />
    <Setter Property="Padding" Value="13" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="MinHeight" Value="82" />
  </Style>
  <!-- ⛔ کادرِ ‎.stat‎ داخلِ یک فهرستِ تکرارشونده سایهٔ **بی‌محو** می‌گیرد.
       «کارتِ کوچک» یعنی چند تا در یک صفحه، نه هشت تا در هر قلمِ یک فهرست:
       فهرستِ خریدهای مخزن با هر خرید هشت ‎.stat‎ می‌سازد و خریدهای شرکت هم
       همین‌طور — یعنی صدها سایهٔ محو در یک درخت، همه با هر فریمِ اسکرول
       (۱۴۰۵/۰۷/۱۳، گزارشِ «مخزن‌ها لگ داره»). ردیفِ ‎UniformGrid.stats‎ی بالای
       صفحه در هیچ فهرستی نیست و سایهٔ محوِ خودش را نگه می‌دارد. -->
  <Style Selector="ItemsControl Border.stat">
    <Setter Property="BoxShadow" Value="{DynamicResource Pump.SectionShadow}" />
  </Style>
  <!-- فاصلهٔ بینِ کادرهای یک ردیفِ خلاصه. ‎UniformGrid‎ خودش فاصله ندارد، پس
       هر کادر نصفِ فاصله را از هر طرف می‌گیرد و کادرهای دو سر با حاشیهٔ منفیِ
       خودِ ردیف به لبه می‌چسبند. -->
  <Style Selector="UniformGrid.stats">
    <Setter Property="Margin" Value="-6,0" />
  </Style>
  <Style Selector="UniformGrid.stats > Border.stat">
    <Setter Property="Margin" Value="6,0" />
  </Style>

  <!-- محتوای کادر وسطِ آن می‌نشیند و نوشته‌هایش وسط‌چین‌اند -->
  <Style Selector="Border.stat > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.stat TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- تب‌های حساب: چیپ، نه فهرستِ ساده -->
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.AccentGrad}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>

  <!-- ══ کارتِ شیفتِ پارچه — همان چیدمانِ نسخهٔ وب ══ -->
  <Style Selector="Border.shift-card">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.shift-header">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="13,13,0,0" />
  </Style>
  <!-- روز: نارنجی · شب: بنفش — همان دو رنگِ نسخهٔ وب -->
  <Style Selector="Border.shift-header.day">
    <Setter Property="Background" Value="#f0952b" />
  </Style>
  <Style Selector="Border.shift-header.day TextBlock">
    <Setter Property="Foreground" Value="#1a1102" />
  </Style>
  <Style Selector="Border.shift-header.night">
    <Setter Property="Background" Value="#7c4dbe" />
  </Style>
  <Style Selector="Border.shift-header.night TextBlock">
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>

  <!-- ══ نامِ کادرهای فرم — سرِ کادر، سمتِ راست ═════════════════════════════
       گزارشِ صاحب ریپو با عکس: «اسم‌های کادر سرِ کادرهایشان سمتِ راست‌اند و
       همان مدل باشد.» در سایت هم همین است و ساده هم هست:

           .field-row{display:flex;flex-direction:column;gap:3px}
           .field-label{font-size:0.9rem;color:رنگِ برچسب;font-weight:600}

       یعنی برچسب هیچ ‎text-align‎ی ندارد و در چیدمانِ راست‌به‌چپ سرِ خط —
       یعنی سمتِ راست — می‌نشیند. در برنامهٔ نیتیو ولی قاعدهٔ عمومیِ
       «هر نوشته وسط» (که برای **جدول‌ها** خواسته شده بود) این‌ها را هم وسط
       می‌برد. حالا برچسب‌های فرم از آن قاعده بیرون‌اند؛ جدول‌ها دست‌نخورده‌اند.

       ⚠️ اندازه هم ۰٫۹rem سایت شد (≈۱۴)، نه ۱۲. -->
  <Style Selector="TextBlock.fld">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Start" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- خانهٔ «خودکار» — خوانده می‌شود، تایپ نمی‌شود -->
  <!-- ══ ‎.wfield‎ — یک قدِ واحد برای همهٔ خانه‌های فرمِ پارچه ═══════════════
       گزارشِ صاحب ریپو با عکس (۱۴۰۵/۰۷/۱۰): «هیچ کادرش برابر نیست و نامِ
       کارمندها از همه متفاوت‌تر است… همه را با دقت درست کن و تراز.»

       ⛔ **یک عدد، یک جا.** پیش از این بلندیِ کادرِ نام (۴۸) در خودِ نما
       نوشته شده بود و بقیه ‎MinHeight‎ی ۳۶ی پیش‌فرض را داشتند و خانه‌های
       «خودکار» (‎Border.calc‎) از هر دو کوتاه‌تر بودند — سه قد روی یک کارت.
       حالا هر سه از همین یک خط می‌آیند.

       ⚠️ و خواستهٔ ۱۴۰۵/۰۶/۰۶ («کادرِ نام طولش بزرگ باشه نه عرضش») پس
       گرفته نشد: ۴۴ از پیش‌فرضِ ۳۶ بلندتر است و حالا **همه** آن را دارند. -->
  <Style Selector="TextBox.wfield">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.calc.wfield">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <!-- ══ دکمهٔ کنارِ خانه («گرفتن از شب» / «فرستادن به روز») ═══════════════
       هم‌قدِ خانه و هم‌پهنای ستونِ کناری، وگرنه همان ناهمواری از سمتِ دکمه
       برمی‌گردد.

       ⛔ **و رنگِ شیفتِ خودش را دارد، نه سطحِ کادرِ تایپ.** گزارشِ صاحب ریپو
       با عکس (۱۴۰۵/۰۷/۱۲): «اون دو کادر رو هم رنگ بده — گرفتن از روز و شب
       — اون‌ها دکمه‌ستن، باید متفاوت باشن.»

       حق داشت و ریشه‌اش همان قاعدهٔ ۱۴۰۵/۰۷/۰۶ بود: سبکِ **پایهٔ** دکمه
       زمینه‌اش `Pump.Input` است و کادرِ تایپ هم همان — پس این دو دقیقاً
       هم‌رنگِ کادرهای کنارشان می‌شدند و کسی نمی‌فهمید دکمه‌اند.

       ⚠️ رنگ از خودِ کارت می‌آید (نارنجیِ روز · بنفشِ شب) — همان دو رنگی که
       سربرگ و دکمهٔ ذخیره دارند، پس هر کارت یک زبانِ رنگی دارد و رنگِ تازه‌ای
       به برنامه اضافه نشد.
       ⚠️ و `:pointerover` هم نوشته شده، وگرنه زیرِ ماوس به رنگِ پیش‌فرضِ
       آوالونیا برمی‌گشت و همان لحظه دوباره شبیهِ کادر می‌شد. -->
  <Style Selector="Button.wside">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.wside.day /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0952b" />
    <Setter Property="TextBlock.Foreground" Value="#1a1102" />
  </Style>
  <Style Selector="Button.wside.day:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#ffab4d" />
    <Setter Property="TextBlock.Foreground" Value="#1a1102" />
  </Style>
  <Style Selector="Button.wside.night /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#7c4dbe" />
    <Setter Property="TextBlock.Foreground" Value="#ffffff" />
  </Style>
  <Style Selector="Button.wside.night:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#9468d4" />
    <Setter Property="TextBlock.Foreground" Value="#ffffff" />
  </Style>

  <Style Selector="Border.calc">
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <Style Selector="Border.saved-badge">
    <Setter Property="Background" Value="#2038a169" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Ok}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.saved-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Ok}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="Button.save-btn">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.save-btn.day /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#f0952b" />
    <Setter Property="TextBlock.Foreground" Value="#1a1102" />
  </Style>
  <Style Selector="Button.save-btn.night /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#7c4dbe" />
    <Setter Property="TextBlock.Foreground" Value="#ffffff" />
  </Style>

  <!-- ══ سربرگِ داخلِ کارت — ‎.card-head‎ ══
       ‎padding:12px 16px; border-bottom:1px solid var(-border)‎
       زمینه یک پله تیره‌تر از خودِ کارت است تا سربرگ از بدنه جدا دیده شود —
       همان کاری که در نسخهٔ وب اختلافِ ‎-panel‎ و ‎-card‎ می‌کرد. -->
  <!-- ‎.card-head‎ — مقدارِ محاسبه‌شدهٔ مرورگر روی هر ۳۵ سربرگ: ‎15.84px 22px‎
       (یعنی افقی ۲۲، عمودی ۱۵٫۸۴). پیش از این ۱۶/۱۲ بود و عنوانِ هر کارت
       شش پیکسل به لبه نزدیک‌تر می‌نشست. -->
  <!-- سربرگِ هر بخش: هم‌رنگِ خودِ کادر و فقط با یک خطِ زیرین جدا می‌شود — نه
       یک نوارِ رنگیِ جدا. همان چیزی که در نمونه‌های پسندیده‌شده بود. -->
  <Style Selector="Border.card-head">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="18,13" />
  </Style>

  <!-- ══ نوارِ ابزارِ هر بخش: همه در یک خط و هم‌قد ══════════════════════
       گزارشِ صاحب ریپو با عکس (۱۴۰۵/۰۷/۱۴): «این‌ها چرا هم‌تراز نیستن؟ خیلی
       به‌هم ریخته‌اند؛ همه توی یک خط باشن، نه بالا یا پایینِ هم.»
       ریشه: هر کنترل قدِ خودش را داشت — کارتِ زیربخش ۴۴، دکمه ۳۶، کشویی
       ۳۴، کادرِ تایپ ۳۶ — پس هر چیز در ارتفاعی دیگر می‌نشست. حالا هر
       دکمه، کشویی و کادرِ این نوار **۳۸** است و وسطِ خط. (A−/A+/↺ جدا و
       کوچک‌اند و در ستونِ خودشان.) سنجه‌اش ‎round14‎. -->
  <Style Selector="WrapPanel.sec-tools Button:not(.seg), WrapPanel.sec-tools ComboBox, WrapPanel.sec-tools TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Pump.Dark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ══ کارتِ قرض‌دار — رنگِ کارت از حالِ حساب می‌آید ══ -->
  <!-- ══ کارتِ قرض‌دار ═════════════════════════════════════════════════════
       همان کارتی که صاحب ریپو از روی نمونه‌ها پسندید: قابِ تخت با یک خطِ
       ۱ پیکسلی، و حالِ حساب نه با قابِ رنگی بلکه با **نوارِ زندهٔ بالای کارت**.

       ⚠️ قابِ رنگیِ قبلی (۱٫۵ پیکسل سرخ/زرد/سبز) عمداً برداشته شد: وقتی
       چهارده کارت هر کدام یک قابِ پررنگ داشته باشند، صفحه چهارده تا فریاد
       می‌شود و چشم نمی‌فهمد کجا را نگاه کند. حالا رنگ فقط در نوارِ بالاست.

       ⚠️ هیچ سایه‌ای این‌جا نیست و نباید بیاید: هر ‎BoxShadow‎ یک لایهٔ رندرِ
       جداست و چهارده‌تا از آن، بخش را کند می‌کند. سایه فقط روی قابِ بخش است. -->
  <Style Selector="Border.person-card">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- ══ نوارِ زندهٔ بالای کارت ═══════════════════════════════════════════════
       «به اندازهٔ همان رسیدی که برد می‌شود جلو برود و پر یا خالی شود.»
       ‎ProgressBar‎ی تخت است، نه کنترلِ تازه — سبک‌ترین راهِ ممکن. -->
  <Style Selector="ProgressBar.meter">
    <Setter Property="Height" Value="5" />
    <Setter Property="MinHeight" Value="5" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Pump.GridLine}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ProgressBar.meter /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- ۹۰٪ به بالا: «سرخ می‌شود و چراغ می‌زند». فقط همین چند کارت می‌تپند،
       پس هزینه‌اش ناچیز است. -->
  <Style Selector="ProgressBar.meter.alarm">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- دکمهٔ ✕ گوشهٔ کارت -->
  <!-- دکمه‌های ریزِ داخلِ جدول/کارت از قاعدهٔ «۳۶ پیکسل» مستثنایند -->
  <Style Selector="Button.card-x, Button.qr, Button.seg, Button.nav-edge">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.card-x">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Danger}" />
  </Style>
  <Style Selector="Button.card-x /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- دکمهٔ «کیوآر کد» — کادرِ آبیِ خالی، مثلِ نسخهٔ وب -->
  <Style Selector="Button.qr">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Info}" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Info}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Button.qr /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ‎.pname‎ — نامِ کارت. جای نام همیشه دو خط است (‎min-height:66px‎ در CSS)
       تا کارت‌های یک ردیف هم‌قد بمانند، و همهٔ نام‌ها یک اندازه‌اند: نامِ بلندتر
       ریز نمی‌شود، با «…» کوتاه می‌شود. -->
  <!-- ══ نامِ روی کارت ═════════════════════════════════════════════════════
       همان زبانی که کارتِ قرض‌دار گرفت و صاحب ریپو از روی نمونه‌ها پسندید:
       یک خط، سرِ خط (نه وسط)، و بی آن ‎MinHeight‎ی ۵۰ پیکسلی.

       ⚠️ آن ‎MinHeight‎ برای این بود که نامِ دوخطه کارت‌ها را ناهم‌قد نکند، ولی
       چون نام‌ها تقریباً همیشه یک‌خطه‌اند، عملاً یک حفرهٔ خالیِ ۲۵ پیکسلی وسطِ
       هر کارت می‌ساخت. حالا نامِ بلند با «…» بریده می‌شود و هم‌قدی از
       ‎MinItemHeight‎ی خودِ چیدمان می‌آید، نه از کش‌آوردنِ نام. -->
  <!-- ⚠️ نام از همه درشت‌تر — گزارشِ صاحب ریپو با عکس: «اسم که اصلاً دیده
       نمی‌شود، مهم‌ترین همان است.» همان ۱۹ی سیاهِ کارتِ قرض‌دار. -->
  <Style Selector="TextBlock.pname">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="TextAlignment" Value="Start" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="11,8,11,0" />
  </Style>

  <!-- ══ نامِ شرکت روی کارتِ خودش — وسطِ کادر و کامل ═══════════════════════
       گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۰۷): «اسمِ شرکت‌ها روی هدرها به‌خوبی دیده
       نمی‌شود و وسطِ کادر نیست؛ اسمِ دقیق دیده بشه و وسط باشه.»

       ⛔ دو چیز عوض شد و هر دو لازم بود:
         ۱) ‎TextAlignment=Center‎ — ‎.pname‎ی مشترک ‎Start‎ است و برای کارتِ
            قرض‌دار همان درست است (کنارِ ✕ و عددِ کفِ کارت)، ولی کارتِ شرکت
            نامش تنها چیزِ بالای کارت است.
         ۲) ‎Wrap‎ به‌جای «…» — نامِ دو‌کلمه‌ای («شرکتِ نفتِ بلخ») با
            ‎NoWrap‎ بریده می‌شد، یعنی «اسمِ دقیق» دیده نمی‌شد. ردیفِ کارت
            ‎Auto‎ است، پس دو خط جا دارد.
       ⚠️ ‎.pname‎ دست‌نخورده ماند: کارتِ قرض‌دار همان است که بود. -->
  <Style Selector="TextBlock.cname">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="8,6,8,0" />
  </Style>

  <!-- ‎.cmp-fig‎ — کادرِ «دالر» و «الباقی» کارتِ شرکت: بی‌خط، وسط‌چین، هم‌قد -->
  <!-- عددِ اصلیِ کارت — درشت و سرِ خط، مثلِ کارتِ قرض‌دار.
       عددِ ۱۴ پیکسلیِ وسط‌چینِ قبلی از نامِ بالایش هم کوچک‌تر بود و کارت
       «سلسله‌مراتب» نداشت: چشم نمی‌فهمید مهم‌ترین چیزِ کارت کدام است. -->
  <Style Selector="TextBlock.cmp-fig">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="TextAlignment" Value="Start" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="11,6,11,0" />
  </Style>

  <!-- سطرِ کوچکِ زیرِ عدد («الباقی · افغانی»، «۴۲٪ مصرف» و مانندِ آن) -->
  <Style Selector="TextBlock.card-sub">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Start" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
    <Setter Property="Margin" Value="11,3,11,0" />
  </Style>

  <!-- ══ نوارِ بخش‌ها ═══════════════════════════════════════════════════════
       ارتفاع ثابت است و نوارِ لغزش پنهان — وگرنه نوارِ لغزشِ افقی از پایین
       ارتفاع را می‌خورد و زیرِ نوشتهٔ دکمه‌ها بریده می‌شد. دو دکمهٔ «‹ ›» فقط
       وقتی پیدا می‌شوند که واقعاً بخشی بیرونِ قاب مانده باشد. -->
  <Style Selector="c|NavStrip">
    <Setter Property="Height" Value="52" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- فلش‌ها بیرونِ ناحیهٔ لغزش‌اند، نه رویش. اگر رویش باشند، بخشِ فعالی
             که تازه به لبه آمده زیرشان نیمه‌پنهان می‌ماند. ستونِ Auto با پنهان
             شدنِ دکمه خودش صفر می‌شود، پس وقتی لغزشی در کار نیست هیچ جایی
             هدر نمی‌رود. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Name="PART_Prev" Classes="nav-edge" Content="›" IsVisible="False" />

          <ScrollViewer Grid.Column="1" Name="PART_Scroll"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <!-- ⚠️ فاصلهٔ دو سرِ نوار «حاشیهٔ محتوا» است نه ‎Padding‎ِ خودِ
                 ScrollViewer: بالشتکِ ScrollViewer بیرونِ اندازهٔ محتوا می‌ماند،
                 پس دکمهٔ آخر — که همیشه بخشِ «تاریخچه‌ها» بود — ده پیکسل بیرونِ
                 دامنهٔ لغزش می‌افتاد و نصفه بریده می‌شد. -->
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                              Margin="10,0" />
          </ScrollViewer>

          <Button Grid.Column="2" Name="PART_Next" Classes="nav-edge" Content="‹" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.nav-edge">
    <Setter Property="Width" Value="26" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Label}" />
  </Style>
  <Style Selector="Button.nav-edge /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.NavBg}" />
  </Style>
  <Style Selector="Button.nav-edge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
  </Style>

  <!-- ‎.dash-seg‎ — دکمه‌های کوچکِ «همه/پطرول/دیزل» و «روزانه/هفتگی/…» -->
  <Style Selector="Button.seg">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Foreground" Value="{DynamicResource Pump.OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>
  <Style Selector="Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- ══ نوارِ کشوییِ جدولِ آرشیو (قرض‌داران) — همان نوارهای رنگیِ سایت ══════
       تمام‌عرض، پررنگ، نوشتهٔ سفید؛ زمینه از ‎BarBrushKey‎ی خودِ ردیف می‌آید. -->
  <Style Selector="Button.arc-bar">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.arc-bar /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
  </Style>
  <Style Selector="Button.arc-bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- ستونِ نمودارِ فروشِ داشبورد -->
  <Style Selector="Border.db-bar">
    <Setter Property="Background" Value="{DynamicResource Pump.ChartLine}" />
    <Setter Property="Opacity" Value="0.62" />
  </Style>
  <Style Selector="Border.db-bar.sel">
    <Setter Property="Background" Value="{DynamicResource Pump.ChartBarSel}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- خانهٔ کارتِ خرید — برچسب بالا، مقدار پایین -->
  <Style Selector="StackPanel.cell">
    <Setter Property="Width" Value="126" />
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,12,10" />
  </Style>
  <!-- خانهٔ فرم داخلِ ردیفِ پخش‌شده پهنای ثابتِ ‎.cell‎ را کنار می‌گذارد و
       عرضش را از خودِ ردیف می‌گیرد؛ وگرنه ۱۲۶ پیکسل می‌ماند و وسطِ خانه‌اش
       شناور می‌شود. (‎NaN‎ در Avalonia یعنی «خودکار».) -->
  <Style Selector="UniformGrid.stats > StackPanel.cell">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Margin" Value="6,0" />
  </Style>


  <!-- ══ جانِ حرکت ═══════════════════════════════════════════════════════════
       نسخهٔ وب همه‌جا ‎transition‎ داشت و نسخهٔ نیتیو هیچ: دکمه‌ها آنی رنگ عوض
       می‌کردند و کارت‌ها به لمسِ ماوس واکنشی نشان نمی‌دادند. همان زمان‌بندی‌های
       خودِ CSS این‌جا آمده — نه بیشتر، تا برنامه «شلوغ» نشود:

         دکمه   ‎transform .15s · background .2s‎ ، فشار ‎scale(.95)‎
         ناوبری ‎.2s‎ ، فشار ‎scale(.93)‎
         کارت   ‎border-color .3s‎ و روشن‌تر شدنِ لبه زیرِ ماوس

       هیچ سایه/تاری اضافه نشده (خواستهٔ صریحِ صاحب ریپو) — حرکت از تغییرِ
       اندازه و رنگِ لبه می‌آید، نه از blur.                                -->
  <Style Selector="Button">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="Button.nav:pressed">
    <Setter Property="RenderTransform" Value="scale(0.93)" />
  </Style>

  <!-- فقط رنگِ لبه نرم می‌شود، نه زمینه.
       خودِ CSS هم همین است: ‎transition: transform .3s, box-shadow .3s,
       border-color .3s‎ — زمینه در فهرست نیست. یک‌بار زمینه را هم گذاشتم و
       نتیجه‌اش این شد که کارت‌ها هنگامِ باز شدنِ بخش از رنگِ اولیه به رنگِ
       خودشان «محو» می‌شدند و صفحه یک لحظه مه‌آلود دیده می‌شد. -->
  <Style Selector="Border.card, Border.person-card, Border.shift-card, Border.stat">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.person-card:pointerover, Border.shift-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Accent}" />
  </Style>

  <!-- خطِ جداکنندهٔ پایینِ کارت — پیش از ردیفِ ⛽/🟤 و کیوآر -->
  <Style Selector="Border.card-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Pump.GridLine}" />
  </Style>

  <!-- «کیوآر» به شکلِ نوشتهٔ رنگی، نه دکمهٔ قاب‌دار — همان چیزی که در نمونه بود -->
  <Style Selector="Button.qr-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Accent}" />
  </Style>
  <Style Selector="Button.qr-link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ورودی‌ها هم نرم روشن شوند، نه پرشی -->
  <Style Selector="TextBox">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <!-- ══ اسکرول‌بار ═══════════════════════════════════════════════════════════
       بندِ ۶ی «پرامپت کیفیت بصری»: «عرض ۱۰px، دستگیره ‎border‎ با شعاعِ کامل،
       روی hover پررنگ‌تر. اسکرول‌بارِ پیش‌فرضِ ویندوز کیفیتِ کلِ برنامه را
       پایین می‌آورد.» -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar[Orientation=Vertical]">
    <Setter Property="Width" Value="10" />
  </Style>
  <Style Selector="ScrollBar[Orientation=Horizontal]">
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Pump.Border}" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Pump.Muted}" />
  </Style>

  <!-- ══ ردیفِ «جمله»ی ته جدول ═══════════════════════════════════════════════
       همتای ‎<tfoot class="xls-foot">‎ی سایت: نوارِ تیره‌تر با خطِ بالای پررنگ،
       خانهٔ اولش «جمله» و بقیه جمعِ هر ستون. با ‎c:TotalsBar‎ زیرِ هر جدول
       گذاشته می‌شود؛ هیچ‌وقت داخلِ خودِ جدول نمی‌رود (توضیحِ چرایی در
       ‎Controls/TotalsBar.cs‎). -->
  <!-- ══ ردیفِ «جمله» — همتای ‎<tfoot class="xls-foot">‎ی سایت ════════════════
       گزارشِ صاحب ریپو: «زیرِ جدول‌ها جمله، آن شبیهِ جدول نیست.»

       درست می‌گفت: تا امروز یک نوارِ ‎WrapPanel‎ی از جفت‌های برچسب/عدد بود که
       هیچ شباهتی به خودِ جدول نداشت — نه خطِ عمودیِ بینِ خانه‌ها، نه
       وسط‌چینی، نه هم‌قدیِ فونت با جدول.

       در سایت این یک ردیفِ واقعیِ همان جدول است:
           .xls-foot td{ background:gx-foot; color:…;
                         border-top:2px solid ...; font-weight:900;
                         padding:9px 8px; font-size:0.92rem }
       و چون ‎<td>‎ است، خطِ عمودیِ ستون‌ها و وسط‌چینیِ ‎.xls-tbl td‎ را هم دارد.

       حالا هر خانه یک «خانهٔ جدول» است: خطِ عمودیِ سمتِ خودش، وسط‌چین، با
       همان پس‌زمینه و وزنِ سنگینِ سرستون. -->
  <!-- ══ نوارِ «➕ ردیف» و «➕➕ چندتایی» ═══════════════════════════════════════
       همتای ‎.row-add-bar‎ی نسخهٔ وب: یک دکمهٔ ردیف، و کادرِ «تعداد» با دکمهٔ
       «چندتایی». جایش هم همان‌جاست که سایت گذاشته — پایینِ جدول، نه در سربرگ:
       «تا سربرگ شلوغ نباشد و دستِ آدم موقعِ کار به آن‌ها نخورد».
       خودِ کنترل در ‎Controls/RowAddBar.cs‎ است. -->
  <Style Selector="c|RowAddBar">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="accent" Content="➕ ردیف"
                  Command="{TemplateBinding AddRowCommand}" />
          <Border Classes="panel" Padding="7,4">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="تعداد:" Classes="muted" VerticalAlignment="Center" />
              <TextBox Width="62" Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       TextAlignment="Center" VerticalAlignment="Center" />
              <Button Name="PART_Many" Classes="ghost info" Content="➕➕ چندتایی"
                      ToolTip.Tip="همین تعداد ردیفِ خالی یک‌جا باز می‌شود (بیشترین ۵۰)" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="c|TotalsBar">
    <Setter Property="Margin" Value="0,-1,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource Pump.HeadBand}"
                BorderBrush="{DynamicResource Pump.Table.Border}"
                BorderThickness="{DynamicResource Pump.Table.SumBorder}"
                CornerRadius="0,0,10,10" Padding="0">
          <Panel ClipToBounds="True">
            <!-- «جمله» روی خانهٔ اولِ ردیف می‌نشیند، درست مثلِ ‎tfoot‎ی سایت.
                 ⚠️ نامش ‎PART_Title‎ است چون ‎TotalsStrip‎ پهنایش را می‌خواند:
                 خانه‌هایی که زیرِ هیچ ستونی نیستند نباید رویش بیفتند. -->
            <TextBlock Name="PART_Title" Text="{TemplateBinding Title}"
                       FontWeight="ExtraBold" FontSize="13"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0"
                       Foreground="{DynamicResource Pump.OnHeadBand}" />
            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}" x:CompileBindings="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:TotalsStrip />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- ⚠️ خطِ عمودیِ کنارِ هر خانه — همان چیزی که یک ‎&lt;td&gt;‎ دارد و
                       این نوار نداشت. با آن، هر جمع «کادرِ خودش» را دارد و
                       شش عددِ گاوصندوق دیگر یک تودهٔ به‌هم‌چسبیده نیستند. -->
                  <Border BorderBrush="{DynamicResource Pump.Table.Border}"
                          BorderThickness="1,0,0,0" Padding="4,0">
                    <StackPanel Spacing="1" Margin="0,9" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource Pump.OnHeadBandMuted}" />
                      <!-- ‎ConverterParameter=band‎: همان کلیدِ رنگِ ویومدل، ولی نسخهٔ
                           خواندنی‌اش روی نوارِ تیره. ویومدل دست‌نخورده می‌ماند. -->
                      <TextBlock Text="{Binding Value}" FontWeight="ExtraBold" FontSize="14"
                                 TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Foreground="{Binding BrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=band}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ══ حبابِ پیام ══════════════════════════════════════════════════════
       پیامِ دیگران سمتِ شروع، پیامِ خودم سمتِ پایان و با زمینهٔ تاکیدیِ ملایم. -->
  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="MaxWidth" Value="460" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="Background" Value="{DynamicResource Pump.Selected}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <!-- پیامِ سطل — کم‌رنگ، تا با گفت‌وگوی زنده قاطی نشود -->
  <Style Selector="Border.bubble.trashed">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <!-- 🗑ِ حباب فقط زیرِ ماوس — روی هر پیام یک قابِ سرخ شلوغش می‌کرد -->
  <Style Selector="Button.bubbledel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.bubble:pointerover Button.bubbledel">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="TextBlock.chatval">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Text}" />
  </Style>
  <Style Selector="TextBlock.chatval.accent">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Accent}" />
  </Style>
  <Style Selector="TextBlock.chatval.muted2">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
  </Style>
  <!-- کادرهای ستونِ مشخصاتِ پیام‌رسان -->
  <Style Selector="Border.chatinfo">
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- ══ کلیدهای ماشین‌حساب ══════════════════════════════════════════════ -->
  <Style Selector="Button.calc">
    <Setter Property="Margin" Value="3" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0" />
    <!-- کلیدها یک پله از کارت جدا — وگرنه در تمِ تیره کلید و کارت یک رنگ بودند -->
    <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
  </Style>
  <Style Selector="Button.calc.op">
    <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Accent}" />
  </Style>

  <!-- ══ نقطهٔ سرخِ «ماهِ تازه» ═══════════════════════════════════════════════
       ‎monthdot‎ کنارِ گزینهٔ ماهِ پیش در فهرست، و ‎monthdot.badge‎ روی گوشهٔ
       خودِ کشویی. ⚠️ سرخِ خودِ تم (‎Pump.Dot‎) و یک حلقهٔ همرنگِ کارت، تا
       روی لبهٔ کشویی هم جدا دیده شود. ⛔ هیچ انیمیشنی ندارد. -->
  <Style Selector="Ellipse.monthdot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="{DynamicResource Pump.Dot}" />
  </Style>
  <Style Selector="Ellipse.monthdot.badge">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stroke" Value="{DynamicResource Pump.Card}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="-5,-5,0,0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
</Styles>
