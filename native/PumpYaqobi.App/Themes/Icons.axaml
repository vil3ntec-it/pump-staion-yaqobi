<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ══ آیکون‌های بخش‌ها — بازسازی از سر (۱۴۰۵/۰۶/۲۵) ═══════════════════════════
       خواستهٔ صاحب ریپو: «تمام بخش‌ها ایکون‌هاشون رو استاندارد خودت درست کن،
       بازسازیِ تمام ایکون‌ها از سر باشه و جذاب‌تر، و ایکون‌ها رنگ هم داشته باشه.»

       قاعده: شبکهٔ ۲۴×۲۴، خطِ ۱٫۷۵ با سرِ گرد، گوشه‌های گرد (شعاعِ ۲)، شکلِ
       آشنا (پمپ، ورق، بشکه، مخزن، تقویم…). هر آیکون یک رنگِ خودش دارد
       (‎IconColor.<key>‎) — رنگِ سیرِ میانی که هم روی سفید خوانده شود هم روی
       مشکی. پشتِ آیکون در نوار یک «نشانِ» گردِ کم‌رنگ از همان رنگ می‌نشیند
       (‎IconColorConverter‎ با پارامترِ ‎badge‎).

       ⚠️ بدون تصویر، بدون فونتِ آیکون — فقط مسیرِ برداری، تا در هر اندازه و
       هر تم تیز بماند. کلید همان ‎IconKey‎ی بخش است. -->
  <!-- چهار کاشیِ گرد -->
  <StreamGeometry x:Key="Icon.dashboard">M5,3 H9 A2,2 0 0 1 11,5 V9 A2,2 0 0 1 9,11 H5 A2,2 0 0 1 3,9 V5 A2,2 0 0 1 5,3 Z M15,3 H19 A2,2 0 0 1 21,5 V6 A2,2 0 0 1 19,8 H15 A2,2 0 0 1 13,6 V5 A2,2 0 0 1 15,3 Z M15,11 H19 A2,2 0 0 1 21,13 V19 A2,2 0 0 1 19,21 H15 A2,2 0 0 1 13,19 V13 A2,2 0 0 1 15,11 Z M5,14 H9 A2,2 0 0 1 11,16 V19 A2,2 0 0 1 9,21 H5 A2,2 0 0 1 3,19 V16 A2,2 0 0 1 5,14 Z</StreamGeometry>
  <Color x:Key="IconColor.dashboard">#3b82f6</Color>
  <!-- پمپِ تیل با نازل -->
