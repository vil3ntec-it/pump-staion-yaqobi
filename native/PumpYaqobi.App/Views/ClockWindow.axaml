<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PumpYaqobi.App.ViewModels"
        x:Class="PumpYaqobi.App.Views.ClockWindow"
        x:DataType="vm:ClockViewModel"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource Pump.Card}"
        Title="تاریخ و ساعت">

  <!-- ══ 🕘 تاریخ و ساعت — مالِ خودِ برنامه ════════════════════════════════
       ⛔ نمایشی (‎DisplayClock‎، ۱۴۰۵/۰۷/۱۶): «ثبت» فقط تاریخ و ساعتِ سربرگ را
       عوض می‌کند — نه ساعتِ ویندوز، نه اجازهٔ مدیر، نه هیچ حسابی — و ⛔ هیچ
       هشدارِ «ساعتِ ویندوز جلو/عقب است» این‌جا نیست. -->
  <StackPanel Margin="22" Spacing="14">
    <TextBlock Classes="h2" Text="🕘 تاریخ و ساعت" TextAlignment="Center" />

    <Border Classes="calc" Padding="12,10">
      <TextBlock Text="{Binding NowText}" FontSize="17" FontWeight="Bold" TextAlignment="Center" />
    </Border>

    <!-- روز · ماه (با نام) · سال — به ترتیبِ خواندنِ فارسی، از راست -->
    <Grid ColumnDefinitions="*,8,2*,8,*" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Column="0" Classes="label" FontSize="13" Text="روز" TextAlignment="Center" />
      <TextBlock Grid.Column="2" Classes="label" FontSize="13" Text="ماه" TextAlignment="Center" />
      <TextBlock Grid.Column="4" Classes="label" FontSize="13" Text="سال" TextAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" />
      <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                ItemsSource="{Binding Months}" SelectedIndex="{Binding MonthIndex}" />
      <ComboBox Grid.Row="1" Grid.Column="4" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
    </Grid>

    <!-- ساعت : دقیقه — عددها چپ‌به‌راست، همان شکلی که ساعت خوانده می‌شود -->
    <Grid ColumnDefinitions="*,Auto,*" FlowDirection="LeftToRight" Width="260" HorizontalAlignment="Center">
      <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Hours}" SelectedIndex="{Binding HourIndex}" />
      <TextBlock Grid.Column="1" Text=":" FontSize="20" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center" />
      <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Minutes}" SelectedIndex="{Binding MinuteIndex}" />
    </Grid>

    <TextBlock Text="{Binding PickedText}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
               Foreground="{DynamicResource Pump.Ink.Accent}" />

    <WrapPanel HorizontalAlignment="Center">
      <Button Classes="accent" Content="✔ ثبت" Margin="4" Command="{Binding ApplyCommand}"
              ToolTip.Tip="فقط تاریخ و ساعتِ نمایشی عوض می‌شود — هیچ حسابی دست نمی‌خورد" />
      <Button Content="↺ ساعتِ واقعی" Margin="4" Command="{Binding RealCommand}"
              IsVisible="{Binding Shifted}" />
      <Button Content="بستن" Margin="4" Click="OnClose" />
    </WrapPanel>

    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
               Text="این تاریخ فقط برای دیدن است — حساب‌ها، ماه‌ها و اشتراک با تاریخِ واقعی کار می‌کنند." />
  </StackPanel>
</Window>
