<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:PumpYaqobi.App.Printing"
        xmlns:c="using:PumpYaqobi.App.Controls"
        x:Class="PumpYaqobi.App.Views.DocumentPreviewWindow"
        x:DataType="p:DocumentPreviewViewModel"
        Width="1280" Height="900" WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        FlowDirection="LeftToRight" Background="#ffffff"
        Title="چاپ">

  <!-- ══ صفحهٔ چاپ — همان پشتِ‌صحنهٔ اکسل ═══════════════════════════════════
       خواستهٔ صریحِ صاحب ریپو با عکس: «بخشِ پرینت باید این مدلی باشد؛ در سایت
       هم همین مدل بود.» سایت (‎pumpPrintStudio‎) دو ستون است — ستونِ تنظیمات
       و پیش‌نمایشِ زندهٔ ورق — و همین‌جا هم همان است.

       ⚠️ اندازه‌ها و رنگ‌ها حدسی نیستند؛ از خودِ ‎index.html‎ برداشته شده‌اند:

           #xlpr{direction:ltr}                     ← خطِ ۲۵۶۴۹
           #xlpr .xt{height:44px;background:#217346}
           #xlpr .xs{flex:0 0 352px;padding:14px 22px 30px;direction:rtl}
           #xlpr .xp{background:#f3f2f1;border-left:1px solid #e1dfdd}
           #xlpr .xh1{font-size:2.6rem;font-weight:300;color:#323130}
           #xlpr .xh2{font-size:1.45rem;font-weight:400;color:#217346}
           #xlpr .xprint{width:118px;height:104px}
           #xlpr .xcard{min-height:52px;border:1px solid #d2d0ce;border-radius:2px}
           #xlpr .xb{height:38px;background:#faf9f8}

       ⚠️ کلِ پنجره **چپ‌به‌راست** است و فقط ستونِ تنظیمات داخلش راست‌به‌چپ —
       دقیقاً همان دو خطِ بالا. برای همین ستون سمتِ **چپ** می‌نشیند، مثلِ
       اکسل. یک‌بار کلِ پنجره را راست‌به‌چپ کردم و ستون آینه شد و رفت راست؛
       این را دوباره برنگردانید. -->

  <Grid RowDefinitions="Auto,*">

    <!-- ══ نوارِ بالا ══ -->
    <Border Grid.Row="0" Background="#217346" Height="44" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="White"
                   FontWeight="Bold" FontSize="15"
                   Text="{Binding Title, StringFormat='🖨️ چاپ — {0}'}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ToggleButton Classes="doc-btn" Content="⚙ تنظیمات" IsChecked="{Binding RailOpen}" />
          <Button Classes="doc-btn" Content="✕ بستن" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

      <!-- ══════════════════════════════════════════════════════════════════
           ستونِ تنظیمات — ترتیبش مو‌به‌مو همان ‎sidebarHtml()‎ی سایت است:
           «چاپ» ▸ «چاپگر» ▸ «تنظیمات» ▸ «تنظیمِ ورق…»
           ══════════════════════════════════════════════════════════════════ -->
      <Border Grid.Column="0" Width="352" Background="White"
              FlowDirection="RightToLeft"
              IsVisible="{Binding RailOpen}">
        <ScrollViewer Padding="22,14,22,30" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">

            <!-- ‎.xh1{font-size:2.6rem;font-weight:300;color:#323130}‎ -->
            <TextBlock Text="چاپ" FontSize="42" FontWeight="Light" Foreground="#323130"
                       Margin="0,2,0,18" />

            <!-- ── دکمهٔ چاپ + تعدادِ نسخه ── -->
            <!-- ⚠️ فاصله با ‎Margin‎ است نه ‎ColumnSpacing‎: آن یکی در این نسخهٔ
                 آوالونیا روی ‎Grid‎ وجود ندارد و ساخت را می‌شکند. -->
            <Grid ColumnDefinitions="Auto,*">
              <Button Grid.Column="0" Classes="big-print" Click="OnPrint" Margin="0,0,12,0">
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                  <TextBlock Text="🖨️" FontSize="26" HorizontalAlignment="Center" />
                  <TextBlock Text="چاپ" FontSize="13" FontWeight="Bold"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="تعدادِ نسخه" Classes="pl" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Grid.Column="0" Classes="spin" Content="−" Click="OnCopiesMinus" />
                  <TextBox Grid.Column="1" Text="{Binding CopiesText}" Classes="spinbox" />
                  <Button Grid.Column="2" Classes="spin" Content="+" Click="OnCopiesPlus" />
                </Grid>
              </StackPanel>
            </Grid>

            <!-- ساختنِ PDF کارِ چاپگر نیست، پس هیچ پنجرهٔ ویندوزی لازم ندارد -->
            <Button Classes="pdf" Click="OnPdf" HorizontalAlignment="Stretch">
              <StackPanel Spacing="1">
                <TextBlock Text="⬇️ ساختنِ فایلِ PDF" FontWeight="Bold" />
                <TextBlock Text="بدونِ پنجرهٔ ویندوز" FontSize="11" Opacity="0.8" />
              </StackPanel>
            </Button>

            <!-- ── چاپگر ── -->
            <TextBlock Text="چاپگر" Classes="ph" />
            <Border Classes="prn">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="🖨️" FontSize="22" VerticalAlignment="Center" />
                <StackPanel Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="چاپگرِ پیش‌فرضِ ویندوز" FontWeight="Bold" FontSize="13" />
                  <TextBlock Text="آماده" Classes="pn" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Button Classes="link" Content="انتخابِ چاپگر و تنظیماتش…" Click="OnPrinters" />

            <!-- ── تنظیمات ── -->
            <TextBlock Text="تنظیمات" Classes="ph" />

            <c:SettingCard ItemsSource="{Binding Whats}" SelectedItem="{Binding What}" />
            <TextBlock Text="{Binding WhatNote}" Classes="pn" Margin="4,-4,4,2" />

            <!-- ورق‌ها: از … تا … — فقط وقتی «بازه» انتخاب شده، مثلِ اکسل -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRange}">
              <TextBlock Text="ورق‌ها:" VerticalAlignment="Center" Classes="pl" />
              <TextBox Text="{Binding FromText}" Width="74" Classes="spinbox" />
              <TextBlock Text="تا" VerticalAlignment="Center" Classes="pl" />
              <TextBox Text="{Binding ToText}" Width="74" Classes="spinbox" />
            </StackPanel>

            <c:SettingCard ItemsSource="{Binding Collates}" SelectedItem="{Binding Collate}" />
            <c:SettingCard ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" />
            <c:SettingCard ItemsSource="{Binding Papers}" SelectedItem="{Binding Paper}" />
            <c:SettingCard ItemsSource="{Binding MarginChoices}" SelectedItem="{Binding Margin}" />
            <TextBlock Text="{Binding MarginNoteText}" Classes="pn" Margin="4,-4,4,2" />
            <c:SettingCard ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" />
            <TextBlock Text="{Binding ScaleNote}" Classes="pn" Margin="4,-4,4,2" />

            <Button Classes="link" Content="تنظیمِ ورق…" Click="OnSetup" />
            <TextBlock Text="{Binding ScaleInfo}" Classes="pn" />
            <Button Classes="link" Content="⬇️ ذخیرهٔ فایلِ گزارش" Click="OnSave" />

            <TextBlock Text="{Binding Status}" Classes="pn" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════════
           پیش‌نمایشِ ورق — ‎.xp{background:#f3f2f1;border-left:1px solid #e1dfdd}‎
           چپ‌به‌راست می‌ماند (از خودِ پنجره ارث می‌برد): تصویرِ ورق نباید آینه
           شود و خط‌چینِ حاشیه هم باید چپ و راستش همان چپ و راستِ ورق باشد.
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto" Background="#f3f2f1">

        <Panel Grid.Row="0">
          <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Auto" Name="PreviewScroll">
            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Background="White" BoxShadow="0 2 12 0 #26000000">
                <Image Source="{Binding CurrentPage}" Stretch="Uniform"
                       Width="{Binding PageWidth}" />
              </Border>
              <!-- خط‌چینِ حاشیه — دکمهٔ «نمایشِ حاشیه‌ها»ی نوارِ پایین -->
              <Rectangle Margin="{Binding GuideMargin}" IsVisible="{Binding ShowGuides}"
                         Stroke="#2b6cb0" StrokeThickness="1" StrokeDashArray="4,3"
                         Fill="Transparent" IsHitTestVisible="False" />
            </Panel>
          </ScrollViewer>

          <Border Background="#b3ffffff" IsVisible="{Binding Busy}">
            <TextBlock Text="⏳ در حالِ چیدنِ ورق‌ها…" FontSize="16" FontWeight="Bold"
                       Foreground="#1f2430"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>

        <!-- ══ نوارِ پایین — ‎◀ [۱] از ۲ ▶‎ یک طرف، دو دکمهٔ گوشه طرفِ دیگر ══ -->
        <Border Grid.Row="1" Background="#faf9f8" BorderBrush="#e1dfdd"
                BorderThickness="0,1,0,0" Height="38" Padding="10,0">
          <Grid ColumnDefinitions="Auto,*,Auto">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button Classes="page-btn" Content="◀" Command="{Binding PrevCommand}"
                      ToolTip.Tip="ورق قبل" />
              <TextBox Text="{Binding PageNumberText}" Width="58" Classes="spinbox" />
              <TextBlock VerticalAlignment="Center" Foreground="#5b6472"
                         Text="{Binding PageCount, StringFormat='از {0}'}" />
              <Button Classes="page-btn" Content="▶" Command="{Binding NextCommand}"
                      ToolTip.Tip="ورق بعد" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Classes="page-btn" Content="➖" Command="{Binding ZoomOutCommand}"
                      ToolTip.Tip="کوچک‌تر" />
              <TextBlock Text="{Binding ZoomLabel}" VerticalAlignment="Center" FontWeight="Bold"
                         Foreground="#2d3748" MinWidth="52" TextAlignment="Center" />
              <Button Classes="page-btn" Content="➕" Command="{Binding ZoomInCommand}"
                      ToolTip.Tip="بزرگ‌تر" />
              <Border Width="1" Background="#dfe3e8" Margin="6,2" />
              <ToggleButton Classes="page-btn" Content="⬚" IsChecked="{Binding ShowGuides}"
                            ToolTip.Tip="نمایشِ حاشیه‌ها" />
              <Button Classes="page-btn" Content="⤢" Command="{Binding ZoomPageCommand}"
                      ToolTip.Tip="هم‌اندازهٔ ورق" />
              <Button Classes="page-btn" Content="↔" Command="{Binding ZoomFitCommand}"
                      ToolTip.Tip="هم‌اندازهٔ پهنا" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.doc-btn, ToggleButton.doc-btn">
      <Setter Property="Background" Value="#2f8f5f" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#57ab7f" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton.doc-btn:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#15603b" />
    </Style>

    <!-- دکمهٔ بزرگِ «چاپ» — همان ‎.xprint‎ی سایت -->
    <!-- ‎.xprint{width:118px;height:104px;border:1px solid #d2d0ce;border-radius:2px}‎ -->
    <Style Selector="Button.big-print">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#323130" />
      <Setter Property="BorderBrush" Value="#d2d0ce" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Width" Value="118" />
      <Setter Property="Height" Value="104" />
    </Style>
    <Style Selector="Button.big-print /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="White" />
    </Style>

    <!-- ‎.xpdf{color:#217346;border:1.5px solid #217346;border-radius:2px;padding:10px}‎ -->
    <Style Selector="Button.pdf">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#217346" />
      <Setter Property="BorderBrush" Value="#217346" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,10,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- سرفصل‌های ستون: «چاپگر»، «تنظیمات» -->
    <!-- ‎.xh2{font-size:1.45rem;font-weight:400;color:#217346;margin:20px 0 8px}‎ -->
    <Style Selector="TextBlock.ph">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="23" />
      <Setter Property="Foreground" Value="#217346" />
      <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style Selector="TextBlock.pl">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#5b6472" />
    </Style>
    <Style Selector="TextBlock.pn">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#7b8494" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ‎.xprn{border:1px solid #d2d0ce;border-radius:2px;padding:9px}‎ -->
    <Style Selector="Border.prn">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#d2d0ce" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="9" />
    </Style>

    <!-- لینک‌های آبیِ ستون — «تنظیمِ ورق…»، «انتخابِ چاپگر…» -->
    <!-- ‎.xlink{color:#0f6cbd;font-size:0.8rem;text-decoration:underline;padding:2px 0 10px}‎ -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#0f6cbd" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2,0,10" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.spin">
      <Setter Property="Background" Value="#eef1f5" />
      <Setter Property="Foreground" Value="#2d3748" />
      <Setter Property="BorderBrush" Value="#dfe3e8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBox.spinbox">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1f2430" />
      <Setter Property="BorderBrush" Value="#cfd6de" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ══ کشوی اکسلی — نشانه، عنوانِ پررنگ و یک خطِ توضیح ══
         کشوی معمولی فقط یک خطِ ساده نشان می‌دهد؛ این یکی همان کارتِ دوخطیِ
         اکسل است، هم بسته و هم باز (‎ItemTemplate‎ی یکسان برای هر دو). -->
    <!-- ‎.xcard{border:1px solid #d2d0ce;border-radius:2px;padding:7px 9px;min-height:52px}‎ -->
    <Style Selector="c|SettingCard">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#323130" />
      <Setter Property="BorderBrush" Value="#d2d0ce" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="p:SetupOption">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="19" Margin="0,0,9,0"
                       VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                         Foreground="#1f2430" />
              <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#7b8494"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </Setter>
    </Style>

    <Style Selector="Button.page-btn, ToggleButton.page-btn">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#2b6cb0" />
      <Setter Property="BorderBrush" Value="#cfd6de" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton.page-btn:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#e3edfb" />
    </Style>
  </Window.Styles>
</Window>
