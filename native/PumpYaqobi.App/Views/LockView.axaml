<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels"
             x:Class="PumpYaqobi.App.Views.LockView"
             x:DataType="vm:LockViewModel">
  <Border Background="{DynamicResource Pump.AppBg}">
    <Border Classes="panel" Width="420" Padding="30,28" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Path Data="{StaticResource Icon.pump}" Stroke="{DynamicResource Pump.Accent}"
                StrokeThickness="1.6" Width="30" Height="30" Stretch="Uniform" />
          <TextBlock Text="{Binding Title}" Classes="h1" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="رمز" Classes="label" />
        <TextBox PasswordChar="•" Text="{Binding Password}" x:Name="PwBox">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <!-- ⛔ کادرِ «تکرارِ رمز»ِ نخستین اجرا برداشته شد (۱۴۰۵/۰۷/۰۷): این صفحه
             دیگر رمز **نمی‌سازد** و فقط وقتی دیده می‌شود که خودِ کاربر در
             «تنظیمات ← رمزها و کد» رمزی گذاشته باشد. نصبِ تازه بی هیچ صفحهٔ
             قفلی باز می‌شود (AuthService.OpenWithoutPassword). -->

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Pump.Ink.Danger}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" />

        <Button Classes="accent" Content="{Binding ActionText}" Command="{Binding SubmitCommand}"
                HorizontalAlignment="Stretch" IsEnabled="{Binding !Busy}" Margin="0,4,0,0" />

        <TextBlock Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Text="رمز با PBKDF2 و نمکِ تصادفی نگه داشته می‌شود — نه خودِ رمز، نه چیزی که بشود از آن بازش کرد." />
      </StackPanel>
    </Border>
  </Border>
</UserControl>
