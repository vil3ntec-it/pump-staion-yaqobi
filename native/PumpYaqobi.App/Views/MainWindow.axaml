<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PumpYaqobi.App.ViewModels"
        xmlns:th="using:PumpYaqobi.App.Themes"
        xmlns:v="using:PumpYaqobi.App.Views"
        xmlns:c="using:PumpYaqobi.App.Controls"
        x:Class="PumpYaqobi.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="پمپ یعقوبی"
        Icon="avares://PumpYaqobi/Assets/logo.png"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        FlowDirection="RightToLeft">

  <Window.Resources>
    <th:IconLookupConverter x:Key="IconLookup" />
  </Window.Resources>

  <!-- ══ انیمیشنِ پردهٔ لودینگ ═══════════════════════════════════════════════
       سه حلقه که با فاصلهٔ زمانی نفس می‌کشند. عمداً نه تصویر و نه ‎GIF‎: با تمِ
       کاربر هم‌رنگ می‌ماند، هیچ فایلی به برنامه اضافه نمی‌کند، و روی کامپیوترِ
       ضعیف هم فقط سه دایرهٔ کوچک است.

       ⚠️ و عمداً ‎RenderTransform‎ نیست: آوالونیا برای آن خاصیت انیماتورِ
       آماده ندارد و همان‌جا استثنا می‌دهد («No animator registered for the
       property RenderTransform»). ‎Opacity‎ و ‎Width‎/‎Height‎ انیماتورِ
       ‎double‎ دارند و همیشه کار می‌کنند. -->
  <!-- ══ انیمیشنِ پردهٔ لودینگ ═══════════════════════════════════════════════
       یک نفسِ آرام روی خودِ لوگو. عمداً ساده: خواستهٔ صاحب ریپو «یک لودینگِ
       ساده و معمولی» بود، و روی کامپیوترِ ضعیف هم باید ارزان بماند.

       ⚠️ ‎RenderTransform‎ عمداً نیست: آوالونیا برایش انیماتورِ آماده ندارد و
       همان‌جا استثنا می‌دهد («No animator registered for the property
       RenderTransform»). ‎Opacity‎ انیماتورِ ‎double‎ دارد و همیشه کار می‌کند. -->
  <Window.Styles>
    <!-- ⚠️ فقط با کلاسِ ‎pulse‎ که به ‎IsStarting‎ بسته است: انیمیشنِ بی‌پایان روی
         کنترلِ **پنهان** هم می‌چرخد و هر فریم پنجره را از نو می‌کشد — همان
         «کامپیوتر داغ می‌شود»ِ صاحب ریپو، بعد از رمز و تا ابد. -->
    <Style Selector="Border#WarmLogo.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.72" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.72" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- ⚠️ همان قاعده، برای پردهٔ «آوردنِ اطلاعاتِ حساب»: انیمیشن فقط با
         کلاسی که به ‎IsSyncPriming‎ بسته است، وگرنه یک انیمیشنِ بی‌پایان
         روی کنترلِ پنهان تا ابد می‌چرخد. -->
    <Style Selector="Border#PrimeDot.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Panel>
  <!-- ══ یک اسکرولِ واحد برای کلِ صفحه ═════════════════════════════════════
       دقیقاً مدلِ سایت، اندازه‌گیری‌شده: کلِ صفحه می‌لغزد، ‎.header‎ و
       ‎.top-banner‎ هر دو ‎position:static‎‌اند و با اسکرول بالا می‌روند، و
       تنها ‎.nav‎ چسبان است (‎position:sticky; top:0‎).

       پیش از این هر سه‌تا ردیفِ ثابتِ یک ‎Grid‎ بودند و فقط بدنهٔ بخش
       می‌لغزید — صاحب ریپو گفت باید «تمام برنامه با همه چیز» برود بالا و
       فقط نوارِ بخش‌ها قفل بماند.

       نوار بیرونِ اسکرول است و با ‎TranslateTransform‎ (در کدِ پشتِ پنجره)
       تا وقتی سربرگ دیده می‌شود پایین می‌ایستد و بعد سرِ صفر قفل می‌شود؛
       آوالونیا ‎position:sticky‎ ندارد و این نزدیک‌ترین معادلش است. -->
  <!-- ⚠️ پوستهٔ برنامه فقط در حالتِ ‎Ready‎ ساخته و دیده می‌شود — یعنی فقط
       **پس از رمزِ درست**. نه حینِ لودینگ، نه روی صفحهٔ قفل. گرم کردن قابِ
       جدای خودش را دارد (‎WarmHost‎، همین پایین) و هیچ‌وقت از این پوسته
       استفاده نمی‌کند. -->
  <Grid IsVisible="{Binding IsShellVisible}">
   <ScrollViewer Name="PageScroll" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

    <!-- ══ سربرگ ══════════════════════════════════════════════════════════
         اندازه‌ها اندازه‌گیری‌شده‌اند، نه حدس: در همان پنجرهٔ ۱۴۴۰ پیکسلی،
         خودِ ‎index.html‎ این عددها را می‌دهد —
           ‎.header‎ ۷۵ پیکسل بلند با ‎padding:12px 20px‎
           عنوان ۲۱٫۱ پیکسل وزنِ ۹۰۰ · تاریخ ۱۵٫۷ وزنِ ۷۰۰
           ‎#lockBtn‎ ۶۵×۴۰ ، ‎.role-badge‎ ۶۳×۳۰ ، هر دو کپسولی (‎r:999‎)
         پیش از این سربرگِ نیتیو ۵۵ پیکسل بود و نه قفل داشت نه نشانِ نقش. -->
    <Border Name="HeaderBlock" IsVisible="{Binding IsChromeVisible}" Background="{DynamicResource Pump.HeaderBg}"
            BorderBrush="{DynamicResource Pump.Accent}" BorderThickness="0,0,0,2" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Path Data="{StaticResource Icon.pump}" Stroke="{DynamicResource Pump.Accent}"
                StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                Width="26" Height="26" Stretch="Uniform" />
          <TextBlock Text="پمپ یعقوبی" FontSize="21" FontWeight="Black"
                     Foreground="{DynamicResource Pump.HeaderTitle}" VerticalAlignment="Center" />
          <!-- ● چراغِ سرور — خواستهٔ صاحب ریپو: «بغلِ اسمِ پمپ یعقوبی یک نقطه
               که سبز یا سرخ شود و دلیلش را بگوید؛ نام و نشانیِ سرور نوشته
               نباشد.» دلیل فقط در ‎ToolTip‎ است، نشانی هیچ‌جا نیست. -->
          <!-- ⚠️ کلیک‌شدنی: «همین حالا بررسی کن» (گزارشِ ۱۴۰۵/۰۶/۲۹ — «سرور
               روشن است اما برنامه می‌گوید خاموش»). خودِ حلقه هر پنج ثانیه
               می‌گردد؛ این برای وقتی است که کاربر نمی‌خواهد منتظر بماند. -->
          <!-- ⛔ **و از ۱۴۰۵/۰۷/۱۰ یکی است، نه دو.** گزارشِ صاحب ریپو با
               عکس: «چرا دو نوع سرور رو نشون میده؟ یکی باشه اصلی که واقعاً
               نشون بده وصل است یا نه؛ الان یکی میگه وصل یکی میگه قط.»
               دو حقیقت (سرورِ خانگی و سرورِ حساب) سرِ جایشان‌اند و هر دو
               در ‎ToolTip‎ نوشته می‌شوند؛ فقط چراغ یکی شد. زرد یعنی «یکی
               وصل است و یکی نه» — سبز کردنش دروغ بود و سرخ کردنش هم. -->
          <Button Padding="4" Margin="2,2,0,0" VerticalAlignment="Center" Background="Transparent"
                  BorderThickness="0" Command="{Binding CheckLinksCommand}"
                  ToolTip.Tip="{Binding LinkDotReason}">
            <Border Width="12" Height="12" CornerRadius="6"
                    Background="{Binding LinkDotBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding Current.Title}"
                   FontSize="17" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Pump.HeaderTitle}" Opacity="0.85" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <!-- تاریخ و ساعت یک‌خطه. دوخطه بود و روی همین پنجرهٔ ۱۴۴۰ تاریخ
               می‌شکست و سربرگ شلوغ می‌شد. -->
          <!-- ⛔ کلیک ⇐ «تاریخ و ساعتِ» خودِ ویندوز (۱۴۰۵/۰۷/۱۳): برنامه ساعتِ دومی نمی‌سازد -->
          <Button Classes="ghost" Padding="6,2" Background="Transparent" BorderThickness="0"
                  Command="{Binding OpenClockSettingsCommand}" Cursor="Hand"
                  ToolTip.Tip="برای عوض کردنِ تاریخ یا ساعت کلیک کنید — تنظیماتِ تاریخ و ساعتِ ویندوز باز می‌شود">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <TextBlock Text="{Binding TodayText}" FontSize="14.5" FontWeight="Bold"
                       VerticalAlignment="Center" TextWrapping="NoWrap"
                       Foreground="{DynamicResource Pump.HeaderTitle}" />
            <Border Width="1" Height="15" VerticalAlignment="Center" Opacity="0.28"
                    Background="{DynamicResource Pump.HeaderTitle}" />
            <TextBlock Text="{Binding Clock}" FontSize="13.5" FontWeight="Bold"
                       VerticalAlignment="Center" TextWrapping="NoWrap"
                       Foreground="{DynamicResource Pump.HeaderTitle}" Opacity="0.8" />
          </StackPanel>
          </Button>

          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinWidth="180">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="th:PumpTheme">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Accent, Converter={x:Static th:ColorToBrushConverter.Instance}}" />
                  <TextBlock Text="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- 👤 پروفایل — بغلِ تم، خواستهٔ صریحِ صاحب ریپو: «یک بخشِ جدید
               بالای صفحه بغلِ تم بگذار به اسمِ پروفایل که آن‌جا هم بتواند
               لاگین با جیمیل را انجام بدهد و هم VIP و مدتش را ببیند.» متنش
               همین‌جا می‌گوید: «VIP · ۴۲ روز» یا «پروفایل». -->
          <Button Classes="pill-btn profile" Padding="13,4"
                  Command="{Binding GoCommand}" CommandParameter="{Binding Account}"
                  ToolTip.Tip="پروفایل: حساب، اشتراک و کدِ پمپ برای اپِ کارمندان">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="👤" FontSize="13" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Account.PillText}" FontSize="12.5" FontWeight="ExtraBold"
                           Foreground="White" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Account.PillSub}" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="White" Opacity="0.85" TextWrapping="NoWrap"
                           IsVisible="{Binding Account.PillSub, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Border Classes="pill" Background="#FFD700" Padding="6,0" IsVisible="{Binding Account.VipActive}">
                <TextBlock Text="فعال" FontSize="10" FontWeight="Black" Foreground="#1a1a1a" />
              </Border>
            </StackPanel>
          </Button>

          <!-- نشانِ نقش و دکمهٔ قفل — کپسولی، مثلِ نسخهٔ وب.
               «قفل» به همان ‎SignOut‎ی وصل است که تا امروز ساخته شده بود ولی
               هیچ دکمه‌ای صدایش نمی‌زد. -->
          <Border Classes="pill" Background="{Binding RoleBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                  Padding="11,5">
            <TextBlock Text="{Binding RoleText}" FontSize="12.5" FontWeight="ExtraBold" Foreground="White" />
          </Border>
          <!-- 💬 پشتیبانی — پیام‌های مشتری‌های کیو‌آر، همیشه جلوی چشم (خواستهٔ
               صاحب ریپو: «چتِ بخشِ پمپ رو ببرن بالا جای قفل و غیره»). با
               نخوانده، شماره می‌گیرد. -->
          <Button Classes="pill-btn support" FontSize="12.5" FontWeight="ExtraBold" Padding="13,5"
                  Command="{Binding GoCommand}" CommandParameter="{Binding Chat}"
                  ToolTip.Tip="پیام‌رسان و پشتیبانیِ مشتری‌ها">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="💬 پشتیبانی" FontSize="12.5" FontWeight="ExtraBold" Foreground="White" />
              <Border Classes="pill" Background="White" Padding="6,0" IsVisible="{Binding Chat.HasSupportUnread}">
                <TextBlock Text="{Binding Chat.SupportUnread}" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Pump.Danger}" />
              </Border>
            </StackPanel>
          </Button>
          <!-- ماشین‌حسابِ شناور — هر جای برنامه، با همین دکمه یا ‎Ctrl+K‎ -->
          <Button Classes="pill-btn" Content="ماشین‌حساب" FontSize="12.5" FontWeight="ExtraBold"
                  Padding="13,5" Command="{Binding Calculator.ToggleCommand}"
                  ToolTip.Tip="ماشین‌حساب (Ctrl+K)" />
          <Button Classes="pill-btn" Content="قفل" FontSize="12.5" FontWeight="ExtraBold"
                  Padding="13,5" Command="{Binding SignOutCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ نوارِ خبر — همان چهار عددِ ‎#topBanner‎ ══════════════════════════
         اندازه‌گیریِ نسخهٔ وب: نوار ۷۴ پیکسل بلند با ‎padding:8px 20px‎، و هر
         قلم <b>دو خطه</b> — برچسب ۱۶ پیکسل وزنِ ۸۰۰ بالا، عدد ۱۶٫۸ وزنِ ۸۰۰
         پایین. تا امروز این‌جا یک خطه و ۱۲ پیکسلی بود، برای همین نوار ۳۰
         پیکسل می‌شد و کنارِ نسخهٔ وب «ریز» دیده می‌شد. -->
    <Border Name="BannerBlock" IsVisible="{Binding IsChromeVisible}" Background="{DynamicResource Pump.BannerBg}"
            BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="0,0,0,1" Padding="20,8">
      <ItemsControl ItemsSource="{Binding Banner}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BannerItemViewModel">
            <StackPanel Spacing="2" MinWidth="140" VerticalAlignment="Center">
              <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="ExtraBold"
                         Foreground="{DynamicResource Pump.Muted}" />
              <TextBlock Text="{Binding Value}" FontWeight="ExtraBold" FontSize="16.8"
                         Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ══ نوارِ بخش‌ها ══════════════════════════════════════════════════
         افقی و بالای صفحه، مثلِ ‎<div class="nav">‎ در نسخهٔ وب — نه ستونِ
         کناری. چون ردیفِ جداگانهٔ همین Grid است، محتوا زیرش اسکرول می‌شود و
         خودِ نوار سرِ جایش می‌ماند (خواستهٔ صریحِ صاحب ریپو). -->
    <!-- جای خالیِ نوار: نوار خودش بیرونِ اسکرول شناور است، پس این‌جا به
         همان بلندی جا باز می‌شود تا محتوا زیرش پنهان نشود. -->
    <Panel Name="NavGap" Height="46" IsVisible="{Binding IsChromeVisible}" />

    <!-- ══ نوارِ «‹ برگشت» ═══════════════════════════════════════════════
         فقط وقتی زیربخشی باز است — «قرض‌های کهنه»، «تخلیهٔ تانکر»،
         «مدیریت داده‌ها» و مانندِ آن‌ها که در سایت هم دکمهٔ نوار ندارند و از
         دلِ بخشِ خودشان باز می‌شوند. -->
    <Border IsVisible="{Binding IsSubOpen}"
            Background="{DynamicResource Pump.NavBg}"
            BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="0,0,0,1"
            Padding="16,8">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Classes="ghost" Content="{Binding BackText}" FontWeight="Bold"
                Command="{Binding Current.CloseSubCommand}" />
        <TextBlock Text="{Binding Content.Title}" VerticalAlignment="Center"
                   FontWeight="ExtraBold" FontSize="15"
                   Foreground="{DynamicResource Pump.Accent}" />
      </StackPanel>
    </Border>

    <!-- ‎Content‎ است نه ‎Current‎: اگر زیربخشی باز باشد همان جلوی چشم می‌آید،
         وگرنه خودِ بخش. -->
    <!-- ══ همهٔ بخش‌ها این‌جایند؛ فقط یکی دیده می‌شود ═══════════════════════
         خواستهٔ صاحب ریپو: «این بازگشت به صفحهٔ اصلی نباید تأخیری داشته باشد.»

         ⚠️ پیش از این یک ‎ContentControl‎ بود که صفحه‌ها را جابه‌جا می‌کرد، و
         سنجشِ ‎waraqperf‎ گرفتش: بیرون رفتن از یک بخش و برگشتن، ردیف‌های
         جدولش را نابود و از نو می‌ساخت — باز کردنِ یک ورقِ ۸۰ ردیفی ۹۰۷
         میلی‌ثانیه در برابرِ ۶۲ وقتی از بخش بیرون نرفته بودیم.

         آوالونیا کنترلِ نادیدنی را اصلاً اندازه نمی‌گیرد، پس بیست‌ونه صفحهٔ
         پنهان هیچ هزینهٔ چیدمانی ندارند؛ فقط در حافظه‌اند — و به‌هرحال
         بودند، چون ‎ViewLocator‎ همان نمونه‌ها را کش می‌کرد. -->
    <ItemsControl ItemsSource="{Binding AllPages}" HorizontalAlignment="Stretch">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><Panel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ContentControl Content="{Binding}"
                          IsVisible="{Binding IsShown}"
                          HorizontalAlignment="Stretch"
                          MaxWidth="{Binding ContentMaxWidth, FallbackValue=1000}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- جای خالیِ نوارِ پایین: نوار خودش بیرونِ اسکرول شناور است، پس
         این‌جا به همان بلندی جا باز می‌شود تا تهِ محتوا زیرش پنهان نشود —
         همان کاری که ‎NavGap‎ برای نوارِ بالا می‌کند. -->
    <Panel Name="StatusGap" Height="30">
      <Panel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsChromeVisible" />
          <Binding Path="HasNotice" />
        </MultiBinding>
      </Panel.IsVisible>
    </Panel>
    </StackPanel>
   </ScrollViewer>

    <!-- ══ نوارِ بخش‌ها — چسبانِ بالا ═══════════════════════════════════════ -->
    <Border Name="NavBar" VerticalAlignment="Top"
            IsVisible="{Binding IsChromeVisible}"
            Background="{DynamicResource Pump.NavBg}"
            BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="0,0,0,1">
      <c:NavStrip Name="Nav">
        <ItemsControl ItemsSource="{Binding NavSections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SectionViewModel">
              <Button Classes="nav" Margin="3,0"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).GoCommand}"
                      CommandParameter="{Binding}">
                <Classes.active>
                  <Binding Path="IsActive" />
                </Classes.active>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <!-- آیکونِ رنگیِ خودِ بخش داخلِ نشانِ گردِ کم‌رنگ — رنگ با تب
                       فعال شدن عوض نمی‌شود؛ رنگ هویتِ بخش است، نه حالتش. -->
                  <Border Classes="icon-badge"
                          Background="{Binding IconKey, Converter={x:Static th:IconColorConverter.Instance}, ConverterParameter=badge}">
                    <Path Data="{Binding IconKey, Converter={StaticResource IconLookup}}"
                          Stroke="{Binding IconKey, Converter={x:Static th:IconColorConverter.Instance}}"
                          StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="17" Height="17" Stretch="Uniform" />
                  </Border>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="16" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </c:NavStrip>
    </Border>

    <!-- ══ نوارِ وضعیت — چسبانِ پایین ══════════════════════════════════════
         بندِ ۱۳ی پرامپتِ ۲۲: «نمایشِ وضعیتِ Sync در نوارِ وضعیتِ پایینِ
         پنجره (سبز/زرد/خاکستری/قرمز).»
         ⚠️ بیرونِ اسکرول و ‎VerticalAlignment="Bottom"‎ — همان الگوی نوارِ
         بخش‌ها، که بالای صفحه می‌ایستد. آوالونیا ‎position:sticky‎ ندارد.
         ⛔ هیچ نام و نشانیِ سروری در آن نیست؛ دلیل فقط در ‎ToolTip‎. -->
    <Border Name="StatusBar" VerticalAlignment="Bottom"
            Background="{DynamicResource Pump.NavBg}"
            BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="0,1,0,0"
            Padding="14,4">
      <!-- ⛔ چراغِ «● همگام‌سازی» از این نوار برداشته شد (خواستهٔ صاحب ریپو،
           ۱۴۰۵/۰۷/۱۳: «جا می‌گیرد»). حالِ همگام‌سازی سرِ جایش در «تنظیمات ←
           همگام‌سازی» است. نوار فقط وقتی دیده می‌شود که اعلانی هست. -->
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsChromeVisible" />
          <Binding Path="HasNotice" />
        </MultiBinding>
      </Border.IsVisible>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- بنرِ اعلانِ مدیر و قفلِ نرم — یک جا، نه دو -->
        <TextBlock Grid.Column="1" Text="{Binding NoticeText}" IsVisible="{Binding HasNotice}"
                   FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Margin="14,0"
                   Foreground="{DynamicResource Pump.Info}" />

        <Button Grid.Column="2" Classes="link" Content="بستن" FontSize="11"
                IsVisible="{Binding HasNotice}" Command="{Binding CloseNoticeCommand}"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource Pump.Muted}" />
      </Grid>
    </Border>

  </Grid>

    <!-- ══ قفل ══ -->
    <!-- صفحهٔ رمز پس از پرده می‌آید، نه پیش از آن -->
    <Panel IsVisible="{Binding IsLockVisible}">
      <v:LockView DataContext="{Binding Lock}" />
    </Panel>

    <!-- ══ ماشین‌حسابِ شناور ══════════════════════════════════════════════
         بیرونِ اسکرول و روی همهٔ بخش‌هاست، چون «داینامیک» یعنی هر جای برنامه
         که هستی همان‌جا باز شود — نه این‌که بخشی را ترک کنی. -->
    <!-- اندازه از ویومدل (در تنظیمات می‌ماند)، گوشهٔ بالا-چپ کشیدنی (‎Thumb‎)،
         دکمهٔ بزرگ/کوچک مثلِ سایت، و قلمِ کلیدها با بلندی بزرگ می‌شود.
         ⚠️ ‎FlowDirection‎ی چپ‌به‌راست روی خودِ قاب: تا جهتِ کشیدنِ گوشه با
         جهتِ حرکتِ ماوس یکی باشد و عددها چپ‌به‌راست بنشینند. -->
    <Border DataContext="{Binding Calculator}" IsVisible="{Binding IsOpen}"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"
            Width="{Binding Width}" Height="{Binding Height}" Classes="card" Padding="0"
            FlowDirection="LeftToRight">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Thumb Name="CalcResize" Grid.Row="0" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
               Cursor="SizeAll" Background="Transparent" ZIndex="5" DragDelta="OnCalcResize"
               ToolTip.Tip="بکشید تا بزرگ یا کوچک شود">
          <Thumb.Template>
            <ControlTemplate>
              <Border Background="Transparent" Padding="4">
                <Border Width="9" Height="9" BorderThickness="2,2,0,0" BorderBrush="{DynamicResource Pump.Muted}" CornerRadius="2,0,0,0" Opacity="0.7" />
              </Border>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,10,8,0" FlowDirection="RightToLeft">
          <TextBlock Grid.Column="0" Text="ماشین‌حساب" FontWeight="ExtraBold" FontSize="13"
                     VerticalAlignment="Center" />
          <Button Grid.Column="3" Classes="card-x" Content="✕" Command="{Binding CloseCommand}" />
          <Button Grid.Column="2" Classes="card-x" Content="⤢" Command="{Binding ToggleSizeCommand}" HorizontalAlignment="Left"
                  ToolTip.Tip="بزرگ/کوچک" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Trail}" Classes="card-sub" Margin="12,8,12,0"
                   TextAlignment="End" MinHeight="15" />
        <TextBlock Grid.Row="2" Text="{Binding Display}" FontSize="{Binding DisplayFont}" FontWeight="ExtraBold"
                   Margin="12,2,12,10" TextAlignment="End"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Row="3" Classes="card-rule" Margin="0" />

        <UniformGrid Grid.Row="4" Columns="4" Margin="8">
          <UniformGrid.Styles>
            <Style Selector="Button.calc">
              <Setter Property="FontSize" Value="{Binding KeyFont}" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="VerticalAlignment" Value="Stretch" />
              <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
          </UniformGrid.Styles>
          <Button Classes="calc" Content="C" Command="{Binding KeyCommand}" CommandParameter="C" />
          <Button Classes="calc" Content="←" Command="{Binding KeyCommand}" CommandParameter="←" />
          <Button Classes="calc" Content="%" Command="{Binding KeyCommand}" CommandParameter="%" />
          <Button Classes="calc op" Content="÷" Command="{Binding KeyCommand}" CommandParameter="÷" />

          <Button Classes="calc" Content="7" Command="{Binding KeyCommand}" CommandParameter="7" />
          <Button Classes="calc" Content="8" Command="{Binding KeyCommand}" CommandParameter="8" />
          <Button Classes="calc" Content="9" Command="{Binding KeyCommand}" CommandParameter="9" />
          <Button Classes="calc op" Content="×" Command="{Binding KeyCommand}" CommandParameter="×" />

          <Button Classes="calc" Content="4" Command="{Binding KeyCommand}" CommandParameter="4" />
          <Button Classes="calc" Content="5" Command="{Binding KeyCommand}" CommandParameter="5" />
          <Button Classes="calc" Content="6" Command="{Binding KeyCommand}" CommandParameter="6" />
          <Button Classes="calc op" Content="-" Command="{Binding KeyCommand}" CommandParameter="-" />

          <Button Classes="calc" Content="1" Command="{Binding KeyCommand}" CommandParameter="1" />
          <Button Classes="calc" Content="2" Command="{Binding KeyCommand}" CommandParameter="2" />
          <Button Classes="calc" Content="3" Command="{Binding KeyCommand}" CommandParameter="3" />
          <Button Classes="calc op" Content="+" Command="{Binding KeyCommand}" CommandParameter="+" />

          <Button Classes="calc" Content="±" Command="{Binding KeyCommand}" CommandParameter="±" />
          <Button Classes="calc" Content="0" Command="{Binding KeyCommand}" CommandParameter="0" />
          <Button Classes="calc" Content="." Command="{Binding KeyCommand}" CommandParameter="." />
          <Button Classes="calc accent" Content="=" Command="{Binding KeyCommand}" CommandParameter="=" />
        </UniformGrid>
      </Grid>
    </Border>

    <!-- ══ پردهٔ لودینگِ آغاز ═════════════════════════════════════════════════
         خواستهٔ صاحب ریپو: «یک انیمیشن با صفحهٔ لودینگ طراحی و درست کن.»

         انیمیشن عمداً از سه تا ‎Border‎ی چرخان ساخته شده، نه از تصویر یا
         ‎GIF‎: چیزی که با تمِ کاربر هم‌رنگ می‌شود، روی کامپیوترِ ضعیف هم
         ارزان است، و هیچ فایلی به برنامه اضافه نمی‌کند. -->
    <!-- ⚠️ ‎Pump.AppBg‎، نه ‎Pump.Bg‎: چنین کلیدی در تم **وجود ندارد** و
         ‎DynamicResource‎ی که پیدا نشود بی‌صدا ‎null‎ می‌شود — یعنی پرده
         کاملاً شفاف بود و کاربر همهٔ گشتِ پشتش را می‌دید. آوالونیا برای
         منبعِ نبوده نه خطا می‌دهد نه هشدار؛ فقط رنگ نمی‌گذارد. -->
    <Border Name="Splash" IsVisible="{Binding IsStarting}"
            Background="{DynamicResource Pump.AppBg}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">

        <!-- ══ لوگوی برنامه ══════════════════════════════════════════════
             ⚠️ خودِ لوگو، نه ایموجی و نه حلقه‌های جانشینش — خواستهٔ صریحِ
             صاحب ریپو. حلقه‌ها وقتی گذاشته شده بودند که لوگویی نبود؛ حالا
             که هست، فقط جا می‌گرفتند و تصویر را کوچک نگه می‌داشتند.

             همان فایلی که نشانِ پنجره و آیکونِ نصب هم از آن ساخته شده، پس
             همه‌جا یک تصویر است. -->
        <Border Name="WarmLogo" Width="168" Height="168" CornerRadius="34"
                Classes.pulse="{Binding IsStarting}"
                HorizontalAlignment="Center" ClipToBounds="True"
                BoxShadow="0 10 34 0 #33000000">
          <Image Source="avares://PumpYaqobi/Assets/logo.png"
                 Stretch="UniformToFill" />
        </Border>

        <TextBlock Text="پمپ یعقوبی" HorizontalAlignment="Center"
                   FontSize="22" FontWeight="ExtraBold"
                   Foreground="{DynamicResource Pump.Accent}" />

        <TextBlock Text="در حالِ آماده‌سازیِ بخش‌ها…" HorizontalAlignment="Center"
                   FontSize="14" Opacity="0.75" />

        <!-- میلهٔ پیشرفت — ‎RightToLeft‎ی پنجره خودش از راست پرش می‌کند -->
        <Border Width="340" Height="8" CornerRadius="999"
                Background="{DynamicResource Pump.Hover}"
                HorizontalAlignment="Center" ClipToBounds="True">
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding WarmProgress}"
                       Height="8" CornerRadius="999"
                       Foreground="{DynamicResource Pump.Accent}"
                       Background="Transparent" />
        </Border>

        <!-- ⚠️ فقط درصد، نه نامِ بخشی که دارد گرم می‌شود: خواستهٔ صاحب ریپو
             «یک لودینگِ ساده و معمولی» بود، و پیش از احراز هویت هیچ چیزی از
             درونِ برنامه هم نباید روی صفحه بیاید. -->
        <TextBlock Text="{Binding WarmPercentText}" FontWeight="Bold" FontSize="13"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Pump.Accent}" />
      </StackPanel>
    </Border>

    <!-- ══ ⏳ پردهٔ «آوردنِ اطلاعاتِ حساب» ═══════════════════════════════════
         خواستهٔ صاحب ریپو (۱۴۰۵/۰۷/۱۱): «یارو اینترنت داره و می‌ره تو حساب
         است و لودینگ روی صفحه نمیاد تا اطلاعاتی که توی حساب و سرور است
         بیاد روی همون حساب.»

         ⛔ فقط **نخستین** گرفتنِ هر حساب (‎SyncEngine.PrimeWanted‎). بعدش
         همان چراغِ کوچکِ نوارِ پایین کار را می‌کند.
         ⛔ و دیوار نیست: «ادامه در پس‌زمینه» همیشه این‌جاست، و هر خطایی
         خودش پرده را می‌برد. -->
    <Border IsVisible="{Binding IsSyncPriming}"
            Background="{DynamicResource Pump.AppBg}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">

        <Border Name="PrimeDot" Width="120" Height="120" CornerRadius="26"
                Classes.pulse="{Binding IsSyncPriming}"
                HorizontalAlignment="Center" ClipToBounds="True">
          <Image Source="avares://PumpYaqobi/Assets/logo.png" Stretch="UniformToFill" />
        </Border>

        <TextBlock Text="آوردنِ اطلاعاتِ حسابِ شما" HorizontalAlignment="Center"
                   FontSize="20" FontWeight="ExtraBold"
                   Foreground="{DynamicResource Pump.Accent}" />

        <!-- ⚠️ جملهٔ خودِ موتور، نه یک نوشتهٔ دومِ این‌جا: دو جای نوشتن یعنی
             روزی پرده یک چیز می‌گوید و چراغ چیزِ دیگر. -->
        <TextBlock Text="{Binding SyncPrimeText}" HorizontalAlignment="Center"
                   FontSize="14" Opacity="0.8" MaxWidth="420" TextWrapping="Wrap"
                   TextAlignment="Center" />

        <Border Width="340" Height="8" CornerRadius="999"
                Background="{DynamicResource Pump.Hover}"
                HorizontalAlignment="Center" ClipToBounds="True">
          <ProgressBar IsIndeterminate="True" Height="8" CornerRadius="999"
                       Foreground="{DynamicResource Pump.Accent}"
                       Background="Transparent" />
        </Border>

        <TextBlock Text="دفترِ این کامپیوتر دست‌نخورده است — چیزی پاک نمی‌شود."
                   HorizontalAlignment="Center" FontSize="12" Opacity="0.65" />

        <Button Content="ادامه در پس‌زمینه"
                Command="{Binding DismissSyncPrimeCommand}"
                HorizontalAlignment="Center" Padding="18,8" />
      </StackPanel>
    </Border>

    <!-- ══ توست — پیامِ کوتاهِ پایینِ صفحه ══ -->
    <Border DataContext="{Binding Toasts}" IsVisible="{Binding Visible}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
            CornerRadius="10" Padding="18,10" MinWidth="220"
            Background="{DynamicResource Pump.Panel}"
            BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="1">
      <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" FontWeight="SemiBold" />
    </Border>
  </Panel>
</Window>
