<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PumpYaqobi.App.Views.MonthPickWindow"
        SizeToContent="Height" Width="380" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource Pump.Card}"
        Title="ماه جدید">

  <!-- انتخابِ سال و ماه برای ساختِ جدولِ یک ماهِ تازه. هر دوازده ماه هست و
       سال‌ها هم چند تا — نه فقط ماهی که داده دارد. -->
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="TitleText" Classes="h2" TextWrapping="Wrap" Text="📅 ماه جدید" />
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="سال و ماه را انتخاب کنید. جدولِ همان ماه ساخته و باز می‌شود." />

    <Grid ColumnDefinitions="Auto,10,*" RowDefinitions="Auto,10,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="سال" Classes="label" VerticalAlignment="Center" />
      <ComboBox x:Name="YearBox" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="ماه" Classes="label" VerticalAlignment="Center" />
      <ComboBox x:Name="MonthBox" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" />
    </Grid>

    <!-- اگر آن ماه از قبل ساخته شده، همین‌جا گفته می‌شود و دکمه خاموش می‌شود —
         تا رکوردِ تکراری ساخته نشود. -->
    <TextBlock x:Name="DupeText" IsVisible="False" TextWrapping="Wrap" FontWeight="Bold"
               Foreground="{DynamicResource Pump.Warn}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
      <Button x:Name="OkBtn" Classes="accent" Content="ساختن" Click="OnOk" MinWidth="92" />
      <Button Content="انصراف" Click="OnCancel" MinWidth="92" />
    </StackPanel>
  </StackPanel>
</Window>
