<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.AccountSectionView"
             x:DataType="vm:AccountSectionViewModel">

  <!-- ══ پروفایل — به شکلِ «پروفایلِ بیمار»ِ مرجع ══════════════════════════════
       خواستهٔ صاحب ریپو با عکس: «باید شبیهِ این عکس باشد، نه این که توی تنظیمات
       برود.» سه ستون: آواتار · مشخصاتِ پمپ · اشتراک؛ زیرش تب‌ها با ردیف‌های
       رنگی و ستونِ فایل‌ها (پشتیبان‌ها) و کدِ اپِ کارمندان.
       ⛔ هیچ کادرِ نشانی و رمزی این‌جا نیست و نباید بیاید. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.kvl">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.kvv">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prow">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BorderThickness" Value="0,0,5,0" />
    </Style>
    <Style Selector="Border.ptitle">
      <Setter Property="Padding" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.ptitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ══ کادرهای کارتِ ورود: گِرد و بلند، نه مربعی ══════════════════════
         «اون مربعی نبود و کادرهای لاگینش خیلی بهتر بود» — پس فقط داخلِ همین
         کارت، کادرها گوشهٔ ۱۴ و بلندیِ ۴۴ می‌گیرند و دکمه‌ها کپسولی می‌شوند.
         بیرونِ این کارت هیچ چیزی عوض نمی‌شود. -->
    <Style Selector="Border.logincard TextBox">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Border.logincard Button.go">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.logincard TextBlock.lbl">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <c:SectionPage Header="پروفایل">
    <Grid ColumnDefinitions="300,*,330" RowDefinitions="Auto,Auto,*">

      <!-- ══ 🪪 کارتِ ورود — فرم روی خودِ عکس ═══════════════════════════════
           خواستهٔ صاحب ریپو (۱۴۰۵/۰۶/۲۸، با دو عکس و بعد اصلاحش): «خودِ لاگین
           تو اون عکس باشه و خیلی بهتر و قشنگ‌تر… اون عکسِ پمپ‌استیشن باشه، نه
           این که اون نوشته‌های عکس هم باشه… اون مربعی نبود و کادرهای لاگینش
           خیلی بهتر بود.»

           پس: عکس تمام‌قدِ کارت است و **بریده** (فقط پمپ، بی هیچ نوشتهٔ عکس)،
           و فرم یک پنلِ سفیدِ گردِ شناور **روی** همان عکس می‌نشیند. گوشه‌ها
           بزرگ و کادرها گِرد و بلندند — مربعی نیست.
           ⚠️ عکس فقط وقتی خوانده می‌شود که کاربر روی این صفحه بیاید. -->
      <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Classes="logincard"
              CornerRadius="26" Margin="0,0,0,16" ClipToBounds="True"
              MaxWidth="880" HorizontalAlignment="Center"
              Background="{DynamicResource Pump.Panel}"
              BoxShadow="{DynamicResource Pump.CardShadow}">
        <!-- ⚠️ عکسِ اصلی **ایستاده** است (۳۷۶×۴۱۲)، پس اگر تمامِ یک کارتِ
             پهن را پر کند فقط سقفِ پمپ دیده می‌شود. برای همین کارت باریک
             است و عکس یک طرفش را با نسبتِ طبیعیِ خودش می‌گیرد، و پنلِ فرم
             **لبه‌اش را می‌پوشاند** — همان طرحی که صاحب ریپو نشان داد. -->
        <!-- ⚠️ پهنا و بلندی **صریح**‌اند: هر دو پنل به دو لبه چسبیده‌اند، پس
             اگر اندازه را نگوییم خودِ قاب به اندازهٔ پهن‌ترین پنل جمع می‌شود
             و فرم تمامِ عکس را می‌پوشاند (یک بار همین شد).
             و بلندی آن‌قدر است که تهِ فرم («ورود با گوگل») بریده نشود. -->
        <Grid Width="880" Height="552">

          <!-- عکسِ بریده — یک طرفِ کارت، از بالا تا پایین -->
          <Image Source="{Binding LoginArt}" Stretch="UniformToFill"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Width="470"
                 IsVisible="{Binding LoginArt, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <!-- پردهٔ ملایم روی همان عکس، تا نوشته‌اش خوانده شود -->
          <Border HorizontalAlignment="Right" Width="470"
                  IsVisible="{Binding LoginArt, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.45" Color="#26000000" />
                <GradientStop Offset="1" Color="#59000000" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- نامِ پمپ، گوشهٔ عکس -->
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="26,22" Spacing="2"
                      IsVisible="{Binding LoginArt, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding PumpName}" FontSize="21" FontWeight="Black" Foreground="White" />
            <TextBlock Text="حساب و اشتراکِ همین پمپ" FontSize="12" Foreground="#eaeaea" />
          </StackPanel>

          <!-- ══ پنلِ شناورِ فرم — روی خودِ عکس ══ -->
          <Border HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="438"
                  Margin="16" CornerRadius="22" Padding="26,16"
                  Background="{DynamicResource Pump.Card}"
                  BoxShadow="0 12 34 0 #40000000">
            <StackPanel Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="خوش آمدید" FontSize="28" FontWeight="Black" />
              <TextBlock Text="ایمیل و کدِ شش‌رقمی را بزنید؛ رمزی لازم نیست."
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />

              <TextBlock Text="ایمیل" Classes="lbl" Margin="0,8,0,0" />
              <TextBox Text="{Binding LoginEmail}" Watermark="name@gmail.com" FlowDirection="LeftToRight" />

              <TextBlock Text="کدِ شش‌رقمیِ اشتراک" Classes="lbl" />
              <TextBox Text="{Binding LoginCode}" MaxLength="6" Watermark="۱۲۳۴۵۶" />

              <Grid ColumnDefinitions="*,10,*">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="نامِ شما" Classes="lbl" />
                  <TextBox Text="{Binding LoginName}" Watermark="نامِ خودتان" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                  <TextBlock Text="نامِ پمپ" Classes="lbl" />
                  <TextBox Text="{Binding LoginPump}" Watermark="پمپ یعقوبی" />
                </StackPanel>
              </Grid>

              <Button Classes="accent go" Content="ثبت و فعال‌سازی" Margin="0,10,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding SubmitLoginCommand}" IsEnabled="{Binding !Busy}" />

              <Grid ColumnDefinitions="*,Auto,*" Margin="0,4">
                <Border Grid.Column="0" Height="1" Background="{DynamicResource Pump.Border}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="یا" Classes="muted" FontSize="12" Margin="10,0" />
                <Border Grid.Column="2" Height="1" Background="{DynamicResource Pump.Border}" VerticalAlignment="Center" />
              </Grid>

              <Button Classes="ghost go" Content="ورود با گوگل"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding SignInCommand}" IsEnabled="{Binding !Busy}" />

              <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Bold"
                         IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="نام و نامِ پمپ بی کد هم ذخیره می‌شوند؛ دفترِ خودتان همیشه باز است." />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ══ آواتار ══ -->
      <Border Grid.Row="1" Grid.Column="0" Classes="panel" Padding="22" Margin="0,0,14,14">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Width="110" Height="110" CornerRadius="55" Background="{DynamicResource Pump.Accent}"
                  BoxShadow="{DynamicResource Pump.CardShadow}">
            <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Black" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding PumpName}" FontSize="20" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UserLine}" Classes="muted" TextAlignment="Center" />
          <TextBlock Text="{Binding AccountEmail}" Classes="muted" FontSize="12.5" TextAlignment="Center"
                     Foreground="{DynamicResource Pump.Info}"
                     IsVisible="{Binding AccountEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Border Classes="pill" Padding="11,4"
                    Background="{Binding RoleBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
              <TextBlock Text="{Binding RoleText}" FontSize="12" FontWeight="ExtraBold" />
            </Border>
            <Border Classes="pill" Padding="11,4" Background="#FFD700" IsVisible="{Binding VipActive}">
              <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="Black" Foreground="#1a1a1a" />
            </Border>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource Pump.Border}" Margin="0,6" />
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="ورود با گوگل" Command="{Binding SignInCommand}"
                  IsVisible="{Binding SignedOut}" IsEnabled="{Binding !Busy}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="🔄 گرفتنِ دوبارهٔ اطلاعات" Command="{Binding PullHomeCommand}"
                  IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="خروج از حساب" Command="{Binding SignOutCommand}"
                  IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          <TextBlock Text="{Binding AccountStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding StationLine}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding StationLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- ══ مشخصاتِ پمپ ══ -->
      <Border Grid.Row="1" Grid.Column="1" Classes="panel" Padding="22" Margin="0,0,14,14">
        <StackPanel Spacing="12">
          <TextBlock Text="مشخصاتِ پمپ" Classes="ptitle" />
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="نامِ پمپ" Classes="kvl" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PumpName}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="کدِ پمپ روی ابر" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PumpCodeLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="تلفن" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PumpPhone}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="نشانی" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PumpAddress}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="سرورِ خانگی" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HomeLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="ابر" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CloudLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="نسخهٔ برنامه" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AppVersionLine}" Classes="kvv" Margin="0,8,0,0" />
          </Grid>

          <Border Height="1" Background="{DynamicResource Pump.Border}" />

          <!-- کدِ اپِ کارمندان — همان چیزی که هر کارمند در گوشی می‌زند -->
          <TextBlock Text="کدِ پمپ برای اپِ کارمندان" Classes="ptitle" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="stat" Padding="18,10" MinWidth="220" IsVisible="{Binding HasAccessCode}">
              <SelectableTextBlock Text="{Binding AccessCodeDisplay}" FontSize="30" FontWeight="Black"
                                   FontFamily="Consolas,Menlo,monospace" LetterSpacing="4"
                                   Foreground="{DynamicResource Pump.Accent}" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="accent" Content="📋 کپی" Command="{Binding CopyAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="📲 کیو‌آر" Command="{Binding ShowAccessQrCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="🔄 گرفتنِ کد" Command="{Binding LoadAccessCodeCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="♻️ عوض کردن" Command="{Binding RotateAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}"
                        ToolTip.Tip="کدِ قبلی همان لحظه از کار می‌افتد" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                         Text="هر کسی اپِ اندروید یا آیفون را نصب می‌کند این کد را می‌زند و فقط حساب‌های همین پمپ را می‌بیند؛ بعدش رمزِ همین برنامه را هم می‌خواهد." />
              <TextBlock Text="{Binding AccessStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding AccessStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ اشتراکِ VIP ══ -->
      <Border Grid.Row="1" Grid.Column="2" Classes="panel" Padding="22" Margin="0,0,0,14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="اشتراکِ VIP" Classes="ptitle" />
            <Border Classes="pill" Padding="9,2" Background="#FFD700" IsVisible="{Binding VipActive}" VerticalAlignment="Center">
              <TextBlock Text="فعال" FontSize="11" FontWeight="Black" Foreground="#1a1a1a" />
            </Border>
          </StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="پلن" Classes="kvl" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubPlanText}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="پایان" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubEndsText}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="مانده" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubDaysText}" Classes="kvv" Margin="0,8,0,0"
                       Foreground="{DynamicResource Pump.Ok}" FontSize="18" FontWeight="Black" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="وضعیت" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubSourceText}" Classes="kvv" Margin="0,8,0,0" />
          </Grid>
          <Border Height="1" Background="{DynamicResource Pump.Border}" />
          <TextBlock Text="کدِ اشتراک (شش رقم)" Classes="kvl" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding SubCode}" Width="130" MaxLength="6" Watermark="۱۲۳۴۵۶" />
            <Button Classes="accent" Content="فعال کن" Command="{Binding RedeemSubCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="🔄" Command="{Binding RefreshSubCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="تازه‌سازی از سرور" />
          </StackPanel>
          <TextBlock Text="{Binding SubMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding SubMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding GraceText}" FontSize="12" TextWrapping="Wrap" FontWeight="Bold"
                     Foreground="{DynamicResource Pump.Warn}"
                     IsVisible="{Binding GraceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- ══ چه چیزی در اشتراکِ من است ══════════════════════════════
               سه کارِ ابری با اشتراک‌اند و پشتیبانی همیشه باز. دفترِ خودش
               هیچ‌وقت قفل نمی‌شود، پس این‌جا هم اسمی از آن نیست. -->
          <Border Height="1" Background="{DynamicResource Pump.Border}" />
          <TextBlock Text="دسترسی‌ها" Classes="kvl" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="اپِ کارمندان و ربات" Classes="kvv" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccessKarText}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="کیو‌آرِ حسابِ مشتری" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccessQrText}" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="بک‌اپِ خودکار روی سرور" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessBackupText}" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="چتِ پشتیبانی" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessSupportText}" Classes="kvv" Margin="0,6,0,0"
                       Foreground="{DynamicResource Pump.Ok}" />
          </Grid>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="دفترِ شما روی همین کامپیوتر می‌ماند و با تمام شدنِ اشتراک هم سرِ جایش است — قرض‌داران، ورق، مخزن، گاوصندوق، چاپ و بک‌اپِ محلی. فقط سه کارِ ابریِ بالا بسته می‌شوند." />
        </StackPanel>
      </Border>

      <!-- ══ تب‌ها: کارمندان · تاریخچه · پشتیبان‌ها ══ -->
      <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="panel" Padding="22" Margin="0,0,14,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,14">
            <Button Classes="seg" Classes.active="{Binding TabStaff}" Content="کارمندان"
                    Command="{Binding SetTabCommand}" CommandParameter="staff" />
            <Button Classes="seg" Classes.active="{Binding TabHistory}" Content="تاریخچهٔ بخش‌ها"
                    Command="{Binding SetTabCommand}" CommandParameter="history" />
            <Button Classes="seg" Classes.active="{Binding TabBackups}" Content="پشتیبان‌ها"
                    Command="{Binding SetTabCommand}" CommandParameter="backups" />
          </StackPanel>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="ردیفی نیست." Classes="muted" IsVisible="{Binding !Rows.Count}" />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <Border Classes="prow" Background="{DynamicResource Pump.Input}"
                            BorderBrush="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                      <Grid ColumnDefinitions="2*,1.4*,1.4*,2*">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="عنوان" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding L1}" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding V1}" FontWeight="SemiBold"
                                     Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                          <TextBlock Text="{Binding L2}" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding V2}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding HasNote}">
                          <TextBlock Text="یادداشت" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ══ فایل‌ها: پشتیبان‌ها ══ -->
      <Border Grid.Row="2" Grid.Column="2" Classes="panel" Padding="22">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="فایل‌های پشتیبان" Classes="ptitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill-btn support" Content="باز کردنِ پوشه" FontSize="12" Padding="12,4"
                    Command="{Binding OpenBackupsCommand}" />
          </Grid>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="هنوز پشتیبانی گرفته نشده — هر روز سرِ ورود خودکار گرفته می‌شود." Classes="muted" FontSize="12"
                         TextWrapping="Wrap" IsVisible="{Binding !Backups.Count}" />
              <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="🗄️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Text="{Binding V2}" Classes="muted" FontSize="11.5" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding V1}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </c:SectionPage>
</UserControl>
