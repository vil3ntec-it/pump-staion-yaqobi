<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:vmr="using:PumpYaqobi.App.ViewModels"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.AccountSectionView"
             x:DataType="vm:AccountSectionViewModel">

  <!-- ══ پروفایل — و صفحهٔ ورودی که اولویت دارد ═══════════════════════════════
       دو صفحه داخلِ یک ‎Panel‎ روی هم‌اند و هر لحظه فقط یکی دیده می‌شود:
         `ShowLoginPage`   ⇒ صفحهٔ ورود، تمامِ صفحه (کسی که حساب ندارد)
         `ShowProfilePage` ⇒ خودِ پروفایل، با همان مشخصات
       ⛔ رنگ‌بندیِ عکسِ مرجع **فقط** در صفحهٔ ورود است، نه جای دیگر — خواستهٔ
       صریحِ صاحب ریپو: «رنگ را گفتم فقط توی صفحهٔ لاگینِ حساب باشد.»
       ⛔ و هیچ دکمهٔ گوگل یا هر سرویسِ دیگری در هیچ‌کدام نیست.

       ══ پروفایل — به شکلِ «پروفایلِ بیمار»ِ مرجع ══════════════════════════════
       خواستهٔ صاحب ریپو با عکس: «باید شبیهِ این عکس باشد، نه این که توی تنظیمات
       برود.» سه ستون: آواتار · مشخصاتِ پمپ · اشتراک؛ زیرش تب‌ها با ردیف‌های
       رنگی و ستونِ فایل‌ها (پشتیبان‌ها) و کدِ اپِ کارمندان.
       ⛔ هیچ کادرِ نشانی و رمزی این‌جا نیست و نباید بیاید. -->
  <UserControl.Resources>
    <!-- ══ پالتِ صفحهٔ ورود — ریمیکِ دوم ═══════════════════════════════════
         خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۵): «تمام دیزاینِ لاگین متفاوت و
         جذاب باشه. اینی که الان است، این مدل و ظاهر یک درصد هم دیگه نباشه.
         یک چیزِ متفاوت و الترا یو‌ای‌یو‌ایکس باشه — و منطق دست نخوره.»

         پس کارتِ سفیدِ دوپنلیِ روزِ قبل کاملاً کنار رفت و جایش **یک کارتِ
         شیشه‌ای وسطِ یک آسمانِ شب** نشست:

           آسمان   #070b1e → #14225c → #2d1b69   (گرادیانِ پس‌زمینه)
           تاکید   #3f8cff → #6c5ce7 → #a855f7   (دکمهٔ اصلی و نشان)
           کارت    #F7FBFFFF شیشه‌ای، گوشهٔ ۳۰
           نوشته   #101935 · متن #5a6a8c · کم‌رنگ #8d9ab5
           کادر    #f0f5ff با خطِ #dbe5f7
           روی آسمان #dbe7ff

         ⛔ فقط زیرِ `Border.loginpage` — دو تمِ برنامه (آبی و طلایی) دست
            نمی‌خورند و هیچ‌کدامِ این رنگ‌ها جای دیگری نمی‌رود. -->
    <LinearGradientBrush x:Key="Login.Sky" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#070b1e" />
      <GradientStop Offset="0.52" Color="#14225c" />
      <GradientStop Offset="1" Color="#2d1b69" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Login.Grad" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#3f8cff" />
      <GradientStop Offset="0.5" Color="#6c5ce7" />
      <GradientStop Offset="1" Color="#a855f7" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.kvl">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.kvv">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- ردیفِ «کلید ⇠ مقدار» — خطِ مویی زیرش، مثلِ هر برگهٔ مشخصاتِ حرفه‌ای.
         ⚠️ ردیفِ آخرِ هر دسته ‎BorderThickness="0"‎ می‌گیرد؛ در آوالونیا
         ‎:nth-last-child‎ روی ‎Border‎ی داخلِ ‎StackPanel‎ قابلِ اتکا نیست. -->
    <Style Selector="Border.kvrow">
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.prow">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BorderThickness" Value="0,0,5,0" />
    </Style>
    <Style Selector="Border.ptitle">
      <Setter Property="Padding" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.ptitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ══ رنگ‌بندی و کادرهای **صفحهٔ ورود** — ریمیکِ دوم ═════════════════
         گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۰۵): «تمام دیزاینِ لاگین متفاوت و جذاب
         باشه… این مدل و ظاهر یک درصد هم دیگه نباشه… الترا یو‌ای‌یو‌ایکس.»

         پس این‌بار فرم روی یک **کارتِ شیشه‌ای وسطِ صفحه** می‌نشیند، روی
         آسمانِ شب. کارتِ سفیدِ تمام‌صفحهٔ دوپنلی و پالتِ آبیِ روزِ قبل
         کاملاً رفتند.
         ⛔ هیچ‌کدامِ این رنگ‌ها بیرونِ این صفحه به کار نمی‌رود و دو تمِ
            برنامه (آبی و طلایی) دست نمی‌خورند —
            آزمونِ `RangBandi_FaghatDarSafheyeVorud_Ast`.
         ⚠️ ترتیبِ سبک‌ها مهم است: در آوالونیا سبکِ **بعدی** برنده است، نه
            خاص‌تر — پس اول نوشتهٔ عمومی و بعد کلاس‌ها. -->
    <Style Selector="Border.loginpage TextBlock">
      <Setter Property="Foreground" Value="#5a6a8c" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.dim">
      <Setter Property="Foreground" Value="#8d9ab5" />
    </Style>
    <!-- ⚠️ برچسبِ **بالای** هر کادر سرِ جایش ماند: کاربر تا داخلِ کادر
         نمی‌زد نمی‌دانست چه می‌خواهد، و با پر شدنِ کادر نوشتهٔ راهنما هم
         می‌رفت. این یکی از ریمیکِ قبلی درست بود و برنگشت. -->
    <Style Selector="Border.loginpage TextBlock.lbl">
      <Setter Property="Foreground" Value="#101935" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,0,0,5" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.h1">
      <Setter Property="Foreground" Value="#101935" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Black" />
    </Style>
    <!-- نوشته‌های روی خودِ آسمان — روشن، جدا از نوشته‌های روی کارت -->
    <Style Selector="Border.loginpage StackPanel.brand TextBlock">
      <Setter Property="Foreground" Value="#dbe7ff" />
    </Style>

    <!-- ══ کادرها ═══════════════════════════════════════════════════════
         ⚠️ رنگ باید روی **قالبِ** `TextBox` بنشیند (`PART_BorderElement`)،
            وگرنه در تمِ تیره کادر سیاه می‌ماند روی کارتِ روشن. -->
    <Style Selector="Border.loginpage TextBox">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#101935" />
      <Setter Property="CaretBrush" Value="#6c5ce7" />
    </Style>
    <Style Selector="Border.loginpage TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#f0f5ff" />
      <Setter Property="BorderBrush" Value="#dbe5f7" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.loginpage TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#e9f0ff" />
      <Setter Property="BorderBrush" Value="#c3d3f5" />
    </Style>
    <Style Selector="Border.loginpage TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#ffffff" />
      <Setter Property="BorderBrush" Value="#6c5ce7" />
      <Setter Property="BorderThickness" Value="1.7" />
    </Style>
    <Style Selector="Border.loginpage TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#8d9ab5" />
    </Style>

    <!-- ══ دکمه‌ها ══════════════════════════════════════════════════════ -->
    <!-- ⚠️ تیکِ شرایط و ضوابط: قالبِ خودِ آوالونیا در تمِ تیره کادرش را
         سیاه می‌کند و روی کارتِ روشنِ این صفحه **گم** می‌شود (با عکس دیده
         شد). پس همان‌جا رنگِ خودش را می‌گیرد. -->
    <Style Selector="Border.loginpage CheckBox /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#ffffff" />
      <Setter Property="BorderBrush" Value="#b7c4de" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.loginpage CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#6c5ce7" />
      <Setter Property="BorderBrush" Value="#6c5ce7" />
    </Style>
    <Style Selector="Border.loginpage CheckBox /template/ Path#CheckGlyph">
      <Setter Property="Stroke" Value="#ffffff" />
      <Setter Property="Fill" Value="#ffffff" />
    </Style>

    <!-- دکمهٔ اصلی — گرادیانِ تاکید، نه یک آبیِ تخت -->
    <Style Selector="Border.loginpage Button.go">
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.loginpage Button.go /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Login.Grad}" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.loginpage Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6c5ce7" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Border.loginpage Button.link">
      <Setter Property="Foreground" Value="#6c5ce7" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Border.loginpage Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.loginpage Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#3f8cff" />
    </Style>
    <!-- لینک‌های روی آسمان — روشن، نه بنفشِ تیره روی تیره -->
    <Style Selector="Border.loginpage Button.linkw">
      <Setter Property="Foreground" Value="#dbe7ff" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Border.loginpage Button.linkw /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.loginpage Button.linkw:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>

    <!-- کپسولِ «حساب می‌سازم / حساب دارم / کدِ ایمیلی» -->
    <Style Selector="Border.loginpage Button.mode">
      <Setter Property="Foreground" Value="#5a6a8c" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.loginpage Button.mode /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Border.loginpage Button.mode.active">
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.loginpage Button.mode.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Login.Grad}" />
    </Style>

    <!-- ══ خانه‌های کد ═══════════════════════════════════════════════════
         شش کادرِ مربعیِ هم‌اندازه، عدد درشت و وسط — همان شکلی که کاربر در
         هر برنامهٔ دیگری دیده. ⚠️ `MaxLength` عمداً بلندتر از یک است تا
         چسباندنِ شش رقم در یک خانه هم کار کند؛ خودِ ویومدل پخششان می‌کند. -->
    <Style Selector="Border.loginpage TextBox.codebox">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="56" />
      <Setter Property="MaxLength" Value="12" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ⛔ سبکِ `stepchip` برداشته شد: نوارِ «۱ حساب · ۲ کدِ ایمیل · ۳ پمپ ·
         ۴ تمام» به خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۵ — «اون سه مرحله
         نباید دیده بشن») از صفحه رفت. خودِ گام‌ها سرِ جایشان‌اند و منطق یک
         نقطه هم عوض نشد؛ فقط دیگر شمرده نمی‌شوند. -->
  </UserControl.Styles>

  <!-- ⚠️ صفحهٔ ورود **داخلِ** قالبِ بخش نیست و نباید باشد: خواستهٔ صریحِ صاحب
       ریپو (۱۴۰۵/۰۶/۲۹) «تمام صفحه منظورم فقط همین را نشان بده در صفحه، نه
       بخش‌ها باشند نه غیره». پس نه سربرگِ بخش، نه کارتِ بخش — و سربرگ و نوار و
       نوارِ بخش‌های خودِ پنجره هم با `IsPageOpen` پنهان می‌شوند
       (`MainViewModel.IsChromeVisible`، همان راهی که صفحهٔ حسابِ قرض‌دار می‌رود). -->
  <Panel>

      <!-- ══════════════════════════════════════════════════════════════════
           🪪 صفحهٔ ورود — کارتِ شیشه‌ای وسطِ آسمانِ شب (ریمیکِ ۱۴۰۵/۰۷/۰۵)
           ══════════════════════════════════════════════════════════════════
           خواستهٔ صریحِ صاحب ریپو: «لاگین هنوز مشکل داره. اون سه مرحله نباید
           دیده بشن، و شرایط و ضوابط هم دیده نمی‌شه و باید با زدنش بره صفحهٔ
           جداگانه. لاگین رو هم وسطِ صفحه‌اش بزار. تمام دیزاینِ لاگین متفاوت
           و جذاب باشه — اینی که الان است، این مدل و ظاهر یک درصد هم دیگه
           نباشه. یک چیزِ متفاوت و الترا یو‌ای‌یو‌ایکس باشه، و منطق دست نخوره.»

           چهار چیزی که عوض شد، و هر کدام یک بندِ همان خواسته است:
             ۱) نوارِ گام‌ها (۱ حساب · ۲ کدِ ایمیل · ۳ پمپ · ۴ تمام) **رفت**
             ۲) شرایط و ضوابط یک **صفحهٔ جدا** شد، نه کادرِ کشوییِ ته فرم
             ۳) فرم **وسطِ صفحه** نشست، نه چسبیده به ستونِ راست
             ۴) و کلِ ظاهر عوض شد: کارتِ سفیدِ دوپنلیِ آبی رفت و جایش یک
                کارتِ شیشه‌ای روی آسمانِ شب نشست، با شفق و نشانِ گرادیانی

           ⛔ **هیچ منطقی عوض نشد.** ویومدل در این کار **یک کاراکتر** هم
              دست نخورد: فهرستِ `{Binding …}`ها و `Command`ها پیش و پس از
              این کار یکی است، جز `StepDone` که تنها مصرفش همان نوارِ
              گام‌ها بود. خودِ `StepDone` سرِ جایش است و فقط دیگر شمرده
              نمی‌شود.
           ⛔ **هیچ دکمهٔ سرویسِ بیرونی‌ای اضافه نشد** — نه گوگل، نه فیسبوک،
              نه اپل. هیچ‌کدام در این برنامه **وجود ندارد**؛ دکمه‌ای که زده
              شود و هیچ کاری نکند از نبودنش بدتر است، و قاعدهٔ «هیچ سرویسِ
              بیرونی در این صفحه» از ۱۴۰۵/۰۶/۲۸ سرِ جایش است. -->
      <Border Name="LoginPage" Classes="loginpage" CornerRadius="0"
              Background="{StaticResource Login.Sky}"
              IsVisible="{Binding ShowLoginPage}">
        <Panel>
          <!-- ══ شفقِ پس‌زمینه ══
               سه لکهٔ نرمِ کم‌رنگ روی آسمان. ⚠️ عمداً `Border`ِ گردِ
               تک‌رنگ‌اند و نه گرادیانِ شعاعی: شکلِ `RadialGradientBrush`
               بینِ نسخه‌های آوالونیا فرق کرده و این صفحه نباید به آن
               بند باشد. -->
          <Border Width="520" Height="520" CornerRadius="260" Background="#1A3f8cff"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-160,0,0" />
          <Border Width="440" Height="440" CornerRadius="220" Background="#1Aa855f7"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-140" />
          <Border Width="300" Height="300" CornerRadius="150" Background="#146c5ce7"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,90,0" />

          <!-- ══ آدمک‌های برداری — حالا تزئینِ خودِ آسمان ══
               ⛔ نقشهٔ unDraw (پروانهٔ MIT) سرِ جایش ماند — خواستهٔ صریحِ
                  صاحب ریپو از ۱۴۰۵/۰۶/۲۹ و سنجهٔ `loginart` هم بودنش در
                  درخت را قفل کرده.
               ⚠️ ولی دیگر کنارِ فرم نیست: در ریمیکِ تازه فرم وسطِ صفحه
                  است و نقشه پشتِ آن، کم‌رنگ، گوشهٔ پایین — تزئین، نه
                  رقیبِ فرم. -->
          <c:LoginArt Width="520" Opacity="0.14" Margin="40,0,0,26"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" />

          <!-- ══ همه‌چیز، وسطِ صفحه ══
               خواستهٔ صریحِ صاحب ریپو: «لاگین رو هم وسط صفحه‌اش بزار.»
               ⚠️ `VerticalAlignment="Center"` روی محتوای `ScrollViewer`
                  است، نه روی خودش: تا وقتی محتوا از قاب کوتاه‌تر است وسط
                  می‌ماند، و از آن بلندتر که شد خودش می‌لغزد. -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24,28">
            <StackPanel Spacing="0" MaxWidth="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

              <!-- ══ نشانِ برنامه، روی خودِ آسمان ══
                   ⚠️ `Classes="brand"` فقط دورِ همین سه‌تاست و نه دورِ کلِ
                   ستون: سبکِ `StackPanel.brand TextBlock` نوشته را روشن
                   می‌کند، و اگر کارت هم زیرش می‌بود، متنِ روی کارتِ روشن
                   روشنِ روی روشن می‌شد — یعنی نامرئی. -->
              <StackPanel Classes="brand" Spacing="0">
                <Border Width="68" Height="68" CornerRadius="24" HorizontalAlignment="Center"
                        Background="{StaticResource Login.Grad}"
                        BoxShadow="0 16 40 0 #593f8cff">
                  <Path Data="{StaticResource Icon.pump}" Stroke="#ffffff" StrokeThickness="1.75"
                        Stretch="Uniform" Width="34" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="پمپ یعقوبی" FontSize="19" FontWeight="Black"
                           HorizontalAlignment="Center" Margin="0,12,0,3" />
                <TextBlock Text="حسابِ شما، اشتراکِ شما، دفترِ شما — روی سرورِ خودتان"
                           FontSize="12" Foreground="#93a7d6" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,18" />
              </StackPanel>

              <!-- ══════════ کارتِ شیشه‌ای ══════════ -->
              <Border Background="#F7FBFFFF" CornerRadius="30" Padding="34,30"
                      BoxShadow="0 40 90 0 #66050a24">
                <StackPanel Spacing="0">

                  <!-- ⛔ نوارِ «۱ حساب · ۲ کدِ ایمیل · ۳ پمپ · ۴ تمام» این‌جا
                       بود و برداشته شد — خواستهٔ صریحِ صاحب ریپو
                       (۱۴۰۵/۰۷/۰۵): «اون سه مرحله نباید دیده بشن.»
                       ⚠️ خودِ گام‌ها دست نخوردند: `StepAccount` و
                       `StepEmailCode` و `StepPump` همان‌اند و هر بخش با
                       همان `IsVisible` پیدا و پنهان می‌شود. آن‌چه رفت فقط
                       شمردنشان روی صفحه بود. -->

                  <!-- ══════════ گامِ ۱: حساب ══════════ -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepAccount}">
                    <!-- ⛔ عنوان از همان حالت‌های موجود می‌آید، نه از یک
                         خاصیتِ تازه در ویومدل: خواستهٔ صریحِ صاحب ریپو این
                         بود که «منطق دست نخوره». -->
                    <TextBlock Text="ساختنِ حساب" Classes="h1" HorizontalAlignment="Center"
                               IsVisible="{Binding IsSignUp}" />
                    <TextBlock Text="خوش آمدید" Classes="h1" HorizontalAlignment="Center"
                               IsVisible="{Binding IsSignIn}" />
                    <TextBlock Text="ورود با کدِ ایمیلی" Classes="h1" HorizontalAlignment="Center"
                               IsVisible="{Binding IsCodeLogin}" />
                    <TextBlock Classes="dim" FontSize="12.5" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,7,0,0"
                               Text="چند ثانیه، و دفترتان روی حسابِ خودتان می‌نشیند."
                               IsVisible="{Binding IsSignUp}" />
                    <TextBlock Classes="dim" FontSize="12.5" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,7,0,0"
                               Text="با ایمیل و رمزتان وارد شوید."
                               IsVisible="{Binding IsSignIn}" />
                    <TextBlock Classes="dim" FontSize="12.5" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,7,0,0"
                               Text="بی رمز — یک کدِ شش‌رقمی به ایمیلتان می‌رود."
                               IsVisible="{Binding IsCodeLogin}" />

                    <!-- «حساب داری یا نه؟» — سه راهِ جدا و دیدنی -->
                    <Border CornerRadius="999" Background="#eef2fb" Padding="4"
                            HorizontalAlignment="Center" Margin="0,18,0,20">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="mode" Classes.active="{Binding IsSignUp}" Content="حساب می‌سازم"
                                Command="{Binding SetSignUpCommand}" CommandParameter="yes" />
                        <Button Classes="mode" Classes.active="{Binding IsSignIn}" Content="حساب دارم"
                                Command="{Binding SetSignUpCommand}" CommandParameter="no" />
                        <!-- درِ سوم: بی رمز. بندِ ۲۰٫۷ی پرامپت — ایمیل ⇒ کدِ
                             شش‌رقمی ⇒ نشست. ثبت‌نام و ورود در این راه یکی‌اند. -->
                        <Button Classes="mode" Classes.active="{Binding IsCodeLogin}" Content="کدِ ایمیلی"
                                Command="{Binding SetSignUpCommand}" CommandParameter="code" />
                      </StackPanel>
                    </Border>

                    <!-- ⚠️ **برچسب بالای هر کادر** سرِ جایش ماند: نوشتهٔ
                         راهنمای داخلِ کادر با پر شدنِ کادر می‌رود و کاربر
                         دیگر نمی‌داند کدام خانه چیست.
                         ⚠️ **Enter هم فرم را می‌فرستد.** روی خودِ کادرها
                         می‌نشیند، نه روی صفحه، وگرنه Enter در هر جای
                         دیگری هم دکمه را می‌زد. -->
                    <StackPanel IsVisible="{Binding IsSignUp}" Margin="0,0,0,13">
                      <TextBlock Text="نامِ شما" Classes="lbl" />
                      <TextBox Text="{Binding LoginName}" Watermark="نام و نامِ خانوادگی">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,13">
                      <TextBlock Text="ایمیل" Classes="lbl" />
                      <TextBox Text="{Binding LoginEmail}" Watermark="you@example.com"
                               FlowDirection="LeftToRight">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <!-- ⚠️ در راهِ «کدِ ایمیلی» اصلاً رمزی در کار نیست، پس
                         کادرش هم نباید دیده شود. -->
                    <StackPanel IsVisible="{Binding !IsCodeLogin}" Margin="0,0,0,13">
                      <TextBlock Text="رمز" Classes="lbl" />
                      <TextBox Text="{Binding LoginPassword}" PasswordChar="{Binding PassChar}"
                               Watermark="دستِ‌کم هشت نویسه">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSignUp}" Margin="0,0,0,13">
                      <TextBlock Text="تکرارِ رمز" Classes="lbl" />
                      <TextBox Text="{Binding LoginPassword2}" PasswordChar="{Binding PassChar}"
                               Watermark="همان رمز را دوباره بنویسید">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <!-- «چشم» و «رمزم را فراموش کرده‌ام» -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4"
                                IsVisible="{Binding !IsCodeLogin}">
                      <Button Classes="link" Content="{Binding RevealPassText}"
                              Command="{Binding ToggleRevealPassCommand}" />
                      <Button Classes="link" Content="رمزم را فراموش کرده‌ام" IsVisible="{Binding IsSignIn}"
                              Command="{Binding OpenForgotCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <!-- ══ شرایط و ضوابط ══
                         خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۵): «شرایط و
                         ضوابط هم دیده نمی‌شه، و باید با زدنِ شرایط و ضوابط
                         بره صفحهٔ جداگانه.» پس:
                           • ردیفش یک کادرِ رنگیِ دیدنی است، نه یک خطِ ریز
                           • و «شرایط و ضوابط» یک **صفحهٔ کاملِ جدا** باز
                             می‌کند (پایینِ همین فایل)، نه یک کادرِ کشویی
                         ⚠️ پذیرشِ شرایط **اجباریِ خودِ سرور** است
                            (`terms_required`) و متنش هم از سرور می‌آید.
                         ⛔ و منطق عوض نشد: همان `AcceptTerms` و همان
                            `LoadTermsCommand`ِ همیشگی — فقط آن‌چه
                            `ShowTerms` نشان می‌دهد حالا یک صفحه است. -->
                    <Border IsVisible="{Binding IsSignUp}" Margin="0,10,0,0"
                            Background="#f0f5ff" BorderBrush="#dbe5f7" BorderThickness="1"
                            CornerRadius="14" Padding="14,11">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <CheckBox IsChecked="{Binding AcceptTerms}" VerticalAlignment="Center" />
                        <Button Classes="link" Content="شرایط و ضوابط" VerticalAlignment="Center"
                                Command="{Binding LoadTermsCommand}" />
                        <TextBlock Text="را خوانده‌ام و می‌پذیرم" FontSize="12.5" Foreground="#5a6a8c"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <Button Classes="go" Content="{Binding AccountButtonText}" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding AccountStepCommand}" IsEnabled="{Binding !Busy}" />

                    <!-- ⛔ زیرِ دکمه هیچ ردیفِ «ورود با …» و هیچ نشانِ
                         سرویسِ بیرونی‌ای نیست: هیچ‌کدامِ آن راه‌ها در این
                         برنامه وجود ندارد و یک دکمهٔ بی‌کار از نبودنش بدتر
                         است. راهِ سومِ واقعیِ خودمان همان «کدِ ایمیلی»ِ
                         بالاست. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                Margin="0,14,0,0" IsVisible="{Binding IsSignUp}">
                      <TextBlock Text="حساب دارید؟" FontSize="12.5" VerticalAlignment="Center"
                                 Foreground="#8d9ab5" />
                      <Button Classes="link" Content="وارد شوید"
                              Command="{Binding SetSignUpCommand}" CommandParameter="no" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                Margin="0,14,0,0" IsVisible="{Binding !IsSignUp}">
                      <TextBlock Text="حساب ندارید؟" FontSize="12.5" VerticalAlignment="Center"
                                 Foreground="#8d9ab5" />
                      <Button Classes="link" Content="یک حساب بسازید"
                              Command="{Binding SetSignUpCommand}" CommandParameter="yes" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ══════════ گامِ ۰: رمزم را فراموش کرده‌ام ══════════
                       بندِ ۹ی صاحب ریپو. ⚠️ این راه روی سرور از قبل بود
                       (`/api/auth/password/forgot` و `/password/reset`) و
                       فقط برنامهٔ نیتیو هیچ‌وقت صدایش نزده بود. -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepForgot}">
                    <TextBlock Text="رمزِ تازه" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,18"
                               Text="ایمیلتان را بنویسید تا یک کدِ شش‌رقمی برایش بفرستیم، بعد رمزِ تازه را بگذارید." />

                    <TextBlock Text="ایمیل" Classes="lbl" />
                    <TextBox Text="{Binding LoginEmail}" Watermark="you@example.com"
                             FlowDirection="LeftToRight">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendResetCodeCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Classes="go" Content="فرستادنِ کد به ایمیل" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding SendResetCodeCommand}" IsEnabled="{Binding !Busy}" />

                    <!-- تا کد نرفته، نیمهٔ دوم دیده نمی‌شود -->
                    <StackPanel Spacing="0" IsVisible="{Binding ResetSent}" Margin="0,16,0,0">
                      <TextBlock Text="کدِ ایمیل" Classes="lbl" />
                      <TextBox Text="{Binding ResetCode}" MaxLength="6" Watermark="شش رقم"
                               FlowDirection="LeftToRight" Margin="0,0,0,13" />
                      <TextBlock Text="رمزِ تازه" Classes="lbl" />
                      <TextBox Text="{Binding ResetPass}" PasswordChar="{Binding PassChar}"
                               Watermark="دستِ‌کم هشت نویسه" Margin="0,0,0,13" />
                      <TextBlock Text="تکرارِ رمزِ تازه" Classes="lbl" />
                      <TextBox Text="{Binding ResetPass2}" PasswordChar="{Binding PassChar}"
                               Watermark="همان رمز را دوباره بنویسید">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding ResetPasswordCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button Classes="go" Content="گذاشتنِ رمزِ تازه و ورود" Margin="0,16,0,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="کد نرسید؟ دوباره بفرست" HorizontalAlignment="Center"
                              Margin="0,8,0,0"
                              Command="{Binding SendResetCodeCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <Button Classes="link" Content="‹ برگشت به ورود" HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                  </StackPanel>

                  <!-- ══════════ گامِ ۲: کدِ ایمیل ══════════
                       ⚠️ این کد **کدِ ایمیل** است، نه کدِ اشتراک. -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepEmailCode}">
                    <TextBlock Text="کدِ ایمیل" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,18"
                               Text="یک کدِ شش‌رقمی به ایمیلتان فرستادیم. همان را این‌جا بزنید تا حساب ساخته شود." />

                    <!-- ══ شش خانهٔ کد ══
                         پرشِ خودکار، Paste، ارقامِ فارسی/انگلیسی و ارسالِ
                         خودکار پس از رقمِ ششم. همهٔ تصمیم‌ها در
                         `CodeBoxesViewModel` است؛ این‌جا فقط فوکوس جابه‌جا
                         می‌شود (`AccountSectionView.axaml.cs`).
                         ⚠️ چپ‌به‌راست، وگرنه رقمِ اول سمتِ راست می‌افتد و
                         کاربر کد را وارونه می‌بیند.
                         ⚠️ `IsVisible` روی قابِ بیرونی است و `DataContext`
                         روی خودِ ردیف: با بایندِ کامپایل‌شده، عوض کردنِ
                         `DataContext` بدونِ `x:DataType` اصلاً کامپایل
                         نمی‌شود، و اگر `IsVisible` هم داخلِ همان می‌نشست
                         روی `CodeBoxesViewModel` دنبالِ `IsCodeLogin`
                         می‌گشت — که آن‌جا وجود ندارد. -->
                    <Panel IsVisible="{Binding IsCodeLogin}">
                      <StackPanel Name="CodeBoxRow" Orientation="Horizontal" Spacing="8"
                                  HorizontalAlignment="Center"
                                  FlowDirection="LeftToRight"
                                  DataContext="{Binding CodeBoxes}"
                                  x:DataType="vmr:CodeBoxesViewModel">
                        <TextBox Name="Code0" Classes="codebox" Text="{Binding B1, Mode=OneWay}" />
                        <TextBox Name="Code1" Classes="codebox" Text="{Binding B2, Mode=OneWay}" />
                        <TextBox Name="Code2" Classes="codebox" Text="{Binding B3, Mode=OneWay}" />
                        <TextBox Name="Code3" Classes="codebox" Text="{Binding B4, Mode=OneWay}" />
                        <TextBox Name="Code4" Classes="codebox" Text="{Binding B5, Mode=OneWay}" />
                        <TextBox Name="Code5" Classes="codebox" Text="{Binding B6, Mode=OneWay}" />
                      </StackPanel>
                    </Panel>

                    <!-- ایمیلِ پوشانده و حالِ تحویل — هر دو از خودِ سرور -->
                    <TextBlock Classes="dim" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"
                               IsVisible="{Binding IsCodeLogin}" Text="{Binding CodeMasked}"
                               FlowDirection="LeftToRight" />
                    <TextBlock Classes="dim" FontSize="12" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsCodeLogin}"
                               Text="{Binding CodeDelivery}" />

                    <!-- راهِ رمز همان کادرِ تک‌خطیِ همیشگی‌اش را دارد -->
                    <StackPanel IsVisible="{Binding !IsCodeLogin}">
                      <TextBlock Text="کدِ ایمیل" Classes="lbl" />
                      <TextBox Text="{Binding EmailCode}" MaxLength="6"
                               Watermark="شش رقم" FlowDirection="LeftToRight">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding VerifyEmailCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <Button Classes="go" Content="تایید و ساختنِ حساب" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding VerifyEmailCommand}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                      <!-- ⚠️ شمارشِ معکوسِ شصت ثانیه — عددش از خودِ سرور
                           می‌آید (`resend_after`)، نه از حدسِ ما. -->
                      <Button Classes="link" Content="کد نرسید؟ دوباره بفرست"
                              Command="{Binding ResendEmailCodeCommand}"
                              IsEnabled="{Binding CanResendCode}" />
                      <TextBlock Classes="dim" FontSize="12" VerticalAlignment="Center"
                                 IsVisible="{Binding !CanResendCode}"
                                 Text="{Binding CodeSeconds, StringFormat='{}{0} ثانیه'}" />
                      <Button Classes="link" Content="‹ برگشت به حساب"
                              Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ══════════ گامِ ۳: پمپ ══════════ -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepPump}">
                    <TextBlock Text="پمپِ خودتان" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,18"
                               Text="نام و لوکیشنِ پمپ را بنویسید و تمام. اشتراک روی همین حساب می‌نشیند، پس هیچ کدی لازم نیست." />

                    <!-- ⛔ کادرِ «کدِ شش‌رقمی — اگر دارید» در ۱۴۰۵/۰۷/۰۴ از
                         همین‌جا برداشته شد و برنمی‌گردد. خرج کردنِ کدِ
                         اشتراک همان‌جایی ماند که باید باشد — کارتِ
                         «اشتراک»ِ خودِ پروفایل (`SubCode` +
                         `RedeemSubCommand`). -->
                    <TextBlock Text="نامِ پمپ" Classes="lbl" />
                    <TextBox Text="{Binding LoginPump}" Watermark="مثلاً پمپ یعقوبی">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FinishPumpCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>

                    <!-- ⛔ **کادرِ «لوکیشنِ پمپ» برداشته شد و برنمی‌گردد.**
                         خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۱۰): «اون لوکیشن
                         رو حذف کن لازم نیست، یارو همین که اسمِ پمپشو بزنه
                         بسه.»

                         ⚠️ و به سرور هم هیچ‌وقت نمی‌رفت: `EnsureStationAsync`
                         فقط `{ name }` می‌فرستد. آن کادر یک خانهٔ دیگر بود
                         که کاربر نمی‌دانست باید پرش کند یا نه — و چون
                         گامِ پمپ تنها دیوارِ بینِ او و برنامه است، هر خانهٔ
                         اضافه همان‌جا هزینه دارد. -->

                    <Button Classes="go" Content="ساختنِ پمپ و پایان" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding FinishPumpCommand}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                      <Button Classes="link" Content="‹ برگشت به حساب"
                              Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="بعداً — بعد کد را می‌زنم"
                              Command="{Binding SkipPumpCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ⚠️ **حالتِ Loading دیدنی**: تا امروز فقط دکمه‌ها
                       خاکستری می‌شدند و کاربر نمی‌فهمید برنامه دارد کار
                       می‌کند یا گیر کرده. نوار نامعین است چون نمی‌دانیم
                       سرور چقدر طول می‌دهد. -->
                  <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                               Foreground="#6c5ce7" Background="Transparent"
                               IsVisible="{Binding Busy}" />

                  <!-- حالِ کار — پیامِ خودِ سرور، در یک کادرِ دیدنی -->
                  <Border Background="#f0f5ff" BorderBrush="#dbe5f7" BorderThickness="1"
                          CornerRadius="14" Padding="13,11" Margin="0,13,0,0"
                          IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" FontSize="12.5"
                               FontWeight="Bold" Foreground="#101935" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- ⚠️ «برگشت» — کسی که نمی‌خواهد حساب بسازد باید بتواند
                   برگردد سرِ دفترِ خودش (خواستهٔ ۱۴۰۵/۰۶/۲۹). زیرِ کارت،
                   روی خودِ آسمان. -->
              <Button Classes="linkw" Content="‹ برگشت به برنامه" HorizontalAlignment="Center"
                      Margin="0,16,0,0"
                      Command="{Binding CloseLoginCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>
          </ScrollViewer>

          <!-- ══════════════════════════════════════════════════════════
               📜 شرایط و ضوابط — یک صفحهٔ **جداگانه**، روی همه‌چیز
               ══════════════════════════════════════════════════════════
               خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۵): «شرایط و ضوابط هم
               دیده نمی‌شه و باید با زدنِ شرایط و ضوابط بره صفحهٔ جداگانه.»

               ⛔ **و هیچ منطقی برایش ساخته نشد**: همان `ShowTerms` و همان
                  `LoadTermsCommand`ِ همیشگی‌اند. تا دیروز `ShowTerms` یک
                  کادرِ کشوییِ ۱۶۰پیکسلی را باز می‌کرد که ته فرم گم می‌شد؛
                  حالا همین صفحه را باز می‌کند. فرمانِ دوم هم لازم نشد،
                  چون `LoadTermsAsync` خودش **دوحالته** است و همان دکمهٔ
                  برگشت می‌بنددش.
               ⚠️ تیکِ پذیرش این‌جا هم هست و همان `AcceptTerms` است: کسی
                  که تا ته متن آمده نباید برای زدنِ تیک برگردد. -->
          <Border IsVisible="{Binding ShowTerms}" Background="{StaticResource Login.Sky}">
            <Border Background="#F7FBFFFF" CornerRadius="30" Margin="26"
                    MaxWidth="820" BoxShadow="0 40 90 0 #66050a24">
              <Grid RowDefinitions="Auto,*,Auto" Margin="30,26">
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                  <TextBlock Text="شرایط و ضوابط" Classes="h1" />
                  <TextBlock Classes="dim" FontSize="12.5"
                             Text="همانی که سرور می‌خواهد بپذیرید — پیش از ساختنِ حساب." />
                </StackPanel>

                <Border Grid.Row="1" Background="#f0f5ff" BorderBrush="#dbe5f7" BorderThickness="1"
                        CornerRadius="16" Padding="18,16">
                  <ScrollViewer>
                    <SelectableTextBlock Text="{Binding TermsText}" FontSize="12.5"
                                         Foreground="#5a6a8c" TextWrapping="Wrap" LineHeight="22" />
                  </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14" Margin="0,18,0,0"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding AcceptTerms}" VerticalAlignment="Center"
                            Content="می‌پذیرم" />
                  <Button Classes="go" Content="بستن و برگشت" MinWidth="200"
                          HorizontalContentAlignment="Center"
                          Command="{Binding LoadTermsCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </Border>
        </Panel>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════════
           👤 خودِ پروفایل — همان مشخصات، با تمِ خودِ برنامه
           ══════════════════════════════════════════════════════════════════ -->
      <c:SectionPage Header="پروفایل" IsVisible="{Binding ShowProfilePage}">
      <StackPanel Spacing="14">

      <!-- ══ سرصفحه — آواتار، نام، نشان‌ها و کارها ═══════════════════════════
           پیش از این سه ستونِ هم‌وزن بود («آواتار | مشخصات | اشتراک») و هر سه
           از بالای صفحه شروع می‌شدند، پس هیچ‌کدام سرصفحه نبود و چشم نمی‌دانست
           از کجا شروع کند. حالا یک سرصفحهٔ پهن است و بقیه زیرش. -->
      <Border Classes="card" Padding="24,20">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <Border Grid.Column="0" Width="104" Height="104" CornerRadius="52"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Pump.Accent}"
                  BoxShadow="{DynamicResource Pump.CardShadow}">
            <TextBlock Text="{Binding Initial}" FontSize="46" FontWeight="Black" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" Margin="20,0" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding PumpName}" FontSize="26" FontWeight="Black"
                       TextAlignment="Start" TextWrapping="Wrap" />
            <TextBlock Text="{Binding UserLine}" Classes="muted" FontSize="13" TextAlignment="Start" />
            <TextBlock Text="{Binding AccountEmail}" FontSize="12.5" TextAlignment="Start"
                       Foreground="{DynamicResource Pump.Ink.Info}"
                       IsVisible="{Binding AccountEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <WrapPanel Margin="0,4,0,0">
              <Border Classes="pill" Padding="12,4" Margin="0,0,7,6"
                      Background="{Binding RoleBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                <TextBlock Text="{Binding RoleText}" FontSize="12" FontWeight="ExtraBold" />
              </Border>
              <Border Classes="pill" Padding="12,4" Margin="0,0,7,6"
                      Background="#FFD700" IsVisible="{Binding VipActive}">
                <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="Black" Foreground="#1a1a1a" />
              </Border>
            </WrapPanel>

            <!-- ⚠️ «وارد شده‌اید» از روی فایلِ روی دیسک گفته نمی‌شود — این
                 همان جمله‌ای است که خودِ پاسخِ سرورِ حساب ساخته. -->
            <TextBlock Text="{Binding AccountStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Start"
                       IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding StationLine}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Start"
                       IsVisible="{Binding StationLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <!-- ⚠️ راهِ برگشت به صفحهٔ ورود. ⛔ هیچ دکمهٔ سرویسِ بیرونی‌ای این‌جا
               نیست: «هیچ پکنه‌ای نباشد، نه از گوگل و نه غیره.» -->
          <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center" MinWidth="196">
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    MinHeight="40" Content="حساب و ورود" Command="{Binding OpenAccountPageCommand}"
                    IsEnabled="{Binding !Busy}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="🔄 گرفتنِ دوبارهٔ اطلاعات" Command="{Binding PullHomeCommand}"
                    IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="خروج از حساب" Command="{Binding SignOutCommand}"
                    IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══ ⛔ وارد شده، هنوز وصل نشده — فقط یک خطِ حال، بی کارت و بی دکمه ══════
           صاحب ریپو (۱۴۰۵/۰۷/۱۳): «این ثبتِ همین کامپیوتر و ساختِ حساب چیه… همین که
           یارو حسابِ کاربری برای خودش درست کرد تموم حساب درست شده.» ساختنِ پمپ و
           وصل کردنِ همین کامپیوتر خودکارند (`EnsureReadyAsync`)؛ این خط فقط می‌گوید
           کجای کار است — و اگر نشد، چرا. -->
      <Border Classes="card" Padding="18,12" IsVisible="{Binding LinkingNow}">
        <TextBlock Text="{Binding LinkingLine}" TextWrapping="Wrap" Classes="muted" />
      </Border>

      <!-- ══ چهار عددِ سرِ دست ═══════════════════════════════════════════════
           آن‌چه صاحبِ پمپ بیشتر از همه نگاهش می‌کند، بی باز کردنِ هیچ کارتی. -->
      <Grid ColumnDefinitions="*,12,*,12,*,12,*">
        <Border Grid.Column="0" Classes="stat" Padding="16,13">
          <StackPanel Spacing="3">
            <TextBlock Text="💎 پلنِ اشتراک" Classes="label" />
            <TextBlock Text="{Binding SubPlanText}" Classes="num" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="stat" Padding="16,13">
          <StackPanel Spacing="3">
            <TextBlock Text="⏳ ماندهٔ اشتراک" Classes="label" />
            <TextBlock Text="{Binding SubDaysText}" Classes="num"
                       Foreground="{DynamicResource Pump.Ink.Ok}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="stat" Padding="16,13">
          <StackPanel Spacing="3">
            <TextBlock Text="🖥️ سرورِ حساب" Classes="label" />
            <TextBlock Text="{Binding CloudLine}" Classes="num2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="6" Classes="stat" Padding="16,13">
          <StackPanel Spacing="3">
            <TextBlock Text="📦 نسخهٔ برنامه" Classes="label" />
            <TextBlock Text="{Binding AppVersionLine}" Classes="num2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══ دو ستون: مشخصاتِ پمپ  |  اشتراک و دسترسی‌ها ═════════════════════ -->
      <Grid ColumnDefinitions="*,14,380">

        <StackPanel Grid.Column="0" Spacing="14">

          <!-- مشخصاتِ پمپ -->
          <Border Classes="card" Padding="22,18">
            <StackPanel Spacing="4">
              <TextBlock Text="🏷️ مشخصاتِ پمپ" Classes="ptitle" Margin="0,0,0,8" />

              <Border Classes="kvrow">
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="نامِ پمپ" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding PumpName}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="کدِ پمپ روی سرورِ حساب" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding PumpCodeLine}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="تلفن" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding PumpPhone}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="نشانی" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding PumpAddress}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="سرورِ خانگی" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding HomeLine}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow" BorderThickness="0">
                <Grid ColumnDefinitions="150,*">
                  <TextBlock Grid.Column="0" Text="سرورِ حساب" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding CloudLine}" Classes="kvv" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- کدِ اپِ کارمندان — همان چیزی که هر کارمند در گوشی می‌زند -->
          <Border Classes="card" Padding="22,18">
            <StackPanel Spacing="12">
              <TextBlock Text="📲 کدِ پمپ برای اپِ کارمندان" Classes="ptitle" />

              <Border Classes="stat" Padding="20,14" HorizontalAlignment="Left"
                      MinWidth="250" IsVisible="{Binding HasAccessCode}">
                <SelectableTextBlock Text="{Binding AccessCodeDisplay}" FontSize="32" FontWeight="Black"
                                     FontFamily="Consolas,Menlo,monospace" LetterSpacing="5"
                                     Foreground="{DynamicResource Pump.Ink.Accent}" FlowDirection="LeftToRight" />
              </Border>

              <WrapPanel>
                <Button Classes="accent" Content="📋 کپی" Margin="0,0,7,7"
                        Command="{Binding CopyAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="📲 کیو‌آر" Margin="0,0,7,7" Command="{Binding ShowAccessQrCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="🔄 گرفتنِ کد" Margin="0,0,7,7"
                        Command="{Binding LoadAccessCodeCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="♻️ عوض کردن" Margin="0,0,7,7"
                        Command="{Binding RotateAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}"
                        ToolTip.Tip="کدِ قبلی همان لحظه از کار می‌افتد" />
              </WrapPanel>

              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="هر کسی اپِ اندروید یا آیفون را نصب می‌کند این کد را می‌زند و فقط حساب‌های همین پمپ را می‌بیند؛ بعدش رمزِ همین برنامه را هم می‌خواهد." />
              <TextBlock Text="{Binding AccessStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding AccessStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- ⚠️ جابه‌جاییِ پمپ: برنامه از قبل می‌گفت «این دستگاه را از پمپِ
                   فعلی جدا کنید» ولی هیچ دکمه‌ای برایش نبود. ⛔ دفتر دست نمی‌خورد،
                   و پیش از انجام پرسیده می‌شود. -->
              <Border Height="1" Background="{DynamicResource Pump.Border}" IsVisible="{Binding PumpBound}" />
              <StackPanel Spacing="6" IsVisible="{Binding PumpBound}">
                <Button HorizontalAlignment="Left" Content="🔓 جدا کردنِ این دستگاه از این پمپ"
                        Command="{Binding ForgetPumpCommand}" IsEnabled="{Binding !Busy}"
                        ToolTip.Tip="برای بردنِ این کامپیوتر به پمپِ دیگر" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="اشتراک و کدِ اپِ کارمندان و نشانیِ سرورِ این پمپ برداشته می‌شوند؛ دفتر و حساب‌ها دست نمی‌خورند." />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ══ اشتراک ══ -->
        <Border Grid.Column="2" Classes="card" Padding="22,18" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="💎 اشتراک" Classes="ptitle" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="pill" Padding="10,3" Background="#FFD700"
                      IsVisible="{Binding VipActive}" VerticalAlignment="Center">
                <TextBlock Text="فعال" FontSize="11" FontWeight="Black" Foreground="#1a1a1a" />
              </Border>
            </Grid>

            <!-- ماندهٔ اشتراک، درشت -->
            <Border Classes="stat" Padding="18,14">
              <StackPanel Spacing="2">
                <TextBlock Text="ماندهٔ اشتراک" Classes="label" />
                <TextBlock Text="{Binding SubDaysText}" FontSize="28" FontWeight="Black"
                           Foreground="{DynamicResource Pump.Ink.Ok}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="4">
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="90,*">
                  <TextBlock Grid.Column="0" Text="پلن" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding SubPlanText}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="90,*">
                  <TextBlock Grid.Column="0" Text="پایان" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding SubEndsText}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow" BorderThickness="0">
                <Grid ColumnDefinitions="90,*">
                  <TextBlock Grid.Column="0" Text="وضعیت" Classes="kvl" />
                  <TextBlock Grid.Column="1" Text="{Binding SubSourceText}" Classes="kvv" />
                </Grid>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding GraceText}" FontSize="12" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Warn}"
                       IsVisible="{Binding GraceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Height="1" Background="{DynamicResource Pump.Border}" />

            <!-- ⛔ کدِ اشتراک همین‌جاست و برنمی‌گردد به گامِ ورود: کسی که کد
                 دارد بعد از ورود این‌جا می‌زندش، و کسی که ندارد کادری
                 نمی‌بیند که دنبالش بگردد. -->
            <TextBlock Text="کدِ اشتراک (شش رقم)" Classes="kvl" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Grid.Column="0" Text="{Binding SubCode}" MaxLength="6" Watermark="۱۲۳۴۵۶"
                       TextAlignment="Center" FontSize="16" MinHeight="40" />
              <Button Grid.Column="1" Classes="accent" Content="فعال کن" Margin="7,0,0,0" MinHeight="40"
                      Command="{Binding RedeemSubCommand}" IsEnabled="{Binding !Busy}" />
              <Button Grid.Column="2" Content="🔄" Margin="6,0,0,0" MinHeight="40"
                      Command="{Binding RefreshSubCommand}" IsEnabled="{Binding !Busy}"
                      ToolTip.Tip="تازه‌سازی از سرور" />
            </Grid>
            <TextBlock Text="{Binding SubMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding SubMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- ══ چه چیزی در اشتراکِ من است ══════════════════════════════
                 سه کارِ ابری با اشتراک‌اند و پشتیبانی همیشه باز. دفترِ خودش
                 هیچ‌وقت قفل نمی‌شود، پس این‌جا هم اسمی از آن نیست. -->
            <Border Height="1" Background="{DynamicResource Pump.Border}" />
            <TextBlock Text="دسترسی‌ها" Classes="ptitle" FontSize="15" />
            <StackPanel Spacing="4">
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="اپِ کارمندان و ربات" Classes="kvv" />
                  <TextBlock Grid.Column="1" Text="{Binding AccessKarText}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="کیو‌آرِ حسابِ مشتری" Classes="kvv" />
                  <TextBlock Grid.Column="1" Text="{Binding AccessQrText}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="بک‌اپِ خودکار روی سرور" Classes="kvv" />
                  <TextBlock Grid.Column="1" Text="{Binding AccessBackupText}" Classes="kvv" />
                </Grid>
              </Border>
              <Border Classes="kvrow" BorderThickness="0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="چتِ پشتیبانی" Classes="kvv" />
                  <TextBlock Grid.Column="1" Text="{Binding AccessSupportText}" Classes="kvv"
                             Foreground="{DynamicResource Pump.Ink.Ok}" />
                </Grid>
              </Border>
            </StackPanel>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="دفترِ شما روی همین کامپیوتر می‌ماند و با تمام شدنِ اشتراک هم سرِ جایش است — قرض‌داران، ورق، مخزن، گاوصندوق، چاپ و بک‌اپِ محلی. فقط سه کارِ ابریِ بالا بسته می‌شوند." />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══ تب‌ها: کارمندان · تاریخچه · پشتیبان‌ها  |  فایل‌های پشتیبان ══ -->
      <Grid ColumnDefinitions="*,14,380" Height="380">
        <Border Grid.Column="0" Classes="card" Padding="22,18">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,14">
              <Button Classes="seg" Classes.active="{Binding TabStaff}" Content="کارمندان"
                      Command="{Binding SetTabCommand}" CommandParameter="staff" />
              <Button Classes="seg" Classes.active="{Binding TabHistory}" Content="تاریخچهٔ بخش‌ها"
                      Command="{Binding SetTabCommand}" CommandParameter="history" />
              <Button Classes="seg" Classes.active="{Binding TabBackups}" Content="پشتیبان‌ها"
                      Command="{Binding SetTabCommand}" CommandParameter="backups" />
            </StackPanel>
            <ScrollViewer>
              <StackPanel>
                <TextBlock Text="ردیفی نیست." Classes="muted" IsVisible="{Binding !Rows.Count}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileRow">
                      <Border Classes="prow" Background="{DynamicResource Pump.Input}"
                              BorderBrush="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                        <Grid ColumnDefinitions="2*,1.4*,1.4*,2*">
                          <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="عنوان" Classes="kvl" FontSize="11" />
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding L1}" Classes="kvl" FontSize="11" />
                            <TextBlock Text="{Binding V1}" FontWeight="SemiBold"
                                       Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding L2}" Classes="kvl" FontSize="11" />
                            <TextBlock Text="{Binding V2}" FontWeight="SemiBold" />
                          </StackPanel>
                          <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding HasNote}">
                            <TextBlock Text="یادداشت" Classes="kvl" FontSize="11" />
                            <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- ══ فایل‌ها: پشتیبان‌ها ══ -->
        <Border Grid.Column="2" Classes="card" Padding="22,18">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock Text="🗄️ فایل‌های پشتیبان" Classes="ptitle" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="pill-btn support" Content="باز کردنِ پوشه" FontSize="12" Padding="12,4"
                      Command="{Binding OpenBackupsCommand}" />
            </Grid>
            <ScrollViewer>
              <StackPanel>
                <TextBlock Text="هنوز پشتیبانی گرفته نشده — هر روز سرِ ورود خودکار گرفته می‌شود." Classes="muted" FontSize="12"
                           TextWrapping="Wrap" IsVisible="{Binding !Backups.Count}" />
                <ItemsControl ItemsSource="{Binding Backups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileRow">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="🗄️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                          <TextBlock Text="{Binding V2}" Classes="muted" FontSize="11.5" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding V1}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      </StackPanel>
      </c:SectionPage>
  </Panel>
</UserControl>
