<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.AccountSectionView"
             x:DataType="vm:AccountSectionViewModel">

  <!-- ══ پروفایل — و صفحهٔ ورودی که اولویت دارد ═══════════════════════════════
       دو صفحه داخلِ یک ‎Panel‎ روی هم‌اند و هر لحظه فقط یکی دیده می‌شود:
         `ShowLoginPage`   ⇒ صفحهٔ ورود، تمامِ صفحه (کسی که حساب ندارد)
         `ShowProfilePage` ⇒ خودِ پروفایل، با همان مشخصات
       ⛔ رنگ‌بندیِ عکسِ مرجع **فقط** در صفحهٔ ورود است، نه جای دیگر — خواستهٔ
       صریحِ صاحب ریپو: «رنگ را گفتم فقط توی صفحهٔ لاگینِ حساب باشد.»
       ⛔ و هیچ دکمهٔ گوگل یا هر سرویسِ دیگری در هیچ‌کدام نیست.

       ══ پروفایل — به شکلِ «پروفایلِ بیمار»ِ مرجع ══════════════════════════════
       خواستهٔ صاحب ریپو با عکس: «باید شبیهِ این عکس باشد، نه این که توی تنظیمات
       برود.» سه ستون: آواتار · مشخصاتِ پمپ · اشتراک؛ زیرش تب‌ها با ردیف‌های
       رنگی و ستونِ فایل‌ها (پشتیبان‌ها) و کدِ اپِ کارمندان.
       ⛔ هیچ کادرِ نشانی و رمزی این‌جا نیست و نباید بیاید. -->
  <UserControl.Resources>
    <!-- گرادیانِ همان قالب: #ff7a59 → #e8458b → #7b3fe4 (فقط صفحهٔ ورود) -->
    <LinearGradientBrush x:Key="Login.Grad" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#ff7a59" />
      <GradientStop Offset="0.5" Color="#e8458b" />
      <GradientStop Offset="1" Color="#7b3fe4" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.kvl">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.kvv">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prow">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BorderThickness" Value="0,0,5,0" />
    </Style>
    <Style Selector="Border.ptitle">
      <Setter Property="Padding" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.ptitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ══ رنگ‌بندی و کادرهای **صفحهٔ ورود** ══════════════════════════════
         خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۶/۲۸، با عکسِ مرجعِ لاگین و یک قالبِ
         ایمیل): «همین مدل باشد و این آدمک‌ها هم باشند… و من رنگ‌های همان
         سایت را گفتم بگیر، نه که شبیه آن بسازی… و رنگ را گفتم فقط توی صفحهٔ
         لاگینِ حساب باشد، نه جای دیگر.»

         پس دقیقاً همان رنگ‌های آن قالب، و **فقط** زیرِ `Border.loginpage`:
           بوم        #f6e3d8
           گرادیان    #ff7a59 → #e8458b → #7b3fe4
           نوشتهٔ تیره #2b1640   متن #4a3b52   کم‌رنگ #7a6a82
           تینت‌ها     #ffe9e1 · #fde4f0 · #ece3fc
           لینک       #c2185b
           کارتِ سفید  گوشهٔ ۲۸ با سایهٔ 0 20 50 0 #2E7B3FE4
           دکمهٔ اصلی  #2b1640 با گوشهٔ ۴۰
         ⛔ هیچ‌کدامِ این رنگ‌ها بیرونِ این صفحه به کار نمی‌رود و دو تمِ
         برنامه (آبی و طلایی) دست نمی‌خورند.
         ⚠️ ترتیبِ سبک‌ها مهم است: در آوالونیا سبکِ **بعدی** برنده است، نه
         خاص‌تر — پس اول نوشتهٔ عمومی و بعد کلاس‌ها. -->
    <Style Selector="Border.loginpage TextBlock">
      <Setter Property="Foreground" Value="#4a3b52" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.dim">
      <Setter Property="Foreground" Value="#7a6a82" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.lbl">
      <Setter Property="Foreground" Value="#7a6a82" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.h1">
      <Setter Property="Foreground" Value="#2b1640" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Black" />
    </Style>

    <!-- ══ کادرها: خط‌دار و بی‌قاب، مثلِ خودِ عکسِ مرجع ══════════════════
         «اون مربعی نبود و کادرهای لاگینش خیلی بهتر بود» — کادرهای عکس فقط
         یک خطِ زیرین دارند. ⚠️ رنگ باید روی **قالبِ** `TextBox` بنشیند
         (`PART_BorderElement`)، وگرنه در تمِ تیره کادر سیاه می‌ماند. -->
    <Style Selector="Border.loginpage TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="2,8" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="Foreground" Value="#2b1640" />
      <Setter Property="CaretBrush" Value="#7b3fe4" />
    </Style>
    <Style Selector="Border.loginpage TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#e0d3e6" />
      <Setter Property="BorderThickness" Value="0,0,0,1.6" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.loginpage TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#e8458b" />
    </Style>
    <Style Selector="Border.loginpage TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#7b3fe4" />
    </Style>
    <Style Selector="Border.loginpage TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#a99bb0" />
    </Style>

    <!-- ══ دکمه‌ها ══════════════════════════════════════════════════════ -->
    <!-- ⚠️ تیکِ شرایط و ضوابط: قالبِ خودِ آوالونیا در تمِ تیره کادرش را
         سیاه می‌کند و روی کارتِ سفیدِ این صفحه **گم** می‌شود (با عکس دیده
         شد). پس همان‌جا سفیدِ خط‌دار می‌شود، مثلِ بقیهٔ کادرهای این صفحه. -->
    <Style Selector="Border.loginpage CheckBox /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#ffffff" />
      <Setter Property="BorderBrush" Value="#b9a6bd" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.loginpage CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#2b1640" />
      <Setter Property="BorderBrush" Value="#2b1640" />
    </Style>
    <Style Selector="Border.loginpage CheckBox /template/ Path#CheckGlyph">
      <Setter Property="Stroke" Value="#ffffff" />
      <Setter Property="Fill" Value="#ffffff" />
    </Style>

    <Style Selector="Border.loginpage Button.go">
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="40" />
    </Style>
    <Style Selector="Border.loginpage Button.go /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2b1640" />
      <Setter Property="CornerRadius" Value="40" />
    </Style>
    <Style Selector="Border.loginpage Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#41215f" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Border.loginpage Button.link">
      <Setter Property="Foreground" Value="#c2185b" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.loginpage Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.loginpage Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#e8458b" />
    </Style>
    <Style Selector="Border.loginpage Button.mode">
      <Setter Property="Foreground" Value="#7a6a82" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.loginpage Button.mode /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Border.loginpage Button.mode.active">
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.loginpage Button.mode.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Login.Grad}" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="#f6e3d8" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#7a6a82" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip.on">
      <Setter Property="Background" Value="{StaticResource Login.Grad}" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip.on TextBlock">
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
  </UserControl.Styles>

  <!-- ⚠️ صفحهٔ ورود **داخلِ** قالبِ بخش نیست و نباید باشد: خواستهٔ صریحِ صاحب
       ریپو (۱۴۰۵/۰۶/۲۹) «تمام صفحه منظورم فقط همین را نشان بده در صفحه، نه
       بخش‌ها باشند نه غیره». پس نه سربرگِ بخش، نه کارتِ بخش — و سربرگ و نوار و
       نوارِ بخش‌های خودِ پنجره هم با `IsPageOpen` پنهان می‌شوند
       (`MainViewModel.IsChromeVisible`، همان راهی که صفحهٔ حسابِ قرض‌دار می‌رود). -->
  <Panel>

      <!-- ══════════════════════════════════════════════════════════════════
           🪪 صفحهٔ ورود — تمامِ صفحه، به همان مدلِ عکسِ مرجع
           ══════════════════════════════════════════════════════════════════
           خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۶/۲۸): «وقتی پروفایل را کلیک می‌کنم
           این صفحهٔ لاگین اولویت باشد و تمامِ صفحه همین را نشان بدهد برای
           کسانی که حساب ندارند، و برای کسانی که دارند پروفایل همان مشخصات را
           نشان بدهد… همین مدل باشد و این آدمک‌ها هم باشند؛ اصلاً همین عکس
           باید باشد… هیچ پکنه‌ای نباشد، نه از گوگل و نه غیره.»

           پس: آدمک‌های همان عکس یک طرفِ کارت، فرمِ **خودِ برنامه** طرفِ دیگر،
           و هیچ دکمهٔ سرویسِ بیرونی‌ای در کار نیست. رنگ‌ها همان قالبی است که
           داد — و فقط همین‌جا.
           ⚠️ عکس فقط وقتی خوانده می‌شود که کاربر روی این صفحه بیاید. -->
      <Border Name="LoginPage" Classes="loginpage" Background="#f6e3d8" CornerRadius="0"
              IsVisible="{Binding ShowLoginPage}">
        <Grid>
          <!-- مربع‌های نرمِ پس‌زمینه — همان تزئینِ گوشه‌های عکسِ مرجع -->
          <Border Width="150" Height="150" CornerRadius="36" Background="#22e8458b"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,30,0,0" />
          <Border Width="110" Height="110" CornerRadius="28" Background="#1Aff7a59"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,34" />
          <Border Width="74" Height="74" CornerRadius="22" Background="#207b3fe4"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,60" />

          <!-- ══ کارتِ سفید — **تمامِ صفحه** ══
               خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۶/۲۹): «این لاگین تمام صفحه
               باشد و کلِ صفحه را بگیرد… این‌جوری کوچک نباشد.»
               ⚠️ پس اندازهٔ صریحِ قبلی (۹۸۰×۶۰۴) برداشته شد و کارت
               **کشیده** است. ستونِ فرم پهنای صریح دارد (`440`) و ستونِ
               عکس بقیه را می‌گیرد — بی این، قاب به اندازهٔ پهن‌ترین پنل
               جمع می‌شد و فرم تمامِ عکس را می‌پوشاند (یک بار همین شد). -->
          <Border Background="#ffffff" CornerRadius="28" Margin="18"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"
                  BoxShadow="0 20 50 0 #2E7B3FE4">
            <Grid ColumnDefinitions="*,440">

              <!-- ══ آدمک‌ها — برداری، با رنگ و تمِ خودِ برنامه ══
                   خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۶/۲۹، با عکس): «اون آدمک‌ها
                   رو باسازی کن و بک‌گراندشو درست کن و با رنگ و تمِ خودِ
                   برنامه باشه و همه‌چی با کیفیتِ خیلی بالا درست کن.»
                   ⛔ پس نه عکسِ JPEGی مانده و نه آن کادرِ سفیدِ داخلِ کادرِ
                   بنفش که دورش خط کشید: بومِ نقشه شفاف است و پس‌زمینه از
                   خودِ تم می‌آید (`Pump.Section`)، با دو هالهٔ نرمِ تاکید.
                   ⚠️ برداری است، پس در هر اندازه تیز است — سقفِ اندازه هم
                   لازم ندارد (شرحش بالای `Controls/LoginArt.axaml`). -->
              <Border Grid.Column="0" Background="{DynamicResource Pump.Section}" Margin="0">
                <Panel>
                  <!-- ⚠️ هالهٔ تاکید با آلفای کم — نه `IconBadge` که در تمِ
                       تیره یک لکهٔ روشنِ درشت می‌شد (با عکس دیده شد). -->
                  <Ellipse Width="300" Height="300" Fill="{DynamicResource Pump.Accent}"
                           Opacity="0.09" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="-70,-60,0,0" />
                  <Ellipse Width="220" Height="220" Fill="{DynamicResource Pump.Accent}"
                           Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,-50,-40" />
                  <!-- ⚠️ نقشه جا برای نفس کشیدن دارد: بی سقفِ پهنا، در کارتِ
                       کشیده لبه‌به‌لبه می‌شد و آدمک‌ها به کنارهٔ کارت
                       می‌چسبیدند. -->
                  <c:LoginArt Margin="46,40" MaxWidth="700" MaxHeight="660"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>

              <!-- ══ فرمِ خودِ برنامه ══ -->
              <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Padding="36,22">
                <StackPanel Spacing="10" VerticalAlignment="Center">

                  <!-- ⚠️ «برگشت» — کسی که نمی‌خواهد حساب بسازد باید بتواند
                       برگردد سرِ دفترِ خودش (خواستهٔ ۱۴۰۵/۰۶/۲۹). -->
                  <Button Classes="link" Content="‹ برگشت به برنامه" HorizontalAlignment="Right"
                          Command="{Binding CloseLoginCommand}" IsEnabled="{Binding !Busy}" />

                  <!-- نشانِ گام‌ها -->
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Border Classes="stepchip" Classes.on="{Binding StepAccount}">
                      <TextBlock Text="۱ حساب" />
                    </Border>
                    <Border Classes="stepchip" Classes.on="{Binding StepEmailCode}"
                            IsVisible="{Binding IsSignUp}">
                      <TextBlock Text="۲ کدِ ایمیل" />
                    </Border>
                    <Border Classes="stepchip" Classes.on="{Binding StepPump}">
                      <TextBlock Text="۳ پمپ" />
                    </Border>
                    <Border Classes="stepchip" Classes.on="{Binding StepDone}">
                      <TextBlock Text="۴ تمام" />
                    </Border>
                  </StackPanel>

                  <!-- ══════════ گامِ ۱: حساب ══════════ -->
                  <StackPanel Spacing="8" IsVisible="{Binding StepAccount}">
                    <TextBlock Text="سلام،" Classes="h1" />
                    <TextBlock Text="خوش آمدید" Classes="h1" Margin="0,-8,0,6" />

                    <!-- «حساب داری یا نه؟» — دو راهِ جدا و دیدنی -->
                    <Border CornerRadius="999" Background="#f6e3d8" Padding="4" HorizontalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="mode" Classes.active="{Binding IsSignUp}" Content="حساب می‌سازم"
                                Command="{Binding SetSignUpCommand}" CommandParameter="yes" />
                        <Button Classes="mode" Classes.active="{Binding IsSignIn}" Content="حساب دارم"
                                Command="{Binding SetSignUpCommand}" CommandParameter="no" />
                      </StackPanel>
                    </Border>

                    <!-- ⚠️ نوشتهٔ راهنما **داخلِ خودِ کادر** است، مثلِ عکسِ
                         مرجع — نه برچسبِ جدا. -->
                    <!-- ⚠️ **Enter هم فرم را می‌فرستد** (بندِ ۲ی صاحب ریپو:
                         «امکانِ ارسالِ فرم با Enter»). روی خودِ کادرها
                         می‌نشیند، نه روی صفحه، وگرنه Enter در هر جای دیگری
                         هم دکمه را می‌زد. -->
                    <TextBox Text="{Binding LoginName}" Watermark="نامِ شما" IsVisible="{Binding IsSignUp}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox Text="{Binding LoginEmail}" Watermark="ایمیل" FlowDirection="LeftToRight">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox Text="{Binding LoginPassword}" PasswordChar="{Binding PassChar}"
                             Watermark="رمز — دستِ‌کم هشت نویسه">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox Text="{Binding LoginPassword2}" PasswordChar="{Binding PassChar}" Watermark="تکرارِ رمز"
                             IsVisible="{Binding IsSignUp}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>

                    <!-- «چشم» و «رمزم را فراموش کرده‌ام» — هر دو خواستهٔ
                         بندهای ۲ و ۹ی صاحب ریپو. -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                      <Button Classes="link" Content="{Binding RevealPassText}"
                              Command="{Binding ToggleRevealPassCommand}" />
                      <Button Classes="link" Content="رمزم را فراموش کرده‌ام" IsVisible="{Binding IsSignIn}"
                              Command="{Binding OpenForgotCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <!-- ⚠️ پذیرشِ شرایط **اجباریِ خودِ سرور** است
                         (`terms_required`)، پس واقعاً پرسیده می‌شود و متنش
                         هم از سرور می‌آید — نه یک تیکِ تشریفاتی. -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsSignUp}" Margin="0,6,0,0">
                      <CheckBox IsChecked="{Binding AcceptTerms}" Content="شرایط و ضوابط را می‌پذیرم"
                                Foreground="#2b1640" FontSize="13" HorizontalAlignment="Center" />
                      <Button Classes="link" Content="متنِ شرایط و ضوابط" HorizontalAlignment="Center"
                              Command="{Binding LoadTermsCommand}" />
                      <Border Background="#fbf6f3" CornerRadius="12" Padding="10" MaxHeight="150"
                              IsVisible="{Binding ShowTerms}">
                        <ScrollViewer>
                          <SelectableTextBlock Text="{Binding TermsText}" FontSize="11.5"
                                               Foreground="#4a3b52" TextWrapping="Wrap" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>

                    <Button Classes="go" Content="{Binding AccountButtonText}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding AccountStepCommand}" IsEnabled="{Binding !Busy}" />

                    <Button Classes="link" Content="بعداً — فعلاً بی حساب ادامه می‌دهم"
                            HorizontalAlignment="Center"
                            Command="{Binding SkipAccountCommand}" IsEnabled="{Binding !Busy}" />
                  </StackPanel>

                  <!-- ══════════ گامِ ۰: رمزم را فراموش کرده‌ام ══════════
                       بندِ ۹ی صاحب ریپو. ⚠️ این راه روی سرور از قبل بود
                       (`/api/auth/password/forgot` و `/password/reset`) و
                       فقط برنامهٔ نیتیو هیچ‌وقت صدایش نزده بود — پس کسی که
                       رمزش را گم می‌کرد هیچ راهی جز ساختنِ حسابِ تازه
                       نداشت. -->
                  <StackPanel Spacing="9" IsVisible="{Binding StepForgot}">
                    <TextBlock Text="رمزِ تازه" Classes="h1" FontSize="26" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                               Text="ایمیلتان را بنویسید تا یک کدِ شش‌رقمی برایش بفرستیم، بعد رمزِ تازه را بگذارید." />

                    <TextBox Text="{Binding LoginEmail}" Watermark="ایمیل" FlowDirection="LeftToRight"
                             Margin="0,6,0,0">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendResetCodeCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Classes="go" Content="فرستادنِ کد به ایمیل" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding SendResetCodeCommand}" IsEnabled="{Binding !Busy}" />

                    <!-- تا کد نرفته، نیمهٔ دوم دیده نمی‌شود -->
                    <StackPanel Spacing="9" IsVisible="{Binding ResetSent}" Margin="0,8,0,0">
                      <TextBox Text="{Binding ResetCode}" MaxLength="6" Watermark="کدِ ایمیل — شش رقم"
                               FlowDirection="LeftToRight" />
                      <TextBox Text="{Binding ResetPass}" PasswordChar="{Binding PassChar}"
                               Watermark="رمزِ تازه — دستِ‌کم هشت نویسه" />
                      <TextBox Text="{Binding ResetPass2}" PasswordChar="{Binding PassChar}"
                               Watermark="تکرارِ رمزِ تازه">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding ResetPasswordCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button Classes="go" Content="گذاشتنِ رمزِ تازه و ورود"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="کد نرسید؟ دوباره بفرست" HorizontalAlignment="Center"
                              Command="{Binding SendResetCodeCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <Button Classes="link" Content="‹ برگشت به ورود" HorizontalAlignment="Center"
                            Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                  </StackPanel>

                  <!-- ══════════ گامِ ۲: کدِ ایمیل ══════════
                       گزارشِ صاحب ریپو (۱۴۰۵/۰۶/۲۹): «می‌خواهم با ایمیل خودم
                       حسابی بسازم، نمی‌شود.» ریشه: سرور حسابِ بی تأییدِ
                       ایمیل نمی‌سازد. پس این گام آمد — و ⚠️ این کد **کدِ
                       ایمیل** است، نه کدِ اشتراک. -->
                  <StackPanel Spacing="9" IsVisible="{Binding StepEmailCode}">
                    <TextBlock Text="کدِ ایمیل" Classes="h1" FontSize="26" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                               Text="یک کدِ شش‌رقمی به ایمیلتان فرستادیم. همان را این‌جا بزنید تا حساب ساخته شود. (این با کدِ اشتراک فرق دارد.)" />

                    <TextBox Text="{Binding EmailCode}" MaxLength="6" Margin="0,6,0,0"
                             Watermark="کدِ ایمیل — شش رقم" FlowDirection="LeftToRight">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding VerifyEmailCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>

                    <Button Classes="go" Content="تایید و ساختنِ حساب" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding VerifyEmailCommand}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                      <Button Classes="link" Content="کد نرسید؟ دوباره بفرست"
                              Command="{Binding ResendEmailCodeCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="‹ برگشت به حساب"
                              Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ══════════ گامِ ۳: پمپ ══════════ -->
                  <StackPanel Spacing="8" IsVisible="{Binding StepPump}">
                    <TextBlock Text="پمپِ خودتان" Classes="h1" FontSize="26" />
                    <TextBlock Text="کدِ شش‌رقمی را بزنید تا سرور تاییدش کند، و نام و لوکیشنِ پمپ را بنویسید."
                               Classes="dim" FontSize="12.5" TextWrapping="Wrap" />

                    <TextBox Text="{Binding LoginCode}" MaxLength="6" Margin="0,6,0,0"
                             Watermark="کدِ شش‌رقمی">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding VerifyCodeCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox Text="{Binding LoginPump}" Watermark="نامِ پمپ">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding VerifyCodeCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox Text="{Binding LoginLocation}" Watermark="لوکیشنِ پمپ">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding VerifyCodeCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>

                    <Button Classes="go" Content="تایید از سرور و پایان" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding VerifyCodeCommand}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                      <Button Classes="link" Content="‹ برگشت به حساب"
                              Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="بعداً — بعد کد را می‌زنم"
                              Command="{Binding SkipPumpCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ⚠️ **حالتِ Loading دیدنی** (بندِ ۲ی صاحب ریپو): تا امروز
                       فقط دکمه‌ها خاکستری می‌شدند و کاربر نمی‌فهمید برنامه
                       دارد کار می‌کند یا گیر کرده. نوار نامعین است چون
                       نمی‌دانیم سرور چقدر طول می‌دهد. -->
                  <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0"
                               Foreground="#c2185b" Background="Transparent"
                               IsVisible="{Binding Busy}" />

                  <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Bold"
                             Foreground="#c2185b"
                             IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════════
           👤 خودِ پروفایل — همان مشخصات، با تمِ خودِ برنامه
           ══════════════════════════════════════════════════════════════════ -->
      <c:SectionPage Header="پروفایل" IsVisible="{Binding ShowProfilePage}">
      <Grid ColumnDefinitions="300,*,330" RowDefinitions="Auto,*">

      <!-- ══ آواتار ══ -->
      <Border Grid.Row="0" Grid.Column="0" Classes="panel" Padding="22" Margin="0,0,14,14">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Width="110" Height="110" CornerRadius="55" Background="{DynamicResource Pump.Accent}"
                  BoxShadow="{DynamicResource Pump.CardShadow}">
            <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Black" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding PumpName}" FontSize="20" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UserLine}" Classes="muted" TextAlignment="Center" />
          <TextBlock Text="{Binding AccountEmail}" Classes="muted" FontSize="12.5" TextAlignment="Center"
                     Foreground="{DynamicResource Pump.Info}"
                     IsVisible="{Binding AccountEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Border Classes="pill" Padding="11,4"
                    Background="{Binding RoleBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
              <TextBlock Text="{Binding RoleText}" FontSize="12" FontWeight="ExtraBold" />
            </Border>
            <Border Classes="pill" Padding="11,4" Background="#FFD700" IsVisible="{Binding VipActive}">
              <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="Black" Foreground="#1a1a1a" />
            </Border>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource Pump.Border}" Margin="0,6" />
          <!-- ⚠️ راهِ برگشت به صفحهٔ ورود. ⛔ هیچ دکمهٔ سرویسِ بیرونی‌ای این‌جا
               نیست: «هیچ پکنه‌ای نباشد، نه از گوگل و نه غیره.» -->
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="حساب و ورود" Command="{Binding OpenAccountPageCommand}"
                  IsEnabled="{Binding !Busy}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="🔄 گرفتنِ دوبارهٔ اطلاعات" Command="{Binding PullHomeCommand}"
                  IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="خروج از حساب" Command="{Binding SignOutCommand}"
                  IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          <TextBlock Text="{Binding AccountStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding StationLine}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding StationLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- ══ مشخصاتِ پمپ ══ -->
      <Border Grid.Row="0" Grid.Column="1" Classes="panel" Padding="22" Margin="0,0,14,14">
        <StackPanel Spacing="12">
          <TextBlock Text="مشخصاتِ پمپ" Classes="ptitle" />
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="نامِ پمپ" Classes="kvl" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PumpName}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="کدِ پمپ روی ابر" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PumpCodeLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="تلفن" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PumpPhone}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="نشانی" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PumpAddress}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="سرورِ خانگی" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HomeLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="ابر" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CloudLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="نسخهٔ برنامه" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AppVersionLine}" Classes="kvv" Margin="0,8,0,0" />
          </Grid>

          <Border Height="1" Background="{DynamicResource Pump.Border}" />

          <!-- کدِ اپِ کارمندان — همان چیزی که هر کارمند در گوشی می‌زند -->
          <TextBlock Text="کدِ پمپ برای اپِ کارمندان" Classes="ptitle" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="stat" Padding="18,10" MinWidth="220" IsVisible="{Binding HasAccessCode}">
              <SelectableTextBlock Text="{Binding AccessCodeDisplay}" FontSize="30" FontWeight="Black"
                                   FontFamily="Consolas,Menlo,monospace" LetterSpacing="4"
                                   Foreground="{DynamicResource Pump.Accent}" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="accent" Content="📋 کپی" Command="{Binding CopyAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="📲 کیو‌آر" Command="{Binding ShowAccessQrCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="🔄 گرفتنِ کد" Command="{Binding LoadAccessCodeCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="♻️ عوض کردن" Command="{Binding RotateAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}"
                        ToolTip.Tip="کدِ قبلی همان لحظه از کار می‌افتد" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                         Text="هر کسی اپِ اندروید یا آیفون را نصب می‌کند این کد را می‌زند و فقط حساب‌های همین پمپ را می‌بیند؛ بعدش رمزِ همین برنامه را هم می‌خواهد." />
              <TextBlock Text="{Binding AccessStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding AccessStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ اشتراکِ VIP ══ -->
      <Border Grid.Row="0" Grid.Column="2" Classes="panel" Padding="22" Margin="0,0,0,14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="اشتراکِ VIP" Classes="ptitle" />
            <Border Classes="pill" Padding="9,2" Background="#FFD700" IsVisible="{Binding VipActive}" VerticalAlignment="Center">
              <TextBlock Text="فعال" FontSize="11" FontWeight="Black" Foreground="#1a1a1a" />
            </Border>
          </StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="پلن" Classes="kvl" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubPlanText}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="پایان" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubEndsText}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="مانده" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubDaysText}" Classes="kvv" Margin="0,8,0,0"
                       Foreground="{DynamicResource Pump.Ok}" FontSize="18" FontWeight="Black" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="وضعیت" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubSourceText}" Classes="kvv" Margin="0,8,0,0" />
          </Grid>
          <Border Height="1" Background="{DynamicResource Pump.Border}" />
          <TextBlock Text="کدِ اشتراک (شش رقم)" Classes="kvl" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding SubCode}" Width="130" MaxLength="6" Watermark="۱۲۳۴۵۶" />
            <Button Classes="accent" Content="فعال کن" Command="{Binding RedeemSubCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="🔄" Command="{Binding RefreshSubCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="تازه‌سازی از سرور" />
          </StackPanel>
          <TextBlock Text="{Binding SubMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding SubMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding GraceText}" FontSize="12" TextWrapping="Wrap" FontWeight="Bold"
                     Foreground="{DynamicResource Pump.Warn}"
                     IsVisible="{Binding GraceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- ══ چه چیزی در اشتراکِ من است ══════════════════════════════
               سه کارِ ابری با اشتراک‌اند و پشتیبانی همیشه باز. دفترِ خودش
               هیچ‌وقت قفل نمی‌شود، پس این‌جا هم اسمی از آن نیست. -->
          <Border Height="1" Background="{DynamicResource Pump.Border}" />
          <TextBlock Text="دسترسی‌ها" Classes="kvl" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="اپِ کارمندان و ربات" Classes="kvv" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccessKarText}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="کیو‌آرِ حسابِ مشتری" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccessQrText}" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="بک‌اپِ خودکار روی سرور" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessBackupText}" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="چتِ پشتیبانی" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessSupportText}" Classes="kvv" Margin="0,6,0,0"
                       Foreground="{DynamicResource Pump.Ok}" />
          </Grid>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="دفترِ شما روی همین کامپیوتر می‌ماند و با تمام شدنِ اشتراک هم سرِ جایش است — قرض‌داران، ورق، مخزن، گاوصندوق، چاپ و بک‌اپِ محلی. فقط سه کارِ ابریِ بالا بسته می‌شوند." />
        </StackPanel>
      </Border>

      <!-- ══ تب‌ها: کارمندان · تاریخچه · پشتیبان‌ها ══ -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="panel" Padding="22" Margin="0,0,14,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,14">
            <Button Classes="seg" Classes.active="{Binding TabStaff}" Content="کارمندان"
                    Command="{Binding SetTabCommand}" CommandParameter="staff" />
            <Button Classes="seg" Classes.active="{Binding TabHistory}" Content="تاریخچهٔ بخش‌ها"
                    Command="{Binding SetTabCommand}" CommandParameter="history" />
            <Button Classes="seg" Classes.active="{Binding TabBackups}" Content="پشتیبان‌ها"
                    Command="{Binding SetTabCommand}" CommandParameter="backups" />
          </StackPanel>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="ردیفی نیست." Classes="muted" IsVisible="{Binding !Rows.Count}" />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <Border Classes="prow" Background="{DynamicResource Pump.Input}"
                            BorderBrush="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                      <Grid ColumnDefinitions="2*,1.4*,1.4*,2*">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="عنوان" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding L1}" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding V1}" FontWeight="SemiBold"
                                     Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                          <TextBlock Text="{Binding L2}" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding V2}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding HasNote}">
                          <TextBlock Text="یادداشت" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ══ فایل‌ها: پشتیبان‌ها ══ -->
      <Border Grid.Row="1" Grid.Column="2" Classes="panel" Padding="22">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="فایل‌های پشتیبان" Classes="ptitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill-btn support" Content="باز کردنِ پوشه" FontSize="12" Padding="12,4"
                    Command="{Binding OpenBackupsCommand}" />
          </Grid>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="هنوز پشتیبانی گرفته نشده — هر روز سرِ ورود خودکار گرفته می‌شود." Classes="muted" FontSize="12"
                         TextWrapping="Wrap" IsVisible="{Binding !Backups.Count}" />
              <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="🗄️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Text="{Binding V2}" Classes="muted" FontSize="11.5" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding V1}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Grid>
      </c:SectionPage>
  </Panel>
</UserControl>
