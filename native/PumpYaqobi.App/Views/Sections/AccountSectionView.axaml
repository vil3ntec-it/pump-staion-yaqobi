<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:vmr="using:PumpYaqobi.App.ViewModels"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.AccountSectionView"
             x:DataType="vm:AccountSectionViewModel">

  <!-- ══ پروفایل — و صفحهٔ ورودی که اولویت دارد ═══════════════════════════════
       دو صفحه داخلِ یک ‎Panel‎ روی هم‌اند و هر لحظه فقط یکی دیده می‌شود:
         `ShowLoginPage`   ⇒ صفحهٔ ورود، تمامِ صفحه (کسی که حساب ندارد)
         `ShowProfilePage` ⇒ خودِ پروفایل، با همان مشخصات
       ⛔ رنگ‌بندیِ عکسِ مرجع **فقط** در صفحهٔ ورود است، نه جای دیگر — خواستهٔ
       صریحِ صاحب ریپو: «رنگ را گفتم فقط توی صفحهٔ لاگینِ حساب باشد.»
       ⛔ و هیچ دکمهٔ گوگل یا هر سرویسِ دیگری در هیچ‌کدام نیست.

       ══ پروفایل — به شکلِ «پروفایلِ بیمار»ِ مرجع ══════════════════════════════
       خواستهٔ صاحب ریپو با عکس: «باید شبیهِ این عکس باشد، نه این که توی تنظیمات
       برود.» سه ستون: آواتار · مشخصاتِ پمپ · اشتراک؛ زیرش تب‌ها با ردیف‌های
       رنگی و ستونِ فایل‌ها (پشتیبان‌ها) و کدِ اپِ کارمندان.
       ⛔ هیچ کادرِ نشانی و رمزی این‌جا نیست و نباید بیاید. -->
  <UserControl.Resources>
    <!-- ══ پالتِ صفحهٔ ورود ═══════════════════════════════════════════════
         خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۴، با عکسِ مرجع): «بخشِ لاگینِ
         برنامهٔ پمپ خیلی داغون و خراب است، اصلاً ریمیک کن ۱۰۰… همه کادرها و
         بخش‌هایش را بهتر و حرفه‌ای‌تر کن… شبیه این عکس باشد همه‌چی.»
         ⛔ فقط زیرِ `Border.loginpage` — دو تمِ برنامه (آبی و طلایی) دست
         نمی‌خورند و هیچ‌کدامِ این رنگ‌ها جای دیگری نمی‌رود. -->
    <LinearGradientBrush x:Key="Login.Grad" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#1746c9" />
      <GradientStop Offset="0.55" Color="#2a6ae8" />
      <GradientStop Offset="1" Color="#4b93f7" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.kvl">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.kvv">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prow">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BorderThickness" Value="0,0,5,0" />
    </Style>
    <Style Selector="Border.ptitle">
      <Setter Property="Padding" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.ptitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ══ رنگ‌بندی و کادرهای **صفحهٔ ورود** ══════════════════════════════
         گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۰۴، با عکسِ مرجع): «بخشِ لاگینِ برنامهٔ پمپ
         خیلی داغون و خراب است، اصلاً ریمیک کن ۱۰۰ و همهٔ کادرها و بخش‌هایش
         را بهتر و حرفه‌ای‌تر کن… ظاهری خیلی داغون است… شبیه این عکس باشد
         همه‌چی.»

         پس پالتِ قالبِ نارنجی/بنفشِ قبلی کاملاً کنار رفت و جایش پالتِ آبیِ
         همان عکس نشست — و **فقط** زیرِ `Border.loginpage`:
           بومِ صفحه  #eaf4fe            کارتِ سفید  #ffffff، گوشهٔ ۲۸
           گرادیان    #1746c9 → #2a6ae8 → #4b93f7
           نوشتهٔ تیره #16233d   متن #3f4d68   کم‌رنگ #7b879e
           کادرِ تایپ  #eef4fc با خطِ #dce6f5، گوشهٔ ۱۰
           دکمهٔ اصلی و لینک  #1746c9، گوشهٔ ۱۰
         ⛔ هیچ‌کدام بیرونِ این صفحه به کار نمی‌رود و دو تمِ برنامه (آبی و
            طلایی) دست نمی‌خورند — آزمونِ `RangBandi_FaghatDarSafheyeVorud_Ast`.
         ⚠️ ترتیبِ سبک‌ها مهم است: در آوالونیا سبکِ **بعدی** برنده است، نه
            خاص‌تر — پس اول نوشتهٔ عمومی و بعد کلاس‌ها. -->
    <Style Selector="Border.loginpage TextBlock">
      <Setter Property="Foreground" Value="#3f4d68" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.dim">
      <Setter Property="Foreground" Value="#7b879e" />
    </Style>
    <!-- ⚠️ برچسبِ **بالای** هر کادر — همان چیزی که عکسِ مرجع دارد و این
         صفحه نداشت: کاربر تا داخلِ کادر نمی‌زد نمی‌دانست چه می‌خواهد، و با
         پر شدنِ کادر نوشتهٔ راهنما هم می‌رفت. -->
    <Style Selector="Border.loginpage TextBlock.lbl">
      <Setter Property="Foreground" Value="#16233d" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,0,0,5" />
    </Style>
    <Style Selector="Border.loginpage TextBlock.h1">
      <Setter Property="Foreground" Value="#16233d" />
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="Black" />
    </Style>
    <!-- نوشته‌های روی پنلِ آبی — سفید، جدا از نوشته‌های روی کارتِ سفید -->
    <Style Selector="Border.loginpage StackPanel.brand TextBlock">
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>

    <!-- ══ کادرها: پُر و گوشه‌گرد، مثلِ عکسِ مرجع ════════════════════════
         ⛔ کادرِ خط‌دارِ قبلی رفت: روی کارتِ سفید تقریباً دیده نمی‌شد و
            همان «داغون» بودنی بود که گزارش شد. حالا زمینهٔ آبیِ روشن دارد،
            پس مرزِ کادر بی هیچ تلاشی پیداست.
         ⚠️ رنگ باید روی **قالبِ** `TextBox` بنشیند (`PART_BorderElement`)،
            وگرنه در تمِ تیره کادر سیاه می‌ماند. -->
    <Style Selector="Border.loginpage TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#16233d" />
      <Setter Property="CaretBrush" Value="#1746c9" />
    </Style>
    <Style Selector="Border.loginpage TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#eef4fc" />
      <Setter Property="BorderBrush" Value="#dce6f5" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.loginpage TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#e7effb" />
      <Setter Property="BorderBrush" Value="#b9d0f4" />
    </Style>
    <Style Selector="Border.loginpage TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#ffffff" />
      <Setter Property="BorderBrush" Value="#2a6ae8" />
      <Setter Property="BorderThickness" Value="1.6" />
    </Style>
    <Style Selector="Border.loginpage TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#9aa7bd" />
    </Style>

    <!-- ══ دکمه‌ها ══════════════════════════════════════════════════════ -->
    <!-- ⚠️ تیکِ شرایط و ضوابط: قالبِ خودِ آوالونیا در تمِ تیره کادرش را
         سیاه می‌کند و روی کارتِ سفیدِ این صفحه **گم** می‌شود (با عکس دیده
         شد). پس همان‌جا رنگِ خودش را می‌گیرد. -->
    <Style Selector="Border.loginpage CheckBox /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#ffffff" />
      <Setter Property="BorderBrush" Value="#b9c6da" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.loginpage CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#1746c9" />
      <Setter Property="BorderBrush" Value="#1746c9" />
    </Style>
    <Style Selector="Border.loginpage CheckBox /template/ Path#CheckGlyph">
      <Setter Property="Stroke" Value="#ffffff" />
      <Setter Property="Fill" Value="#ffffff" />
    </Style>

    <Style Selector="Border.loginpage Button.go">
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.loginpage Button.go /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1746c9" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.loginpage Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2a6ae8" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Border.loginpage Button.link">
      <Setter Property="Foreground" Value="#1746c9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Border.loginpage Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.loginpage Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#4b93f7" />
    </Style>
    <!-- لینک‌های کفِ پنلِ آبی — سفیدِ کم‌رنگ، نه آبی روی آبی -->
    <Style Selector="Border.loginpage Button.linkw">
      <Setter Property="Foreground" Value="#d8e6ff" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Border.loginpage Button.linkw /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.loginpage Button.linkw:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#ffffff" />
    </Style>

    <!-- کپسولِ «حساب می‌سازم / حساب دارم / کدِ ایمیلی» -->
    <Style Selector="Border.loginpage Button.mode">
      <Setter Property="Foreground" Value="#5b6b85" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.loginpage Button.mode /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Border.loginpage Button.mode.active">
      <Setter Property="Foreground" Value="#ffffff" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.loginpage Button.mode.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1746c9" />
    </Style>
    <!-- ══ خانه‌های کد ═══════════════════════════════════════════════════
         شش کادرِ مربعیِ هم‌اندازه، عدد درشت و وسط — همان شکلی که کاربر در
         هر برنامهٔ دیگری دیده. ⚠️ `MaxLength` عمداً بلندتر از یک است تا
         چسباندنِ شش رقم در یک خانه هم کار کند؛ خودِ ویومدل پخششان می‌کند. -->
    <Style Selector="Border.loginpage TextBox.codebox">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="54" />
      <Setter Property="MaxLength" Value="12" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Background" Value="#eef4fc" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#7b879e" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip.on">
      <Setter Property="Background" Value="{StaticResource Login.Grad}" />
    </Style>
    <Style Selector="Border.loginpage Border.stepchip.on TextBlock">
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
  </UserControl.Styles>

  <!-- ⚠️ صفحهٔ ورود **داخلِ** قالبِ بخش نیست و نباید باشد: خواستهٔ صریحِ صاحب
       ریپو (۱۴۰۵/۰۶/۲۹) «تمام صفحه منظورم فقط همین را نشان بده در صفحه، نه
       بخش‌ها باشند نه غیره». پس نه سربرگِ بخش، نه کارتِ بخش — و سربرگ و نوار و
       نوارِ بخش‌های خودِ پنجره هم با `IsPageOpen` پنهان می‌شوند
       (`MainViewModel.IsChromeVisible`، همان راهی که صفحهٔ حسابِ قرض‌دار می‌رود). -->
  <Panel>

      <!-- ══════════════════════════════════════════════════════════════════
           🪪 صفحهٔ ورود — دو پنل، به مدلِ عکسِ مرجعِ ۱۴۰۵/۰۷/۰۴
           ══════════════════════════════════════════════════════════════════
           گزارشِ صاحب ریپو: «بخشِ لاگینِ برنامهٔ پمپ خیلی داغون و خراب است،
           اصلاً ریمیک کن ۱۰۰ و همهٔ کادرها و بخش‌هایش را بهتر و حرفه‌ای‌تر
           کن. منطق‌ها و کاربردی‌ها یک دانه هم دست نخورد؛ ظاهری خیلی داغون
           است. و شرایط و ضوابط هم ندارد. شبیه این عکس باشد همه‌چی.»

           ⛔ **هیچ منطقی عوض نشد.** هر `Binding`، هر `Command` و هر
              `IsVisible` دقیقاً همانی است که بود؛ آن‌چه عوض شد چیدمان،
              رنگ، برچسب و فاصله است.
           ⚠️ «شرایط و ضوابط ندارد» درست دیده شده بود ولی ریشه‌اش نبودن
              نبود: تیک **بود**، ته یک ستونِ شلوغ و وسط‌چین، و فقط در حالتِ
              «حساب می‌سازم». حالا مثلِ عکس، یک ردیفِ روشن درست بالای دکمهٔ
              اصلی است و متنِ شرایط همان‌جا باز می‌شود.
           ⛔ **هیچ دکمهٔ سرویسِ بیرونی‌ای اضافه نشد** — نه گوگل، نه فیسبوک،
              نه اپل. عکسِ مرجع دارد، ولی این برنامه هیچ‌کدام را **ندارد**؛
              دکمه‌ای که زده شود و هیچ کاری نکند از نبودنش بدتر است، و
              قاعدهٔ «هیچ سرویسِ بیرونی در این صفحه» از ۱۴۰۵/۰۶/۲۸ سرِ
              جایش است. -->
      <Border Name="LoginPage" Classes="loginpage" Background="#eaf4fe" CornerRadius="0"
              IsVisible="{Binding ShowLoginPage}">
        <Grid>
          <!-- لکه‌های نرمِ پس‌زمینه — همان تزئینِ گوشه‌های عکسِ مرجع -->
          <Border Width="150" Height="150" CornerRadius="40" Background="#141746c9"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,30,0,0" />
          <Border Width="110" Height="110" CornerRadius="30" Background="#144b93f7"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,34" />

          <!-- ══ کارتِ سفید — **تمامِ صفحه** ══
               خواستهٔ صاحب ریپو (۱۴۰۵/۰۶/۲۹): «این لاگین تمام صفحه باشد و
               کلِ صفحه را بگیرد.» پس اندازهٔ صریح ندارد و کشیده است؛ فقط
               ستونِ فرم پهنای ثابت دارد، وگرنه قاب به اندازهٔ پهن‌ترین پنل
               جمع می‌شود و فرم تمامِ پنلِ برند را می‌پوشاند. -->
          <Border Background="#ffffff" CornerRadius="28" Margin="26"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"
                  BoxShadow="0 24 60 0 #1F1746C9">
            <Grid ColumnDefinitions="*,470">

              <!-- ══════════ پنلِ برند — گرادیانِ آبی ══════════
                   عکسِ مرجع: «خوش آمدید به» بالا، نشانِ گرد وسط، نامِ
                   برنامه، یک بندِ توضیح، و دو لینکِ کوچک در کف. -->
              <Panel Grid.Column="0">
                <Border Background="{StaticResource Login.Grad}" />

                <!-- ══ لبهٔ موجی ══
                     همان موجِ لایه‌لایهٔ عکس. ⚠️ داخلِ یک پنلِ
                     `LeftToRight` است تا «چپ» واقعاً چپِ هندسی باشد: در
                     چیدمانِ راست‌به‌راست، ستونِ صفر سمتِ راست کشیده
                     می‌شود و لبهٔ داخلی‌اش (مرزِ فرم) چپِ خودش است.
                     ⚠️ `Stretch="Fill"` یعنی همین داده در هر بلندیِ
                     پنجره درست کشیده می‌شود — بی هیچ حسابِ دستی. -->
                <Panel FlowDirection="LeftToRight" ClipToBounds="True">
                  <Path HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="104"
                        Stretch="Fill" Fill="#24ffffff"
                        Data="M104,0 L44,0 C96,96 8,176 52,268 C94,356 4,432 46,524 C86,612 12,660 58,720 L104,720 Z" />
                  <Path HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="72"
                        Stretch="Fill" Fill="#2effffff"
                        Data="M104,0 L44,0 C96,96 8,176 52,268 C94,356 4,432 46,524 C86,612 12,660 58,720 L104,720 Z" />
                  <Path HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="40"
                        Stretch="Fill" Fill="#3affffff"
                        Data="M104,0 L44,0 C96,96 8,176 52,268 C94,356 4,432 46,524 C86,612 12,660 58,720 L104,720 Z" />
                </Panel>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="46,34">
                  <StackPanel Classes="brand" Spacing="0" VerticalAlignment="Center"
                              HorizontalAlignment="Center" MaxWidth="440">

                    <TextBlock Text="خوش آمدید به" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,18" />

                    <!-- نشانِ گردِ سفید با آیکنِ خودِ برنامه — مثلِ عکس -->
                    <Border Width="96" Height="96" CornerRadius="48" Background="#ffffff"
                            HorizontalAlignment="Center">
                      <Path Data="{StaticResource Icon.pump}" Stroke="#1746c9" StrokeThickness="1.75"
                            Stretch="Uniform" Width="46" Height="46"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="پمپ یعقوبی" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />

                    <!-- ══ آدمک‌های برداری ══
                         ⛔ نقشهٔ unDraw (پروانهٔ MIT) سرِ جایش ماند — خواستهٔ
                            صریحِ صاحب ریپو از ۱۴۰۵/۰۶/۲۹ («اون آدمک‌ها رو
                            باسازی کن… با رنگ و تمِ خودِ برنامه») و سنجهٔ
                            `loginart` هم بودنش در درخت را قفل کرده.
                         ⚠️ رنگش با تم جا عوض می‌کند و یک بار برای همیشه
                            تجزیه می‌شود؛ خواندنش فقط سرِ باز شدنِ همین صفحه
                            است. -->
                    <c:LoginArt Margin="0,10,0,6" MaxWidth="420" MaxHeight="300"
                                HorizontalAlignment="Center" />

                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                               Foreground="#d8e6ff" LineHeight="21" Margin="0,4,0,0"
                               Text="حساب بسازید تا دفترِ پمپتان روی سرورِ خودتان پشتیبان بگیرد، اشتراک روی همین حساب بنشیند و گوشیِ کارمندان به همین پمپ وصل شود." />

                    <!-- دو لینکِ کفِ پنل، مثلِ عکس — و هر دو کارِ واقعی
                         می‌کنند: یکی به ساختنِ حساب می‌برد و یکی به ورود. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                      <Button Classes="linkw" Content="ساختنِ حساب"
                              Command="{Binding SetSignUpCommand}" CommandParameter="yes" />
                      <TextBlock Text="|" Foreground="#7fb0f5" VerticalAlignment="Center" />
                      <Button Classes="linkw" Content="ورود با کدِ ایمیلی"
                              Command="{Binding SetSignUpCommand}" CommandParameter="code" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Panel>

              <!-- ══════════ فرم ══════════ -->
              <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Padding="44,26">
                <StackPanel Spacing="0" VerticalAlignment="Center">

                  <!-- ⚠️ «برگشت» — کسی که نمی‌خواهد حساب بسازد باید بتواند
                       برگردد سرِ دفترِ خودش (خواستهٔ ۱۴۰۵/۰۶/۲۹). -->
                  <Button Classes="link" Content="‹ برگشت به برنامه" HorizontalAlignment="Right"
                          Command="{Binding CloseLoginCommand}" IsEnabled="{Binding !Busy}" />

                  <!-- نشانِ گام‌ها -->
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                              Margin="0,10,0,16">
                    <Border Classes="stepchip" Classes.on="{Binding StepAccount}">
                      <TextBlock Text="۱ حساب" />
                    </Border>
                    <Border Classes="stepchip" Classes.on="{Binding StepEmailCode}"
                            IsVisible="{Binding IsSignUp}">
                      <TextBlock Text="۲ کدِ ایمیل" />
                    </Border>
                    <Border Classes="stepchip" Classes.on="{Binding StepPump}">
                      <TextBlock Text="۳ پمپ" />
                    </Border>
                    <Border Classes="stepchip" Classes.on="{Binding StepDone}">
                      <TextBlock Text="۴ تمام" />
                    </Border>
                  </StackPanel>

                  <!-- ══════════ گامِ ۱: حساب ══════════ -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepAccount}">
                    <!-- ⛔ عنوان از همان حالت‌های موجود می‌آید، نه از یک
                         خاصیتِ تازه در ویومدل: خواستهٔ صریحِ صاحب ریپو این
                         بود که «منطق‌ها و کاربردی‌ها یک دانه هم دست نخورد». -->
                    <TextBlock Text="ساختنِ حساب" Classes="h1" HorizontalAlignment="Center"
                               IsVisible="{Binding IsSignUp}" />
                    <TextBlock Text="ورود به حساب" Classes="h1" HorizontalAlignment="Center"
                               IsVisible="{Binding IsSignIn}" />
                    <TextBlock Text="ورود با کدِ ایمیلی" Classes="h1" HorizontalAlignment="Center"
                               IsVisible="{Binding IsCodeLogin}" />

                    <!-- «حساب داری یا نه؟» — سه راهِ جدا و دیدنی -->
                    <Border CornerRadius="999" Background="#eef4fc" Padding="4"
                            HorizontalAlignment="Center" Margin="0,14,0,18">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="mode" Classes.active="{Binding IsSignUp}" Content="حساب می‌سازم"
                                Command="{Binding SetSignUpCommand}" CommandParameter="yes" />
                        <Button Classes="mode" Classes.active="{Binding IsSignIn}" Content="حساب دارم"
                                Command="{Binding SetSignUpCommand}" CommandParameter="no" />
                        <!-- درِ سوم: بی رمز. بندِ ۲۰٫۷ی پرامپت — ایمیل ⇒ کدِ
                             شش‌رقمی ⇒ نشست. ثبت‌نام و ورود در این راه یکی‌اند. -->
                        <Button Classes="mode" Classes.active="{Binding IsCodeLogin}" Content="کدِ ایمیلی"
                                Command="{Binding SetSignUpCommand}" CommandParameter="code" />
                      </StackPanel>
                    </Border>

                    <!-- ⚠️ **برچسب بالای هر کادر** — همان چیزی که عکسِ مرجع
                         دارد و این صفحه نداشت. نوشتهٔ راهنمای داخلِ کادر با
                         پر شدنِ کادر می‌رفت و کاربر دیگر نمی‌دانست کدام
                         خانه چیست.
                         ⚠️ **Enter هم فرم را می‌فرستد** (بندِ ۲ی صاحب ریپو).
                         روی خودِ کادرها می‌نشیند، نه روی صفحه، وگرنه Enter
                         در هر جای دیگری هم دکمه را می‌زد. -->
                    <StackPanel IsVisible="{Binding IsSignUp}" Margin="0,0,0,12">
                      <TextBlock Text="نامِ شما" Classes="lbl" />
                      <TextBox Text="{Binding LoginName}" Watermark="نام و نامِ خانوادگی">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Text="ایمیل" Classes="lbl" />
                      <TextBox Text="{Binding LoginEmail}" Watermark="you@example.com"
                               FlowDirection="LeftToRight">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <!-- ⚠️ در راهِ «کدِ ایمیلی» اصلاً رمزی در کار نیست، پس
                         کادرش هم نباید دیده شود. -->
                    <StackPanel IsVisible="{Binding !IsCodeLogin}" Margin="0,0,0,12">
                      <TextBlock Text="رمز" Classes="lbl" />
                      <TextBox Text="{Binding LoginPassword}" PasswordChar="{Binding PassChar}"
                               Watermark="دستِ‌کم هشت نویسه">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSignUp}" Margin="0,0,0,12">
                      <TextBlock Text="تکرارِ رمز" Classes="lbl" />
                      <TextBox Text="{Binding LoginPassword2}" PasswordChar="{Binding PassChar}"
                               Watermark="همان رمز را دوباره بنویسید">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding AccountStepCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <!-- «چشم» و «رمزم را فراموش کرده‌ام» — هر دو خواستهٔ
                         بندهای ۲ و ۹ی صاحب ریپو. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4"
                                IsVisible="{Binding !IsCodeLogin}">
                      <Button Classes="link" Content="{Binding RevealPassText}"
                              Command="{Binding ToggleRevealPassCommand}" />
                      <Button Classes="link" Content="رمزم را فراموش کرده‌ام" IsVisible="{Binding IsSignIn}"
                              Command="{Binding OpenForgotCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <!-- ══ شرایط و ضوابط ══
                         ⚠️ پذیرشِ شرایط **اجباریِ خودِ سرور** است
                         (`terms_required`) و متنش هم از سرور می‌آید — نه یک
                         تیکِ تشریفاتی. حالا درست بالای دکمهٔ اصلی و در یک
                         ردیف است، مثلِ عکسِ مرجع. -->
                    <StackPanel IsVisible="{Binding IsSignUp}" Margin="0,8,0,0">
                      <!-- ⚠️ ترتیب مهم است: در راست‌به‌چپ این سه‌تا کنارِ هم
                           «شرایط و ضوابط را می‌پذیرم» خوانده می‌شوند. متنِ
                           شرایط روی همان لینک باز می‌شود، پس کاربر بی
                           بیرون رفتن از فرم می‌خواندش. -->
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <CheckBox IsChecked="{Binding AcceptTerms}" VerticalAlignment="Center" />
                        <Button Classes="link" Content="شرایط و ضوابط" VerticalAlignment="Center"
                                Command="{Binding LoadTermsCommand}" />
                        <TextBlock Text="را می‌پذیرم" FontSize="12.5" Foreground="#3f4d68"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <Border Background="#f4f8fd" BorderBrush="#dce6f5" BorderThickness="1"
                              CornerRadius="10" Padding="12" MaxHeight="160" Margin="0,8,0,0"
                              IsVisible="{Binding ShowTerms}">
                        <ScrollViewer>
                          <SelectableTextBlock Text="{Binding TermsText}" FontSize="11.5"
                                               Foreground="#3f4d68" TextWrapping="Wrap" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>

                    <Button Classes="go" Content="{Binding AccountButtonText}" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding AccountStepCommand}" IsEnabled="{Binding !Busy}" />

                    <!-- ⛔ زیرِ دکمه، در عکسِ مرجع، ردیفِ «Sign Up with» و
                         نشانِ گوگل و فیسبوک و اپل است. این‌جا **ساخته
                         نشد**: هیچ‌کدامِ آن راه‌ها در این برنامه وجود
                         ندارد و یک دکمهٔ بی‌کار از نبودنش بدتر است. جایش
                         همان راهِ سومِ واقعیِ خودمان است — کدِ ایمیلی. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                Margin="0,14,0,0" IsVisible="{Binding IsSignUp}">
                      <TextBlock Text="حساب دارید؟" FontSize="12.5" VerticalAlignment="Center"
                                 Foreground="#7b879e" />
                      <Button Classes="link" Content="وارد شوید"
                              Command="{Binding SetSignUpCommand}" CommandParameter="no" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                Margin="0,14,0,0" IsVisible="{Binding !IsSignUp}">
                      <TextBlock Text="حساب ندارید؟" FontSize="12.5" VerticalAlignment="Center"
                                 Foreground="#7b879e" />
                      <Button Classes="link" Content="یک حساب بسازید"
                              Command="{Binding SetSignUpCommand}" CommandParameter="yes" />
                    </StackPanel>

                    <!-- ⛔ «بعداً — فعلاً بی حساب ادامه می‌دهم» برداشته شد
                         (۱۴۰۵/۰۶/۳۰). دروغ می‌گفت: بی حساب ادامه نمی‌داد،
                         فقط به گامِ کدِ پمپ می‌رفت و کاربر همچنان داخلِ همان
                         دیوارِ ورود می‌ماند. راهِ واقعی «‹ برگشت به برنامه»ی
                         بالای همین صفحه است. -->
                  </StackPanel>

                  <!-- ══════════ گامِ ۰: رمزم را فراموش کرده‌ام ══════════
                       بندِ ۹ی صاحب ریپو. ⚠️ این راه روی سرور از قبل بود
                       (`/api/auth/password/forgot` و `/password/reset`) و
                       فقط برنامهٔ نیتیو هیچ‌وقت صدایش نزده بود — پس کسی که
                       رمزش را گم می‌کرد هیچ راهی جز ساختنِ حسابِ تازه
                       نداشت. -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepForgot}">
                    <TextBlock Text="رمزِ تازه" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,18"
                               Text="ایمیلتان را بنویسید تا یک کدِ شش‌رقمی برایش بفرستیم، بعد رمزِ تازه را بگذارید." />

                    <TextBlock Text="ایمیل" Classes="lbl" />
                    <TextBox Text="{Binding LoginEmail}" Watermark="you@example.com"
                             FlowDirection="LeftToRight">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendResetCodeCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Classes="go" Content="فرستادنِ کد به ایمیل" Margin="0,14,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding SendResetCodeCommand}" IsEnabled="{Binding !Busy}" />

                    <!-- تا کد نرفته، نیمهٔ دوم دیده نمی‌شود -->
                    <StackPanel Spacing="0" IsVisible="{Binding ResetSent}" Margin="0,16,0,0">
                      <TextBlock Text="کدِ ایمیل" Classes="lbl" />
                      <TextBox Text="{Binding ResetCode}" MaxLength="6" Watermark="شش رقم"
                               FlowDirection="LeftToRight" Margin="0,0,0,12" />
                      <TextBlock Text="رمزِ تازه" Classes="lbl" />
                      <TextBox Text="{Binding ResetPass}" PasswordChar="{Binding PassChar}"
                               Watermark="دستِ‌کم هشت نویسه" Margin="0,0,0,12" />
                      <TextBlock Text="تکرارِ رمزِ تازه" Classes="lbl" />
                      <TextBox Text="{Binding ResetPass2}" PasswordChar="{Binding PassChar}"
                               Watermark="همان رمز را دوباره بنویسید">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding ResetPasswordCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button Classes="go" Content="گذاشتنِ رمزِ تازه و ورود" Margin="0,14,0,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="کد نرسید؟ دوباره بفرست" HorizontalAlignment="Center"
                              Margin="0,8,0,0"
                              Command="{Binding SendResetCodeCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>

                    <Button Classes="link" Content="‹ برگشت به ورود" HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                  </StackPanel>

                  <!-- ══════════ گامِ ۲: کدِ ایمیل ══════════
                       گزارشِ صاحب ریپو (۱۴۰۵/۰۶/۲۹): «می‌خواهم با ایمیل خودم
                       حسابی بسازم، نمی‌شود.» ریشه: سرور حسابِ بی تأییدِ
                       ایمیل نمی‌سازد. پس این گام آمد — و ⚠️ این کد **کدِ
                       ایمیل** است، نه کدِ اشتراک. -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepEmailCode}">
                    <TextBlock Text="کدِ ایمیل" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,16"
                               Text="یک کدِ شش‌رقمی به ایمیلتان فرستادیم. همان را این‌جا بزنید تا حساب ساخته شود. (این با کدِ اشتراک فرق دارد.)" />

                    <!-- ══ شش خانهٔ کد — بندِ ۴ی پرامپتِ ۲۲ ════════════════
                         پرشِ خودکار، Paste، ارقامِ فارسی/انگلیسی و ارسالِ
                         خودکار پس از رقمِ ششم. همهٔ تصمیم‌ها در
                         `CodeBoxesViewModel` است؛ این‌جا فقط فوکوس جابه‌جا
                         می‌شود (`AccountSectionView.axaml.cs`).
                         ⚠️ چپ‌به‌راست، وگرنه رقمِ اول سمتِ راست می‌افتد و
                         کاربر کد را وارونه می‌بیند. -->
                    <!-- ⚠️ `IsVisible` روی قابِ بیرونی است و `DataContext` روی
                         خودِ ردیف: با بایندِ کامپایل‌شده، عوض کردنِ
                         `DataContext` بدونِ `x:DataType` اصلاً کامپایل
                         نمی‌شود، و اگر `IsVisible` هم داخلِ همان می‌نشست
                         روی `CodeBoxesViewModel` دنبالِ `IsCodeLogin`
                         می‌گشت — که آن‌جا وجود ندارد. -->
                    <Panel IsVisible="{Binding IsCodeLogin}">
                      <StackPanel Name="CodeBoxRow" Orientation="Horizontal" Spacing="8"
                                  HorizontalAlignment="Center"
                                  FlowDirection="LeftToRight"
                                  DataContext="{Binding CodeBoxes}"
                                  x:DataType="vmr:CodeBoxesViewModel">
                        <TextBox Name="Code0" Classes="codebox" Text="{Binding B1, Mode=OneWay}" />
                        <TextBox Name="Code1" Classes="codebox" Text="{Binding B2, Mode=OneWay}" />
                        <TextBox Name="Code2" Classes="codebox" Text="{Binding B3, Mode=OneWay}" />
                        <TextBox Name="Code3" Classes="codebox" Text="{Binding B4, Mode=OneWay}" />
                        <TextBox Name="Code4" Classes="codebox" Text="{Binding B5, Mode=OneWay}" />
                        <TextBox Name="Code5" Classes="codebox" Text="{Binding B6, Mode=OneWay}" />
                      </StackPanel>
                    </Panel>

                    <!-- ایمیلِ پوشانده و حالِ تحویل — هر دو از خودِ سرور -->
                    <TextBlock Classes="dim" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"
                               IsVisible="{Binding IsCodeLogin}" Text="{Binding CodeMasked}"
                               FlowDirection="LeftToRight" />
                    <TextBlock Classes="dim" FontSize="12" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsCodeLogin}"
                               Text="{Binding CodeDelivery}" />

                    <!-- راهِ رمز همان کادرِ تک‌خطیِ همیشگی‌اش را دارد -->
                    <StackPanel IsVisible="{Binding !IsCodeLogin}">
                      <TextBlock Text="کدِ ایمیل" Classes="lbl" />
                      <TextBox Text="{Binding EmailCode}" MaxLength="6"
                               Watermark="شش رقم" FlowDirection="LeftToRight">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding VerifyEmailCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </StackPanel>

                    <Button Classes="go" Content="تایید و ساختنِ حساب" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding VerifyEmailCommand}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                      <!-- ⚠️ شمارشِ معکوسِ شصت ثانیه — عددش از خودِ سرور
                           می‌آید (`resend_after`)، نه از حدسِ ما. -->
                      <Button Classes="link" Content="کد نرسید؟ دوباره بفرست"
                              Command="{Binding ResendEmailCodeCommand}"
                              IsEnabled="{Binding CanResendCode}" />
                      <TextBlock Classes="dim" FontSize="12" VerticalAlignment="Center"
                                 IsVisible="{Binding !CanResendCode}"
                                 Text="{Binding CodeSeconds, StringFormat='{}{0} ثانیه'}" />
                      <Button Classes="link" Content="‹ برگشت به حساب"
                              Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ══════════ گامِ ۳: پمپ ══════════ -->
                  <StackPanel Spacing="0" IsVisible="{Binding StepPump}">
                    <TextBlock Text="پمپِ خودتان" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,18"
                               Text="نام و لوکیشنِ پمپ را بنویسید و تمام. اشتراک روی همین حساب می‌نشیند، پس هیچ کدی لازم نیست." />

                    <!-- ⛔ کادرِ «کدِ شش‌رقمی — اگر دارید» در ۱۴۰۵/۰۷/۰۴ از
                         همین‌جا برداشته شد. گزارشِ صاحب ریپو: «بعد از کد شش
                         رقمی یک کد شش رقمی دیگه می‌خواد، اون چیه؟ اون رو
                         حذف کن، لازم نیست.» و حق داشت: درست پس از کدِ
                         **ایمیل**، یک کادرِ شش‌رقمیِ دیگر با همان شکل
                         می‌آمد که هیچ ربطی به آن یکی نداشت.
                         ⚠️ هیچ قابلیتی از بین نرفت: خرج کردنِ کدِ اشتراک
                         همان‌جایی ماند که باید باشد — کارتِ «اشتراک»ِ خودِ
                         پروفایل (`SubCode` + `RedeemSubCommand`). -->
                    <TextBlock Text="نامِ پمپ" Classes="lbl" />
                    <TextBox Text="{Binding LoginPump}" Watermark="مثلاً پمپ یعقوبی" Margin="0,0,0,12">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FinishPumpCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>

                    <TextBlock Text="لوکیشنِ پمپ" Classes="lbl" />
                    <TextBox Text="{Binding LoginLocation}" Watermark="شهر و آدرس">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FinishPumpCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>

                    <Button Classes="go" Content="ساختنِ پمپ و پایان" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding FinishPumpCommand}" IsEnabled="{Binding !Busy}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                      <Button Classes="link" Content="‹ برگشت به حساب"
                              Command="{Binding BackToAccountCommand}" IsEnabled="{Binding !Busy}" />
                      <Button Classes="link" Content="بعداً — بعد کد را می‌زنم"
                              Command="{Binding SkipPumpCommand}" IsEnabled="{Binding !Busy}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- ⚠️ **حالتِ Loading دیدنی** (بندِ ۲ی صاحب ریپو): تا امروز
                       فقط دکمه‌ها خاکستری می‌شدند و کاربر نمی‌فهمید برنامه
                       دارد کار می‌کند یا گیر کرده. نوار نامعین است چون
                       نمی‌دانیم سرور چقدر طول می‌دهد. -->
                  <ProgressBar IsIndeterminate="True" Height="3" Margin="0,14,0,0"
                               Foreground="#1746c9" Background="Transparent"
                               IsVisible="{Binding Busy}" />

                  <!-- حالِ کار — پیامِ خودِ سرور، در یک کادرِ دیدنی -->
                  <Border Background="#eef4fc" BorderBrush="#dce6f5" BorderThickness="1"
                          CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                          IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding LoginStatus}" TextWrapping="Wrap" FontSize="12.5"
                               FontWeight="Bold" Foreground="#16233d" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════════
           👤 خودِ پروفایل — همان مشخصات، با تمِ خودِ برنامه
           ══════════════════════════════════════════════════════════════════ -->
      <c:SectionPage Header="پروفایل" IsVisible="{Binding ShowProfilePage}">
      <Grid ColumnDefinitions="300,*,330" RowDefinitions="Auto,*">

      <!-- ══ آواتار ══ -->
      <Border Grid.Row="0" Grid.Column="0" Classes="panel" Padding="22" Margin="0,0,14,14">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Border Width="110" Height="110" CornerRadius="55" Background="{DynamicResource Pump.Accent}"
                  BoxShadow="{DynamicResource Pump.CardShadow}">
            <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Black" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding PumpName}" FontSize="20" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UserLine}" Classes="muted" TextAlignment="Center" />
          <TextBlock Text="{Binding AccountEmail}" Classes="muted" FontSize="12.5" TextAlignment="Center"
                     Foreground="{DynamicResource Pump.Info}"
                     IsVisible="{Binding AccountEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Border Classes="pill" Padding="11,4"
                    Background="{Binding RoleBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
              <TextBlock Text="{Binding RoleText}" FontSize="12" FontWeight="ExtraBold" />
            </Border>
            <Border Classes="pill" Padding="11,4" Background="#FFD700" IsVisible="{Binding VipActive}">
              <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="Black" Foreground="#1a1a1a" />
            </Border>
          </StackPanel>
          <Border Height="1" Background="{DynamicResource Pump.Border}" Margin="0,6" />
          <!-- ⚠️ راهِ برگشت به صفحهٔ ورود. ⛔ هیچ دکمهٔ سرویسِ بیرونی‌ای این‌جا
               نیست: «هیچ پکنه‌ای نباشد، نه از گوگل و نه غیره.» -->
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="حساب و ورود" Command="{Binding OpenAccountPageCommand}"
                  IsEnabled="{Binding !Busy}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="🔄 گرفتنِ دوبارهٔ اطلاعات" Command="{Binding PullHomeCommand}"
                  IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="خروج از حساب" Command="{Binding SignOutCommand}"
                  IsVisible="{Binding SignedIn}" IsEnabled="{Binding !Busy}" />
          <TextBlock Text="{Binding AccountStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding StationLine}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding StationLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- ══ مشخصاتِ پمپ ══ -->
      <Border Grid.Row="0" Grid.Column="1" Classes="panel" Padding="22" Margin="0,0,14,14">
        <StackPanel Spacing="12">
          <TextBlock Text="مشخصاتِ پمپ" Classes="ptitle" />
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="نامِ پمپ" Classes="kvl" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PumpName}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="کدِ پمپ روی سرورِ حساب" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PumpCodeLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="تلفن" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PumpPhone}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="نشانی" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PumpAddress}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="سرورِ خانگی" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HomeLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="سرورِ حساب" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CloudLine}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="نسخهٔ برنامه" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AppVersionLine}" Classes="kvv" Margin="0,8,0,0" />
          </Grid>

          <Border Height="1" Background="{DynamicResource Pump.Border}" />

          <!-- کدِ اپِ کارمندان — همان چیزی که هر کارمند در گوشی می‌زند -->
          <TextBlock Text="کدِ پمپ برای اپِ کارمندان" Classes="ptitle" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="stat" Padding="18,10" MinWidth="220" IsVisible="{Binding HasAccessCode}">
              <SelectableTextBlock Text="{Binding AccessCodeDisplay}" FontSize="30" FontWeight="Black"
                                   FontFamily="Consolas,Menlo,monospace" LetterSpacing="4"
                                   Foreground="{DynamicResource Pump.Accent}" FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="accent" Content="📋 کپی" Command="{Binding CopyAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="📲 کیو‌آر" Command="{Binding ShowAccessQrCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}" />
                <Button Content="🔄 گرفتنِ کد" Command="{Binding LoadAccessCodeCommand}" IsEnabled="{Binding !Busy}" />
                <Button Content="♻️ عوض کردن" Command="{Binding RotateAccessCodeCommand}"
                        IsVisible="{Binding HasAccessCode}" IsEnabled="{Binding !Busy}"
                        ToolTip.Tip="کدِ قبلی همان لحظه از کار می‌افتد" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                         Text="هر کسی اپِ اندروید یا آیفون را نصب می‌کند این کد را می‌زند و فقط حساب‌های همین پمپ را می‌بیند؛ بعدش رمزِ همین برنامه را هم می‌خواهد." />
              <TextBlock Text="{Binding AccessStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding AccessStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>

          <!-- ⚠️ جابه‌جاییِ پمپ: برنامه از قبل می‌گفت «این دستگاه را از پمپِ
               فعلی جدا کنید» ولی هیچ دکمه‌ای برایش نبود. ⛔ دفتر دست نمی‌خورد،
               و پیش از انجام پرسیده می‌شود. -->
          <Border Height="1" Background="{DynamicResource Pump.Border}" IsVisible="{Binding PumpBound}" />
          <StackPanel Spacing="6" IsVisible="{Binding PumpBound}">
            <Button HorizontalAlignment="Left" Content="🔓 جدا کردنِ این دستگاه از این پمپ"
                    Command="{Binding ForgetPumpCommand}" IsEnabled="{Binding !Busy}"
                    ToolTip.Tip="برای بردنِ این کامپیوتر به پمپِ دیگر" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                       Text="اشتراک و کدِ اپِ کارمندان و نشانیِ سرورِ این پمپ برداشته می‌شوند؛ دفتر و حساب‌ها دست نمی‌خورند." />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ اشتراکِ VIP ══ -->
      <Border Grid.Row="0" Grid.Column="2" Classes="panel" Padding="22" Margin="0,0,0,14">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="اشتراکِ VIP" Classes="ptitle" />
            <Border Classes="pill" Padding="9,2" Background="#FFD700" IsVisible="{Binding VipActive}" VerticalAlignment="Center">
              <TextBlock Text="فعال" FontSize="11" FontWeight="Black" Foreground="#1a1a1a" />
            </Border>
          </StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="پلن" Classes="kvl" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubPlanText}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="پایان" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubEndsText}" Classes="kvv" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="مانده" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubDaysText}" Classes="kvv" Margin="0,8,0,0"
                       Foreground="{DynamicResource Pump.Ok}" FontSize="18" FontWeight="Black" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="وضعیت" Classes="kvl" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubSourceText}" Classes="kvv" Margin="0,8,0,0" />
          </Grid>
          <Border Height="1" Background="{DynamicResource Pump.Border}" />
          <TextBlock Text="کدِ اشتراک (شش رقم)" Classes="kvl" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding SubCode}" Width="130" MaxLength="6" Watermark="۱۲۳۴۵۶" />
            <Button Classes="accent" Content="فعال کن" Command="{Binding RedeemSubCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="🔄" Command="{Binding RefreshSubCommand}" IsEnabled="{Binding !Busy}" ToolTip.Tip="تازه‌سازی از سرور" />
          </StackPanel>
          <TextBlock Text="{Binding SubMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding SubMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding GraceText}" FontSize="12" TextWrapping="Wrap" FontWeight="Bold"
                     Foreground="{DynamicResource Pump.Warn}"
                     IsVisible="{Binding GraceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- ══ چه چیزی در اشتراکِ من است ══════════════════════════════
               سه کارِ ابری با اشتراک‌اند و پشتیبانی همیشه باز. دفترِ خودش
               هیچ‌وقت قفل نمی‌شود، پس این‌جا هم اسمی از آن نیست. -->
          <Border Height="1" Background="{DynamicResource Pump.Border}" />
          <TextBlock Text="دسترسی‌ها" Classes="kvl" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="اپِ کارمندان و ربات" Classes="kvv" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccessKarText}" Classes="kvv" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="کیو‌آرِ حسابِ مشتری" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccessQrText}" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="بک‌اپِ خودکار روی سرور" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessBackupText}" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="چتِ پشتیبانی" Classes="kvv" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessSupportText}" Classes="kvv" Margin="0,6,0,0"
                       Foreground="{DynamicResource Pump.Ok}" />
          </Grid>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="دفترِ شما روی همین کامپیوتر می‌ماند و با تمام شدنِ اشتراک هم سرِ جایش است — قرض‌داران، ورق، مخزن، گاوصندوق، چاپ و بک‌اپِ محلی. فقط سه کارِ ابریِ بالا بسته می‌شوند." />
        </StackPanel>
      </Border>

      <!-- ══ تب‌ها: کارمندان · تاریخچه · پشتیبان‌ها ══ -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="panel" Padding="22" Margin="0,0,14,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,14">
            <Button Classes="seg" Classes.active="{Binding TabStaff}" Content="کارمندان"
                    Command="{Binding SetTabCommand}" CommandParameter="staff" />
            <Button Classes="seg" Classes.active="{Binding TabHistory}" Content="تاریخچهٔ بخش‌ها"
                    Command="{Binding SetTabCommand}" CommandParameter="history" />
            <Button Classes="seg" Classes.active="{Binding TabBackups}" Content="پشتیبان‌ها"
                    Command="{Binding SetTabCommand}" CommandParameter="backups" />
          </StackPanel>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="ردیفی نیست." Classes="muted" IsVisible="{Binding !Rows.Count}" />
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <Border Classes="prow" Background="{DynamicResource Pump.Input}"
                            BorderBrush="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                      <Grid ColumnDefinitions="2*,1.4*,1.4*,2*">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="عنوان" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding L1}" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding V1}" FontWeight="SemiBold"
                                     Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                          <TextBlock Text="{Binding L2}" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding V2}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding HasNote}">
                          <TextBlock Text="یادداشت" Classes="kvl" FontSize="11" />
                          <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ══ فایل‌ها: پشتیبان‌ها ══ -->
      <Border Grid.Row="1" Grid.Column="2" Classes="panel" Padding="22">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="فایل‌های پشتیبان" Classes="ptitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill-btn support" Content="باز کردنِ پوشه" FontSize="12" Padding="12,4"
                    Command="{Binding OpenBackupsCommand}" />
          </Grid>
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="هنوز پشتیبانی گرفته نشده — هر روز سرِ ورود خودکار گرفته می‌شود." Classes="muted" FontSize="12"
                         TextWrapping="Wrap" IsVisible="{Binding !Backups.Count}" />
              <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                      <TextBlock Grid.Column="0" Text="🗄️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Text="{Binding V2}" Classes="muted" FontSize="11.5" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding V1}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Grid>
      </c:SectionPage>
  </Panel>
</UserControl>
