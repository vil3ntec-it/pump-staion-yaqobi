<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.AmanatSectionView"
             x:DataType="vm:AmanatSectionViewModel">
  <Panel>

    <!-- ══ شبکهٔ کارت‌ها ══════════════════════════════════════════════════
         صفحهٔ اصلیِ «تیل امانت» در نسخهٔ وب فقط کارتِ حساب‌هاست؛ جدول و
         تحلیل با زدنِ کارت باز می‌شوند. -->
    <c:SectionPage ScrollBody="False" IsVisible="{Binding IsListVisible}" Header="تیل امانت">

      <c:SectionPage.Toolbar>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" />
          <Button Classes="ghost" Content="📊 خلاصه و ابزارها" Margin="0,0,6,0" />
          <Button Classes="ghost info" Content="📄 PDF" Margin="0,0,6,0"
                  Command="{Binding PdfCommand}" />
          <Button Classes="accent" Content="➕ حساب جدید" Command="{Binding AddAccountCommand}" />
        </WrapPanel>
      </c:SectionPage.Toolbar>

      <c:SectionPage.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="250" Text="{Binding Search}" Watermark="🔍 جست‌وجوی نام حساب…" />
          <Button Classes="seg" Classes.on="{Binding IsAll}" Content="همه"
                  Command="{Binding SetFuelCommand}" CommandParameter="all" />
          <Button Classes="seg" Classes.on="{Binding IsPetrol}" Content="⛽ پطرول"
                  Command="{Binding SetFuelCommand}" CommandParameter="petrol" />
          <Button Classes="seg" Classes.on="{Binding IsDieselFilter}" Content="🟤 دیزل"
                  Command="{Binding SetFuelCommand}" CommandParameter="diesel" />
          <Button Classes="seg on" Content="{Binding FuelChipText}" IsVisible="{Binding HasFuelChip}"
                  Command="{Binding ClearFuelCommand}" />
        </StackPanel>
      </c:SectionPage.Filters>

              <Panel>
          <TextBlock Text="{Binding EmptyText}" Classes="muted" HorizontalAlignment="Center"
                     Margin="0,40,0,0" IsVisible="{Binding !Cards.Count}" />
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><c:AutoFillPanel MinItemWidth="252" Gap="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AmanatCardViewModel">
                <Button Classes="card-shell"
                        Command="{Binding $parent[ItemsControl].((vm:AmanatSectionViewModel)DataContext).OpenCommand}"
                        CommandParameter="{Binding}">
                  <Border Classes="person-card">
                    <Grid RowDefinitions="Auto,Auto,*">
                      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="card-x" Content="✕"
                                Command="{Binding $parent[ItemsControl].((vm:AmanatSectionViewModel)DataContext).DeleteCardCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="qr" Content="📄" Padding="8,3" FontSize="12"
                                Command="{Binding $parent[ItemsControl].((vm:AmanatSectionViewModel)DataContext).PdfCardCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>

                      <TextBlock Grid.Row="1" Text="{Binding Name}" Classes="pname"
                                 ToolTip.Tip="{Binding Name}" />

                      <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="7" Margin="0,8,0,0">
                        <TextBlock Text="{Binding RestText}" Classes="cmp-fig"
                                   Foreground="{Binding RestBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding State}" FontSize="12" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{Binding StateBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                          <TextBlock Text="{Binding LitersText}" FontWeight="Bold" FontSize="13" />
                          <TextBlock Text="{Binding LossText}" FontWeight="Bold" FontSize="13"
                                     Foreground="{DynamicResource Pump.Accent}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PctText}" Classes="muted" FontSize="11"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" FontWeight="Bold"
                                   FontSize="12" Foreground="{DynamicResource Pump.Accent}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      
    </c:SectionPage>

    <!-- ══ صفحهٔ یک حساب ══
         مثلِ صفحهٔ قرض‌دار و شرکت، داخلِ همان قالبِ مشترک — تا سربرگ و کادر و
         فاصله‌هایش با بقیهٔ برنامه یکی باشد. پیش از این تنها صفحه‌ای بود که
         بی‌کادر و چسبیده به لبهٔ پنجره کشیده می‌شد. -->
    <Panel IsVisible="{Binding !IsListVisible}">
    <c:SectionPage ScrollBody="False" DataContext="{Binding Page}" x:CompileBindings="False"
                   Header="{Binding Name}" SubHeader="حسابِ تیلِ امانت">

      <c:SectionPage.Toolbar>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost info" Content="📄 PDF حساب" Command="{Binding PdfCommand}" />
          <Button Classes="accent" Content="← بازگشت به حساب‌ها" Command="{Binding BackCommand}" />
        </StackPanel>
      </c:SectionPage.Toolbar>

      <c:SectionPage.Filters>
        <UniformGrid Rows="1" Classes="stats">
          <StackPanel Spacing="3" Margin="6,0">
            <TextBlock Text="نامِ حساب" Classes="label" />
            <TextBox Text="{Binding Name}" />
          </StackPanel>
          <StackPanel Spacing="3" Margin="6,0">
            <TextBlock Text="فیصدیِ من" Classes="label" />
            <TextBox Text="{Binding MyPctText}" />
          </StackPanel>
          <StackPanel Spacing="3" Margin="6,0">
            <TextBlock Text="کلِ رسید (لیتر)" Classes="label" />
            <TextBlock Text="{Binding TotalLiters}" FontWeight="Bold" FontSize="15" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Spacing="3" Margin="6,0">
            <TextBlock Text="کلِ بخار" Classes="label" />
            <TextBlock Text="{Binding TotalLoss}" FontWeight="Bold" FontSize="15" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Spacing="3" Margin="6,0">
            <TextBlock Text="سهمِ من" Classes="label" />
            <TextBlock Text="{Binding TotalShare}" FontWeight="Bold" FontSize="15" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Spacing="3" Margin="6,0">
            <TextBlock Text="باقیِ تیلِ مشتری" Classes="label" />
            <TextBlock Text="{Binding TotalRest}" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource Pump.Accent}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,4">
            <Button Content="ردیفِ تازه" Command="{Binding AddRowCommand}" Padding="10,4" />
            <Button Classes="ghost danger" Content="حذفِ حساب"
                    Command="{Binding DeleteAccountCommand}" Padding="10,4" />
          </StackPanel>
        </UniformGrid>
      </c:SectionPage.Filters>

      <c:ExcelGrid ItemsSource="{Binding Rows}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
          <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="Auto" MinWidth="150" MaxWidth="320" />
          <DataGridTextColumn Header="رسید (لیتر)" Binding="{Binding LitersText}" Width="Auto" />
          <DataGridTextColumn Header="برده‌شده" Binding="{Binding TakenText}" Width="Auto" />
          <DataGridTextColumn Header="روز" Binding="{Binding DaysText}" Width="Auto" />
          <DataGridTextColumn Header="گرما" Binding="{Binding TempText}" Width="Auto" />
          <DataGridTextColumn Header="بخار" Binding="{Binding LossText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="٪ بخار" Binding="{Binding LossPctText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="سهمِ من" Binding="{Binding ShareText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="به من می‌رسد" Binding="{Binding NetText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="فیصدیِ لازم" Binding="{Binding AskPctText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="باقیِ تیل" Binding="{Binding RestText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="اندازهٔ واقعی" Binding="{Binding ActualText}" Width="Auto" />
          <DataGridCheckBoxColumn Header="بسته" Binding="{Binding IsClosed}" Width="Auto" />
          <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                        Command="{Binding $parent[DataGrid].DataContext.DeleteRowCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </c:ExcelGrid>
    </c:SectionPage>
    </Panel>
  </Panel>
</UserControl>
