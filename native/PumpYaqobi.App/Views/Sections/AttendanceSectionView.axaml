<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.AttendanceSectionView"
             x:DataType="vm:AttendanceSectionViewModel">

  <c:SectionPage Header="حاضری و معاش"
                 SubHeader="شیفتی که از نیمه‌شب رد می‌شود، ساعتش درست شمرده می‌شود">

    <c:SectionPage.Toolbar>
      <Button Classes="ghost info" Content="🕘 تاریخچه" Command="{Binding OpenHistoryCommand}"
              IsVisible="{Binding HasHistory}"
              ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <!-- ⛔ یک خط، هم‌قد (۱۴۰۵/۰۷/۱۴): «این‌ها چرا هم‌تراز نیستن… همه توی یک
           خط باشن». پهناها فشرده شدند تا کنارِ دکمه‌ها جا شوند؛ برچسبِ
           «کارمندِ تازه» حالا نوشتهٔ راهنمای خودِ کادر است. -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                  IsVisible="{Binding Picker.HasYears}"
                  ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="90" />
        <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                  ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="120" />
        <TextBox Text="{Binding NewName}" Watermark="نامِ کارمندِ تازه" Width="150" Margin="8,0,0,0" />
        <TextBox Text="{Binding NewSalary}" Watermark="معاش" Width="90" />
        <Button Classes="accent" Content="افزودن" Command="{Binding AddStaffCommand}" />
      </StackPanel>
    </c:SectionPage.Filters>

    <Grid RowDefinitions="Auto,12,*,Auto">
      <Panel Grid.Row="0">
        <ItemsRepeater ItemsSource="{Binding Staff}">
          <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="252" ItemsStretch="Fill"
                                 MinColumnSpacing="12" MinRowSpacing="12" />
            </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:StaffViewModel">
              <Border Classes="card">
                <StackPanel Spacing="7">
                  <TextBlock Text="{Binding Name}" Classes="h2" />
                  <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="روز" Classes="label" FontSize="11" />
                      <TextBlock Text="{Binding Days}" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="ساعت" Classes="label" FontSize="11" />
                      <TextBlock Text="{Binding HoursText}" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1">
                      <TextBlock Text="معاش" Classes="label" FontSize="11" />
                      <TextBlock Text="{Binding SalaryText}" FontWeight="Bold" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding PaidText}" Classes="muted" />
                  <TextBlock Text="{Binding ShortageText, StringFormat=کمبودی: {0}}" Classes="muted" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="آمدن" Padding="9,3" FontSize="11" Margin="0,0,5,0"
                            Command="{Binding $parent[ItemsRepeater].((vm:AttendanceSectionViewModel)DataContext).MarkInCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="رفتن" Padding="9,3" FontSize="11" Margin="0,0,5,0"
                            Command="{Binding $parent[ItemsRepeater].((vm:AttendanceSectionViewModel)DataContext).MarkOutCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="accent" Content="پرداختِ معاش" Padding="9,3" FontSize="11" Margin="0,0,5,0"
                            IsVisible="{Binding NotPaid}"
                            Command="{Binding $parent[ItemsRepeater].((vm:AttendanceSectionViewModel)DataContext).PaySalaryCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ghost danger" Content="حذف" Padding="9,3" FontSize="11"
                            Command="{Binding $parent[ItemsRepeater].((vm:AttendanceSectionViewModel)DataContext).DeleteStaffCommand}"
                            CommandParameter="{Binding}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </Panel>

      <c:ExcelGrid Grid.Row="2" ItemsSource="{Binding Rows}" x:CompileBindings="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="کارمند" Binding="{Binding StaffName}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
          <DataGridTextColumn Header="آمدن" Binding="{Binding In}" Width="Auto" />
          <DataGridTextColumn Header="رفتن" Binding="{Binding Out}" Width="Auto" />
          <DataGridTextColumn Header="ساعت" Binding="{Binding HoursText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" />
        </DataGrid.Columns>
      </c:ExcelGrid>

      <!-- ردیفِ «جمله» — روزها و جمعِ ساعت‌ها -->
      <c:TotalsBar Grid.Row="3" ItemsSource="{Binding TotalCells}" />
    </Grid>
  </c:SectionPage>
</UserControl>
