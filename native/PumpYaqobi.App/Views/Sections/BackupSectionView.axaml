<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.BackupSectionView"
             x:DataType="vm:BackupSectionViewModel">

  <c:SectionPage Header="بک‌اپ و به‌روزرسانی‌ها"
                 SubHeader="{Binding DataHomeText}">

    <StackPanel Spacing="14" MaxWidth="900">

      <!-- ══ تازه‌ترین بکاپ — یکی، که صفحه شلوغ نشود ═══════════════════ -->
      <Border Classes="panel" Padding="0">
        <StackPanel>
          <Border Classes="card-head">
            <TextBlock Text="💾 تازه‌ترین بکاپ" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>
          <StackPanel Margin="14" Spacing="10">

            <TextBlock Text="هنوز هیچ بکاپی گرفته نشده" Classes="label"
                       IsVisible="{Binding NoBackups}" />

            <StackPanel Spacing="8" IsVisible="{Binding !NoBackups}">
              <TextBlock Text="{Binding Newest.OneLine}" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="{Binding KeepText}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ⛔ «فرستادن به سرور» همین‌جا، کنارِ بقیهٔ کارهای بکاپ (۱۴۰۵/۰۷/۱۵) -->
            <WrapPanel Orientation="Horizontal">
              <WrapPanel.Styles>
                <Style Selector="WrapPanel > Button">
                  <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
              </WrapPanel.Styles>
              <!-- ⛔ بکاپ و «فایلِ کامل» یکی شدند (۱۴۰۵/۰۷/۱۶): فایلِ بکاپ همان
                   ‎.pumpyaqobi‎ است — دفتر + تم و تنظیمات، سنجیده، برای فلش. -->
              <Button Classes="accent" Content="💾 ذخیرهٔ فایلِ بکاپ"
                      Command="{Binding ExportFullCommand}" IsEnabled="{Binding !Busy}" />
              <Button Classes="ghost" Content="📸 بکاپِ همین حالا"
                      Command="{Binding SnapshotNowCommand}" IsEnabled="{Binding !Busy}" />
              <Button Classes="accent" Content="📤 فرستادن به سرور"
                      Command="{Binding SendToServerCommand}" IsEnabled="{Binding !SendingToServer}" />
              <Button Classes="ghost" Content="📂 پوشهٔ بکاپ‌ها"
                      Command="{Binding OpenBackupFolderCommand}" />
              <!-- ⛔ شورا، بندِ ۱: عددِ ناخوانای روی دیسک دیده شود، نه بی‌صدا صفر -->
              <Button Classes="ghost" Content="🩺 سلامتِ دفتر"
                      Command="{Binding CheckHealthCommand}" IsEnabled="{Binding !Busy}" />
              <Button Classes="ghost danger" Content="↩ بازگرداندنِ همین بکاپ"
                      Command="{Binding RestoreNewestCommand}"
                      IsVisible="{Binding CanRestore}" IsEnabled="{Binding !Busy}" />
              <Button Classes="ghost danger" Content="↩ بازگردانی از فایل"
                      Command="{Binding RestoreFromFileCommand}"
                      IsVisible="{Binding CanRestore}" IsEnabled="{Binding !Busy}" />
            </WrapPanel>

            <!-- ⛔ بکاپ‌های روی سرورِ حساب — دیدن و برگرداندن (۱۴۰۵/۰۷/۲۰): تا امروز فقط فرستاده می‌شد -->
            <Border Classes="card calm" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="☁️ بکاپ‌های روی سرورِ حساب" FontWeight="Bold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="روی کامپیوترِ تازه یا پس از نصبِ دوباره، با همان حساب وارد شوید و بکاپِ دلخواه را برگردانید. پیش از جایگزینی، شمارِ رکوردها گفته می‌شود و از حالِ فعلی یک بکاپِ ایمنی گرفته می‌شود." />
                <WrapPanel>
                  <Button Classes="accent" Content="🔄 دیدنِ بکاپ‌های روی سرور" Margin="0,0,8,0"
                          Command="{Binding LoadCloudBackupsCommand}" IsEnabled="{Binding !CloudBusy}" />
                  <TextBlock Text="{Binding CloudStatus}" TextWrapping="Wrap" FontWeight="Bold" VerticalAlignment="Center"
                             Foreground="{Binding CloudStatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                             IsVisible="{Binding CloudStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </WrapPanel>
                <ProgressBar IsIndeterminate="{Binding CloudBusy}" Height="5" IsVisible="{Binding CloudBusy}" />
                <ItemsControl ItemsSource="{Binding CloudBackups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CloudBackupRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost danger" Content="↩ برگرداندن" VerticalAlignment="Center"
                                Command="{Binding Owner.RestoreCloudCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- ⛔ شورا ب۵: بکاپی که فقط روی همین دیسک است، با یک دیسکِ سوخته می‌رود -->
            <Border Classes="card calm" Padding="12" IsVisible="{Binding OnlyLocal}">
              <StackPanel Spacing="8">
                <TextBlock Text="⚠️ بکاپ فقط روی همین کامپیوتر است" FontWeight="Bold"
                           Foreground="{DynamicResource Pump.Ink.Warn}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="اگر این دیسک خراب شود یا کامپیوتر برود، بکاپ‌ها هم با آن می‌روند. یکی از این دو کافی است: فایلِ بکاپ روی فلش (ماهی یک بار)، یا فرستادن به سرور (هر هفته خودکار)." />
                <WrapPanel>
                  <Button Classes="accent" Content="💾 فایلِ بکاپ روی فلش" Margin="0,0,8,0"
                          Command="{Binding ExportFullCommand}" IsEnabled="{Binding !Busy}" />
                  <Button Classes="accent" Content="📤 فرستادن به سرور"
                          Command="{Binding SendToServerCommand}" IsEnabled="{Binding !SendingToServer}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- ⛔ شورا ب۵: آزمونِ بازیابی — ماهی یک بار خودکار، و همین حالا با یک دکمه -->
            <WrapPanel>
              <Button Classes="ghost" Content="🧪 آزمونِ بازیابی — همین حالا" Margin="0,0,8,0"
                      Command="{Binding DrillNowCommand}" IsEnabled="{Binding !Busy}" />
              <TextBlock Text="{Binding DrillText}" TextWrapping="Wrap" FontWeight="Bold" VerticalAlignment="Center"
                         Foreground="{Binding DrillBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                         IsVisible="{Binding DrillText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </WrapPanel>

            <!-- ⛔ شورا ب۱: تعارضِ دو کامپیوتر دیده می‌شود، نه بی‌صدا -->
            <Border Classes="card calm" Padding="12" IsVisible="{Binding HasConflicts}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ConflictsTitle}" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Pump.Ink.Warn}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="هیچ مقداری گم نشده: یکی در دفتر است و دیگری همین‌جا. «همین بماند» فقط این یادداشت را می‌بندد؛ «آن یکی را برگردان» مقدارِ دیگر را می‌نشاند و به کامپیوترهای دیگر هم می‌فرستد." />
                <ItemsControl ItemsSource="{Binding Conflicts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConflictRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding When}" Classes="muted" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="ghost" Content="✔ همین بماند"
                                  Command="{Binding Owner.KeepConflictCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="accent" Content="↩ آن یکی را برگردان"
                                  Command="{Binding Owner.RestoreConflictCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding HealthText}" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{Binding HealthBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                       IsVisible="{Binding HealthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ProgressBar IsIndeterminate="{Binding SendingToServer}" Height="5"
                         IsVisible="{Binding SendingToServer}" />
            <TextBlock Text="{Binding ServerStatus}" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{Binding ServerStatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                       IsVisible="{Binding ServerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding FullStatus}" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{Binding FullStatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                       IsVisible="{Binding FullStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="فایلِ بکاپ همهٔ حساب‌ها و تنظیمات را دارد و روی فلش یا کامپیوترِ دیگر با دوبار-کلیک باز می‌شود. بازگردانی جای حساب‌های فعلی را می‌گیرد؛ پیش از آن یک بکاپِ ایمنی گرفته می‌شود." />

            <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ بقیهٔ بکاپ‌ها — کشویی ═══════════════════════════════════════
           ⚠️ جدولِ داخلِ کادرِ بسته نامرئی است و ‎ExcelGrid‎ ردیف‌هایش را پارک
           می‌کند. با یک ‎ItemsControl‎ ساده، همهٔ ردیف‌ها تا ابد زنده می‌ماندند
           — همان چیزی که سنجشِ ‎idle‎ قدغن کرده. -->
      <StackPanel Spacing="8" IsVisible="{Binding HasOlder}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="ghost" Content="{Binding ToggleText}"
                  Command="{Binding ToggleOlderCommand}" />
          <TextBlock Text="{Binding OlderText}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <Border Classes="panel" Padding="0" IsVisible="{Binding ShowOlder}">
          <StackPanel>
            <c:ExcelGrid ItemsSource="{Binding Older}" x:CompileBindings="False"
                         SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                         IsReadOnly="True" BorderThickness="0" CornerRadius="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="روز" Binding="{Binding Day}" Width="Auto" />
                <DataGridTextColumn Header="ساعت" Binding="{Binding TakenText}" Width="Auto" />
                <DataGridTextColumn Header="اندازه" Binding="{Binding SizeText}" Width="*" />
              </DataGrid.Columns>
            </c:ExcelGrid>
            <Button Classes="ghost danger" Margin="14,10" HorizontalAlignment="Right"
                    Content="بازگرداندنِ بکاپِ انتخاب‌شده"
                    Command="{Binding RestoreSelectedCommand}"
                    IsVisible="{Binding CanRestore}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ══ خروجیِ یک حساب یا بخش — فایلِ خودِ برنامه (‎.pumphesab‎)، ۱۴۰۵/۰۷/۱۹ ══════════════════════
           ⛔ همان راهِ همگام‌سازی: هیچ پاک کردنی، و پاک‌شده‌ای زنده نمی‌شود. -->
      <Border Classes="panel" Padding="0">
        <StackPanel>
          <Border Classes="card-head">
            <TextBlock Text="📤 خروجیِ یک حساب یا بخش" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>
          <StackPanel Margin="14" Spacing="10">
            <WrapPanel Orientation="Horizontal">
              <WrapPanel.Styles>
                <Style Selector="WrapPanel > :is(Control)">
                  <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
              </WrapPanel.Styles>
              <ComboBox Name="PortableKindBox" MinWidth="200" ItemsSource="{x:Static vm:BackupSectionViewModel.PortableKinds}"
                        SelectedItem="{Binding PortableKind, Mode=TwoWay}" />
              <ComboBox Name="PortableTargetBox" MinWidth="220" ItemsSource="{Binding PortableTargets}"
                        SelectedItem="{Binding PortableTarget, Mode=TwoWay}"
                        IsVisible="{Binding PortableNeedsTarget}" />
              <TextBox Name="PortableFromBox" Width="130" Watermark="از ماه — 1405/01"
                       Text="{Binding PortableFrom, Mode=TwoWay}" />
              <TextBox Name="PortableToBox" Width="130" Watermark="تا ماه — خالی: همان یک ماه"
                       Text="{Binding PortableTo, Mode=TwoWay}" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <WrapPanel.Styles>
                <Style Selector="WrapPanel > Button">
                  <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
              </WrapPanel.Styles>
              <Button Classes="accent" Content="📤 ساختنِ فایلِ حساب"
                      Command="{Binding ExportPortableCommand}"
                      IsVisible="{Binding CanRestore}" IsEnabled="{Binding !Busy}" />
              <Button Classes="ghost" Content="📥 آوردن از فایلِ حساب"
                      Command="{Binding ImportPortableCommand}"
                      IsVisible="{Binding CanRestore}" IsEnabled="{Binding !Busy}" />
            </WrapPanel>
            <TextBlock Text="{Binding PortableStatus}" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{Binding PortableStatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                       IsVisible="{Binding PortableStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="یک نفر، یک شرکت یا یک بخش؛ فقط «از ماه» = همان یک ماه، هر دو خالی = همه. همین فایل دوباره همین‌جا می‌آید: ردیف‌ها می‌نشینند یا به‌روز می‌شوند، هیچ ردیفی پاک نمی‌شود." />
            <CheckBox Content="پیش از بستنِ برنامه، اگر چیزی نوشته شده و بکاپ نگرفته‌ام، بپرسد"
                      IsChecked="{Binding AskBackupOnExit, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ به‌روزرسانیِ برنامه ══════════════════════════════════════════
           ⚠️ عمداً هیچ نشانی یا نامِ منبعی نوشته نمی‌شود — فقط نسخه و دکمه. -->
      <Border Classes="panel" Padding="0">
        <StackPanel>
          <Border Classes="card-head">
            <TextBlock Text="⬇️ به‌روزرسانیِ برنامه" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>
          <StackPanel Margin="14" Spacing="10">
            <TextBlock Text="{Binding CurrentVersion, StringFormat=نسخهٔ فعلی: {0}}" FontWeight="Bold" />

            <TextBlock Text="{Binding InstallDir, StringFormat=پوشهٔ برنامه: {0}}" Classes="muted"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding InstallNote}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding InstallNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Pump.Ink.Warn}" />

            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                       Foreground="{Binding UpdateStatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                       IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding PackageText}" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Ok}"
                       IsVisible="{Binding PackageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding LastSuccess}" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Ok}"
                       IsVisible="{Binding LastSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding LastFailure}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Pump.Ink.Danger}"
                       IsVisible="{Binding LastFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" Height="7"
                         IsVisible="{Binding Downloading}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <!-- ⛔ کارِ اصلیِ این کارت است، پس تاکیدی می‌ماند: کاربر باید
                   بی گشتن پیدایش کند (۱۴۰۵/۰۷/۰۶).
                   ⛔ و **هیچ‌وقت خاکستری نمی‌شود**: بررسیِ خودکارِ سرِ باز شدنِ
                   صفحه ‎Checking‎ را روشن می‌کرد و با شبکهٔ کند این دکمه تا
                   ۷۵ ثانیه مرده بود — کاربر می‌زد و هیچ اتفاقی نمی‌افتاد.
                   کلیک، بررسیِ در جریان را لغو می‌کند و از نو می‌پرسد. -->
              <Button Classes="accent" Content="🔄 بررسیِ به‌روزرسانی"
                      Command="{Binding CheckUpdateCommand}" />
              <Button Classes="accent" Content="گرفتنِ نسخهٔ تازه"
                      Command="{Binding DownloadUpdateCommand}"
                      IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !Downloading}" />
              <Button Classes="accent" Content="نصب و راه‌اندازیِ دوباره"
                      Command="{Binding InstallUpdateCommand}"
                      IsVisible="{Binding ReadyToInstall}" />
            </StackPanel>

            <!-- بی اینترنت: فایلِ نصبِ تازه از فلش (۱۴۰۵/۰۷/۱۵) — کهنه‌تر رد می‌شود -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="💿 نصبِ نسخهٔ تازه از فایل (بی اینترنت)"
                      Command="{Binding InstallFromFileCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="فایلِ PumpYaqobi-Setup.exe را از فلش بدهید؛ فقط نسخهٔ تازه‌تر پذیرفته می‌شود." />
            <TextBlock Text="{Binding OfflineStatus}" TextWrapping="Wrap" FontWeight="Bold"
                       Foreground="{Binding OfflineStatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                       IsVisible="{Binding OfflineStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </c:SectionPage>
</UserControl>
