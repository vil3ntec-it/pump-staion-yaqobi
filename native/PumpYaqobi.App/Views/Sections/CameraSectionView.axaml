<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.CameraSectionView"
             x:DataType="vm:CameraSectionViewModel">

  <c:SectionPage Header="دوربین‌های مداربسته"
                 SubHeader="عکسِ زندهٔ دوربین‌های شبکه‌ای داخلِ برنامه می‌آید؛ HLS و RTSP به پخش‌کنندهٔ ویندوز سپرده می‌شوند">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="10">

      <!-- ══ افزودن ══ -->
      <Border Classes="panel" Padding="12,10">
        <StackPanel Spacing="8">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Spacing="3" Width="170" Margin="0,0,10,6">
              <TextBlock Text="نام دوربین" Classes="label" />
              <TextBox Text="{Binding NewName}" Watermark="اختیاری" />
            </StackPanel>

            <StackPanel Spacing="3" Width="340" Margin="0,0,10,6">
              <TextBlock Text="لینک دوربین" Classes="label" />
              <TextBox Text="{Binding NewUrl}" Watermark="http://192.168.1.9/cgi-bin/snapshot.cgi" />
            </StackPanel>

            <StackPanel Spacing="3" Width="180" Margin="0,0,10,6">
              <TextBlock Text=" " Classes="label" />
              <Button Content="🖼️ خواندن از عکسِ کیو‌آر" Command="{Binding AddByQrCommand}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- ➕ وب‌کم‌های وصل‌شده را می‌شمارد و هر کدام را که هنوز در فهرست
                 نیست اضافه می‌کند — همان ‎refreshLocalCams‎ی نسخهٔ وب. -->
            <StackPanel Spacing="3" Width="165" Margin="0,0,10,6">
              <TextBlock Text=" " Classes="label" />
              <Button Content="📷 دوربین‌های USB" Command="{Binding AddUsbCommand}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="وب‌کم‌های وصل‌شده را پیدا و اضافه می‌کند" />
            </StackPanel>

            <StackPanel Spacing="3" Width="130" Margin="0,0,10,6">
              <TextBlock Text=" " Classes="label" />
              <Button Classes="accent" Content="➕ ذخیرهٔ دوربین" Command="{Binding AddCommand}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>
          </WrapPanel>

          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="لینکِ عکسِ لحظه‌ای یا MJPEG (snapshot.cgi · /mjpg/ · videostream.cgi) همین‌جا زنده پخش می‌شود. اگر فقط RTSP دارید، از خودِ NVR/DVR لینکِ HTTP یا HLS بگیرید." />
        </StackPanel>
      </Border>

      <!-- ══ کارت‌ها ══ -->
      <ItemsControl ItemsSource="{Binding Cameras}" x:CompileBindings="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="360" Margin="0,0,10,10" Padding="0">
              <StackPanel>
                <Border Classes="card-head">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                 Foreground="{DynamicResource Pump.Accent}" />
                      <Border Classes="pill"><TextBlock Text="{Binding KindText}" /></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <Button Classes="ghost" Content="▶" Padding="8,2" FontSize="12"
                              Command="{Binding ToggleCommand}" ToolTip.Tip="پخش / توقف" />
                      <Button Classes="ghost" Content="⟳" Padding="8,2" FontSize="12"
                              Command="{Binding ReloadCommand}" ToolTip.Tip="تازه کردن تصویر" />
                      <Button Classes="ghost danger" Content="✕" Padding="8,2" FontSize="12"
                              Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="حذف دوربین" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Height="210" Background="{DynamicResource Pump.Dark}">
                  <Panel>
                    <Image Source="{Binding Frame}" Stretch="Uniform" />
                    <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap"
                               Margin="14" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding !ShowsInApp}" />
                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                               Margin="14" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Panel>
                </Border>

                <Border Padding="10,7">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding Url}" Classes="muted" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <Button Classes="ghost" Content="🖥️ باز کردن در ویندوز" Padding="8,3" FontSize="11"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding !ShowsInApp}"
                            Command="{Binding ToggleCommand}" />

                    <!-- 🔍 پویشِ زندهٔ کیو‌آر — کیو‌آرِ دوربینِ تازه را جلوی همین
                         دوربین بگیرید؛ لینکش در کادرِ «دوربینِ تازه» می‌نشیند. -->
                    <Button Classes="ghost" Content="{Binding ScanText}" Padding="8,3" FontSize="11"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CanScan}"
                            Classes.danger="{Binding Scanning}"
                            Command="{Binding ToggleScanCommand}"
                            ToolTip.Tip="کیو‌آر را جلوی این دوربین بگیرید" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="label" HorizontalAlignment="Center" Margin="0,14"
                 IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" TextAlignment="Center"
                 Text="هنوز دوربینی ثبت نشده — لینک را بنویسید یا از عکسِ کیو‌آرِ روی خودِ دوربین بخوانید" />
    </StackPanel>
    </ScrollViewer>
  </c:SectionPage>
</UserControl>
