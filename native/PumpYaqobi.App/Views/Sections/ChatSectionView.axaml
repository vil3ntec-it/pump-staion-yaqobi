<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ChatSectionView"
             x:DataType="vm:ChatSectionViewModel">

  <!-- ══ پیام‌رسانِ تمام‌صفحه — فهرست · گفت‌وگو · مشخصات ══════════════════════
       خواستهٔ صاحب ریپو (۱۴۰۵/۰۷/۱۳) با عکسِ مرجع: «تمام‌صفحه بشه… یک طرف من
       با کاربرهایی که حساب دارن و یک طرف همون یارو که بهم پیام داده و پایینش
       اطلاعاتِ یارو، حساب‌هاش.»

       ⛔ بیرونِ SectionPage است و پوستهٔ پنجره هم پنهان است
       (IsPageOpen ⇒ MainViewModel.IsChromeVisible) — همان راهِ صفحهٔ ورود.
       ⚠️ بلندی از TopLevel.ClientSize می‌آید (ChatSectionView.axaml.cs)، وگرنه
       داخلِ ScrollViewerِ پوسته بلندیِ خودکار می‌گرفت و فهرست‌ها نمی‌لغزیدند. -->
  <Border x:Name="ChatPage" Background="{DynamicResource Pump.AppBg}" Padding="14">
    <Grid ColumnDefinitions="310,*,320">

      <!-- ══ ۱) فهرستِ گفت‌وگوها ════════════════════════════════════════════ -->
      <Border Grid.Column="0" Classes="panel chatcol" Margin="0,0,12,0" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,14,6">
            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="💬 پیام‌رسان" FontWeight="ExtraBold" FontSize="17" TextAlignment="Start" />
              <TextBlock Text="{Binding State}" FontSize="11" TextAlignment="Start"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Pump.Muted}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="‹ برگشت" Padding="12,5"
                    Command="{Binding BackCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="برگشت به برنامه" />
          </Grid>

          <TextBox Grid.Row="1" Margin="12,4,12,8" Text="{Binding Search}"
                   Watermark="🔍 جست‌وجوی نام…" MinHeight="38" VerticalContentAlignment="Center" />

          <ListBox Grid.Row="2" ItemsSource="{Binding Shown}" SelectedItem="{Binding Current}"
                   Background="Transparent" BorderThickness="0" Padding="6,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatThreadViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,7">
                  <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                          Margin="0,0,10,0" VerticalAlignment="Center"
                          Background="{Binding AvatarKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                    <TextBlock Text="{Binding Avatar}" FontWeight="ExtraBold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                               TextAlignment="Start" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Preview}" FontSize="11.5" TextAlignment="Start"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Pump.Muted}"
                               IsVisible="{Binding HasPreview}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" TextAlignment="Start"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Pump.Muted}"
                               IsVisible="{Binding !HasPreview}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="{Binding PreviewTime}" FontSize="10.5" TextAlignment="Center"
                               Foreground="{DynamicResource Pump.Muted}" />
                    <Border CornerRadius="999" IsVisible="{Binding HasUnread}" HorizontalAlignment="Center"
                            Background="{DynamicResource Pump.Danger}" Padding="7,1" MinWidth="22">
                      <TextBlock Text="{Binding Unread}" FontSize="11" FontWeight="ExtraBold"
                                 TextAlignment="Center" Foreground="White" />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="3" Margin="14,8,14,12" FontSize="10.5" TextWrapping="Wrap"
                     TextAlignment="Start" Foreground="{DynamicResource Pump.Muted}"
                     Text="{Binding RetentionText}" />
        </Grid>
      </Border>

      <!-- ══ ۲) خودِ گفت‌وگو ════════════════════════════════════════════════ -->
      <Border Grid.Column="1" Classes="panel chatcol" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">

          <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource Pump.Border}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Background="{Binding Current.AvatarKey, FallbackValue=Pump.Accent, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                <TextBlock Text="{Binding Current.Avatar}" FontWeight="ExtraBold" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Current.Title}" FontWeight="ExtraBold" FontSize="16"
                           TextAlignment="Start" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Current.Subtitle}" FontSize="11.5" TextAlignment="Start"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Pump.Muted}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" Content="{Binding TrashText}" Padding="12,5"
                      Command="{Binding ToggleTrashCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="پیام‌های سطل ۱۵ روز می‌مانند و بعد کامل حذف می‌شوند" />
              <Button Grid.Column="3" Classes="ghost danger" Content="{Binding Current.BlockText}"
                      Command="{Binding ToggleBlockCommand}" Padding="12,5" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Current.IsCustomer, FallbackValue=False}"
                      ToolTip.Tip="مشتریِ بلاک‌شده نمی‌تواند بنویسد، ولی حسابش را می‌بیند" />
            </Grid>
          </Border>

          <Panel Grid.Row="1">
            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="440" IsVisible="{Binding IsEmpty}">
              <TextBlock Text="💬" FontSize="44" TextAlignment="Center" />
              <TextBlock Text="{Binding EmptyText}" FontSize="13" TextAlignment="Center"
                         TextWrapping="Wrap" Foreground="{DynamicResource Pump.Muted}" />
            </StackPanel>

            <ScrollViewer x:Name="Bubbles" VerticalScrollBarVisibility="Auto" Padding="16,12">
              <ItemsControl ItemsSource="{Binding Current.Messages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Border Classes="bubble" Classes.mine="{Binding Mine}" Classes.trashed="{Binding Trashed}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding NotMine}">
                            <TextBlock Text="{Binding Sender}" FontSize="11.5" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource Pump.Accent}" />
                            <Border Classes="pill" Padding="6,0" IsVisible="{Binding HasRole}"
                                    Background="{DynamicResource Pump.Input}">
                              <TextBlock Text="{Binding Role}" FontSize="10" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5"
                                     TextAlignment="Start" IsVisible="{Binding IsText}" />
                          <TextBlock Text="🚫 این پیام پاک شد" FontSize="12" FontStyle="Italic"
                                     Foreground="{DynamicResource Pump.Muted}" IsVisible="{Binding Deleted}" />
                          <TextBlock Text="🗃 این رسانه روی سرور منقضی شده بود" FontSize="12" FontStyle="Italic"
                                     Foreground="{DynamicResource Pump.Muted}" IsVisible="{Binding Gone}" />
                          <Border CornerRadius="10" ClipToBounds="True" IsVisible="{Binding IsImage}"
                                  HorizontalAlignment="Left">
                            <Image Source="{Binding Image}" MaxWidth="320" MaxHeight="320" Stretch="Uniform" />
                          </Border>
                          <Button Classes="ghost" Content="{Binding MediaLabel}" IsVisible="{Binding IsMedia}"
                                  Command="{Binding $parent[ItemsControl].((vm:ChatSectionViewModel)DataContext).OpenMediaCommand}"
                                  CommandParameter="{Binding}" Padding="10,4" HorizontalAlignment="Left" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{DynamicResource Pump.Muted}" />
                            <TextBlock Text="⏳ در صف" FontSize="10.5" IsVisible="{Binding IsPending}"
                                       Foreground="{DynamicResource Pump.Warn}" />
                            <TextBlock Text="{Binding DaysLeft}" FontSize="10.5" Foreground="{DynamicResource Pump.Muted}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2" Margin="6,0,0,0">
                          <Button Classes="bubbledel" Content="🗑" Padding="4,0" FontSize="12"
                                  IsVisible="{Binding CanDelete}" ToolTip.Tip="پاک کردن"
                                  Command="{Binding $parent[ItemsControl].((vm:ChatSectionViewModel)DataContext).DeleteMessageCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="ghost" Content="↩ برگرداندن" Padding="8,2" FontSize="11"
                                  IsVisible="{Binding Trashed}" ToolTip.Tip="برگرداندن به گفت‌وگو"
                                  Command="{Binding $parent[ItemsControl].((vm:ChatSectionViewModel)DataContext).RestoreCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>

          <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource Pump.Border}"
                  BorderThickness="0,1,0,0" IsVisible="{Binding !ShowTrash}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
              <Button Grid.Column="0" Classes="ghost" Content="📎" Padding="11,5" FontSize="15"
                      ToolTip.Tip="عکس یا ویدیو" Command="{Binding AttachCommand}"
                      IsVisible="{Binding Current.CanAttach, FallbackValue=False}" />
              <Button Grid.Column="1" Classes="ghost" Content="{Binding RecordText}" Padding="11,5"
                      Classes.danger="{Binding Recording}" Command="{Binding RecordCommand}"
                      Margin="5,0,0,0" ToolTip.Tip="ضبطِ صدا">
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="Current.CanAttach" FallbackValue="False" />
                    <Binding Path="CanRecord" />
                  </MultiBinding>
                </Button.IsVisible>
              </Button>
              <TextBox Grid.Column="2" Text="{Binding Draft}" Watermark="پیام‌تان را بنویسید…"
                       Margin="7,0,0,0" MinHeight="44" VerticalContentAlignment="Center"
                       AcceptsReturn="False" />
              <Button Grid.Column="3" Classes="accent" Content="فرستادن ➤" Margin="9,0,0,0"
                      MinWidth="112" MinHeight="44" Command="{Binding SendCommand}" IsDefault="True" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ══ ۳) مشخصاتِ همان کسی که پیام داده ═══════════════════════════════ -->
      <Border Grid.Column="2" Classes="panel chatcol" Margin="12,0,0,0" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="16,18">

            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                      Background="{Binding Current.AvatarKey, FallbackValue=Pump.Accent, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                <TextBlock Text="{Binding Current.Avatar}" FontWeight="ExtraBold" FontSize="36"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding InfoTitle}" FontWeight="ExtraBold" FontSize="17"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="{Binding InfoKind}" FontSize="12" TextAlignment="Center"
                         Foreground="{DynamicResource Pump.Muted}" />
              <TextBlock Text="{Binding InfoPhone, StringFormat='📞 {0}'}" FontSize="12.5" TextAlignment="Center"
                         IsVisible="{Binding HasInfoPhone}" />
            </StackPanel>

            <Button Classes="accent" Content="📒 باز کردنِ حساب" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" MinHeight="38"
                    Command="{Binding OpenAccountCommand}"
                    IsVisible="{Binding Current.IsCustomer, FallbackValue=False}" />

            <!-- دفترهای همین حساب — همان عددهای کیو‌آرش -->
            <ItemsControl ItemsSource="{Binding InfoBooks}" IsVisible="{Binding HasInfoBooks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatInfoBook">
                  <Border Classes="chatinfo" Margin="0,0,0,8">
                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextAlignment="Start" />
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChatInfoLine">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" TextAlignment="Start"
                                         Foreground="{DynamicResource Pump.Muted}" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="Bold"
                                         Classes="chatval" Classes.accent="{Binding IsAccent}" Classes.muted2="{Binding IsMuted}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- حساب‌های دیگرِ همین شخص -->
            <Border Classes="chatinfo" IsVisible="{Binding HasInfoAccounts}">
              <StackPanel Spacing="5">
                <TextBlock Text="🗂 حساب‌های این شخص" FontWeight="Bold" FontSize="13" TextAlignment="Start" />
                <ItemsControl ItemsSource="{Binding InfoAccounts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatInfoLine">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" TextAlignment="Start" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                   Classes="chatval" Classes.accent="{Binding IsAccent}" Classes.muted2="{Binding IsMuted}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- اعضای گروه -->
            <Border Classes="chatinfo" IsVisible="{Binding HasMembers}">
              <StackPanel Spacing="5">
                <TextBlock Text="👥 در این گروه نوشته‌اند" FontWeight="Bold" FontSize="13" TextAlignment="Start" />
                <ItemsControl ItemsSource="{Binding Members}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatInfoLine">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" TextAlignment="Start" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                   Foreground="{DynamicResource Pump.Muted}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- رسانه‌های فرستاده‌شده -->
            <Border Classes="chatinfo">
              <StackPanel Spacing="8">
                <TextBlock Text="🖼 رسانه‌ها" FontWeight="Bold" FontSize="13" TextAlignment="Start" />
                <UniformGrid Columns="3">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding ImageCount}" FontWeight="ExtraBold" FontSize="16" TextAlignment="Center" />
                    <TextBlock Text="عکس" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Pump.Muted}" />
                  </StackPanel>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding VideoCount}" FontWeight="ExtraBold" FontSize="16" TextAlignment="Center" />
                    <TextBlock Text="ویدیو" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Pump.Muted}" />
                  </StackPanel>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding AudioCount}" FontWeight="ExtraBold" FontSize="16" TextAlignment="Center" />
                    <TextBlock Text="صدا" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Pump.Muted}" />
                  </StackPanel>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding SharedImages}" IsVisible="{Binding HasSharedImages}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                      <Border CornerRadius="8" ClipToBounds="True" Margin="3" Height="78"
                              Background="{DynamicResource Pump.Input}">
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding InfoNote}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Start"
                       Foreground="{DynamicResource Pump.Muted}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Border>
</UserControl>
