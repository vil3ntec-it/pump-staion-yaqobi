<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.CompanyArchiveView"
             x:DataType="vm:CompanyArchivePageViewModel">

  <!-- ══ 🗂️ جدول‌های آرشیوِ یک تیل — ‎companyArchiveModal‎ی سایت ═══════════
       تازه‌ترین اول. هر جدول: سربرگ، دو دکمهٔ خریدهای همان بازه، جدولِ
       خواندنی با نشانِ 📦، جمله، و «حذفِ این آرشیو». -->
  <c:SectionPage Header="{Binding Title}"
                 SubHeader="هر بار «جدول جدید» زده شود، جدولِ همان تیل این‌جا می‌آید. خودِ داده‌ها دست‌نخورده‌اند.">
    <c:SectionPage.Toolbar>
      <Button Classes="accent" Content="✕ بستن" Command="{Binding CloseCommand}" />
    </c:SectionPage.Toolbar>

    <StackPanel Spacing="12">
      <TextBlock Text="{Binding EmptyText}" Classes="muted" HorizontalAlignment="Center" Margin="0,26"
                 IsVisible="{Binding IsEmpty}" />
      <ItemsControl ItemsSource="{Binding Archives}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CompanyArchiveViewModel">
            <Border Classes="panel" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" FontWeight="Black" FontSize="15" VerticalAlignment="Center" Margin="0,0,14,4" />
                  <Button Classes="ghost ok" Content="{Binding PetrolBuyText}" Command="{Binding OpenPurchasesCommand}"
                          CommandParameter="petrol" Margin="0,0,6,4" />
                  <Button Classes="ghost" Content="{Binding DieselBuyText}" Command="{Binding OpenPurchasesCommand}"
                          CommandParameter="diesel" Margin="0,0,6,4"
                          Foreground="{DynamicResource Pump.Warn}" BorderBrush="{DynamicResource Pump.Warn}" />
                </WrapPanel>
                <c:ExcelGrid ItemsSource="{Binding Rows}" x:CompileBindings="False" IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="📦" Binding="{Binding LinkMark}" Width="Auto" />
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="نام" Binding="{Binding NameText}" Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="خرید (تن)" Binding="{Binding TonText}" Width="Auto" />
                    <DataGridTextColumn Header="قیمت تن ($)" Binding="{Binding UsdText}" Width="Auto" />
                    <DataGridTextColumn Header="کل ($)" Binding="{Binding TotalUsdText}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="نرخ" Binding="{Binding RateText}" Width="Auto" />
                    <DataGridTextColumn Header="کل (افغانی)" Binding="{Binding TotalAfnText}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="رسید" Binding="{Binding PoulText}" Width="Auto" />
                    <DataGridTemplateColumn Header="الباقی" Width="Auto">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding AlbaqiText}" FontWeight="Bold" VerticalAlignment="Center"
                                     Foreground="{Binding AlbaqiBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </c:ExcelGrid>
                <c:TotalsBar ItemsSource="{Binding Totals}" />
                <Button Classes="ghost danger" Content="🗑️ حذفِ این آرشیو" HorizontalAlignment="Right"
                        Padding="10,4" FontSize="11" Command="{Binding DeleteCommand}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </c:SectionPage>
</UserControl>
