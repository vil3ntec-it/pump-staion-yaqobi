<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.CompanyPageView"
             x:DataType="vm:CompanyPageViewModel">

  <c:SectionPage Header="{Binding Name}" SubHeader="دفترِ خرید و رسیدِ همین شرکت">

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleSwitch OnContent="دیزل" OffContent="پطرول" IsChecked="{Binding IsDiesel}" />
        <Button Classes="ghost info" Content="PDF" Command="{Binding PdfCommand}" />
        <Button Classes="ghost info" Content="هر دو تیل" Command="{Binding PdfBothCommand}" />
        <Button Classes="accent" Content="بازگشت به فهرست" Command="{Binding BackCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Summary>
      <!-- ‎Rows="1"‎ یعنی «همه در یک ردیف، با عرضِ مساوی» — کادرها تا لبه پخش
           می‌شوند به‌جای آن‌که راست جمع شوند و کنارشان خالی بماند. -->
      <UniformGrid Rows="1" Classes="stats">
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="کلِ خرید" Classes="label" />
            <TextBlock Text="{Binding TotalAfn, StringFormat={}{0} افغانی}" Classes="num" />
            <TextBlock Text="{Binding TotalUsd, StringFormat={}{0} دالر}" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="رسید" Classes="label" />
            <TextBlock Text="{Binding PaidAfn, StringFormat={}{0} افغانی}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="الباقی" Classes="label" />
            <TextBlock Text="{Binding AlbaqiAfn, StringFormat={}{0} افغانی}" Classes="num" />
            <TextBlock Text="{Binding AlbaqiUsd, StringFormat={}{0} دالر}" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="نرخِ تبدیل" Classes="label" />
            <TextBlock Text="{Binding ConvRate}" Classes="num" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </c:SectionPage.Summary>

    <!-- جدول + ردیفِ «جمله»ی همین دفتر (پطرول و دیزل جدا) -->
    <Grid RowDefinitions="*,Auto">
    <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False"
                RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteRowCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
        <DataGridTextColumn Header="شرح"   Binding="{Binding Name}" Width="Auto" />
        <DataGridTextColumn Header="کیلو"  Binding="{Binding KgText}" Width="Auto" />
        <DataGridTextColumn Header="تن"    Binding="{Binding TonText}" Width="Auto" />
        <DataGridTextColumn Header="فیِ تن ($)" Binding="{Binding UsdText}" Width="Auto" />
        <DataGridTextColumn Header="نرخ"   Binding="{Binding RateText}" Width="Auto" />
        <DataGridTextColumn Header="کلِ دالر" Binding="{Binding TotalUsdText}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="کلِ افغانی" Binding="{Binding TotalAfnText}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="رسید"  Binding="{Binding PoulText}" Width="Auto" />
        <DataGridTemplateColumn Header="واحدِ رسید" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو-سه گزینه، ‎ComboBox‎ یک قالبِ کامل با
                         ‎Popup‎ی خودش می‌ساخت — و ‎ledgerperf‎ گرفتش: نزدیک به چهل درصدِ
                         وقتِ باز شدنِ گاوصندوقِ ۲۰۰ ردیفی مالِ همین ستون‌ها بود. خواستهٔ
                         صاحب ریپو هم همین بود: «اون علامتِ ▾ فقط جا گرفته» و «با تب یا
                         اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ ‎celltoggle‎ را می‌زند. -->
                      <DataTemplate>
                        <Button Classes="fuelchip celltoggle" Content="{Binding PoulCurrencyText}"
                                Command="{Binding TogglePoulCurrencyCommand}"
                                Foreground="{Binding PoulCurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                BorderBrush="{Binding PoulCurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                ToolTip.Tip="زدنش واحدِ رسید را افغانی ⇄ دالر می‌کند" />
                      </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="الباقیِ افغانی" Binding="{Binding AlbaqiAfnText}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="الباقیِ دالر"  Binding="{Binding AlbaqiUsdText}" Width="Auto" IsReadOnly="True" />
      </DataGrid.Columns>
    </c:ExcelGrid>
    <c:TotalsBar Grid.Row="1" ItemsSource="{Binding TotalCells}" />
    </Grid>
  </c:SectionPage>
</UserControl>
