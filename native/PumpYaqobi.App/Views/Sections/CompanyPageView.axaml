<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.CompanyPageView"
             x:DataType="vm:CompanyPageViewModel">

  <!-- ══ حسابِ یک شرکتِ تیل — همان ‎#companyModal‎ی سایت ═══════════════════
       سربرگ: قبلی/بعدی، نامِ شرکت، دیزل/پطرول، تغییر نام، PDF.
       خلاصه: شش کادر (تن، کل دالر، کل افغانی، رسید دالر، رسید افغانی، الباقی).
       بالای جدول: تنها یک کادرِ کشوییِ «کارها» — جدول جدید، خریدهای پطرول و
       دیزل، جدول‌های آرشیو و جستجوی خرید، همه با شمارندهٔ خودشان.
       ته صفحه، دور از بقیه: «🗑️ حذف این جدول».
       ⚠️ ستونِ «کیلو» عمداً نیست — خواستهٔ صاحب ریپو: خرید به تن است و کیلو اضافه. -->
  <c:SectionPage Header="{Binding Name}" SubHeader="{Binding PosText, StringFormat='شرکت {0} — دفترِ خرید و رسیدِ همین شرکت'}">

    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Classes="ghost" Content="→ قبلی" Command="{Binding PrevCommand}" IsEnabled="{Binding CanPrev}" Margin="0,0,4,0" />
        <Button Classes="ghost" Content="بعدی ←" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Margin="0,0,10,0" />
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button Classes="seg" Content="⛽ پطرول" Command="{Binding SetFuelCommand}" CommandParameter="petrol" Classes.active="{Binding IsPetrol}" />
          <Button Classes="seg" Content="🟤 دیزل" Command="{Binding SetFuelCommand}" CommandParameter="diesel" Classes.active="{Binding IsDiesel}" />
        </StackPanel>
        <Button Classes="ghost" Content="✏️ تغییر نام" Command="{Binding RenameCommand}" Margin="0,0,6,0" />
        <Button Classes="ghost info" Content="📄 PDF" Command="{Binding PdfCommand}" Margin="0,0,6,0" />
        <Button Classes="ghost info" Content="هر دو تیل" Command="{Binding PdfBothCommand}" Margin="0,0,6,0" />
        <Button Classes="accent" Content="بازگشت به فهرست" Command="{Binding BackCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Summary>
      <UniformGrid Rows="1" Classes="stats">
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="جمله مقدار (تن)" Classes="label" />
            <TextBlock Text="{Binding TotalTon}" Classes="num" Foreground="{DynamicResource Pump.Ink.Info}" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="جمله کل دالر" Classes="label" />
            <TextBlock Text="{Binding TotalUsd, StringFormat={}{0} $}" Classes="num" Foreground="{DynamicResource Pump.Ink.Info}" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="جمله کل (افغانی)" Classes="label" />
            <TextBlock Text="{Binding TotalAfn, StringFormat={}{0} افغانی}" Classes="num" Foreground="{DynamicResource Pump.Ink.Accent}" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="رسید دالر" Classes="label" />
            <TextBlock Text="{Binding PaidUsd}" Classes="num" Foreground="{DynamicResource Pump.Ink.Ok}" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="رسید (افغانی)" Classes="label" />
            <TextBlock Text="{Binding PaidAfn, StringFormat={}{0} افغانی}" Classes="num" Foreground="{DynamicResource Pump.Ink.Ok}" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="جمله الباقی" Classes="label" />
            <TextBlock Text="{Binding AlbaqiAfn, StringFormat={}{0} AFN}" Classes="num"
                       Foreground="{Binding AlbaqiBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
            <TextBlock Text="{Binding AlbaqiUsd, StringFormat={}{0} $}" Classes="num2" />
            <TextBlock Text="{Binding AlbaqiStatus}" Classes="muted" FontWeight="Bold" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </c:SectionPage.Summary>

    <StackPanel Spacing="10">

      <!-- ══ «کارها» — یک کادرِ کشویی، و بس ═══════════════════════════════
           گزارشِ صاحب ریپو (۱۴۰۵/۰۷/۰۶): «چرا دوتا از هر کدام است؟ خریدهای
           دیزل و پطرول هم توی کشویی هست هم بیرونش… و کادرِ آرشیو را بیاور
           توی کادرِ کشویی بگذار که جا خیلی می‌گیرد.»

           ⛔ پس دو دکمهٔ آرشیو، دو دکمهٔ خرید و دکمهٔ جست‌وجو از این‌جا رفتند
           و همه‌شان داخلِ همان کشویی نشستند — با همان شمارنده‌ها در نوشتهٔ
           خودشان، که تنها چیزِ مفیدِ آن دکمه‌ها بود.

           ⚠️ «حذف این جدول» همچنان ته صفحه و دور از بقیه است. -->
      <!-- ⛔ «جدول‌های آرشیو» و «جستجوی خرید» از کشویی بیرون آمدند و کنارش
           نشستند (۱۴۰۵/۰۷/۰۷): «توی بخشِ شرکت‌ها بغلِ اون کادرِ کشویی باشن تا
           دیده بشن». کشویی از ۳۴۰ به ۲۶۰ کوتاه شد تا هر سه در یک خط جا شوند.
           ⚠️ «خریدهای مخزن» و «جدول جدید» عمداً داخلِ کشویی ماندند. -->
      <WrapPanel Orientation="Horizontal">
        <c:SettingCard Classes="card" MinWidth="260" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}"
                       Margin="0,0,8,6" ToolTip.Tip="کارهای این حساب — «حذف این جدول» عمداً ته صفحه است" />
        <Button Classes="ghost info" Content="{Binding ArcText}" Margin="0,0,8,6"
                Command="{Binding OpenArchiveCommand}"
                IsVisible="{Binding HasArchives}"
                ToolTip.Tip="همهٔ جدول‌های آرشیوِ این شرکت — کشویی، هر دو تیل" />
        <!-- ⛔ جستجوی خرید همین‌جا (۱۴۰۵/۰۷/۱۳): کادر + Enter ⇐ سرِ همان خرید، در هر حسابی که هست -->
        <TextBox Width="220" Text="{Binding FindText}" Margin="0,0,4,6"
                 Watermark="🔍 جستجوی خرید — مقدار یا تاریخ"
                 ToolTip.Tip="مقدار (کیلو یا تن) یا تاریخ را بنویسید و Enter بزنید — اگر پیدا شد، همان خرید در حسابِ خودش باز می‌شود">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding FindCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="ghost info" Content="🔍" Margin="0,0,8,6" Command="{Binding FindCommand}"
                ToolTip.Tip="جستجو" />
      </WrapPanel>

      <!-- ── جدول + ردیفِ «جمله»ی همین دفتر (پطرول و دیزل جدا) ─────────────
           ردیفِ 📦 از خریدِ مخزن آمده و خانه‌هایش تایپ نمی‌شوند (‎ILockedRow‎). -->
      <Grid RowDefinitions="*,Auto">
        <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False"
                     WidthScope="{Binding WidthScope}"
                     RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteRowCommand}">
          <DataGrid.Columns>
            <!-- ⛔ ستونِ «📦» برداشته شد (خواستهٔ صاحب ریپو، ۱۴۰۵/۰۷/۱۳). ردیفِ خریدِ مخزن همچنان قفل است (‎ILockedRow‎) و ‎ExcelGrid‎ پیش از ویرایش می‌پرسد. -->
            <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
            <DataGridTextColumn Header="نام"   Binding="{Binding Name}" Width="Auto" />
            <DataGridTextColumn Header="خرید (تن)" Binding="{Binding TonText}" Width="Auto" />
            <DataGridTextColumn Header="قیمت تن ($)" Binding="{Binding UsdText}" Width="Auto" />
            <DataGridTextColumn Header="کل ($)" Binding="{Binding TotalUsdText}" Width="Auto" IsReadOnly="True" />
            <DataGridTextColumn Header="نرخ"   Binding="{Binding RateText}" Width="Auto" />
            <DataGridTextColumn Header="کل (افغانی)" Binding="{Binding TotalAfnText}" Width="Auto" IsReadOnly="True" />
            <DataGridTextColumn Header="رسید"  Binding="{Binding PoulText}" Width="Auto" />
            <DataGridTemplateColumn Header="واحدِ رسید" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Classes="fuelchip celltoggle" Content="{Binding PoulCurrencyText}"
                          Command="{Binding TogglePoulCurrencyCommand}"
                          Foreground="{Binding PoulCurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                          BorderBrush="{Binding PoulCurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                          ToolTip.Tip="زدنش واحدِ رسید را افغانی ⇄ دالر می‌کند" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="الباقی" Binding="{Binding AlbaqiAfnText}" Width="Auto" IsReadOnly="True" />
            <DataGridTextColumn Header="الباقیِ دالر" Binding="{Binding AlbaqiUsdText}" Width="Auto" IsReadOnly="True" />
          </DataGrid.Columns>
        </c:ExcelGrid>
        <c:TotalsBar Grid.Row="1" ItemsSource="{Binding TotalCells}" />
      </Grid>

      <!-- «➕ ردیف جدید / ➕➕ چندتایی» را خودِ ‎SectionPage‎ از ‎RowAddCommand‎ می‌سازد -->

      <!-- «🗑️ حذف این جدول» — عمداً ته صفحه و دور از بقیه، تا دست اشتباهی نخورد -->
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Pump.Border}" Margin="0,16,0,0" Padding="0,12,0,0">
        <Button Classes="ghost danger" Content="🗑️ حذف این جدول" HorizontalAlignment="Left"
                Command="{Binding ClearTableCommand}"
                ToolTip.Tip="فقط ردیف‌های جدولِ فعلیِ همین تیل پاک می‌شود — جدول‌های آرشیو دست نمی‌خورند" />
      </Border>
    </StackPanel>
  </c:SectionPage>
</UserControl>
