<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.CompanyPurchasesView"
             x:DataType="vm:CompanyPurchasesPageViewModel">

  <!-- ══ 📦 خریدهای یک شرکت — ‎companyPurchasesModal‎ی سایت ═════════════════
       هر تیل یک بخش: چهار کادرِ خلاصه، جدولِ خریدهای مخزن (📦) و زیرش
       «ردیف‌های دستی جدول». فقط نمایش است — هیچ چیزی نمی‌نویسد. -->
  <c:SectionPage Header="{Binding Title}"
                 SubHeader="خریدهای مخزنی که با نامِ همین شرکت ثبت شده‌اند. نمای زنده خریدهای بعد از آخرین «جدول جدید» است و نمای آرشیو فقط بازهٔ همان جدول.">
    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="ghost info" Content="📄 PDF" Command="{Binding PdfCommand}" />
        <Button Classes="accent" Content="✕ بستن" Command="{Binding CloseCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <ItemsControl ItemsSource="{Binding Sections}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PurchaseSectionViewModel">
          <StackPanel Spacing="8" Margin="0,0,0,18">
            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Black"
                       Foreground="{Binding BrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />

            <c:AutoFillPanel MinItemWidth="200" Gap="8" IsVisible="{Binding HasPurchases}">
              <Border Classes="stat"><StackPanel Spacing="3">
                <TextBlock Text="تعداد" Classes="label" />
                <TextBlock Text="{Binding CountText}" Classes="num" />
              </StackPanel></Border>
              <Border Classes="stat"><StackPanel Spacing="3">
                <TextBlock Text="جمله لیتر" Classes="label" />
                <TextBlock Text="{Binding LitersText}" Classes="num" Foreground="{DynamicResource Pump.Ink.Ok}" />
              </StackPanel></Border>
              <Border Classes="stat"><StackPanel Spacing="3">
                <TextBlock Text="جمله کل دالر" Classes="label" />
                <TextBlock Text="{Binding UsdText}" Classes="num" Foreground="{DynamicResource Pump.Ink.Info}" />
              </StackPanel></Border>
              <Border Classes="stat"><StackPanel Spacing="3">
                <TextBlock Text="جمله کل افغانی" Classes="label" />
                <TextBlock Text="{Binding AfnText}" Classes="num" Foreground="{DynamicResource Pump.Ink.Accent}" />
              </StackPanel></Border>
            </c:AutoFillPanel>

            <!-- ══ هر خرید یک کارتِ خواندنی — همان شکلِ بخشِ مخزن ═══════════════
                 گزارشِ صاحب ریپو: «خریدهای پطرول و دیزل را همان‌جوری که توی
                 بخشِ مخزن دیده می‌شود این‌جا هم همین‌طور — ولی تو همه را جدول
                 کردی.» سایت هم همین است (‎cmp-card‎). فقط ردیف‌های دستیِ جدول
                 پایین جدول می‌مانند، مثلِ خودِ سایت. -->
            <ItemsControl ItemsSource="{Binding Purchases}" IsVisible="{Binding HasPurchases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PurchaseItemViewModel">
                  <Border Classes="panel" Margin="0,0,0,12" Padding="0">
                    <StackPanel>
                      <Border Classes="card-head">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                          <TextBlock Text="{Binding IndexText, StringFormat=خرید #{0}}" FontWeight="Bold"
                                     Foreground="{DynamicResource Pump.Ink.Accent}" />
                          <TextBlock Text="{Binding DateText, StringFormat=📅 {0}}" Classes="muted" />
                          <TextBlock Text="{Binding SellerText, StringFormat=👤 {0}}"
                                     Foreground="{DynamicResource Pump.Ink.Info}" />
                          <TextBlock Text="{Binding NoteText}" Classes="muted"
                                     IsVisible="{Binding NoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                      <c:AutoFillPanel MinItemWidth="150" Gap="8" Margin="14">
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="وزن (تن)" Classes="label" />
                          <TextBlock Text="{Binding TonText}" FontWeight="ExtraBold" Foreground="{DynamicResource Pump.Ink.Info}" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="ثقلت" Classes="label" />
                          <TextBlock Text="{Binding DensityText}" FontWeight="ExtraBold" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="لیتر" Classes="label" />
                          <TextBlock Text="{Binding LitersText}" FontWeight="ExtraBold" Foreground="{DynamicResource Pump.Ink.Ok}" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="فی تن ($)" Classes="label" />
                          <TextBlock Text="{Binding PriceTonText}" FontWeight="ExtraBold" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="نرخ دالر" Classes="label" />
                          <TextBlock Text="{Binding UsdRateText}" FontWeight="ExtraBold" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="کل (دالر)" Classes="label" />
                          <TextBlock Text="{Binding TotalUsdText}" FontWeight="ExtraBold" Foreground="{DynamicResource Pump.Ink.Info}" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="کل (افغانی)" Classes="label" />
                          <TextBlock Text="{Binding TotalAfnText}" FontWeight="ExtraBold" Foreground="{DynamicResource Pump.Ink.Accent}" />
                        </StackPanel></Border>
                        <Border Classes="stat" MinHeight="70"><StackPanel Spacing="3">
                          <TextBlock Text="فی لیتر (افغانی)" Classes="label" />
                          <TextBlock Text="{Binding PerLiterText}" FontWeight="ExtraBold" Foreground="{DynamicResource Pump.Ink.Danger}" />
                        </StackPanel></Border>
                      </c:AutoFillPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="panel" IsVisible="{Binding !HasPurchases}" Opacity="0.75">
              <TextBlock Text="{Binding EmptyText}" Classes="muted" HorizontalAlignment="Center" />
            </Border>

            <!-- ردیف‌های دستیِ جدولِ شرکت (بی خریدِ مخزن) -->
            <StackPanel Spacing="6" IsVisible="{Binding HasManual}">
              <TextBlock Text="ردیف‌های دستی جدول" Classes="label" FontWeight="Bold" />
              <c:AutoFillPanel MinItemWidth="200" Gap="8">
                <Border Classes="stat"><StackPanel Spacing="3">
                  <TextBlock Text="تعداد" Classes="label" />
                  <TextBlock Text="{Binding ManualCountText}" Classes="num" />
                </StackPanel></Border>
                <Border Classes="stat"><StackPanel Spacing="3">
                  <TextBlock Text="جمله (تن)" Classes="label" />
                  <TextBlock Text="{Binding ManualTonText}" Classes="num" Foreground="{DynamicResource Pump.Ink.Ok}" />
                </StackPanel></Border>
                <Border Classes="stat"><StackPanel Spacing="3">
                  <TextBlock Text="جمله کل دالر" Classes="label" />
                  <TextBlock Text="{Binding ManualUsdText}" Classes="num" Foreground="{DynamicResource Pump.Ink.Info}" />
                </StackPanel></Border>
                <Border Classes="stat"><StackPanel Spacing="3">
                  <TextBlock Text="جمله کل افغانی" Classes="label" />
                  <TextBlock Text="{Binding ManualAfnText}" Classes="num" Foreground="{DynamicResource Pump.Ink.Accent}" />
                </StackPanel></Border>
              </c:AutoFillPanel>
              <Border Classes="panel" Padding="0">
                <c:ExcelGrid ItemsSource="{Binding Manual}" x:CompileBindings="False"
                             IsReadOnly="True" BorderThickness="0" CornerRadius="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="نام" Binding="{Binding NameText}" Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="مقدار (تن)" Binding="{Binding TonText}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="فی تن ($)" Binding="{Binding UsdText}" Width="Auto" />
                    <DataGridTextColumn Header="نرخ دالر" Binding="{Binding RateText}" Width="Auto" />
                    <DataGridTextColumn Header="کل (دالر)" Binding="{Binding TotalUsdText}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="کل (افغانی)" Binding="{Binding TotalAfnText}" Width="Auto" MinWidth="120" />
                  </DataGrid.Columns>
                </c:ExcelGrid>
              </Border>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </c:SectionPage>
</UserControl>
