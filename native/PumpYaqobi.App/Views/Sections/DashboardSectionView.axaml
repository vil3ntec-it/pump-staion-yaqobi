<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.DashboardSectionView"
             x:DataType="vm:DashboardSectionViewModel">

  <!-- ══ داشبورد ══════════════════════════════════════════════════════════
       چیدمان مو‌به‌مو از ‎#sec-dashboard‎: نوارِ بالا، پنجی کارتِ آماری، و دو
       ردیفِ سه‌کارتی که ستونِ میانی‌شان پهن‌تر است (‎.k-wide‎). -->
  <ScrollViewer>
    <StackPanel Margin="14" Spacing="12">

      <!-- ── نوارِ بالا (‎.dash-head‎) ── -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="19"
                  Background="{DynamicResource Pump.Selected}">
            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="{Binding Greeting}" Classes="muted" FontSize="12" />
          </StackPanel>
          <Button Classes="ghost" Command="{Binding BellCommand}" Padding="9,5">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🔔" FontSize="14" />
              <TextBlock Text="{Binding BellCount}" FontWeight="Bold" FontSize="12"
                         Foreground="{DynamicResource Pump.Danger}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBox Width="220" Text="{Binding SearchText}" Watermark="🔍 نام قرض‌دار + Enter" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="🕘" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Clock}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DateLine}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- ── پنج کارتِ آماری (‎.dash-cards‎) ── -->
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DashCardViewModel">
            <Button Classes="card-shell" Margin="0,0,10,0"
                    Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).GoCommand}"
                    CommandParameter="{Binding GoSection}">
              <Border Classes="card" Padding="14,12" MinHeight="128">
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                  <!-- نوارِ رنگیِ کوچکِ بالای کارت، همان رنگِ کلیدیِ کارت -->
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="7">
                    <Border Width="5" Height="17" CornerRadius="3"
                            Background="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Title}" Classes="label" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="{Binding Value}" FontWeight="Bold" FontSize="19"
                             Margin="0,10,0,0" TextWrapping="Wrap"
                             Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  <TextBlock Grid.Row="2" Text="{Binding Delta}" FontSize="11.5" Margin="0,6,0,0"
                             TextWrapping="Wrap"
                             Foreground="{Binding DeltaColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  <TextBlock Grid.Row="3" Text="{Binding Sub}" Classes="muted" FontSize="11"
                             Margin="0,3,0,0" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── ردیف دوم: وضعیت سوخت‌ها | روند فروش | موجودی مخازن ── -->
      <Grid ColumnDefinitions="1*,2*,1*" Height="300">

        <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="وضعیت سوخت‌ها" Classes="h2" Margin="0,0,0,8" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding FuelStatus}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FuelStatusViewModel">
                  <Button Classes="card-shell" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).GoCommand}"
                          CommandParameter="{Binding GoSection}">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,7,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                          <TextBlock Text="{Binding State}" FontSize="11"
                                     Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="7"
                                   Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                      <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0" Text="{Binding CurrentText}" Classes="muted" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding CapacityText}" Classes="muted" FontSize="11"
                                   HorizontalAlignment="Left" />
                      </Grid>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <StackPanel Grid.Column="0">
                <TextBlock Text="روند فروش" Classes="h2" />
                <TextBlock Text="{Binding AreaSub}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button Classes="seg" Classes.on="{Binding IsFuelAll}" Content="همه"
                        Command="{Binding SetFuelCommand}" CommandParameter="all" />
                <Button Classes="seg" Classes.on="{Binding IsFuelPetrol}" Content="پطرول"
                        Command="{Binding SetFuelCommand}" CommandParameter="petrol" />
                <Button Classes="seg" Classes.on="{Binding IsFuelDiesel}" Content="دیزل"
                        Command="{Binding SetFuelCommand}" CommandParameter="diesel" />
              </StackPanel>
            </Grid>
            <c:SparkChart Grid.Row="1" FlowDirection="LeftToRight"
                          Values="{Binding AreaValues}" Labels="{Binding AreaLabels}"
                          LineBrush="{DynamicResource Pump.Info}"
                          GridBrush="{DynamicResource Pump.GridLine}"
                          LabelBrush="{DynamicResource Pump.Muted}" />
          </Grid>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="موجودی مخازن" Classes="h2" Margin="0,0,0,6" />
            <Grid Grid.Row="1" RowDefinitions="*,Auto">
              <Panel Grid.Row="0">
                <c:DonutGauge FirstShare="{Binding DonutPetrolShare}"
                              SecondShare="{Binding DonutDieselShare}"
                              FirstBrush="{DynamicResource Pump.Ok}"
                              SecondBrush="{DynamicResource Pump.Warn}"
                              TrackBrush="{DynamicResource Pump.GridLine}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding DonutPercentText}" FontWeight="Bold" FontSize="21"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="میزان پر بودن کل" Classes="muted" FontSize="10"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <ItemsControl Grid.Row="1" ItemsSource="{Binding TankLegend}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashTankLegendViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,3">
                      <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                              Background="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" />
                      <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding DonutNote}" Classes="muted" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
          </Grid>
        </Border>
      </Grid>

      <!-- ── ردیف سوم: آخرین هشدارها | نمودار فروش | آخرین فروش‌ها ── -->
      <Grid ColumnDefinitions="1*,2*,1*" Height="440">

        <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="آخرین هشدارها" Classes="h2" Margin="0,0,0,8" />
            <Panel Grid.Row="1">
              <TextBlock Text="✅ همه‌چیز مرتب است — مخزن، قرض‌داران و بکاپ"
                         Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding !Alerts.Count}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Alerts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashAlertViewModel">
                      <Button Classes="card-shell" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).GoCommand}"
                              CommandParameter="{Binding GoSection}">
                        <Border Background="{DynamicResource Pump.Hover}" CornerRadius="9" Padding="9,8">
                          <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Text}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                         Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                              <TextBlock Text="{Binding Sub}" Classes="muted" FontSize="11" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
          <Grid RowDefinitions="Auto,150,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <StackPanel Grid.Column="0">
                <TextBlock Text="نمودار فروش" Classes="h2" />
                <TextBlock Text="{Binding ChartSub}" Classes="muted" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button Classes="seg" Classes.on="{Binding IsRangeDay}" Content="روزانه"
                        Command="{Binding SetRangeCommand}" CommandParameter="day" />
                <Button Classes="seg" Classes.on="{Binding IsRangeWeek}" Content="هفتگی"
                        Command="{Binding SetRangeCommand}" CommandParameter="week" />
                <Button Classes="seg" Classes.on="{Binding IsRangeMonth}" Content="ماهانه"
                        Command="{Binding SetRangeCommand}" CommandParameter="month" />
                <Button Classes="seg" Classes.on="{Binding IsRangeYear}" Content="سالانه"
                        Command="{Binding SetRangeCommand}" CommandParameter="year" />
              </StackPanel>
            </Grid>

            <!-- ستون‌های فروش: هر دوره یک ستون، نه سه ستونِ کنارِ هم -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Bars}" VerticalAlignment="Stretch">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DashBarViewModel">
                  <Button Classes="card-shell" Margin="3,0"
                          ToolTip.Tip="{Binding Tip}"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).SelectBarCommand}"
                          CommandParameter="{Binding}">
                    <Grid RowDefinitions="*,Auto">
                      <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="5,5,0,0"
                              Classes="db-bar" Classes.sel="{Binding IsSelected}"
                              Height="{Binding Height, Converter={x:Static vm:PercentToHeightConverter.Bar}}" />
                      <TextBlock Grid.Row="1" Text="{Binding Label}" Classes="muted" FontSize="10"
                                 HorizontalAlignment="Center" Margin="0,4,0,0"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- جزئیاتِ ستونِ انتخاب‌شده (‎#dash-detail‎) -->
            <Border Grid.Row="2" Background="{DynamicResource Pump.Hover}" CornerRadius="9"
                    Padding="10,8" Margin="0,10,0,0">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DetailDate}" FontWeight="Bold" FontSize="12" Margin="0,0,14,3" />
                <TextBlock Text="{Binding DetailMoney}" FontSize="12" Margin="0,0,14,3" />
                <TextBlock Text="{Binding DetailLiters}" FontSize="12" Margin="0,0,14,3" />
                <TextBlock Text="{Binding DetailCount}" FontSize="12" Margin="0,0,14,3" />
                <TextBlock Text="{Binding DetailFuel}" FontSize="12" Margin="0,0,14,3" />
                <TextBlock Text="{Binding DetailGrowth}" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"
                           Foreground="{Binding DetailGrowthColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
              </WrapPanel>
            </Border>

            <!-- روندِ مفاد و مصارف -->
            <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="0,8,0,0">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="روند مفاد و مصارف" FontWeight="Bold" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                          Background="{DynamicResource Pump.Ok}" />
                  <TextBlock Text="مفاد" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                          Background="{DynamicResource Pump.Warn}" />
                  <TextBlock Text="مصارف" Classes="muted" FontSize="11" />
                </StackPanel>
              </StackPanel>
              <c:SparkChart Grid.Row="1" ShowAxis="False" FlowDirection="LeftToRight"
                            Values="{Binding TrendProfit}" SecondValues="{Binding TrendExpense}"
                            LineBrush="{DynamicResource Pump.Ok}"
                            SecondLineBrush="{DynamicResource Pump.Warn}"
                            GridBrush="{DynamicResource Pump.GridLine}" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="آخرین فروش‌ها" Classes="h2" />
              <Button Grid.Column="1" Classes="ghost" Content="مشاهده همه" Padding="9,4" FontSize="11"
                      Command="{Binding GoCommand}" CommandParameter="shifts" />
            </Grid>
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashRecentViewModel">
                    <Border Background="{DynamicResource Pump.Hover}" CornerRadius="8" Padding="9,7"
                            Margin="0,0,0,7">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Date}" FontWeight="Bold" FontSize="12" />
                          <TextBlock Grid.Column="1" Text="{Binding When}" Classes="muted" FontSize="11" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Fuel}" FontSize="11.5" />
                          <TextBlock Grid.Column="1" Text="{Binding Liters}" Classes="muted" FontSize="11" />
                        </Grid>
                        <TextBlock Text="{Binding Money}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{DynamicResource Pump.Ok}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <TextBlock Text="{Binding FootNote}" Classes="muted" FontSize="11"
                 HorizontalAlignment="Center" Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
