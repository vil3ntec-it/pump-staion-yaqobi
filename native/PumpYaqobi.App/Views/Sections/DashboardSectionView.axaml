<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.DashboardSectionView"
             x:DataType="vm:DashboardSectionViewModel">

  <!-- ══ داشبوردِ پمپ‌بنزین — ظاهرِ تازه (۱۴۰۵/۰۷/۱۳) ══════════════════════
       خواستهٔ صاحب ریپو: «داشبورد خیلی قدیمی و به‌دردنخور و بی‌کیفیت است،
       فعلی را حذف کن و یک داشبوردِ مناسبِ پمپ‌بنزین بگذار… هیچ منطقی دست
       نخورد.»

       ⛔ فقط ظاهر عوض شد: هر عدد، هر فهرست و هر فرمان همان خاصیتِ
       ‎DashboardSectionViewModel‎ است و ویومدل یک کاراکتر هم عوض نشد
       (آزمونِ ‎DashboardRemakeTests‎ فهرستِ بایندها را با ویومدل می‌سنجد).

       چیدمان، از بالا:
         ۱) سربرگِ پمپ: خوش‌آمد، تاریخ و ساعت، میان‌بُرهای کارِ روزانه، جست‌وجو و زنگ
         ۲) پنج کاشیِ عدد: هشدار · فروشِ تیل · الباقیِ قرض‌داران · مصارف · گاوصندوق
         ۳) نمودارِ فروش (پهن) | مخزن‌ها با همان نقشهٔ مخزنِ بخشِ مخزن
         ۴) روندِ فروشِ تیل (پهن) | آخرین هشدارها
         ۵) آخرین شیفت‌ها — نوارِ افقی

       ⚠️ کارت‌های بزرگ ‎calm‎اند (سایهٔ بی‌محو): سایهٔ محو روی کادرِ بزرگ با هر
       فریمِ اسکرول از نو کشیده می‌شود (‎Border.card.calm‎ در ‎Controls.axaml‎).
       فقط کاشی‌های کوچکِ ردیفِ ۲ سایهٔ محوِ خودشان را دارند. -->

  <UserControl.Styles>
    <!-- دکمهٔ میان‌بُر: کپسولِ روشن با آیکونِ رنگیِ همان بخش -->
    <Style Selector="Button.dash-quick">
      <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.dash-quick:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Pump.Hover}" />
    </Style>
    <!-- عنوانِ کارت با یک نوارِ کوچکِ رنگیِ کنارش -->
    <Style Selector="TextBlock.dash-title">
      <Setter Property="FontSize" Value="15.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.dash-mark">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Pump.Accent}" />
    </Style>
    <!-- خانهٔ کوچکِ داخلِ کارت (شیفت، هشدار، جزئیات) -->
    <Style Selector="Border.dash-cell">
      <Setter Property="Background" Value="{DynamicResource Pump.Input}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Pump.Section}" CornerRadius="14" Margin="8">
    <StackPanel Margin="16" Spacing="14">

      <!-- ══ ۱) سربرگِ پمپ ══ -->
      <Border Classes="card calm" Padding="20,16">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- خوش‌آمد و ساعت -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="18"
                    Background="{Binding Source=pump, Converter={x:Static th:IconColorConverter.Instance}, ConverterParameter=badge}">
              <Path Data="{Binding Source=pump, Converter={x:Static th:IconLookupConverter.Instance}}"
                    Stroke="{DynamicResource Pump.Accent}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Width="28" Height="28" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Greeting}" FontWeight="Bold" FontSize="21" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DateLine}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- میان‌بُرهای کارِ روزانهٔ پمپ -->
          <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
            <Button Classes="dash-quick" Command="{Binding GoCommand}" CommandParameter="shifts">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{Binding Source=shifts, Converter={x:Static th:IconLookupConverter.Instance}}"
                      Stroke="{Binding Source=shifts, Converter={x:Static th:IconColorConverter.Instance}}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                <TextBlock Text="پارچه‌ها" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="dash-quick" Command="{Binding GoCommand}" CommandParameter="waraq">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{Binding Source=waraq, Converter={x:Static th:IconLookupConverter.Instance}}"
                      Stroke="{Binding Source=waraq, Converter={x:Static th:IconColorConverter.Instance}}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                <TextBlock Text="ورق‌ها" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="dash-quick" Command="{Binding GoCommand}" CommandParameter="debt">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{Binding Source=debt, Converter={x:Static th:IconLookupConverter.Instance}}"
                      Stroke="{Binding Source=debt, Converter={x:Static th:IconColorConverter.Instance}}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                <TextBlock Text="قرض‌داران" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="dash-quick" Command="{Binding GoCommand}" CommandParameter="storage">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{Binding Source=storage, Converter={x:Static th:IconLookupConverter.Instance}}"
                      Stroke="{Binding Source=storage, Converter={x:Static th:IconColorConverter.Instance}}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                <TextBlock Text="مخزن" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="dash-quick" Command="{Binding GoCommand}" CommandParameter="safe">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{Binding Source=safe, Converter={x:Static th:IconLookupConverter.Instance}}"
                      Stroke="{Binding Source=safe, Converter={x:Static th:IconColorConverter.Instance}}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17" Stretch="Uniform" />
                <TextBlock Text="گاوصندوق" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </WrapPanel>

          <!-- زنگِ هشدارها -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Classes="dash-quick" Margin="0" Command="{Binding BellCommand}" ToolTip.Tip="هشدارها">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🔔" FontSize="15" VerticalAlignment="Center" />
                <Border CornerRadius="9" MinWidth="20" Padding="5,0" Background="{DynamicResource Pump.Danger}">
                  <TextBlock Text="{Binding BellCount}" Foreground="White" FontWeight="Bold" FontSize="12"
                             HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══ ۲) پنج کاشیِ عدد ══ -->
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DashCardViewModel">
            <Button Classes="card-shell" Margin="0,0,12,0"
                    Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).GoCommand}"
                    CommandParameter="{Binding GoSection}">
              <Border Classes="card" Padding="16,14" MinHeight="140">
                <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                  <!-- عنوان، و نشانِ گردِ رنگیِ کارت با آیکونِ بخشش -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" Classes="label" FontSize="13"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Panel Grid.Row="0" Grid.Column="1" Width="40" Height="40">
                    <Border CornerRadius="13" Opacity="0.14"
                            Background="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                    <Path Data="{Binding GoSection, Converter={x:Static th:IconLookupConverter.Instance}}"
                          Stroke="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                          StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="20" Height="20" Stretch="Uniform" />
                  </Panel>
                  <!-- عددِ درشت -->
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Value}" FontWeight="Bold" FontSize="21"
                             Margin="0,12,0,0" TextWrapping="Wrap"
                             Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  <!-- تغییر نسبت به دورهٔ پیش، و زیرنویس -->
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0">
                    <Panel HorizontalAlignment="Left" IsVisible="{Binding Delta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <Border CornerRadius="8" Opacity="0.12"
                              Background="{Binding DeltaColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Delta}" FontSize="11.5" FontWeight="SemiBold" Margin="8,3"
                                 TextWrapping="Wrap"
                                 Foreground="{Binding DeltaColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                    </Panel>
                    <TextBlock Text="{Binding Sub}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ══ ۳) نمودارِ فروش | مخزن‌ها ══ -->
      <Grid ColumnDefinitions="2*,1*">

        <Border Grid.Column="0" Classes="card calm" Margin="0,0,14,0" Padding="18,16">
          <Grid RowDefinitions="Auto,170,Auto,Auto,110">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
              <Border Grid.Column="0" Classes="dash-mark" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="نمودارِ فروش" Classes="dash-title" />
                <TextBlock Text="{Binding ChartSub}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button Classes="seg" Classes.on="{Binding IsRangeDay}" Content="روزانه"
                        Command="{Binding SetRangeCommand}" CommandParameter="day" />
                <Button Classes="seg" Classes.on="{Binding IsRangeWeek}" Content="هفتگی"
                        Command="{Binding SetRangeCommand}" CommandParameter="week" />
                <Button Classes="seg" Classes.on="{Binding IsRangeMonth}" Content="ماهانه"
                        Command="{Binding SetRangeCommand}" CommandParameter="month" />
                <Button Classes="seg" Classes.on="{Binding IsRangeYear}" Content="سالانه"
                        Command="{Binding SetRangeCommand}" CommandParameter="year" />
              </StackPanel>
            </Grid>

            <!-- ستون‌های فروش: هر دوره یک ستون -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Bars}" VerticalAlignment="Stretch">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DashBarViewModel">
                  <Button Classes="card-shell" Margin="4,0"
                          ToolTip.Tip="{Binding Tip}"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).SelectBarCommand}"
                          CommandParameter="{Binding}">
                    <Grid RowDefinitions="*,Auto">
                      <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="8,8,3,3"
                              Classes="db-bar" Classes.sel="{Binding IsSelected}"
                              Height="{Binding Height, Converter={x:Static vm:PercentToHeightConverter.Bar}}" />
                      <TextBlock Grid.Row="1" Text="{Binding Label}" Classes="muted" FontSize="10.5"
                                 HorizontalAlignment="Center" Margin="0,5,0,0"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- جزئیاتِ ستونِ انتخاب‌شده -->
            <Border Grid.Row="2" Classes="dash-cell" Margin="0,12,0,0">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DetailDate}" FontWeight="Bold" FontSize="12.5" Margin="0,0,16,3" />
                <TextBlock Text="{Binding DetailMoney}" FontSize="12.5" Margin="0,0,16,3" />
                <TextBlock Text="{Binding DetailLiters}" FontSize="12.5" Margin="0,0,16,3" />
                <TextBlock Text="{Binding DetailCount}" FontSize="12.5" Margin="0,0,16,3" />
                <TextBlock Text="{Binding DetailFuel}" FontSize="12.5" Margin="0,0,16,3" />
                <TextBlock Text="{Binding DetailGrowth}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,3"
                           Foreground="{Binding DetailGrowthColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
              </WrapPanel>
            </Border>

            <!-- روندِ مفاد و مصارف -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="14" Margin="0,12,0,4">
              <TextBlock Text="روندِ مفاد و مصارف" FontWeight="Bold" FontSize="12.5" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                        Background="{DynamicResource Pump.Ok}" />
                <TextBlock Text="مفاد" Classes="muted" FontSize="11.5" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                        Background="{DynamicResource Pump.Warn}" />
                <TextBlock Text="مصارف" Classes="muted" FontSize="11.5" />
              </StackPanel>
            </StackPanel>
            <c:SparkChart Grid.Row="4" ShowAxis="False" FlowDirection="LeftToRight"
                          Values="{Binding TrendProfit}" SecondValues="{Binding TrendExpense}"
                          LineBrush="{DynamicResource Pump.Ok}"
                          SecondLineBrush="{DynamicResource Pump.Warn}"
                          GridBrush="{DynamicResource Pump.GridLine}" />
          </Grid>
        </Border>

        <!-- مخزن‌ها — همان نقشهٔ مخزنِ بخشِ مخزن، کوچک، یکی برای هر تیل -->
        <Border Grid.Column="1" Classes="card calm" Padding="18,16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="dash-mark" />
              <TextBlock Grid.Column="1" Text="مخزن‌ها" Classes="dash-title" />
              <Border Grid.Column="2" Classes="dash-cell" Padding="10,3">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="پرشدگیِ کل" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DonutPercentText}" FontWeight="Bold" FontSize="13" />
                </StackPanel>
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding FuelStatus}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FuelStatusViewModel">
                  <Button Classes="card-shell" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).GoCommand}"
                          CommandParameter="{Binding GoSection}">
                    <Border Classes="dash-cell" Padding="10,8">
                      <Grid ColumnDefinitions="150,*">
                        <c:TankGauge Grid.Column="0" Compact="True" Width="150" Height="94"
                                     FillPercent="{Binding Percent}" FillText="{Binding PercentText}"
                                     BodyBrush="{DynamicResource Pump.Card}"
                                     BodyDeepBrush="{DynamicResource Pump.Input}"
                                     RimBrush="{DynamicResource Pump.ChromeBorder}"
                                     LabelBrush="{DynamicResource Pump.Text}"
                                     TextBrush="{DynamicResource Pump.Text}"
                                     ThresholdBrush="{DynamicResource Pump.Danger}" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                          <TextBlock Text="{Binding CurrentText}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CapacityText}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- سهمِ هر تیل از کلِ ظرفیت — همان حلقهٔ داشبوردِ قبلی، کوچک، کنارِ راهنما -->
            <Grid ColumnDefinitions="64,*">
              <c:DonutGauge Grid.Column="0" Width="64" Height="64"
                            FirstShare="{Binding DonutPetrolShare}"
                            SecondShare="{Binding DonutDieselShare}"
                            FirstBrush="{DynamicResource Pump.Ok}"
                            SecondBrush="{DynamicResource Pump.Warn}"
                            TrackBrush="{DynamicResource Pump.GridLine}" />
              <ItemsControl Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                            ItemsSource="{Binding TankLegend}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashTankLegendViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,3">
                      <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                              Background="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" />
                      <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
            <TextBlock Text="{Binding DonutNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══ ۴) روندِ فروشِ تیل | آخرین هشدارها ══ -->
      <Grid ColumnDefinitions="2*,1*" Height="330">

        <Border Grid.Column="0" Classes="card calm" Margin="0,0,14,0" Padding="18,16">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
              <Border Grid.Column="0" Classes="dash-mark" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="روندِ فروشِ تیل" Classes="dash-title" />
                <TextBlock Text="{Binding AreaSub}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button Classes="seg" Classes.on="{Binding IsFuelAll}" Content="همه"
                        Command="{Binding SetFuelCommand}" CommandParameter="all" />
                <Button Classes="seg" Classes.on="{Binding IsFuelPetrol}" Content="پطرول"
                        Command="{Binding SetFuelCommand}" CommandParameter="petrol" />
                <Button Classes="seg" Classes.on="{Binding IsFuelDiesel}" Content="دیزل"
                        Command="{Binding SetFuelCommand}" CommandParameter="diesel" />
              </StackPanel>
            </Grid>
            <c:SparkChart Grid.Row="1" FlowDirection="LeftToRight"
                          Values="{Binding AreaValues}" Labels="{Binding AreaLabels}"
                          LineBrush="{DynamicResource Pump.ChartLine}"
                          PointBrush="{DynamicResource Pump.ChartPoint}"
                          GridBrush="{DynamicResource Pump.GridLine}"
                          LabelBrush="{DynamicResource Pump.Muted}" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card calm" Padding="18,16">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
              <Border Grid.Column="0" Classes="dash-mark" Background="{DynamicResource Pump.Danger}" />
              <TextBlock Grid.Column="1" Text="آخرین هشدارها" Classes="dash-title" />
            </Grid>
            <Panel Grid.Row="1">
              <Border Classes="dash-cell" VerticalAlignment="Top" IsVisible="{Binding !Alerts.Count}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Text="همه‌چیز مرتب است — مخزن، قرض‌داران و بکاپ"
                             Classes="muted" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <DockPanel>
              <Button Classes="ghost" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                      IsVisible="{Binding AlertsMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Command="{Binding GoCommand}" CommandParameter="debt">
                <TextBlock Text="{Binding AlertsMore}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </Button>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Alerts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashAlertViewModel">
                      <Button Classes="card-shell" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                              Command="{Binding $parent[ItemsControl].((vm:DashboardSectionViewModel)DataContext).GoCommand}"
                              CommandParameter="{Binding GoSection}">
                        <Border Classes="dash-cell">
                          <Grid ColumnDefinitions="Auto,*">
                            <Panel Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                              <Border CornerRadius="11" Opacity="0.14"
                                      Background="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                              <TextBlock Text="{Binding Icon}" FontSize="15"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Text}" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap"
                                         Foreground="{Binding ColorKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                              <TextBlock Text="{Binding Sub}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              </DockPanel>
            </Panel>
          </Grid>
        </Border>
      </Grid>

      <!-- ══ ۵) آخرین شیفت‌ها — نوارِ افقی ══ -->
      <Border Classes="card calm" Padding="18,16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Classes="dash-mark" Background="{DynamicResource Pump.Ok}" />
            <TextBlock Grid.Column="1" Text="آخرین فروش‌ها — شیفت‌به‌شیفت" Classes="dash-title" />
            <Button Grid.Column="2" Classes="ghost" Content="مشاهده همه ›" Padding="10,4" FontSize="12"
                    Command="{Binding GoCommand}" CommandParameter="shifts" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DashRecentViewModel">
                <Border Classes="dash-cell" Margin="0,0,10,0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Date}" FontWeight="Bold" FontSize="12.5" />
                      <TextBlock Grid.Column="1" Text="{Binding When}" Classes="muted" FontSize="11.5" />
                    </Grid>
                    <TextBlock Text="{Binding Money}" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource Pump.Ok}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Fuel}" FontSize="11.5" />
                      <TextBlock Grid.Column="1" Text="{Binding Liters}" Classes="muted" FontSize="11.5" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding FootNote}" Classes="muted" FontSize="11"
                 HorizontalAlignment="Center" Margin="0,2,0,0" />
    </StackPanel>
  </Border>
</UserControl>
