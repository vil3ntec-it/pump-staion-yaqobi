<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.DebtArchiveView"
             x:DataType="vm:DebtArchivePageViewModel">

  <!-- ══ 🗂️ جدول‌های آرشیوِ یک حسابِ قرض‌دار — ‎personArchiveModal‎ی سایت ═════
       هر آرشیو مو‌به‌مو مثلِ حسابِ زنده: دو کادرِ «حساب پطرول / حساب دیزل» با
       فیصدی، مقدار رسید (نوشتنی)، برد و الباقی؛ نوارِ فیصدی/یادداشت؛ سه دکمهٔ
       فیلتر؛ جدولِ ویرایش‌شدنی؛ و جمعِ زیرِ هر ستون. -->
  <c:SectionPage Header="{Binding Title}"
                 SubHeader="هر بار «جدول جدید» زده شود جدولِ قبلی این‌جا می‌آید. ویرایشِ آرشیو فقط خودِ آرشیو را عوض می‌کند، نه جدولِ زنده را.">
    <c:SectionPage.Toolbar>
      <Button Classes="accent" Content="✕ بستن" Command="{Binding CloseCommand}" />
    </c:SectionPage.Toolbar>

    <StackPanel Spacing="14">
      <TextBlock Text="این حساب هنوز جدولِ آرشیوی ندارد" Classes="muted" HorizontalAlignment="Center"
                 Margin="0,26" IsVisible="{Binding IsEmpty}" />
      <ItemsControl ItemsSource="{Binding Archives}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DebtArchiveViewModel">
            <Border Classes="panel" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontWeight="Black" FontSize="15" />

                <!-- ── سربرگِ پطرول — همان ‎.fuel-split‎ی حسابِ زنده ── -->
                <Border Classes="panel" Padding="14,10" IsVisible="{Binding ShowPetrolCard}">
                  <Grid ColumnDefinitions="Auto,10,*">
                    <Border Grid.Column="0" Classes="fshead" BorderBrush="{DynamicResource Pump.Ok}">
                      <TextBlock Text="⛽ حساب پطرول" Foreground="{DynamicResource Pump.Ok}" />
                    </Border>
                    <UniformGrid Grid.Column="2" Rows="1">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeadPetrolPercentValue, StringFormat='فیصدی ما ({0})'}" Classes="fsl" />
                        <TextBlock Text="{Binding HeadPetrolCommText}" Classes="fsv" Foreground="{DynamicResource Pump.Purple}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeadRasidLabel}" Classes="fsl" />
                        <TextBox Text="{Binding HeadPetrolRasidEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Classes="fsv" Foreground="{DynamicResource Pump.Ok}"
                                 ToolTip.Tip="رسیدِ سربرگ + رسیدهای جدول — نوشتن فقط سهمِ سربرگ را عوض می‌کند" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="برد" Classes="fsl" />
                        <TextBlock Text="{Binding HeadPetrolBordText}" Classes="fsv" Foreground="{DynamicResource Pump.Warn}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeadAlbaqiLabel}" Classes="fsl" />
                        <TextBlock Text="{Binding HeadPetrolAlbaqiText}" Classes="fsv"
                                   Foreground="{Binding HeadPetrolAlbaqiBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                      </StackPanel>
                    </UniformGrid>
                  </Grid>
                </Border>

                <!-- ── سربرگِ دیزل ── -->
                <Border Classes="panel" Padding="14,10" IsVisible="{Binding ShowDieselCard}">
                  <Grid ColumnDefinitions="Auto,10,*">
                    <Border Grid.Column="0" Classes="fshead" BorderBrush="{DynamicResource Pump.Warn}">
                      <TextBlock Text="🟤 حساب دیزل" Foreground="{DynamicResource Pump.Warn}" />
                    </Border>
                    <UniformGrid Grid.Column="2" Rows="1">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeadDieselPercentValue, StringFormat='فیصدی ما ({0})'}" Classes="fsl" />
                        <TextBlock Text="{Binding HeadDieselCommText}" Classes="fsv" Foreground="{DynamicResource Pump.Purple}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeadRasidLabel}" Classes="fsl" />
                        <TextBox Text="{Binding HeadDieselRasidEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Classes="fsv" Foreground="{DynamicResource Pump.Ok}"
                                 ToolTip.Tip="رسیدِ سربرگ + رسیدهای جدول — نوشتن فقط سهمِ سربرگ را عوض می‌کند" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="برد" Classes="fsl" />
                        <TextBlock Text="{Binding HeadDieselBordText}" Classes="fsv" Foreground="{DynamicResource Pump.Warn}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding HeadAlbaqiLabel}" Classes="fsl" />
                        <TextBlock Text="{Binding HeadDieselAlbaqiText}" Classes="fsv"
                                   Foreground="{Binding HeadDieselAlbaqiBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                      </StackPanel>
                    </UniformGrid>
                  </Grid>
                </Border>

                <!-- ── نوارِ فیصدی / یادداشت / جمع — ‎.pm-arc-bar‎ ── -->
                <WrapPanel Orientation="Horizontal">
                  <TextBlock Text="📝 یادداشت:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <TextBox Width="220" Text="{Binding NoteText}" Watermark="مثلاً فی 56 / 57 / 58" Margin="0,0,14,4"
                           ToolTip.Tip="فقط یادداشت — در هیچ محاسبه‌ای استفاده نمی‌شود" />
                  <TextBlock Text="٪ فیصدی ⛽:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <TextBox Width="70" Text="{Binding PercentPetrolText}" Margin="0,0,10,4" ToolTip.Tip="فیصدیِ پطرولِ همین آرشیو" />
                  <TextBlock Text="🟤:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,4" />
                  <TextBox Width="70" Text="{Binding PercentDieselText}" Margin="0,0,14,4" ToolTip.Tip="فیصدیِ دیزلِ همین آرشیو" />
                  <TextBlock Text="{Binding TotalBordText, StringFormat='جمله برد (پطرول+دیزل): {0}'}" Classes="muted"
                             FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,4" Foreground="{DynamicResource Pump.Warn}" />
                  <TextBlock Text="{Binding TotalRemText, StringFormat='الباقی کل (پطرول+دیزل): {0}'}" Classes="muted"
                             FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource Pump.Info}" />
                </WrapPanel>

                <!-- ── فیلترِ تیل — همان سه دکمهٔ حسابِ زنده ── -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="seg" Content="📋 همه" Command="{Binding SetFilterCommand}" CommandParameter="all" Classes.on="{Binding IsAll}" />
                  <Button Classes="seg" Content="⛽ حساب جداگانه پطرول" Command="{Binding SetFilterCommand}" CommandParameter="petrol" Classes.on="{Binding IsPetrolFilter}" />
                  <Button Classes="seg" Content="🟤 حساب جداگانه دیزل" Command="{Binding SetFilterCommand}" CommandParameter="diesel" Classes.on="{Binding IsDieselFilter}" />
                </StackPanel>

                <!-- ── جدولِ ویرایش‌شدنی — همان ستون‌های ‎#pm-tbl‎ ── -->
                <c:ExcelGrid ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False"
                             RowDeleteCommand="{Binding DeleteRowCommand}" Classes="archive">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
                    <DataGridTextColumn Header="نام"   Binding="{Binding Name}" Width="Auto" />
                    <DataGridTextColumn Header="حواله" Binding="{Binding Hawala}" Width="Auto" />
                    <DataGridTemplateColumn Header="نوع تیل" Width="Auto">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Classes="fuelchip celltoggle" Content="{Binding FuelChipText}"
                                  Command="{Binding ToggleFuelCommand}"
                                  Foreground="{Binding FuelChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                  BorderBrush="{Binding FuelChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="مقدار تیل" Binding="{Binding LitersText}" Width="Auto" CellStyleClasses="num" />
                    <DataGridTextColumn Header="فی لیتر" Binding="{Binding PriceText}" Width="Auto" CellStyleClasses="num" />
                    <DataGridTextColumn Header="مقدار بردگی" Binding="{Binding BardagiText}" Width="Auto" CellStyleClasses="num" />
                    <DataGridTextColumn Header="رسید" Binding="{Binding RasidText}" Width="Auto" CellStyleClasses="num" />
                    <DataGridTextColumn Header="رسید تیل" Binding="{Binding RasidFuelText}" Width="Auto" CellStyleClasses="num" />
                    <DataGridTextColumn Header="الباقی" Binding="{Binding AlbaqiText}" Width="Auto" IsReadOnly="True" />
                  </DataGrid.Columns>
                </c:ExcelGrid>
                <c:TotalsBar ItemsSource="{Binding TotalCells}" />

                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:RowAddBar Grid.Column="0" HorizontalAlignment="Left" Host="{Binding}" AddRowCommand="{Binding AddRowCommand}" />
                  <Button Grid.Column="2" Classes="ghost danger" Content="🗑️ حذفِ این آرشیو" Padding="10,4" FontSize="11"
                          VerticalAlignment="Center" Command="{Binding DeleteCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </c:SectionPage>
</UserControl>
