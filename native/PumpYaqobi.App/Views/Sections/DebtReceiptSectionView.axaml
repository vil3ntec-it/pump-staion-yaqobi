<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.DebtReceiptSectionView"
             x:DataType="vm:DebtReceiptSectionViewModel">

  <c:SectionPage>
    <c:SectionPage.Header>رسید قرض‌داران / چکنه</c:SectionPage.Header>

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
        <TextBlock Text="ماه" VerticalAlignment="Center" Classes="label" />
        <!-- کشوی سال + ماه (۱۴۰۵/۰۷/۱۴): «برای بخش‌هایی که ماه کشویی دارن سال کشویی هم اضافه کن» -->
        <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                  IsVisible="{Binding Picker.HasYears}"
                  ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="90" />
        <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                  ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="125" />
        <Button Classes="ghost info" Content="PDF" Command="{Binding PdfCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <StackPanel Spacing="10">

      <!-- ورودِ سریع — بی هیچ دکمهٔ «ثبت»: با کامل شدنِ نام و مبلغ خودش می‌رود -->
      <Border Classes="panel" Padding="12,10" BorderThickness="1" CornerRadius="10">
        <StackPanel Spacing="8">
          <TextBlock Text="نام قرض‌دار و مبلغ را بنویسید — همان لحظه در حسابش ثبت می‌شود"
                     Classes="label" />
          <WrapPanel x:Name="QuickForm" Orientation="Horizontal" Classes="qform">
            <WrapPanel.Styles>
              <Style Selector="StackPanel.q">
                <Setter Property="Margin" Value="0,0,10,8" />
              </Style>
              <!-- ⛔ همهٔ کادرها و کشویی‌ها یک قد و یک قلم (۱۴۰۵/۰۷/۱۴): «کادرِ واحدِ
                   رسید و نوعِ تیل هم‌اندازه‌شون نیست، خیلی بزرگ‌ترن». -->
              <Style Selector="WrapPanel.qform TextBox, WrapPanel.qform ComboBox">
                <Setter Property="Height" Value="42" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
              </Style>
            </WrapPanel.Styles>

            <!-- ══ ترتیب (۱۴۰۵/۰۷/۱۴) ═══════════════════════════════════════
                 «رسید باید بغلِ نامِ قرض‌دار باشه… واحدِ رسید و نوعِ تیل رو بیار
                 وسطِ رسید و توضیحات… و یک کشوییِ دیگه بغلِ اون دوتا: چکنه یا
                 قرض‌دار.» در راست‌به‌چپ نخستین فرزند سمتِ راست است:
                 تاریخ ← نام ← رسید ← واحد ← نوعِ تیل ← حساب ← توضیحات. -->
            <StackPanel Classes="q" Spacing="3" Width="150">
              <TextBlock Text="تاریخ" Classes="label" />
              <TextBox Text="{Binding DateShamsi}" HorizontalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Classes="q" Spacing="3" Width="250">
              <TextBlock Text="{Binding NameLabel}" Classes="label" />
              <TextBox x:Name="NameBox" Text="{Binding TypedName}" Watermark="نام…"
                       c:Suggest.Key="{Binding NameSuggestKey}" />
            </StackPanel>

            <StackPanel Classes="q" Spacing="3" Width="180">
              <TextBlock Text="{Binding AmountLabel}" Classes="label" />
              <TextBox x:Name="AmountBox" Text="{Binding AmountText}"
                       Watermark="{Binding AmountWatermark}" />
            </StackPanel>

            <!-- ⛔ دو کشویی، نه یک دکمهٔ چرخشی (۱۴۰۵/۰۷/۱۰): «واحد» و «کدام تیل»
                 دو ستونِ جدا در دفترند. با «چکنه» واحد روی «پول» بسته می‌شود. -->
            <StackPanel Classes="q" Spacing="3" Width="140">
              <TextBlock Text="واحد رسید" Classes="label" />
              <ComboBox ItemsSource="{Binding UnitOptions}" SelectedIndex="{Binding UnitIndex}"
                        IsEnabled="{Binding UnitOpen}" ToolTip.Tip="{Binding UnitHint}" />
              <TextBlock Text="{Binding UnitHint}" FontSize="11"
                         Foreground="{DynamicResource Pump.Muted}" />
            </StackPanel>

            <!-- ⛔ «رسیدِ پول هیچ‌کدوم لازم نیست» — بسته می‌شود، پنهان نه:
                 پنهان شدنش ردیف را جابه‌جا می‌کرد. -->
            <StackPanel Classes="q" Spacing="3" Width="140">
              <TextBlock Text="نوع تیل" Classes="label" />
              <ComboBox ItemsSource="{Binding FuelOptions}" SelectedIndex="{Binding FuelIndex}"
                        IsEnabled="{Binding IsFuel}" ToolTip.Tip="{Binding FuelHint}" />
              <TextBlock Text="{Binding FuelHint}" FontSize="11"
                         Foreground="{DynamicResource Pump.Muted}" />
            </StackPanel>

            <StackPanel Classes="q" Spacing="3" Width="140">
              <TextBlock Text="حساب" Classes="label" />
              <ComboBox x:Name="TargetBox" ItemsSource="{Binding TargetOptions}"
                        SelectedIndex="{Binding TargetIndex}"
                        ToolTip.Tip="قرض‌دار یا چکنه — نام در همان دفتر پیدا می‌شود" />
            </StackPanel>

            <StackPanel Classes="q" Spacing="3" Width="230">
              <TextBlock Text="توضیحات" Classes="label" />
              <TextBox Text="{Binding Note}" Watermark="اختیاری" />
            </StackPanel>
          </WrapPanel>
          <!-- «الباقی معلوم بشه» — حساب و الباقیِ همین حالا، پس از هر رسید -->
          <TextBlock Text="{Binding LastResult}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{DynamicResource Pump.Ink.Ok}"
                     IsVisible="{Binding LastResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- فهرستِ ماه -->
      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Classes="card-head">
            <TextBlock Text="رسیدهای این ماه" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>

          <c:ExcelGrid Grid.Row="1" ItemsSource="{Binding Rows}" x:CompileBindings="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
              <DataGridTextColumn Header="نام قرض‌دار" Binding="{Binding Account}" Width="Auto" />
              <DataGridTextColumn Header="توضیحات" Binding="{Binding Note}" Width="Auto" />
              <DataGridTemplateColumn Header="واحد" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding UnitText}" FontWeight="Bold" Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding UnitBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="مبلغ رسید" Binding="{Binding AmountText}" Width="Auto" />
              <DataGridTemplateColumn Header="" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Classes="ghost danger" Content="برگرداندن" Padding="8,3" FontSize="11"
                            Command="{Binding $parent[UserControl].DataContext.UndoCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>

          <!-- ردیفِ «جمله» — همان نوارِ یکسانِ همهٔ جدول‌های برنامه -->
          <c:TotalsBar Grid.Row="2" Title="🧮 جملهٔ ماه" ItemsSource="{Binding TotalCells}" />
        </Grid>
      </Border>
    </StackPanel>
  </c:SectionPage>
</UserControl>
