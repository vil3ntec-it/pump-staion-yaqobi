<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:v="using:PumpYaqobi.App.Views.Sections"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.DebtSectionView"
             x:DataType="vm:DebtSectionViewModel">
  <Panel>

    <!-- ══ فهرستِ کارت‌ها ══ -->
    <c:SectionPage IsVisible="{Binding IsListVisible}" Header="{Binding Title}">

      <c:SectionPage.Toolbar>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
          <Button Classes="accent" Content="افزودن شخص" Margin="0,0,8,0"
                  Command="{Binding AddDebtorCommand}" />
          <!-- «قرض‌های کهنه» از این‌جا رفت: حالا کارتِ زیربخشِ همین بخش است و
               بالای فهرست می‌نشیند — مثلِ ‎.tool-link-card‎ نسخهٔ وب. سه دکمهٔ
               مردهٔ قبلی (که هیچ فرمانی نداشتند) هم با آن رفتند. -->
          <!-- ⚠️ این دکمه تا امروز **هیچ فرمانی نداشت** — زده می‌شد و هیچ
               اتفاقی نمی‌افتاد. حالا صفحهٔ «مدت عضویت» را باز می‌کند، همتای
               ‎openMembershipList()‎ی سایت. -->
          <Button Content="مدت عضویت همه" Command="{Binding ShowMembershipCommand}"
                  ToolTip.Tip="یک صفحهٔ جدا با مدت عضویتِ همهٔ قرض‌داران" />
          <!-- «🔍 اسکنِ کیو‌آر» — رمزگشا از اول در برنامه بود، ولی فقط بخشِ
               دوربین از آن استفاده می‌کرد. حالا اسکنِ کیو‌آرِ یک حساب همان
               حساب را باز می‌کند، مثلِ سایت. -->
          <Button Classes="ghost info" Content="اسکنِ کیو‌آر" Margin="8,0,0,0"
                  Command="{Binding ScanQrCommand}"
                  ToolTip.Tip="عکسِ کیو‌آرِ یک حساب را بدهید تا همان حساب باز شود" />
        </WrapPanel>
      </c:SectionPage.Toolbar>

      <!-- ══ جست‌وجو: کوچک و در همان نوار، بغلِ «زیان ناشی از افزایش قیمت» ══
           گزارشِ صاحب ریپو با عکس: «جا اضافه گرفته شده، اون جستجو رو کوچیک کن
           و بذار بغلِ زیان ناشی از افزایش قیمت». پس نه ردیفِ جدا (‎Filters‎)،
           بلکه ‎Inline‎ی همان نوار، بعد از کارت‌های زیربخش. -->
      <c:SectionPage.Inline>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding Search}" Watermark="🔍 نام یا شماره" Width="165" MinHeight="44" FontSize="14.5" VerticalContentAlignment="Center" />
          <!-- 🎤 جست‌وجوی صوتی — همه روی خودِ دستگاه، بی اینترنت و بی سرور. -->
          <Button Padding="8,4" MinHeight="44" Content="🎤" ToolTip.Tip="نام را بگویید — حسابش باز می‌شود"
                  Command="{Binding VoiceSearchCommand}"
                  Classes.danger="{Binding Listening}" />
        </StackPanel>
      </c:SectionPage.Inline>

              <ItemsRepeater ItemsSource="{Binding Cards}">
          <ItemsRepeater.Layout>
              <!-- ══ کارت‌ها: هم‌اندازه، شش تا هشت تا در هر ردیف ══════════════
                   گزارشِ صاحب ریپو با عکس: «کادرهایشان برابرِ هم نیستند، یکی
                   کوچک یکی بزرگ، یا خیلی فاصله دارند … در هر صفحه شش تا هشت تا
                   جا بشود، نه با فاصلهٔ زیاد، برابر و استاندارد.»

                   دو چیز کم بود:
                   • ‎MinItemHeight‎ نبود، پس هر کارت به قدِ محتوای خودش بود —
                     کارتی که «اتمام پول» داشت بلندتر از بقیه می‌شد و ردیف
                     ناهموار می‌ماند. حالا همه یک قد دارند و کارت هم عمودی
                     کِش می‌آید تا قابش پر شود.
                   • ‎MaximumRowsOrColumns‎ نبود، پس روی نمایشگرِ پهن ‎ItemsStretch‎
                     کارت‌ها را بی‌جهت پهن می‌کرد. حالا سقفِ هشت‌تا دارد و
                     ‎MinItemWidth‎ی ۲۰۰ روی باریک‌ترین صفحه هم شش‌تا می‌دهد. -->
              <UniformGridLayout MinItemWidth="210" MinItemHeight="238"
                                 MaximumRowsOrColumns="8" ItemsStretch="Fill"
                                 MinColumnSpacing="10" MinRowSpacing="10" />
            </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:DebtorCardViewModel">

              <!-- کارتِ قرض‌دار — همان چیدمانِ نسخهٔ وب:
                   ✕ بالا-راست (در RTL سمتِ چپِ دید)، نقطهٔ حال بالا-چپ،
                   نام، مبلغِ بزرگ، دو نشانِ «اتمام تیل/پول»، دو عددِ سوخت،
                   دکمهٔ کیوآر و شمارهٔ کارت در پایین. -->
              <!-- ══ کلیک روی خودِ کارت ══════════════════════════════════
                   خواستهٔ صریحِ صاحب ریپو: «روی کادرش کلیک کنم برود، نه این‌که
                   یک کادر باشد به اسم باز کردن حساب». در سایت هم ‎card.onclick‎
                   حساب را باز می‌کند و دکمه‌ای به این نام نیست.

                   پس کارت داخلِ یک دکمهٔ بی‌چهره می‌نشیند (همان ‎card-shell‎ی
                   که بخشِ شرکت‌ها از قبل داشت). دکمه‌های درونِ کارت — ✕ و
                   کیو‌آر — کلیکشان را خودشان مصرف می‌کنند و به این نمی‌رسد. -->
              <Button Classes="card-shell" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                      Command="{Binding $parent[ItemsRepeater].((vm:DebtSectionViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}">
              <Border Classes="person-card">
                <!-- ══ چیدمانِ کارت — همان نمونه‌ای که صاحب ریپو پسندید ══════
                     نوارِ زنده بالا، بعد نام، عددِ درشت، واحد، حالِ حساب، و در
                     پایین یک خطِ نازک با ⛽/🟤 و «کیوآر».

                     ردیف‌های محتوا همه ‎Auto‎اند و تنها یک ردیفِ خالیِ ‎*‎ فضای
                     اضافه را جذب می‌کند. ⚠️ اگر ردیفِ محتوایی ‎*‎ شود، در تنگیِ
                     جا تا صفر جمع می‌شود و محتوایش ناپدید — همان «دیزل و پطرول
                     زیرِ کادر گم شدند»ی گزارشِ قبلی. -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                  <!-- نوارِ زنده: پرشدنش الباقی÷بردگی است و رنگش چهار پله دارد -->
                  <ProgressBar Grid.Row="0" Classes="meter" Minimum="0" Maximum="100"
                               Value="{Binding Meter}"
                               Classes.alarm="{Binding IsAlarm}"
                               Foreground="{Binding MeterBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />

                  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="10,9,10,0">
                    <Button Grid.Column="0" Classes="card-x" Content="✕"
                            Command="{Binding $parent[ItemsRepeater].((vm:DebtSectionViewModel)DataContext).DeleteDebtorCommand}"
                            CommandParameter="{Binding}" />
                    <TextBlock Grid.Column="2" Text="{Binding MeterText}" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{Binding MeterBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </Grid>

                  <!-- ⚠️ نام درشت و پررنگ: گزارشِ صاحب ریپو «اسم خیلی کوچک است، محتوا دیده نمی‌شود» -->
                  <TextBlock Grid.Row="2" Text="{Binding Name}" FontWeight="Black" FontSize="19"
                             Margin="11,8,11,0" TextTrimming="CharacterEllipsis" />

                  <TextBlock Grid.Row="3" Text="{Binding MoneyText}"
                             FontWeight="ExtraBold" FontSize="26" Margin="11,6,11,0"
                             Foreground="{Binding StatusBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />

                  <StackPanel Grid.Row="4" Margin="11,1,11,0" Spacing="5">
                    <TextBlock Text="الباقی · افغانی" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Pump.Muted}" />
                    <!-- دو نشانِ جدا سرِ جایشان‌اند: «اتمام تیل» و «اتمام پول»
                         از دو دفترِ کاملاً جدا می‌آیند و یکی‌شان نمی‌تواند
                         جایِ آن یکی را بگیرد. -->
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <TextBlock Text="{Binding MoneyBadge}" FontSize="13" FontWeight="Bold"
                                 IsVisible="{Binding HasMoneyBadge}"
                                 Foreground="{DynamicResource Pump.Danger}" />
                      <TextBlock Text="{Binding FuelBadge}" FontSize="13" FontWeight="Bold"
                                 IsVisible="{Binding HasFuelBadge}"
                                 Foreground="{DynamicResource Pump.Danger}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Row="6" Margin="0,10,0,0">
                    <Border Classes="card-rule" Margin="11,0" />
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="11,8,7,9">
                      <TextBlock Grid.Column="0" Text="{Binding PetrolText, StringFormat=⛽ {0}}"
                                 FontWeight="Bold" FontSize="13.5"
                                 Foreground="{DynamicResource Pump.Muted}" />
                      <TextBlock Grid.Column="1" Text="{Binding DieselText, StringFormat=🟤 {0}}"
                                 FontWeight="Bold" FontSize="13.5" Margin="12,0,0,0"
                                 Foreground="{DynamicResource Pump.Muted}" />
                      <Button Grid.Column="3" Classes="qr-link" Content="کیوآر"
                              Command="{Binding $parent[ItemsRepeater].((vm:DebtSectionViewModel)DataContext).ShowCardQrCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      
    </c:SectionPage>

    <Panel IsVisible="{Binding IsPersonVisible}">
      <v:PersonView DataContext="{Binding Person}" />
    </Panel>

    <!-- «🗂️ جدول‌های آرشیو» — صفحهٔ جداگانه روی حسابِ شخص، مثلِ ‎personArchiveModal‎ -->
    <Panel IsVisible="{Binding IsOverlayVisible}">
      <ContentControl Content="{Binding Overlay}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DebtArchivePageViewModel">
            <v:DebtArchiveView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Panel>
  </Panel>
</UserControl>
