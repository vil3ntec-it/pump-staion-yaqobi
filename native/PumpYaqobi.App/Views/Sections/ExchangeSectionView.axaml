<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ExchangeSectionView"
             x:DataType="vm:ExchangeSectionViewModel">

  <c:SectionPage Header="صرافی" SubHeader="مبلغ به ارزِ خودش وارد می‌شود و با «فی» شکسته می‌شود — فیِ صفر یعنی صفر">

    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" />
        <Button Classes="ghost" Content="📅 ماه بعد" Margin="0,0,6,0" />
        <Button Classes="ghost info" Content="📄 PDF" Margin="0,0,6,0" />
        <Button Classes="accent" Content="➕ ردیف جدید" Command="{Binding AddRowCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" MinWidth="140" />
      </StackPanel>
    </c:SectionPage.Filters>

    <!-- دو کادرِ بالای جدول و جملهٔ الباقی — همان سه چیزی که نسخهٔ وب دارد -->
    <c:SectionPage.Summary>
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,12,*">
          <Border Grid.Column="0" Classes="stat" HorizontalAlignment="Stretch">
            <StackPanel Spacing="3">
              <TextBlock Text="💲 جمله دالر این ماه" Classes="label" />
              <TextBlock Text="{Binding TotalUsd}" Classes="num"
                         Foreground="{DynamicResource Pump.Info}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="stat" HorizontalAlignment="Stretch">
            <StackPanel Spacing="3">
              <TextBlock Text="💵 جمله بردگی این ماه" Classes="label" />
              <TextBlock Text="{Binding TotalBardagi}" Classes="num"
                         Foreground="{DynamicResource Pump.Ok}" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Classes="panel" Padding="14,12" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding BaqiSentence}" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center"
                       Foreground="{Binding BaqiSentenceBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
            <TextBlock Text="{Binding BaqiSentenceNote}" Classes="muted" FontSize="11.5"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </c:SectionPage.Summary>

    <c:ExcelGrid ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="120" />
        <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*" />
        <DataGridTextColumn Header="مبلغ"  Binding="{Binding AmountText}" Width="130" />
        <DataGridTemplateColumn Header="واحد" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding CurrencyText}" VerticalAlignment="Center" Margin="6,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox SelectedItem="{Binding CurrencyText}">
                <ComboBoxItem Content="تومان" />
                <ComboBoxItem Content="کلدار" />
                <ComboBoxItem Content="افغانی" />
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="فی"      Binding="{Binding RateText}" Width="110" />
        <DataGridTextColumn Header="دالر" Binding="{Binding UsdText}" Width="115" IsReadOnly="True" />
        <DataGridTextColumn Header="رسید به صرافی" Binding="{Binding RasidText}" Width="135" IsReadOnly="True" />
        <DataGridTextColumn Header="بردگی پمپ بنزین ($)" Binding="{Binding BardagiText}" Width="165" />
        <DataGridTemplateColumn Header="" Width="60" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                      Command="{Binding $parent[UserControl].DataContext.DeleteRowCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </c:ExcelGrid>
  </c:SectionPage>
</UserControl>
