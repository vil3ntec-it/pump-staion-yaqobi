<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ExchangeSectionView"
             x:DataType="vm:ExchangeSectionViewModel">

  <c:SectionPage Header="صرافی" SubHeader="مبلغ به ارزِ خودش وارد می‌شود و با «فی» شکسته می‌شود — فیِ صفر یعنی صفر">

    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <!-- «🗓️ ماه جدید» — همتای ‎addChakanaMonth()‎ی سایت: جدولِ ماهِ بعد
             را باز می‌کند. بی این، ماهی که هنوز ردیفی ندارد در کشویی نیست. -->
        <Button Classes="ghost info" Content="ماه جدید" Margin="0,0,6,0"
                Command="{Binding NewMonthCommand}"
                ToolTip.Tip="جدولِ ماهِ بعد را باز می‌کند" />
        <Button Classes="ghost info" Content="تاریخچه" Margin="0,0,6,0" />
        <Button Classes="ghost" Content="ماه بعد" Margin="0,0,6,0" />
        <Button Classes="ghost info" Content="PDF" Margin="0,0,6,0"
                Command="{Binding PdfCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
        <!-- ══ کشویِ «سال» + «ماه» — همتای ‎_ymSelectsHtml‎ی سایت ═══════════════
             گزارشِ صاحب ریپو: «کادرِ کشویی سال هم نیست.» هیچ بخشی نداشت و همهٔ
             ماه‌های همهٔ سال‌ها در یک فهرستِ بلند بودند.
             با انتخابِ هر سال، فقط ماه‌های همان سال در کشویِ ماه می‌آیند.
             ⚠️ آن‌چه دیده می‌شود برچسبِ خوانا است («سنبله ۱۴۰۵»)، نه کلیدِ
             خامِ «1405/06» که تا امروز نشان داده می‌شد. -->
        <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                  IsVisible="{Binding Picker.HasYears}" MinWidth="110" />
        <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                  MinWidth="140" />
      </StackPanel>
    </c:SectionPage.Filters>

    <!-- دو کادرِ بالای جدول و جملهٔ الباقی — همان سه چیزی که نسخهٔ وب دارد -->
    <c:SectionPage.Summary>
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,12,*">
          <Border Grid.Column="0" Classes="stat" HorizontalAlignment="Stretch">
            <StackPanel Spacing="3">
              <TextBlock Text="💲 جمله دالر این ماه" Classes="label" />
              <TextBlock Text="{Binding TotalUsd}" Classes="num"
                         Foreground="{DynamicResource Pump.Info}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="stat" HorizontalAlignment="Stretch">
            <StackPanel Spacing="3">
              <TextBlock Text="💵 جمله بردگی این ماه" Classes="label" />
              <TextBlock Text="{Binding TotalBardagi}" Classes="num"
                         Foreground="{DynamicResource Pump.Ok}" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Classes="panel" Padding="14,12" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding BaqiSentence}" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center"
                       Foreground="{Binding BaqiSentenceBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
            <TextBlock Text="{Binding BaqiSentenceNote}" Classes="muted" FontSize="11.5"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </c:SectionPage.Summary>

    <!-- جدول + ردیفِ «جمله»ی ته آن — همتای ‎<tfoot class="xls-foot">‎ی سایت -->
    <Grid RowDefinitions="*,Auto">
    <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False"
                RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteRowCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
        <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="Auto" />
        <DataGridTextColumn Header="مبلغ"  Binding="{Binding AmountText}" Width="Auto" />
        <DataGridTemplateColumn Header="واحد" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو-سه گزینه، ‎ComboBox‎ یک قالبِ کامل با
                         ‎Popup‎ی خودش می‌ساخت — و ‎ledgerperf‎ گرفتش: نزدیک به چهل درصدِ
                         وقتِ باز شدنِ گاوصندوقِ ۲۰۰ ردیفی مالِ همین ستون‌ها بود. خواستهٔ
                         صاحب ریپو هم همین بود: «اون علامتِ ▾ فقط جا گرفته» و «با تب یا
                         اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ ‎celltoggle‎ را می‌زند. -->
                      <DataTemplate>
                        <Button Classes="fuelchip celltoggle" Content="{Binding CurrencyText}"
                                Command="{Binding ToggleCurrencyCommand}"
                                Foreground="{Binding CurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                BorderBrush="{Binding CurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                ToolTip.Tip="هر زدن یکی جلو: افغانی ← تومان ← کلدار" />
                      </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="فی"      Binding="{Binding RateText}" Width="Auto" />
        <DataGridTextColumn Header="دالر" Binding="{Binding UsdText}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="رسید به صرافی" Binding="{Binding RasidText}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="بردگی پمپ بنزین ($)" Binding="{Binding BardagiText}" Width="Auto" />
        <!-- ══ الباقی ═════════════════════════════════════════════════════
             گزارشِ صاحب ریپو: «بخشِ صرافی الباقی نداره.»

             حق داشت و ریشه‌اش هم همین‌جا بود: ردیفِ «جمله» یک خانهٔ
             «الباقی ($)» می‌ساخت، ولی جدول **ستونی به این نام نداشت**. نوارِ
             جمله هر خانه را زیرِ ستونِ هم‌نامش می‌نشاند و خانه‌ای که ستون
             نداشته باشد به دُمِ نوار می‌رود — یعنی عدد ساخته می‌شد و جایی
             دیده نمی‌شد.

             ⚠️ خانه‌های این ستون در ردیف‌ها عمداً خالی‌اند و فقط «جمله» عدد
             دارد — همان‌طور که نسخهٔ وب دارد و در ‎ExchangeRowViewModel‎ هم
             نوشته شده. -->
        <DataGridTextColumn Header="الباقی ($)" Binding="{Binding BaqiText}"
                            Width="Auto" IsReadOnly="True" />
      </DataGrid.Columns>
    </c:ExcelGrid>
    <c:TotalsBar Grid.Row="1" ItemsSource="{Binding TotalCells}" IsVisible="{Binding HasTotals}" />
    </Grid>
  </c:SectionPage>
</UserControl>
