<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.HistorySectionView"
             x:DataType="vm:HistorySectionViewModel">
  <Panel>

    <!-- ══ کارت‌های بخش‌ها ═════════════════════════════════════════════════
         مو‌به‌مو مثلِ ‎#hc-cards‎: هر بخش یک کادر با شمارِ ردیف و تازه‌ترین
         تاریخش؛ زدنِ کادر، تاریخچهٔ همان بخش را باز می‌کند. -->
    <c:SectionPage IsVisible="{Binding IsListVisible}" Header="تاریخچه‌ها"
                   SubHeader="هر بخش تاریخچهٔ خودش را دارد — از تازه به کهنه. فقط برای دیدن است؛ هیچ چیزی عوض یا پاک نمی‌شود.">
      <c:SectionPage.Toolbar>
        <!-- «برگشت به تاریخچه‌ها»ی صفحهٔ بخش آدم را همین‌جا می‌گذارد، پس راهِ
             برگشت به بخشِ مبدأ باید این‌جا هم باشد. -->
        <Button Classes="accent" Content="{Binding OriginBackText}"
                IsVisible="{Binding HasOrigin}"
                Command="{Binding BackToOriginCommand}" />
      </c:SectionPage.Toolbar>
              <ItemsRepeater ItemsSource="{Binding Cards}">
          <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="272" ItemsStretch="Fill"
                                 MinColumnSpacing="12" MinRowSpacing="12" />
            </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryCardViewModel">
              <Button Classes="card-shell" Command="{Binding OpenCommand}">
                <Border Classes="card" Padding="14,12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding SubText}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      
    </c:SectionPage>

    <!-- ══ تاریخچهٔ یک بخش ═════════════════════════════════════════════════
         همان ‎#sec-historyview‎: دکمهٔ برگشت، کشویِ ماه، خلاصه، و فهرست. -->
    <c:SectionPage IsVisible="{Binding !IsListVisible}" Header="{Binding PageTitle}">

      <c:SectionPage.Toolbar>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <!-- ⛔ دو راهِ برگشت، و هر دو لازم‌اند: یکی به فهرستِ کارت‌ها و یکی
               به **همان بخشی که از آن آمدیم** (۱۴۰۵/۰۷/۰۶). دومی فقط وقتی
               دیده می‌شود که واقعاً از بخشی آمده باشیم. -->
          <Button Classes="accent" Content="{Binding OriginBackText}" Margin="0,0,10,0"
                  IsVisible="{Binding HasOrigin}"
                  Command="{Binding BackToOriginCommand}" />
          <Button Classes="ghost" Content="برگشت به تاریخچه‌ها" Margin="0,0,10,0"
                  Command="{Binding BackCommand}" />
          <TextBlock Text="📅 ماه:" Classes="label" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" MinWidth="150" />
          <!-- ⛔ صافیِ پارچه‌ها (۱۴۰۵/۰۷/۱۳): تیل و شمارهٔ پایه — فقط برای دیدن -->
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="14,0,0,0"
                      IsVisible="{Binding HasShiftFilters}">
            <Button Classes="seg" Content="همه" Command="{Binding PickFuelCommand}"
                    CommandParameter="all" Classes.on="{Binding IsFuelAll}" />
            <Button Classes="seg" Content="⛽ پطرول" Command="{Binding PickFuelCommand}"
                    CommandParameter="petrol" Classes.on="{Binding IsFuelPetrol}" />
            <Button Classes="seg" Content="🟤 دیزل" Command="{Binding PickFuelCommand}"
                    CommandParameter="diesel" Classes.on="{Binding IsFuelDiesel}" />
            <TextBlock Text="پایه:" Classes="label" VerticalAlignment="Center" Margin="10,0,2,0" />
            <ItemsControl ItemsSource="{Binding Pumps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PumpChip">
                  <Button Classes="seg" Content="{Binding Text}" MinWidth="34" Padding="8,2"
                          Command="{Binding PickCommand}" Classes.on="{Binding IsOn}"
                          ToolTip.Tip="{Binding Tip}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </WrapPanel>
      </c:SectionPage.Toolbar>

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Summary}" Classes="muted" HorizontalAlignment="Center" />

        <!-- جدولِ همان بخش، با ستون‌های خودش (پارچه‌ها، ورق‌ها، صرافی، شرکت‌ها) —
             ستون‌ها در کد ساخته می‌شوند (‎HistorySectionView.axaml.cs‎). -->
        <Border Classes="panel" Padding="0" Name="KindHost">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!IsEmpty" />
              <Binding Path="HasColumns" />
            </MultiBinding>
          </Border.IsVisible>
        </Border>

        <Border Classes="panel" Padding="0">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!IsEmpty" />
              <Binding Path="!HasColumns" />
            </MultiBinding>
          </Border.IsVisible>
          <!-- ⛔ سرستون با اسکرول همراه نمی‌آید (خواستهٔ ۱۴۰۵/۰۷/۱۲: «سرِ جدول‌ها
               توی اسکرول تا ته صفحه با من می‌آید») — شرحش ‎ExcelGrid.HeaderFollows‎. -->
          <c:ExcelGrid ItemsSource="{Binding GenericRows}" x:CompileBindings="False" HeaderFollows="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="Auto" />
              <DataGridTextColumn Header="چه بود" Binding="{Binding Title}" Width="Auto" />
              <DataGridTextColumn Header="توضیح" Binding="{Binding Detail}" Width="*" />
              <!-- مبلغ ستونِ خودش را دارد چون رنگش به «آمد/رفت» بستگی دارد -->
              <DataGridTemplateColumn Header="مبلغ" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding AmountText}" Margin="8,0" VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{Binding AmountBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>
        </Border>
      </StackPanel>
    </c:SectionPage>
  </Panel>
</UserControl>
