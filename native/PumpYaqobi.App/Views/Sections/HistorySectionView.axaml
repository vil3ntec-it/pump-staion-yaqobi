<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.HistorySectionView"
             x:DataType="vm:HistorySectionViewModel">
  <Panel>

    <!-- ══ کارت‌های بخش‌ها ═════════════════════════════════════════════════
         مو‌به‌مو مثلِ ‎#hc-cards‎: هر بخش یک کادر با شمارِ ردیف و تازه‌ترین
         تاریخش؛ زدنِ کادر، تاریخچهٔ همان بخش را باز می‌کند. -->
    <c:SectionPage IsVisible="{Binding IsListVisible}" Header="تاریخچه‌ها"
                   SubHeader="هر بخش تاریخچهٔ خودش را دارد — از تازه به کهنه. فقط برای دیدن است؛ هیچ چیزی عوض یا پاک نمی‌شود.">
      <c:SectionPage.Toolbar>
        <!-- «برگشت به تاریخچه‌ها»ی صفحهٔ بخش آدم را همین‌جا می‌گذارد، پس راهِ
             برگشت به بخشِ مبدأ باید این‌جا هم باشد. -->
        <Button Classes="accent" Content="{Binding OriginBackText}"
                IsVisible="{Binding HasOrigin}"
                Command="{Binding BackToOriginCommand}" />
      </c:SectionPage.Toolbar>
              <ItemsRepeater ItemsSource="{Binding Cards}">
          <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="272" ItemsStretch="Fill"
                                 MinColumnSpacing="12" MinRowSpacing="12" />
            </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryCardViewModel">
              <Button Classes="card-shell" Command="{Binding OpenCommand}">
                <Border Classes="card" Padding="14,12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="{Binding SubText}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      
    </c:SectionPage>

    <!-- ══ تاریخچهٔ یک بخش ═════════════════════════════════════════════════
         همان ‎#sec-historyview‎: دکمهٔ برگشت، کشویِ ماه، خلاصه، و فهرست. -->
    <c:SectionPage IsVisible="{Binding !IsListVisible}" Header="{Binding PageTitle}">

      <c:SectionPage.Toolbar>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <!-- ⛔ دو راهِ برگشت، و هر دو لازم‌اند: یکی به فهرستِ کارت‌ها و یکی
               به **همان بخشی که از آن آمدیم** (۱۴۰۵/۰۷/۰۶). دومی فقط وقتی
               دیده می‌شود که واقعاً از بخشی آمده باشیم. -->
          <Button Classes="accent" Content="{Binding OriginBackText}" Margin="0,0,10,0"
                  IsVisible="{Binding HasOrigin}"
                  Command="{Binding BackToOriginCommand}" />
          <Button Classes="ghost" Content="برگشت به تاریخچه‌ها" Margin="0,0,10,0"
                  Command="{Binding BackCommand}" />
          <TextBlock Text="📅 ماه:" Classes="label" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" MinWidth="150" />
        </WrapPanel>
      </c:SectionPage.Toolbar>

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Summary}" Classes="muted" HorizontalAlignment="Center" />

        <Border Classes="panel" Padding="0" IsVisible="{Binding !IsEmpty}">
          <c:ExcelGrid ItemsSource="{Binding Rows}" x:CompileBindings="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="Auto" />
              <DataGridTextColumn Header="چه بود" Binding="{Binding Title}" Width="Auto" />
              <DataGridTextColumn Header="توضیح" Binding="{Binding Detail}" Width="*" />
              <!-- مبلغ ستونِ خودش را دارد چون رنگش به «آمد/رفت» بستگی دارد -->
              <DataGridTemplateColumn Header="مبلغ" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding AmountText}" Margin="8,0" VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{Binding AmountBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>
        </Border>
      </StackPanel>
    </c:SectionPage>
  </Panel>
</UserControl>
