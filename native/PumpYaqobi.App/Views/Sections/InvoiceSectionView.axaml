<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.InvoiceSectionView"
             x:DataType="vm:InvoiceSectionViewModel">

  <c:SectionPage Header="ثبت فاکتورها"
                 SubHeader="تایید، بخشِ پولی را به دفترِ پول و بخشِ تیل را به «رسیدِ تیل»ِ همان حساب می‌برد">

    <c:SectionPage.Toolbar>
      <Button Classes="accent" Content="فاکتورِ تازه" Command="{Binding AddInvoiceCommand}" />
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="جست‌وجو" Classes="label" VerticalAlignment="Center" />
        <TextBox Text="{Binding Search}" Width="240" Watermark="نامِ مشتری یا شماره" />
        <CheckBox Content="فقط در انتظارِ تایید" IsChecked="{Binding OnlyPending}" />
      </StackPanel>
    </c:SectionPage.Filters>

    <c:SectionPage.Summary>
      <!-- ‎Rows="1"‎ یعنی «همه در یک ردیف، با عرضِ مساوی» — کادرها تا لبه پخش
           می‌شوند به‌جای آن‌که راست جمع شوند و کنارشان خالی بماند. -->
      <UniformGrid Rows="1" Classes="stats">
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="در انتظارِ تایید" Classes="label" />
            <TextBlock Text="{Binding PendingCount}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="تایید شده" Classes="label" />
            <TextBlock Text="{Binding ApprovedCount}" Classes="num" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </c:SectionPage.Summary>

    <!-- ══ فهرستِ فاکتورها ═══════════════════════════════════════════════
         در نسخهٔ وب این‌جا جدول نیست، فهرستِ قلم‌هاست (‎.inv-item‎): شماره،
         نامِ مشتری با خطِ جزئیاتش، نشانِ حال و دکمه‌ها.
         با جدولِ چهارده‌ستونه نه شبیهِ نسخهٔ وب بود و نه در ستونِ صفحه جا
         می‌شد — نصفِ ستون‌ها بیرون می‌ماندند. -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InvoiceRowViewModel">
            <Border Classes="panel" Padding="12,10" Margin="0,0,0,9">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <Border Grid.Column="0" Classes="chip" MinWidth="44" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15"
                             HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBox Text="{Binding Customer}" Watermark="نامِ مشتری"
                           BorderThickness="0" Background="Transparent" Padding="0"
                           FontWeight="Bold" FontSize="15" MinHeight="24" />
                  <TextBlock Text="{Binding PartsText}" Classes="muted" FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock Text="{Binding ChipText}" FontSize="12" FontWeight="Bold"
                             Foreground="{Binding ChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                  <Button Classes="accent" Content="✅ تایید فاکتور" FontSize="12" Padding="10,0"
                          IsVisible="{Binding IsPending}"
                          Command="{Binding $parent[ItemsControl].((vm:InvoiceSectionViewModel)DataContext).ApproveCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="↩️ برگشت به صف" FontSize="12" Padding="10,0"
                          IsVisible="{Binding IsApproved}"
                          Command="{Binding $parent[ItemsControl].((vm:InvoiceSectionViewModel)DataContext).RevertCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="ghost danger" Content="🗑️ حذف" FontSize="12" Padding="10,0"
                          Command="{Binding $parent[ItemsControl].((vm:InvoiceSectionViewModel)DataContext).DeleteInvoiceCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </c:SectionPage>
</UserControl>
