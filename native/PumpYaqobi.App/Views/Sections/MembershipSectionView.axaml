<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.MembershipSectionView"
             x:DataType="vm:MembershipSectionViewModel">

  <!-- ══ مدت عضویت ═══════════════════════════════════════════════════════════
       همتای ‎openMembershipList()‎ی نسخهٔ وب: چهار ستون، از قدیمی‌ترین مشتری
       به جدیدترین. دکمه‌اش («⏳ مدت عضویت همه») تا امروز هیچ فرمانی نداشت. -->
  <c:SectionPage Header="⏳ مدت عضویت قرض‌داران" SubHeader="{Binding SummaryText}">

    <c:ExcelGrid ItemsSource="{Binding Rows}" IsReadOnly="True" x:CompileBindings="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="Auto" />
        <DataGridTextColumn Header="از تاریخ" Binding="{Binding FromText}" Width="Auto" />
        <DataGridTextColumn Header="نام قرض‌دار" Binding="{Binding Name}" Width="Auto" MinWidth="180" />
        <DataGridTextColumn Header="مدت عضویت" Binding="{Binding AgeText}" Width="Auto" MinWidth="150" />
      </DataGrid.Columns>
    </c:ExcelGrid>

    <c:SectionPage.Footer>
      <TextBlock Text="هیچ قرض‌داری ثبت نشده" Classes="muted"
                 HorizontalAlignment="Center" Margin="0,14"
                 IsVisible="{Binding IsEmpty}" />
    </c:SectionPage.Footer>
  </c:SectionPage>
</UserControl>
