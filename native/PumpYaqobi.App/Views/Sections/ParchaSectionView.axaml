<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ParchaSectionView"
             x:DataType="vm:ParchaSectionViewModel">

  <UserControl.Resources>
    <!-- کارتِ یک شیفت — همان چیدمانِ نسخهٔ وب، خانه به خانه -->
    <DataTemplate x:Key="ShiftCard" x:DataType="vm:ShiftFormViewModel">
      <Border Classes="shift-card">
        <Grid RowDefinitions="Auto,*,Auto">

          <Border Grid.Row="0" Classes="shift-header" Classes.day="{Binding IsDay}"
                  Classes.night="{Binding IsNight}">
            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
          </Border>

          <!-- ══ خانه‌های شیفت، دو‌ستونه ══════════════════════════════════
               پیش از این یازده خانه روی هم چیده بودند و هر کدام تمامِ عرضِ
               کارت را می‌گرفت: در پنجرهٔ ۱۴۴۰ پیکسلی، یک کادرِ ۶۲۵ پیکسلی
               برای عددِ چهار‌رقمیِ «جمله قرض». دو‌ستونه، کادرها به اندازهٔ
               عددی می‌شوند که تویشان می‌نشیند و کلِ فرم در یک نگاه جا
               می‌شود — بی آن‌که چیزی از صفحه بیرون بماند.

               ترتیبِ خانه‌ها دست‌نخورده است؛ فقط جفت‌های هم‌خانواده کنارِ هم
               نشسته‌اند (شروع/ختمِ پایه، قرض/فی، فروش/موجودی، فایده/پول).  -->
          <Grid Grid.Row="1" Margin="13,12,13,12"
                ColumnDefinitions="*,11,*"
                RowDefinitions="Auto,9,Auto,9,Auto,9,Auto,9,Auto,9,Auto,9,Auto,9,Auto">

            <!-- نامِ کارمند + شمارهٔ پایه — تمامِ عرض -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
              <TextBlock Text="نام کارمند" Classes="fld" />
              <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="نام" />
                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                  <TextBlock Text="شماره پایه" FontSize="10.5" Foreground="{DynamicResource Pump.Muted}"
                             HorizontalAlignment="Center" />
                  <TextBox Text="{Binding PumpNum}" Watermark="#" Width="54"
                           HorizontalContentAlignment="Center" FontWeight="Bold" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- شروعِ پایه | ختمِ پایه -->
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
              <TextBlock Text="شروع پایه (لیتر)" Classes="fld" />
              <Grid ColumnDefinitions="*,7,Auto">
                <TextBox Grid.Column="0" Text="{Binding Start}" Watermark="0" />
                <Button Grid.Column="2" Content="{Binding PullText}" Padding="10,6" FontSize="11.5"
                        Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).PullBaseCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
              <TextBlock Text="ختم پایه (لیتر)" Classes="fld" />
              <Grid ColumnDefinitions="*,7,Auto">
                <TextBox Grid.Column="0" Text="{Binding End}" Watermark="0" />
                <Button Grid.Column="2" Content="{Binding PushText}" Padding="10,6" FontSize="11.5"
                        Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).PushBaseCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>

            <!-- جملهٔ قرض | فیِ لیتر -->
            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
              <TextBlock Text="جمله قرض (افغانی)" Classes="fld" />
              <TextBox Text="{Binding Debt}" Watermark="0" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
              <TextBlock Text="فی لیتر (افغانی)" Classes="fld" />
              <TextBox Text="{Binding Price}" Watermark="0" />
            </StackPanel>

            <!-- فایدهٔ فیِ لیتر — برچسبش بلند است، تمامِ عرض -->
            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
              <TextBlock Text="فایده فی لیتر (افغانی) — اتومات از مخزن" Classes="fld" />
              <Grid ColumnDefinitions="*,11,*">
                <TextBox Grid.Column="0" Text="{Binding ProfitPer}" Watermark="اتومات پر می‌شه" />
                <TextBlock Grid.Column="2" Text="{Binding BuyPerLabel}" FontSize="11" FontStyle="Italic"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Pump.Muted}" />
              </Grid>
            </StackPanel>

            <!-- فروش | جملهٔ موجودی — هر دو خودکار -->
            <StackPanel Grid.Row="8" Grid.Column="0" Spacing="4">
              <TextBlock Text="فروش (لیتر) — خودکار" Classes="fld" />
              <Border Classes="calc"><TextBlock Text="{Binding SaleText}" /></Border>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="2" Spacing="4">
              <TextBlock Text="جمله موجودی افغانی — خودکار" Classes="fld" />
              <Border Classes="calc"><TextBlock Text="{Binding MoneyText}" /></Border>
            </StackPanel>

            <!-- فایده | پولِ موجود -->
            <StackPanel Grid.Row="10" Grid.Column="0" Spacing="4">
              <TextBlock Text="فایده — خودکار" Classes="fld" />
              <Border Classes="calc">
                <TextBlock Text="{Binding ProfitText}" Foreground="{DynamicResource Pump.Ok}" />
              </Border>
            </StackPanel>

            <StackPanel Grid.Row="10" Grid.Column="2" Spacing="4">
              <TextBlock Text="💵 پول موجود افغانی — خودکار" Classes="fld"
                         Foreground="{DynamicResource Pump.Ok}" FontWeight="Bold" />
              <Border Classes="calc">
                <TextBlock Text="{Binding AvailableText}"
                           Foreground="{Binding AvailableBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                           FontWeight="Bold" FontSize="16" />
              </Border>
            </StackPanel>

            <!-- یادداشت — تمامِ عرض -->
            <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
              <TextBlock Text="یادداشت" Classes="fld" />
              <TextBox Text="{Binding Note}" Watermark="..." />
            </StackPanel>

            <Border Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3"
                    Classes="saved-badge" IsVisible="{Binding Saved}">
              <TextBlock Text="{Binding SavedText}" HorizontalAlignment="Center" />
            </Border>
          </Grid>

          <Button Grid.Row="2" Classes="save-btn" Classes.day="{Binding IsDay}"
                  Classes.night="{Binding IsNight}"
                  Content="{Binding SaveText}" Margin="13,0,13,13"
                  HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <c:SectionPage>
    <c:SectionPage.Header>پارچه‌ها</c:SectionPage.Header>

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding FuelToggleText}" Command="{Binding ToggleFuelCommand}" />
        <Button Content="🕘 تاریخچهٔ پایه‌ها" />
        <Button Classes="accent" Content="📄 PDF همه گزارش‌ها" Command="{Binding PdfCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <Grid RowDefinitions="Auto,14,*">

      <!-- ══ کارتِ «ثبت پارچه فعلی» ══ -->
      <Border Grid.Row="0" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto">

          <!-- سربرگِ کارت: عنوان بالا، ابزار زیرش.
               یک‌ردیفه بود و در ستونِ ۱۰۰۰ پیکسلی «پارچهٔ جدید شب» می‌افتاد
               خطِ بعد و بی‌قواره می‌شد. حالا هر چه هم پنجره باریک شود، مرتب
               می‌ماند: هر ابزار حاشیهٔ پایین دارد پس شکستنِ خط هم تمیز است. -->
          <Border Grid.Row="0" Classes="card-head">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding CardTitle}" FontWeight="Bold" FontSize="15"
                         Foreground="{DynamicResource Pump.Accent}" />
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="📅 تاریخ:" Classes="muted" VerticalAlignment="Center"
                           Margin="0,0,7,6" />
                <TextBox Text="{Binding PaDate}" Width="120" HorizontalContentAlignment="Center"
                         Margin="0,0,8,6" />
                <Border Classes="chip" Margin="0,0,8,6">
                  <TextBlock Text="{Binding ReportNumText, StringFormat=گزارش #{0}}" />
                </Border>
                <Button Classes="accent" Content="➕ گزارش جدید" Margin="0,0,8,6"
                        Command="{Binding StartNewReportCommand}" />
                <Button Content="🆕 پارچهٔ جدید روز" Margin="0,0,8,6"
                        Command="{Binding NewParchaDayCommand}" />
                <Button Content="🆕 پارچهٔ جدید شب" Margin="0,0,0,6"
                        Command="{Binding NewParchaNightCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- دو کارتِ شیفت، کنارِ هم -->
          <Grid Grid.Row="1" ColumnDefinitions="*,14,*" Margin="14">
            <ContentControl Grid.Column="0" Content="{Binding Day}"
                            ContentTemplate="{StaticResource ShiftCard}" />
            <ContentControl Grid.Column="2" Content="{Binding Night}"
                            ContentTemplate="{StaticResource ShiftCard}" />
          </Grid>
        </Grid>
      </Border>

      <!-- ══ گزارش‌های ۲۴ ساعته ══ -->
      <Border Grid.Row="2" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="card-head">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <TextBlock Grid.Column="0" Text="📑 گزارش‌های ۲۴ ساعته" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <TextBox Grid.Column="1" Text="{Binding DateFilter}" Width="140" Watermark="فیلتر تاریخ" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" Padding="12">
            <ItemsControl ItemsSource="{Binding Reports}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><c:AutoFillPanel MinItemWidth="268" Gap="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportCardViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13" />
                        <Button Grid.Column="1" Classes="ghost danger" Content="✕" Padding="7,1" FontSize="11"
                                Command="{Binding $parent[ItemsControl].((vm:ParchaSectionViewModel)DataContext).DeleteReportCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                      <TextBlock Text="{Binding DayName, StringFormat=☀️ {0}}" Classes="muted" />
                      <TextBlock Text="{Binding NightName, StringFormat=🌙 {0}}" Classes="muted" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="فروش" Classes="label" FontSize="11" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SaleText}" FontWeight="Bold" FontSize="12.5" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="پول موجود" Classes="label" FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailableText}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{DynamicResource Pump.Ok}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="فایده" Classes="label" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfitText}" FontWeight="Bold" FontSize="12.5" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </c:SectionPage>
</UserControl>
