<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ParchaSectionView"
             x:DataType="vm:ParchaSectionViewModel">

  <!-- ══ نوشتهٔ راهنمای کادرها سمتِ راست ══════════════════════════════════
       خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۶): «place holderهاشون سمتِ راست
       باشن، همه‌شون.»

       ⚠️ ریشه یک ‎Setter‎ی سراسری بود: ‎TextBox.TextAlignment = Center‎ در
       ‎Themes/Controls.axaml‎ (قاعدهٔ «همه نوشته‌ها وسط‌چین»). قالبِ خودِ
       آوالونیا نوشتهٔ راهنما را با همان ‎TextAlignment‎ می‌کشد، پس راهنما هم
       وسط می‌افتاد.

       ⛔ آن قاعده پس گرفته نشد: **نوشتهٔ تایپ‌شده همچنان وسط است** و فقط
       راهنما راست می‌شود، و فقط در همین صفحه و صفحهٔ ورق. -->
  <UserControl.Styles>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- کارتِ یک شیفت — همان چیدمانِ نسخهٔ وب، خانه به خانه -->
    <DataTemplate x:Key="ShiftCard" x:DataType="vm:ShiftFormViewModel">
      <Border Classes="shift-card">
        <Grid RowDefinitions="Auto,*,Auto">

          <Border Grid.Row="0" Classes="shift-header" Classes.day="{Binding IsDay}"
                  Classes.night="{Binding IsNight}">
            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
          </Border>

          <!-- ══ خانه‌های شیفت — هر کدام یک ردیفِ تمام‌عرض ═══════════════
               گزارشِ صاحب ریپو: «پارچه همهٔ ردیف‌هایش پشتِ هم نیستند — کادرها
               منظورم است؛ ببین توی سایت دیگر مدل است.»

               حق داشت. سایت هر خانه را یک ردیفِ جدا و تمام‌عرضِ کارت می‌کند:

                   .field-row{ display:flex; flex-direction:column; gap:3px }
                   .field-input{ width:100% }

               یعنی برچسب بالا، کادر زیرش، و ردیفِ بعدی زیرِ آن — یازده خانه
               پشتِ هم. نیتیو این‌ها را دو‌ستونه کرده بود («جفت‌های هم‌خانواده
               کنارِ هم») که اختراعِ خودش بود و با سایت نمی‌خواند.

               ⚠️ دو‌ستونه‌اش نکنید. ترتیب هم همان ترتیبِ سایت است:
               نام ← شروع ← ختم ← قرض ← فی ← فایدهٔ فی ← فروش ← موجودی ←
               فایده ← پولِ موجود ← یادداشت.                                -->
          <StackPanel Grid.Row="1" Margin="13,12,13,12" Spacing="9">

            <!-- ══ همهٔ ردیف‌ها یک قالب دارند — «تراز» ═══════════════════
                 گزارشِ صاحب ریپو با عکس (۱۴۰۵/۰۷/۱۰): «هیچ کادرش برابر
                 نیست و نامِ کارمندها از همه متفاوت‌تر است؛ فاصله‌هاشو چرا
                 رعایت نکردی؟ همه را با دقت درست کن و تراز.»

                 حق داشت و سه پهنای متفاوت روی یک کارت بود:
                   • نامِ کارمند   ⇒ پهنای **ثابتِ** ۲۱۰ و بلندیِ ۴۸
                   • شروع/ختمِ پایه ⇒ ‎*‎ منهای دکمهٔ کنارش
                   • بقیه           ⇒ تمام‌عرض
                 پس هیچ دو کادری لبه‌های یکسان نداشتند.

                 ⛔ **راهِ درست یک قالب برای همه بود، نه اصلاحِ تک‌تک.**

                 ⚠️ و بندِ «ستونِ کناری روی **هر** ردیف رزرو می‌شود» در
                 ۱۴۰۵/۰۷/۱۲ **پس گرفته شد**، با عکسِ خودِ صاحب ریپو: «اون
                 بغل‌ها خالی گذاشته شدن و کادرش به تمامِ ورق نمی‌رسه.» حق
                 داشت — نُه ردیف یک نوارِ ۱۰۶ پیکسلیِ **خالی** کنارشان
                 داشتند، فقط برای این‌که دو ردیفِ دیگر دکمه دارند.

                 ⛔ پس ستونِ کناری فقط روی ردیفی است که **واقعاً** دکمه
                 دارد (شروع و ختمِ پایه) و بقیه تمام‌عرض‌اند. ترازی هم از
                 دست نرفت: لبهٔ **شروعِ** همهٔ کادرها (سمتِ راست) همان یکی
                 است و قدشان هم یکی (‎.wfield‎) — همان چیزی که سایت دارد.

                 ⚠️ و «بلندیِ کادرِ نام» پس گرفته نشد (خواستهٔ ۱۴۰۵/۰۷/۰۶:
                 «طولش بزرگ باشه نه عرضش») — **همهٔ** کادرها همان بلندی را
                 گرفتند (‎.wfield‎)، پس هم بزرگ است هم برابر. -->

            <!-- نامِ کارمند + شمارهٔ پایه — برچسب‌ها هم روی همان دو ستون -->
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,8,106">
                <TextBlock Grid.Column="0" Text="نام کارمند" Classes="fld" />
                <TextBlock Grid.Column="2" Text="شماره پایه" Classes="fld"
                           TextAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="*,8,106">
                <TextBox Grid.Column="0" Classes="wfield" Text="{Binding Name}"
                         Watermark="نام کارمند" c:Suggest.Key="staff" />
                <TextBox Grid.Column="2" Classes="wfield" Text="{Binding PumpNum}"
                         Watermark="#" FontWeight="Bold" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="شروع پایه (لیتر)" Classes="fld" />
              <Grid ColumnDefinitions="*,8,106">
                <!-- ⛔ خودِ عدد سرخ می‌شود («توی خود همون کادر هم عدد سرخ
                     بشه») — پس نشانه با رفتن به کادرِ دیگر از چشم نمی‌افتد. -->
                <!-- ══ هشدارِ زنجیرهٔ پایه، **داخلِ خودِ کادر** ═══════════════
                     خواستهٔ صاحب ریپو با عکس (۱۴۰۵/۰۷/۱۲): «این کادرِ دیدم داخلِ
                     خودِ شروع پایه باشد که پایین جا یا فاصله با کادرِ پایین
                     نیندازد.» پیش از این یک ردیفِ همیشه‌حاضرِ ۲۲ پیکسلی زیرِ
                     کادر بود — جابه‌جا نمی‌کرد، ولی همیشه یک فاصلهٔ خالی
                     می‌گذاشت. حالا ⚠️ و «✔ دیدم» گوشهٔ خودِ کادر می‌نشینند
                     (‎InnerRightContent‎) و جملهٔ کامل روی خودِ ⚠️ و «دیدم»
                     (‎ToolTip‎) است. ⛔ پس نه چیزی جابه‌جا می‌شود و نه جایی
                     گرفته می‌شود؛ و مانعِ ذخیره هم نیست. -->
                <TextBox Grid.Column="0" Classes="wfield" Text="{Binding Start}" Watermark="0"
                         Foreground="{Binding StartBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}">
                  <TextBox.InnerRightContent>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0"
                                VerticalAlignment="Center" IsVisible="{Binding LowBase}">
                      <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding LowBaseText}" />
                      <Button Content="✔ دیدم" Classes="ghost lowack" Padding="7,1"
                              FontSize="11" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding LowBaseText}"
                              Command="{Binding AckLowBaseCommand}" />
                    </StackPanel>
                  </TextBox.InnerRightContent>
                </TextBox>
                <!-- ⚠️ دکمه هم‌قدِ کادر و هم‌پهنای ستون است، وگرنه همان
                     ناهمواری از سمتِ دکمه برمی‌گردد. -->
                <Button Grid.Column="2" Classes="wside" Classes.day="{Binding IsDay}"
                        Classes.night="{Binding IsNight}"
                        Content="{Binding PullText}"
                        Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).PullBaseCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="ختم پایه (لیتر)" Classes="fld" />
              <Grid ColumnDefinitions="*,8,106">
                <!-- ══ عددِ «ختم» هم‌پای عددِ «شروع» ═════════════════════════════
                     خواستهٔ صاحب ریپو با عکس (۱۴۰۵/۰۷/۱۲): «هر دو عدد با هم بروند
                     یک طرف، و اگر مشکلی نبود هر دو سرِ جایشان.» هشدارِ داخلِ
                     کادرِ شروع جا می‌گیرد و عددِ وسط‌چینش را کنار می‌برد؛ پس همان
                     تکه این‌جا هم هست — **نامرئی** و بی‌کلیک — تا عددِ ختم دقیقاً
                     همان‌قدر برود و دو عدد زیرِ هم بمانند. ⚠️ رونوشتِ مو‌به‌موی
                     همان تکه است (نه یک فاصلهٔ عددی)، تا پهنایش هر قلم و هر
                     اندازه‌ای همان باشد. -->
                <TextBox Grid.Column="0" Classes="wfield" Text="{Binding End}" Watermark="0">
                  <TextBox.InnerRightContent>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0"
                                VerticalAlignment="Center" IsVisible="{Binding LowBase}"
                                Opacity="0" IsHitTestVisible="False" Classes="lowpad">
                      <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                      <Button Content="✔ دیدم" Classes="ghost" Padding="7,1" FontSize="11"
                              VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                    </StackPanel>
                  </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="2" Classes="wside" Classes.day="{Binding IsDay}"
                        Classes.night="{Binding IsNight}"
                        Content="{Binding PushText}"
                        Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).PushBaseCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="جمله قرض (افغانی)" Classes="fld" />
              <TextBox Classes="wfield" Text="{Binding Debt}" Watermark="0" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="فی لیتر (افغانی)" Classes="fld" />
              <TextBox Classes="wfield" Text="{Binding Price}" Watermark="0" />
            </StackPanel>

            <!-- فایدهٔ فیِ لیتر — و زیرش همان جملهٔ کج‌نوشتهٔ «فی خرید…» سایت -->
            <StackPanel Spacing="4">
              <TextBlock Text="فایده فی لیتر (افغانی) — اتومات از مخزن" Classes="fld" />
              <TextBox Classes="wfield" Text="{Binding ProfitPer}"
                       Watermark="اتومات پر می‌شه" />
              <TextBlock Text="{Binding BuyPerLabel}" FontSize="11" FontStyle="Italic"
                         Foreground="{DynamicResource Pump.Muted}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="فروش (لیتر) — خودکار" Classes="fld" />
              <Border Classes="calc wfield">
                <TextBlock Text="{Binding SaleText}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="جمله موجودی افغانی — خودکار" Classes="fld" />
              <Border Classes="calc wfield">
                <TextBlock Text="{Binding MoneyText}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="فایده — خودکار" Classes="fld" />
              <Border Classes="calc wfield">
                <TextBlock Text="{Binding ProfitText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pump.Ok}" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="💵 پول موجود افغانی — خودکار" Classes="fld"
                         Foreground="{DynamicResource Pump.Ok}" FontWeight="Bold" />
              <Border Classes="calc wfield">
                <TextBlock Text="{Binding AvailableText}" VerticalAlignment="Center"
                           Foreground="{Binding AvailableBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                           FontWeight="Bold" FontSize="16" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="یادداشت" Classes="fld" />
              <TextBox Classes="wfield" Text="{Binding Note}" Watermark="..." />
            </StackPanel>

            <Border Classes="saved-badge" IsVisible="{Binding Saved}">
              <TextBlock Text="{Binding SavedText}" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>

          <Button Grid.Row="2" Classes="save-btn" Classes.day="{Binding IsDay}"
                  Classes.night="{Binding IsNight}"
                  Content="{Binding SaveText}" Margin="13,0,13,13"
                  HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <c:SectionPage>
    <c:SectionPage.Header>پارچه‌ها</c:SectionPage.Header>

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
        <Button Content="{Binding FuelToggleText}" Command="{Binding ToggleFuelCommand}" />
        <Button Content="{Binding BaseHistoryToggleText}" Command="{Binding ToggleBaseHistoryCommand}" />
        <Button Classes="accent" Content="PDF همه گزارش‌ها" Command="{Binding PdfCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <Panel>
    <Grid RowDefinitions="Auto,14,Auto,*" IsVisible="{Binding ShowMain}">

      <!-- ══ کارتِ «ثبت پارچه فعلی» ══ -->
      <Border Grid.Row="0" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto">

          <!-- سربرگِ کارت: عنوان بالا، ابزار زیرش.
               یک‌ردیفه بود و در ستونِ ۱۰۰۰ پیکسلی «پارچهٔ جدید شب» می‌افتاد
               خطِ بعد و بی‌قواره می‌شد. حالا هر چه هم پنجره باریک شود، مرتب
               می‌ماند: هر ابزار حاشیهٔ پایین دارد پس شکستنِ خط هم تمیز است. -->
          <Border Grid.Row="0" Classes="card-head">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding CardTitle}" FontWeight="Bold" FontSize="15"
                         Foreground="{DynamicResource Pump.Accent}" />
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="📅 تاریخ:" Classes="muted" VerticalAlignment="Center"
                           Margin="0,0,7,6" />
                <TextBox Text="{Binding PaDate}" Width="120" HorizontalContentAlignment="Center"
                         Margin="0,0,8,6" />
                <Border Classes="chip" Margin="0,0,8,6">
                  <TextBlock Text="{Binding ReportNumText, StringFormat=گزارش #{0}}" />
                </Border>
                <Button Classes="accent" Content="گزارش جدید" Margin="0,0,8,6"
                        Command="{Binding StartNewReportCommand}" />
                <Button Content="پارچهٔ جدید روز" Margin="0,0,8,6"
                        Command="{Binding NewParchaDayCommand}" />
                <Button Content="پارچهٔ جدید شب" Margin="0,0,8,6"
                        Command="{Binding NewParchaNightCommand}" />
                <!-- ⛔ حالتِ **اختیاریِ** تازه (۱۴۰۵/۰۷/۰۶): ختمِ هر پایه باید
                     شروعِ پارچهٔ بعدیِ همان پایه باشد. خاموش که شود، فقط
                     هشدارِ «کمتر است» می‌ماند. -->
                <CheckBox Content="⛓️ برسیِ زنجیرهٔ پایه‌ها" Margin="0,0,0,6"
                          IsChecked="{Binding ChainCheck}"
                          ToolTip.Tip="ختمِ هر پایه باید با شروعِ پارچهٔ بعدیِ همان پایه یکی باشد؛ روز و شبِ یک پایه یک زنجیره‌اند و هر پایه زنجیرهٔ خودش را دارد." />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- دو کارتِ شیفت، کنارِ هم -->
          <Grid Grid.Row="1" ColumnDefinitions="*,14,*" Margin="14">
            <ContentControl Grid.Column="0" Content="{Binding Day}"
                            ContentTemplate="{StaticResource ShiftCard}" />
            <ContentControl Grid.Column="2" Content="{Binding Night}"
                            ContentTemplate="{StaticResource ShiftCard}" />
          </Grid>
        </Grid>
      </Border>

      <!-- ══ تاریخچهٔ پایه‌ها — کشویی ═══════════════════════════════════════
           خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۶): «توی تاریخچهٔ پارچه‌ها همهٔ
           شروع و ختم‌ها، شب و روز، پشتِ سرِ هم ثبت بشود با اسمِ کارمند و
           تاریخ و شماره و چندشنبه است… و آن سرخ شدن هم به این روش باشد.»

           دکمه‌اش تا دیروز **هیچ فرمانی نداشت** و هیچ کاری نمی‌کرد.

           ⚠️ جدولش ‎ExcelGrid‎ است و کشویی: بسته یعنی نامرئی، و جدولِ نامرئی
           ردیف‌هایش را پارک می‌کند — همان قاعدهٔ ‎idle‎. و تا باز نشود، یک
           پرس‌وجو هم زده نمی‌شود. -->
      <Border Grid.Row="2" Classes="panel" Padding="0" Margin="0,0,0,14"
              IsVisible="{Binding ShowBaseHistory}">
        <Grid RowDefinitions="Auto,Auto">
          <Border Grid.Row="0" Classes="card-head">
            <TextBlock Text="🗂️ تاریخچهٔ پایه‌ها — شروع و ختمِ هر شیفت، از قدیم به تازه"
                       FontWeight="Bold" Foreground="{DynamicResource Pump.Accent}" />
          </Border>
          <c:ExcelGrid Grid.Row="1" ItemsSource="{Binding BaseHistory}" x:CompileBindings="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0"
                       MaxHeight="420">
            <DataGrid.Columns>
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
              <DataGridTextColumn Header="روز هفته" Binding="{Binding DayName}" Width="Auto" />
              <DataGridTextColumn Header="پارچه" Binding="{Binding ReportText}" Width="Auto" />
              <DataGridTextColumn Header="شیفت" Binding="{Binding KindText}" Width="Auto" />
              <DataGridTextColumn Header="نام کارمند" Binding="{Binding Name}" Width="Auto" />
              <DataGridTextColumn Header="شماره پایه" Binding="{Binding PumpText}" Width="Auto" />
              <DataGridTemplateColumn Header="شروع" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StartText}" Margin="8,0" VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{Binding StartBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ختم" Binding="{Binding EndText}" Width="Auto" />
              <DataGridTextColumn Header="لیتر" Binding="{Binding LitersText}" Width="Auto" />
              <DataGridTemplateColumn Header="هشدار" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding LowText}" Margin="8,0" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="{DynamicResource Pump.Danger}"
                               ToolTip.Tip="شروعِ این پایه از ختمِ پایهٔ قبلیِ همان شماره کمتر است" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>
        </Grid>
      </Border>

      <!-- ══ گزارش‌های ۲۴ ساعته — فقط یک کادرِ کوچک ═════════════════════════
           ⛔ فهرستِ کارت‌ها دیگر زیرِ پارچه‌ها نیست (خواستهٔ صاحب ریپو،
           ۱۴۰۵/۰۷/۱۳): کادر صفحهٔ جدای گزارش‌ها را باز می‌کند. -->
      <Border Grid.Row="3" Classes="panel" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="📑 گزارش‌های ۲۴ ساعته" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Accent}" />
            <TextBlock Text="{Binding ReportsCountText}" Classes="muted" />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="📂 دیدنِ همهٔ گزارش‌ها ›"
                  Command="{Binding OpenReportsCommand}"
                  ToolTip.Tip="همهٔ گزارش‌ها، ماه‌به‌ماه و سال‌به‌سال — فقط برای دیدن" />
        </Grid>
      </Border>
    </Grid>

    <!-- ══ صفحهٔ گزارش‌ها — ماه‌به‌ماه و سال‌به‌سال، فقط‌خواندنی ═════════════ -->
    <StackPanel Spacing="12" IsVisible="{Binding ReportsOpen}">
      <Border Classes="panel" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="‹ برگشت" FontWeight="Bold"
                  Command="{Binding ReportsBackCommand}" />
          <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                     FontWeight="ExtraBold" FontSize="15"
                     Foreground="{DynamicResource Pump.Accent}"
                     Text="{Binding ReportsCountText, StringFormat=📑 گزارش‌های ۲۴ ساعته — {0}}" />
          <TextBox Grid.Column="2" Text="{Binding DateFilter}" Width="160" Watermark="🔍 فیلتر تاریخ"
                   IsVisible="{Binding ShowReportList}" />
        </Grid>
      </Border>

      <TextBlock Text="هنوز گزارشی ثبت نشده است." Classes="muted" HorizontalAlignment="Center"
                 Margin="0,30" IsVisible="{Binding NoReports}" />

      <!-- سال‌ها ⇐ ماه‌ها ⇐ کارتِ هر گزارش -->
      <ItemsControl ItemsSource="{Binding ReportYears}" IsVisible="{Binding ShowReportList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportYearGroup">
            <Expander IsExpanded="{Binding IsOpen}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Title}" FontWeight="ExtraBold" FontSize="15" />
                  <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Months}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReportMonthGroup">
                    <Expander IsExpanded="{Binding IsOpen}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                     Foreground="{DynamicResource Pump.Accent}" />
                          <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                      </Expander.Header>
                      <ItemsRepeater ItemsSource="{Binding Items}">
                        <ItemsRepeater.Layout>
                          <UniformGridLayout MinItemWidth="268" ItemsStretch="Fill"
                                             MinColumnSpacing="12" MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate x:DataType="vm:ReportCardViewModel">
                            <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="دیدنِ گزارشِ همین پارچه"
                                    Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).ShowReportCommand}"
                                    CommandParameter="{Binding}">
                              <Border Classes="card">
                                <StackPanel Spacing="7">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13" />
                                    <Button Grid.Column="1" Classes="ghost danger" Content="✕" Padding="7,1" FontSize="11"
                                            ToolTip.Tip="حذفِ این گزارش (می‌پرسد)"
                                            Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).DeleteReportCommand}"
                                            CommandParameter="{Binding}" />
                                  </Grid>
                                  <TextBlock Text="{Binding DateLine}" Classes="muted" />
                                  <TextBlock Text="{Binding DayName, StringFormat=☀️ {0}}" Classes="muted" />
                                  <TextBlock Text="{Binding NightName, StringFormat=🌙 {0}}" Classes="muted" />
                                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="فروش" Classes="label" FontSize="11" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SaleText}" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="پول موجود" Classes="label" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailableText}" FontWeight="Bold" FontSize="12.5"
                                               Foreground="{DynamicResource Pump.Ok}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="فایده" Classes="label" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfitText}" FontWeight="Bold" FontSize="12.5" />
                                  </Grid>
                                </StackPanel>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- گزارشِ یک پارچه — همان دو شیفت، خواندنی -->
      <StackPanel Spacing="12" IsVisible="{Binding ShowReportDetail}" DataContext="{Binding OpenReport}"
                  x:CompileBindings="False">
        <Border Classes="panel" Padding="16,12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontWeight="ExtraBold" FontSize="16" />
            <TextBlock Text="{Binding DateLine}" Classes="muted" />
            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{Binding SaleText, StringFormat=فروش: {0}}" FontWeight="Bold" Margin="0,0,18,0" />
              <TextBlock Text="{Binding DebtText, StringFormat=قرض: {0}}" FontWeight="Bold" Margin="0,0,18,0"
                         Foreground="{DynamicResource Pump.Danger}" />
              <TextBlock Text="{Binding AvailableText, StringFormat=پول موجود: {0}}" FontWeight="Bold" Margin="0,0,18,0"
                         Foreground="{DynamicResource Pump.Ok}" />
              <TextBlock Text="{Binding ProfitText, StringFormat=فایده: {0}}" FontWeight="Bold" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Shifts}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="panel" Padding="0" Margin="0,0,12,0">
                <StackPanel>
                  <Border Classes="card-head">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                               Foreground="{DynamicResource Pump.Accent}" />
                  </Border>
                  <TextBlock Text="این شیفت ثبت نشده است." Classes="muted" Margin="16,12"
                             IsVisible="{Binding Empty}" />
                  <ItemsControl ItemsSource="{Binding Items}" Margin="16,10">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="130,*" Margin="0,3">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="label" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Bold"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
    </Panel>
  </c:SectionPage>
</UserControl>
