<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ParchaSectionView"
             x:DataType="vm:ParchaSectionViewModel">

  <!-- ══ نوشتهٔ راهنمای کادرها سمتِ راست ══════════════════════════════════
       خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۶): «place holderهاشون سمتِ راست
       باشن، همه‌شون.»

       ⚠️ ریشه یک ‎Setter‎ی سراسری بود: ‎TextBox.TextAlignment = Center‎ در
       ‎Themes/Controls.axaml‎ (قاعدهٔ «همه نوشته‌ها وسط‌چین»). قالبِ خودِ
       آوالونیا نوشتهٔ راهنما را با همان ‎TextAlignment‎ می‌کشد، پس راهنما هم
       وسط می‌افتاد.

       ⛔ آن قاعده پس گرفته نشد: **نوشتهٔ تایپ‌شده همچنان وسط است** و فقط
       راهنما راست می‌شود، و فقط در همین صفحه و صفحهٔ ورق. -->
  <UserControl.Styles>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- کارتِ یک شیفت — همان چیدمانِ نسخهٔ وب، خانه به خانه -->
    <DataTemplate x:Key="ShiftCard" x:DataType="vm:ShiftFormViewModel">
      <Border Classes="shift-card">
        <Grid RowDefinitions="Auto,*,Auto">

          <Border Grid.Row="0" Classes="shift-header" Classes.day="{Binding IsDay}"
                  Classes.night="{Binding IsNight}">
            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" />
          </Border>

          <!-- ══ خانه‌های شیفت — هر کدام یک ردیفِ تمام‌عرض ═══════════════
               گزارشِ صاحب ریپو: «پارچه همهٔ ردیف‌هایش پشتِ هم نیستند — کادرها
               منظورم است؛ ببین توی سایت دیگر مدل است.»

               حق داشت. سایت هر خانه را یک ردیفِ جدا و تمام‌عرضِ کارت می‌کند:

                   .field-row{ display:flex; flex-direction:column; gap:3px }
                   .field-input{ width:100% }

               یعنی برچسب بالا، کادر زیرش، و ردیفِ بعدی زیرِ آن — یازده خانه
               پشتِ هم. نیتیو این‌ها را دو‌ستونه کرده بود («جفت‌های هم‌خانواده
               کنارِ هم») که اختراعِ خودش بود و با سایت نمی‌خواند.

               ⚠️ دو‌ستونه‌اش نکنید. ترتیب هم همان ترتیبِ سایت است:
               نام ← شروع ← ختم ← قرض ← فی ← فایدهٔ فی ← فروش ← موجودی ←
               فایده ← پولِ موجود ← یادداشت.                                -->
          <StackPanel Grid.Row="1" Margin="13,12,13,12" Spacing="9">

            <!-- نامِ کارمند + شمارهٔ پایه -->
            <StackPanel Spacing="4">
              <TextBlock Text="نام کارمند" Classes="fld" />
              <!-- ⚠️ کادرِ نام پهنای صریح دارد: «کادرِ نامِ کارمندان خیلی بزرگ
                   است». ستونِ آخر خالی می‌ماند تا کارت به‌هم نریزد.
                   ⛔ و **بلند** است، نه پهن — خواستهٔ صریحِ صاحب ریپو
                   (۱۴۰۵/۰۷/۰۶): «طولش بزرگ باشه نه عرضش». پهنای ۲۱۰ همان
                   می‌ماند و فقط بلندی بالا رفت؛ پهن‌ترش نکنید. -->
              <Grid ColumnDefinitions="210,10,Auto,*">
                <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="نام کارمند"
                         MinHeight="48" FontSize="15" VerticalContentAlignment="Center"
                         c:Suggest.Key="staff" />
                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                  <TextBlock Text="شماره پایه" FontSize="10.5" Foreground="{DynamicResource Pump.Muted}"
                             HorizontalAlignment="Center" />
                  <TextBox Text="{Binding PumpNum}" Watermark="#" Width="54"
                           HorizontalContentAlignment="Center" FontWeight="Bold" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="شروع پایه (لیتر)" Classes="fld" />
              <Grid ColumnDefinitions="*,7,Auto">
                <!-- ⛔ خودِ عدد سرخ می‌شود («توی خود همون کادر هم عدد سرخ
                     بشه») — پس نشانه با رفتن به کادرِ دیگر از چشم نمی‌افتد. -->
                <TextBox Grid.Column="0" Text="{Binding Start}" Watermark="0"
                         Foreground="{Binding StartBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                <Button Grid.Column="2" Content="{Binding PullText}" Padding="10,6" FontSize="11.5"
                        Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).PullBaseCommand}"
                        CommandParameter="{Binding}" />
              </Grid>

              <!-- ══ هشدارِ زنجیرهٔ پایه ═══════════════════════════════════
                   ⛔ **یک ردیفِ همیشه‌حاضرِ ۲۲ پیکسلی، نه یک کادرِ بازشو.**
                   ریشهٔ «نمی‌گذارد بروم کادرِ پایین» همین بود: کادرِ هشدار با
                   دکمهٔ «دیدم» داخلِ همین ستون باز می‌شد و «ختم پایه» را ~۷۰
                   پیکسل پایین می‌پراند — کاربر تایپ می‌کرد، کادرِ بعدی از
                   زیرِ نشانگرش فرار می‌کرد. حالا ردیف همیشه هست (خالی، وقتی
                   هشداری نیست)، پس **هیچ چیزی جابه‌جا نمی‌شود**.
                   ⛔ و مانع نیست: ذخیره سرِ جایش است. -->
              <Grid Height="22" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding LowBaseText}" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding LowBaseText}"
                           Foreground="{DynamicResource Pump.Danger}" />
                <Button Grid.Column="1" Content="✔ دیدم" Classes="ghost" Padding="8,1"
                        FontSize="11" VerticalAlignment="Center"
                        IsVisible="{Binding LowBase}" Command="{Binding AckLowBaseCommand}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="ختم پایه (لیتر)" Classes="fld" />
              <Grid ColumnDefinitions="*,7,Auto">
                <TextBox Grid.Column="0" Text="{Binding End}" Watermark="0" />
                <Button Grid.Column="2" Content="{Binding PushText}" Padding="10,6" FontSize="11.5"
                        Command="{Binding $parent[UserControl].((vm:ParchaSectionViewModel)DataContext).PushBaseCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="جمله قرض (افغانی)" Classes="fld" />
              <TextBox Text="{Binding Debt}" Watermark="0" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="فی لیتر (افغانی)" Classes="fld" />
              <TextBox Text="{Binding Price}" Watermark="0" />
            </StackPanel>

            <!-- فایدهٔ فیِ لیتر — و زیرش همان جملهٔ کج‌نوشتهٔ «فی خرید…» سایت -->
            <StackPanel Spacing="4">
              <TextBlock Text="فایده فی لیتر (افغانی) — اتومات از مخزن" Classes="fld" />
              <TextBox Text="{Binding ProfitPer}" Watermark="اتومات پر می‌شه" />
              <TextBlock Text="{Binding BuyPerLabel}" FontSize="11" FontStyle="Italic"
                         Foreground="{DynamicResource Pump.Muted}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="فروش (لیتر) — خودکار" Classes="fld" />
              <Border Classes="calc"><TextBlock Text="{Binding SaleText}" /></Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="جمله موجودی افغانی — خودکار" Classes="fld" />
              <Border Classes="calc"><TextBlock Text="{Binding MoneyText}" /></Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="فایده — خودکار" Classes="fld" />
              <Border Classes="calc">
                <TextBlock Text="{Binding ProfitText}" Foreground="{DynamicResource Pump.Ok}" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="💵 پول موجود افغانی — خودکار" Classes="fld"
                         Foreground="{DynamicResource Pump.Ok}" FontWeight="Bold" />
              <Border Classes="calc">
                <TextBlock Text="{Binding AvailableText}"
                           Foreground="{Binding AvailableBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                           FontWeight="Bold" FontSize="16" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="یادداشت" Classes="fld" />
              <TextBox Text="{Binding Note}" Watermark="..." />
            </StackPanel>

            <Border Classes="saved-badge" IsVisible="{Binding Saved}">
              <TextBlock Text="{Binding SavedText}" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>

          <Button Grid.Row="2" Classes="save-btn" Classes.day="{Binding IsDay}"
                  Classes.night="{Binding IsNight}"
                  Content="{Binding SaveText}" Margin="13,0,13,13"
                  HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <c:SectionPage>
    <c:SectionPage.Header>پارچه‌ها</c:SectionPage.Header>

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
        <Button Content="{Binding FuelToggleText}" Command="{Binding ToggleFuelCommand}" />
        <Button Content="{Binding BaseHistoryToggleText}" Command="{Binding ToggleBaseHistoryCommand}" />
        <Button Classes="accent" Content="PDF همه گزارش‌ها" Command="{Binding PdfCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <Grid RowDefinitions="Auto,14,Auto,*">

      <!-- ══ کارتِ «ثبت پارچه فعلی» ══ -->
      <Border Grid.Row="0" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,Auto">

          <!-- سربرگِ کارت: عنوان بالا، ابزار زیرش.
               یک‌ردیفه بود و در ستونِ ۱۰۰۰ پیکسلی «پارچهٔ جدید شب» می‌افتاد
               خطِ بعد و بی‌قواره می‌شد. حالا هر چه هم پنجره باریک شود، مرتب
               می‌ماند: هر ابزار حاشیهٔ پایین دارد پس شکستنِ خط هم تمیز است. -->
          <Border Grid.Row="0" Classes="card-head">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding CardTitle}" FontWeight="Bold" FontSize="15"
                         Foreground="{DynamicResource Pump.Accent}" />
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="📅 تاریخ:" Classes="muted" VerticalAlignment="Center"
                           Margin="0,0,7,6" />
                <TextBox Text="{Binding PaDate}" Width="120" HorizontalContentAlignment="Center"
                         Margin="0,0,8,6" />
                <Border Classes="chip" Margin="0,0,8,6">
                  <TextBlock Text="{Binding ReportNumText, StringFormat=گزارش #{0}}" />
                </Border>
                <Button Classes="accent" Content="گزارش جدید" Margin="0,0,8,6"
                        Command="{Binding StartNewReportCommand}" />
                <Button Content="پارچهٔ جدید روز" Margin="0,0,8,6"
                        Command="{Binding NewParchaDayCommand}" />
                <Button Content="پارچهٔ جدید شب" Margin="0,0,8,6"
                        Command="{Binding NewParchaNightCommand}" />
                <!-- ⛔ حالتِ **اختیاریِ** تازه (۱۴۰۵/۰۷/۰۶): ختمِ هر پایه باید
                     شروعِ پارچهٔ بعدیِ همان پایه باشد. خاموش که شود، فقط
                     هشدارِ «کمتر است» می‌ماند. -->
                <CheckBox Content="⛓️ برسیِ زنجیرهٔ پایه‌ها" Margin="0,0,0,6"
                          IsChecked="{Binding ChainCheck}"
                          ToolTip.Tip="ختمِ هر پایه باید با شروعِ پارچهٔ بعدیِ همان پایه یکی باشد؛ روز و شبِ یک پایه یک زنجیره‌اند و هر پایه زنجیرهٔ خودش را دارد." />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- دو کارتِ شیفت، کنارِ هم -->
          <Grid Grid.Row="1" ColumnDefinitions="*,14,*" Margin="14">
            <ContentControl Grid.Column="0" Content="{Binding Day}"
                            ContentTemplate="{StaticResource ShiftCard}" />
            <ContentControl Grid.Column="2" Content="{Binding Night}"
                            ContentTemplate="{StaticResource ShiftCard}" />
          </Grid>
        </Grid>
      </Border>

      <!-- ══ تاریخچهٔ پایه‌ها — کشویی ═══════════════════════════════════════
           خواستهٔ صریحِ صاحب ریپو (۱۴۰۵/۰۷/۰۶): «توی تاریخچهٔ پارچه‌ها همهٔ
           شروع و ختم‌ها، شب و روز، پشتِ سرِ هم ثبت بشود با اسمِ کارمند و
           تاریخ و شماره و چندشنبه است… و آن سرخ شدن هم به این روش باشد.»

           دکمه‌اش تا دیروز **هیچ فرمانی نداشت** و هیچ کاری نمی‌کرد.

           ⚠️ جدولش ‎ExcelGrid‎ است و کشویی: بسته یعنی نامرئی، و جدولِ نامرئی
           ردیف‌هایش را پارک می‌کند — همان قاعدهٔ ‎idle‎. و تا باز نشود، یک
           پرس‌وجو هم زده نمی‌شود. -->
      <Border Grid.Row="2" Classes="panel" Padding="0" Margin="0,0,0,14"
              IsVisible="{Binding ShowBaseHistory}">
        <Grid RowDefinitions="Auto,Auto">
          <Border Grid.Row="0" Classes="card-head">
            <TextBlock Text="🗂️ تاریخچهٔ پایه‌ها — شروع و ختمِ هر شیفت، از قدیم به تازه"
                       FontWeight="Bold" Foreground="{DynamicResource Pump.Accent}" />
          </Border>
          <c:ExcelGrid Grid.Row="1" ItemsSource="{Binding BaseHistory}" x:CompileBindings="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0"
                       MaxHeight="420">
            <DataGrid.Columns>
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
              <DataGridTextColumn Header="روز هفته" Binding="{Binding DayName}" Width="Auto" />
              <DataGridTextColumn Header="پارچه" Binding="{Binding ReportText}" Width="Auto" />
              <DataGridTextColumn Header="شیفت" Binding="{Binding KindText}" Width="Auto" />
              <DataGridTextColumn Header="نام کارمند" Binding="{Binding Name}" Width="Auto" />
              <DataGridTextColumn Header="شماره پایه" Binding="{Binding PumpText}" Width="Auto" />
              <DataGridTemplateColumn Header="شروع" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StartText}" Margin="8,0" VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{Binding StartBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ختم" Binding="{Binding EndText}" Width="Auto" />
              <DataGridTextColumn Header="لیتر" Binding="{Binding LitersText}" Width="Auto" />
              <DataGridTemplateColumn Header="هشدار" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding LowText}" Margin="8,0" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="{DynamicResource Pump.Danger}"
                               ToolTip.Tip="شروعِ این پایه از ختمِ پایهٔ قبلیِ همان شماره کمتر است" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>
        </Grid>
      </Border>

      <!-- ══ گزارش‌های ۲۴ ساعته ══ -->
      <Border Grid.Row="3" Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="card-head">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <TextBlock Grid.Column="0" Text="📑 گزارش‌های ۲۴ ساعته" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <TextBox Grid.Column="1" Text="{Binding DateFilter}" Width="140" Watermark="فیلتر تاریخ" />
            </Grid>
          </Border>

          <Border Grid.Row="1" Padding="12">
            <ItemsRepeater ItemsSource="{Binding Reports}">
              <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="268" ItemsStretch="Fill"
                                 MinColumnSpacing="12" MinRowSpacing="12" />
            </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportCardViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13" />
                        <Button Grid.Column="1" Classes="ghost danger" Content="✕" Padding="7,1" FontSize="11"
                                Command="{Binding $parent[ItemsRepeater].((vm:ParchaSectionViewModel)DataContext).DeleteReportCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                      <TextBlock Text="{Binding DayName, StringFormat=☀️ {0}}" Classes="muted" />
                      <TextBlock Text="{Binding NightName, StringFormat=🌙 {0}}" Classes="muted" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="فروش" Classes="label" FontSize="11" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SaleText}" FontWeight="Bold" FontSize="12.5" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="پول موجود" Classes="label" FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailableText}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="{DynamicResource Pump.Ok}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="فایده" Classes="label" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfitText}" FontWeight="Bold" FontSize="12.5" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </c:SectionPage>
</UserControl>
