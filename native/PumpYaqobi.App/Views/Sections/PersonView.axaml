<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.PersonView"
             x:DataType="vm:PersonViewModel">

  <c:SectionPage Header="{Binding Name}" SubHeader="{Binding Phone}">

    <c:SectionPage.Toolbar>
      <!-- ══ همان دکمه‌های سربرگِ ‎.pm-head-btns‎ی سایت، به همان ترتیب ═══════
           سایت (خطِ ۲۱۲۹۳ به بعدِ index.html):
             → قبلی │ بعدی ← │ 🔁 پول │ 📄 PDF │ ⋯ بیشتر │ ✕
           «🔁 پول / 🔁 تیل» دکمه است، نه تیک‌مارک. گزارشِ صاحب ریپو: «واحد پول و
           تیل چرا شبیهِ کادرِ آن بالا بغلِ پی‌دی‌اف نیست؟ که این مدل تیک‌مارکی
           درست کردی چرا؟» — پس چک‌باکسِ «واحدِ پول» از پایین برداشته شد و
           همان‌جایی نشست که در سایت است. -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="→ قبلی" Command="{Binding PrevPersonCommand}" />
        <Button Classes="ghost" Content="بعدی ←" Command="{Binding NextPersonCommand}" />
        <Button Classes="ghost info" Content="{Binding Current.ModeToggleText}"
                Command="{Binding Current.ToggleModeCommand}"
                ToolTip.Tip="دفترِ پول ⇄ دفترِ تیل — این دو کاملاً جدا هستند" />
        <Button Classes="ghost info" Content="📄 PDF" Command="{Binding PdfCommand}" />
        <!-- «📲 کیو‌آر» — در سایت داخلِ کشوییِ «⋯ بیشتر» است و در نیتیو اصلاً
             نبود: نه کیو‌آری ساخته می‌شد و نه دیده می‌شد. -->
        <Button Classes="ghost" Content="📲 کیو‌آر" Command="{Binding ShowQrCommand}"
                ToolTip.Tip="کیو‌آرِ همین حسابی که باز است" />
        <Button Classes="accent" Content="🆕 جدول جدید"
                Command="{Binding Current.NewTableCommand}" />
        <Button Classes="accent" Content="بازگشت به فهرست"
                Command="{Binding BackCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Summary>
      <!-- ══ سربرگِ حساب — مو‌به‌مو ‎#pm-fuel-summary‎ی سایت ════════════════
           دو کادر، رنگ‌به‌رنگ: «⛽ حساب پطرول» و «🟤 حساب دیزل». هر کدام همان
           چهار عددِ سایت را دارد — فیصدیِ ما، مقدار رسید، برد، الباقی — و
           «رسید» همین‌جا داخلِ سربرگ نوشته می‌شود، نه جای دیگر.

           چهار کادرِ تختِ قبلی (الباقیِ پول/پطرول/دیزل/حال) رفتند: نه رنگ
           داشتند، نه رسید را نشان می‌دادند، و نه دیزل و پطرول را از هم جدا
           می‌کردند. -->
      <!-- ⚠️ روی هم، نه بغلِ هم. در سایت این دو کارت زیرِ هم‌اند (پطرول بالا،
           دیزل پایین) و صاحب ریپو صریح گفت همان باشد: «هر دو بالا و پایین هم
           استن نه بغل به بغل هم». بغل‌به‌بغل هر کارت نصفِ عرض می‌گرفت و چهار
           عددش به هم می‌چسبید. -->
      <Grid RowDefinitions="Auto,8,Auto" DataContext="{Binding Current}">
        <Grid.Styles>
          <!-- ══ اندازه‌ها مو‌به‌مو از خودِ سایت ═══════════════════════════
               ‎#personModal .fs-cell .l{font-size:1rem;font-weight:900}‎  → ۱۶
               ‎#personModal .fs-cell .v{font-size:1.2rem;font-weight:900}‎ → ۱۹
               گزارشِ صاحب ریپو: «چرا همه عددها انقدر کوچک، همه کلمات هم همین‌طور
               — می‌خواهم همه یک اندازه و کلفت باشند.» پیش از این برچسب‌ها کلاسِ
               ‎label‎ی ریزِ خاکستری داشتند و عددها ۱۷ بودند. -->
          <Style Selector="TextBlock.fsl">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
          </Style>
          <Style Selector="TextBlock.fsv">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
          </Style>
          <Style Selector="TextBox.fsv">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
          <!-- نشانِ «⛽ حساب پطرول» — کادرِ کوچکِ خودش، کنارِ ردیف. سایت:
               ‎#personModal .fs-head{padding:6px 12px;border-radius:10px;
               border:1.5px solid;background:card}‎ -->
          <Style Selector="Border.fshead">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style Selector="Border.fshead > TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </Grid.Styles>

        <!-- ══ ⛽ حساب پطرول ═══════════════════════════════════════════════
             ⚠️ نشانِ حساب **کنارِ** ردیف می‌نشیند، نه بالای آن. این عینِ قاعدهٔ
             ‎<style id="person-head-inline">‎ی سایت است:

                 @media (min-width:700px){
                   #personModal .fs-group{ display:flex; align-items:center; gap:10px }
                   #personModal .fs-head { flex:0 0 auto; ... }
                   #personModal .fs-rows { flex:1 1 auto }
                 }

             و خودِ سایت دلیلش را هم نوشته: این نوشته یک خطِ کاملِ جدا می‌گرفت و
             کادرِ سربرگ را بی‌جهت بلند می‌کرد. گزارشِ صاحب ریپو با عکس همین بود:
             «حساب پطرول و دیزل بغلِ فیصدی استن و بالا نوشته نشده آن‌جوری که تو
             کشیدی.» چون FlowDirection کلِ پنجره RTL است، ستونِ ۰ سمتِ راست
             می‌افتد — یعنی همان‌جایی که در سایت هست. -->
        <Border Grid.Row="0" Classes="panel" Padding="14,10"
                BorderBrush="{DynamicResource Pump.Ok}" BorderThickness="2">
          <Grid ColumnDefinitions="Auto,10,*">
            <Border Grid.Column="0" Classes="fshead"
                    BorderBrush="{DynamicResource Pump.Ok}">
              <TextBlock Text="⛽ حساب پطرول" Foreground="{DynamicResource Pump.Ok}" />
            </Border>

            <UniformGrid Grid.Column="2" Rows="1">
              <StackPanel Spacing="2">
                <!-- فیصدی داخلِ خودِ برچسب می‌نشیند، مثلِ سایت:
                     setL('pm-p-comm-l', 'فیصدی ما (' + n2fa(rnd(pctP)) + '٪)') -->
                <TextBlock Text="{Binding HeadPetrolPercentLabel}" Classes="fsl" />
                <TextBlock Text="{Binding HeadPetrolPercentText}" Classes="fsv"
                           Foreground="{DynamicResource Pump.Info}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding HeadRasidLabel}" Classes="fsl" />
                <!-- در سایت رسید را همین‌جا در سربرگ می‌نویسند، نه در کادرِ
                     دیگری پایین‌تر. پس این خانه خواندنی نیست، نوشتنی است. -->
                <TextBox Text="{Binding HeadPetrolRasidEdit}" Classes="fsv"
                         Foreground="{DynamicResource Pump.Ok}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="برد" Classes="fsl" />
                <TextBlock Text="{Binding HeadPetrolBordText}" Classes="fsv"
                           Foreground="{DynamicResource Pump.Warn}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding HeadAlbaqiLabel}" Classes="fsl" />
                <TextBlock Text="{Binding HeadPetrolAlbaqiText}" Classes="fsv"
                           Foreground="{Binding HeadPetrolAlbaqiBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
              </StackPanel>
            </UniformGrid>
          </Grid>
        </Border>

        <!-- ══ 🟤 حساب دیزل — همان چیدمان، همان اندازه‌ها ══════════════════ -->
        <Border Grid.Row="2" Classes="panel" Padding="14,10"
                BorderBrush="{DynamicResource Pump.Warn}" BorderThickness="2">
          <Grid ColumnDefinitions="Auto,10,*">
            <Border Grid.Column="0" Classes="fshead"
                    BorderBrush="{DynamicResource Pump.Warn}">
              <TextBlock Text="🟤 حساب دیزل" Foreground="{DynamicResource Pump.Warn}" />
            </Border>

            <UniformGrid Grid.Column="2" Rows="1">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding HeadDieselPercentLabel}" Classes="fsl" />
                <TextBlock Text="{Binding HeadDieselPercentText}" Classes="fsv"
                           Foreground="{DynamicResource Pump.Info}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding HeadRasidLabel}" Classes="fsl" />
                <TextBox Text="{Binding HeadDieselRasidEdit}" Classes="fsv"
                         Foreground="{DynamicResource Pump.Ok}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="برد" Classes="fsl" />
                <TextBlock Text="{Binding HeadDieselBordText}" Classes="fsv"
                           Foreground="{DynamicResource Pump.Warn}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding HeadAlbaqiLabel}" Classes="fsl" />
                <TextBlock Text="{Binding HeadDieselAlbaqiText}" Classes="fsv"
                           Foreground="{Binding HeadDieselAlbaqiBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
              </StackPanel>
            </UniformGrid>
          </Grid>
        </Border>
      </Grid>
    </c:SectionPage.Summary>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

      <!-- ══ نوارِ حساب — کشوییِ «حساب فرعی» + کادرِ «جدول‌های آرشیو» ══════════
           گزارشِ صاحب ریپو، دو تا:
             «حساب فرعی یک کادرِ کشویی است که از آن‌جا انتخاب بشود و آن حساب
              کاملاً جدا است و باید یک اسمِ جدا هم داشته باشد.»
             «کادرِ جدول‌های آرشیو هم یک کادرِ کشویی است؛ می‌زنم یک کادرِ دیگر
              باز می‌شود و با زدنِ روی هر کدام کشویی باز می‌شوند.»

           پیش از این چیپ‌های افقی بود: با چند حساب، نوار پهن‌تر از صفحه می‌شد
           و اسمِ حساب‌ها هم دیده نمی‌شد. حالا دقیقاً مثلِ سایت، یک کشویی. -->
      <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="📒 حساب:" Classes="label" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Current}"
                    MinWidth="220">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountViewModel">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="ghost info" Content="➕ حساب جدید"
                  Command="{Binding AddSubAccountCommand}" />
          <!-- ⚠️ «بغلِ آن حساب جدید باید کادرش باشد و هر وقت زدم اینا بیان» —
               خواستهٔ صریحِ صاحب ریپو. سه کادرِ فیصدی همیشه پیدا نیستند. -->
          <Button Classes="ghost" Content="{Binding Current.PercentToggleText}"
                  Command="{Binding Current.TogglePercentCommand}"
                  ToolTip.Tip="فیصدیِ پطرول و دیزل — دو چیزِ کاملاً جدا" />
          <Button Classes="ghost" Content="✏️ تغییر اسم"
                  Command="{Binding RenamePersonCommand}" />
          <Button Classes="ghost danger" Content="🗑️ حذفِ این حساب"
                  Command="{Binding DeleteSubAccountCommand}"
                  CommandParameter="{Binding Current}" />
        </StackPanel>

        <!-- کادرِ کشوییِ «جدول‌های آرشیو» — تا آرشیوی نباشد، اصلاً دیده نمی‌شود -->
        <StackPanel Spacing="6" DataContext="{Binding Current}"
                    IsVisible="{Binding HasArchives, FallbackValue=False}">
          <Button Classes="ghost info" HorizontalAlignment="Stretch"
                  Content="{Binding ArchiveToggleText}"
                  Command="{Binding ToggleArchivesCommand}" />

          <ItemsControl ItemsSource="{Binding Archives}" IsVisible="{Binding IsArchiveOpen}"
                        x:CompileBindings="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="panel" Margin="0,0,0,6" Padding="0">
                  <StackPanel>
                    <!-- عنوانِ کوچکِ هر آرشیو — با کلیک، آکاردئون باز می‌شود -->
                    <Button Classes="tool-link" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="12,9"
                            Command="{Binding ToggleCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding CaretText}" FontWeight="ExtraBold" />
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                      </StackPanel>
                    </Button>

                    <StackPanel IsVisible="{Binding IsOpen}" Margin="12,0,12,12" Spacing="8">
                      <TextBlock Text="{Binding PetrolHeadText}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Pump.Ok}" FontWeight="Bold" />
                      <TextBlock Text="{Binding DieselHeadText}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Pump.Warn}" FontWeight="Bold" />
                      <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasNote}" Classes="label" />

                      <!-- ⚠️ فقط برای دیدن — عکسِ گذشته ویرایش نمی‌شود -->
                      <c:ExcelGrid ItemsSource="{Binding Rows}" IsReadOnly="True"
                                   x:CompileBindings="False">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
                          <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="Auto" MinWidth="140" />
                          <DataGridTextColumn Header="حواله" Binding="{Binding Hawala}" Width="Auto" />
                          <DataGridTextColumn Header="تیل" Binding="{Binding FuelText}" Width="Auto" />
                          <DataGridTextColumn Header="مقدار" Binding="{Binding LitersText}" Width="Auto" />
                          <DataGridTextColumn Header="فی" Binding="{Binding PriceText}" Width="Auto" />
                          <DataGridTextColumn Header="بردگی" Binding="{Binding BardagiText}" Width="Auto" />
                          <DataGridTextColumn Header="رسید" Binding="{Binding RasidText}" Width="Auto" />
                          <DataGridTextColumn Header="رسیدِ تیل" Binding="{Binding RasidFuelText}" Width="Auto" />
                        </DataGrid.Columns>
                      </c:ExcelGrid>
                      <c:TotalsBar ItemsSource="{Binding Totals}" />

                      <Button Classes="ghost danger" Content="🗑️ حذفِ این آرشیو"
                              HorizontalAlignment="Right" Padding="10,4" FontSize="11"
                              Command="{Binding $parent[UserControl].DataContext.Current.DeleteArchiveCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- ══ فیصدی — بسته، مگر این‌که خودت بازش کنی ══════════════════════
           ⛔ نوارِ پهنی که این‌جا بود برداشته شد. گزارشِ صاحب ریپو با عکس و
           کادرِ قرمز: «آن بخش که در عکس سوم زدم را برمی‌داری و دیگر نبینمش.»

           آن نوار نُه کادر داشت — فیصدیِ پطرول/دیزل/هر دو، رسیدِ تیلِ پطرول و
           دیزل، رسیدِ پولِ پطرول و دیزل، سپردهٔ پول، و یک تیک‌مارکِ «واحدِ پول» —
           و هیچ‌کدامشان در سایت این شکل را ندارند:

             • رسیدها جای خودشان در **سربرگ** است (خانهٔ «مقدار رسید تیل/پول»)،
               پس این‌جا تکراری بودند و برچسبشان هم معلوم نمی‌کرد مالِ کدام
               کادرند («جمله‌ها نامعلوم که برای کدوم کادر استن»).
             • «واحد پول» در سایت دکمهٔ ‎🔁 پول‎ی سربرگ است، نه تیک‌مارک — به
               سربرگ رفت.
             • فیصدی در سایت سه کادرِ فشرده است که همیشه هم دیده نمی‌شوند؛
               خواستهٔ صاحب ریپو: «بغلِ آن حساب جدید باید کادرش باشد و هر وقت
               زدم اینا بیان.» پس با دکمهٔ «٪ فیصدی» باز و بسته می‌شود. -->
      <Border Grid.Row="1" Classes="panel" Padding="12,10" Margin="0,0,0,10"
              DataContext="{Binding Current}" IsVisible="{Binding IsPercentOpen}">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel.Styles>
            <Style Selector="TextBlock.pl">
              <Setter Property="FontSize" Value="15" />
              <Setter Property="FontWeight" Value="Black" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="TextBox.pv">
              <Setter Property="FontSize" Value="16" />
              <Setter Property="FontWeight" Value="Black" />
              <Setter Property="Width" Value="90" />
              <Setter Property="TextAlignment" Value="Center" />
            </Style>
          </StackPanel.Styles>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⛽ پطرول" Classes="pl" Foreground="{DynamicResource Pump.Ok}" />
            <TextBox Text="{Binding PercentPetrolText}" Classes="pv" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="🟤 دیزل" Classes="pl" Foreground="{DynamicResource Pump.Warn}" />
            <TextBox Text="{Binding PercentDieselText}" Classes="pv" />
          </StackPanel>
          <!-- میان‌بُر: هر عددی این‌جا نوشته شود، همان لحظه روی هر دو تیل
               می‌نشیند. خالی می‌ماند اگر فیصدیِ دو تیل یکی نباشد — چون آن‌وقت
               «هر دو» عددی ندارد که نشان بدهد. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="هر دو" Classes="pl" />
            <TextBox Text="{Binding PercentBothText}" Classes="pv" Watermark="هر دو" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding IsMoney}">
            <TextBlock Text="سپردهٔ پول" Classes="pl" />
            <TextBox Text="{Binding MoneyDepositText}" Classes="pv" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- دفترِ حسابِ باز -->
      <c:ExcelGrid Grid.Row="2" ItemsSource="{Binding Current.Rows}" GrowsOnEnter="True" x:CompileBindings="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
          <DataGridTextColumn Header="نام"   Binding="{Binding Name}" Width="Auto" MinWidth="150" MaxWidth="320" />
          <DataGridTextColumn Header="حواله" Binding="{Binding Hawala}" Width="Auto" />
          <!-- ══ نوع تیل — دو کادرِ رادیویی، **روی هم** ═════════════════════
               مو‌به‌مو ‎.ft-pick‎ی سایت:

                   .ft-pick{ display:flex; flex-direction:column;
                             align-items:center; gap:3px; min-width:74px; padding:3px }
                   .ft-opt { gap:4px; font-size:0.88rem; font-weight:700;
                             border-radius:6px; padding:3px 7px; border:1px solid transparent }

               ⚠️ ‎flex-direction:column‎ — پطرول بالا، دیزل پایین. گزارشِ صاحب
               ریپو با عکسِ سایت: «نوع تیل رو هم ببین پایین و بالا هم استن نه بغل
               به بغل هم». بغل‌به‌بغل بودنشان خانه را پهن می‌کرد و ستون را می‌بلعید
               («خیلی بزرگ می‌شه و خیلی خرابه»).

               ⚠️ ‎GroupName‎ باید برای هر ردیف یکتا باشد — با نامِ ثابت، آوالونیا
               همهٔ ردیف‌های جدول را یک گروه می‌بیند و زدنِ «دیزل» در یک ردیف
               انتخابِ همهٔ ردیف‌های دیگر را برمی‌دارد. -->
          <DataGridTemplateColumn Header="تیل" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Spacing="3" Margin="3" MinWidth="74"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel.Styles>
                    <Style Selector="RadioButton">
                      <Setter Property="FontSize" Value="14" />
                      <Setter Property="FontWeight" Value="Bold" />
                      <Setter Property="MinHeight" Value="0" />
                      <Setter Property="Padding" Value="7,3" />
                    </Style>
                  </StackPanel.Styles>
                  <RadioButton GroupName="{Binding FuelGroup}" Content="⛽ پطرول"
                               Foreground="{DynamicResource Pump.Ok}"
                               IsChecked="{Binding IsPetrol}" />
                  <RadioButton GroupName="{Binding FuelGroup}" Content="🟤 دیزل"
                               Foreground="{DynamicResource Pump.Warn}"
                               IsChecked="{Binding IsDiesel}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="لیتر"  Binding="{Binding LitersText}" Width="Auto" />
          <DataGridTextColumn Header="فی"    Binding="{Binding PriceText}" Width="Auto" />
          <DataGridTextColumn Header="بردگیِ دستی" Binding="{Binding ManualBardagiText}" Width="Auto" />
          <DataGridTextColumn Header="بردگی" Binding="{Binding BardagiText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="رسید"  Binding="{Binding RasidText}" Width="Auto" />
          <DataGridTextColumn Header="رسیدِ تیل" Binding="{Binding RasidFuelText}" Width="Auto" />
          <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                        Command="{Binding $parent[UserControl].DataContext.Current.DeleteRowCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </c:ExcelGrid>

      <!-- ردیفِ «جمله» — همتای ‎<tfoot class="xls-foot">‎ی سایت -->
      <c:TotalsBar Grid.Row="3" ItemsSource="{Binding Current.TotalCells}" />

      <StackPanel Grid.Row="4" Spacing="10" Margin="0,10,0,0"
                  DataContext="{Binding Current}">
        <!-- «ردیفِ تازه» زیرِ جدول است، نه لای کادرهای بالا — همان‌جایی که در
             سایت ‎.add-row-btn‎ می‌نشیند. -->
        <Button Classes="accent" Content="➕ ردیفِ تازه" HorizontalAlignment="Stretch"
                Padding="12,8" FontSize="15" FontWeight="Bold"
                Command="{Binding AddRowCommand}" />

        <!-- ══ نوتِ حساب — همتای ‎#pm-note-area‎ی سایت ═════════════════════ -->
        <StackPanel Spacing="5">
          <TextBlock Text="📌 نوت" FontSize="15" FontWeight="Black" />
          <TextBox Text="{Binding AccountNote}" AcceptsReturn="True" MinHeight="64"
                   TextWrapping="Wrap" FontSize="15"
                   Watermark="📝 توضیحات حساب…" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </c:SectionPage>
</UserControl>
