<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.PriceLossSectionView"
             x:DataType="vm:PriceLossSectionViewModel">

  <!-- ══ 📉 زیان ناشی از افزایش قیمت — کادرِ خالی ═══════════════════════════
       خواستهٔ صاحب ریپو (۱۴۰۵/۰۷/۱۲): «کادرش باشه، محتوای داخلش همه حذف؛
       یک فرمولِ بهتر می‌دهم.» شرحش بالای ‎PriceLossSectionViewModel‎. -->
  <c:SectionPage Header="📉 زیان ناشی از افزایش قیمت">
    <Border Classes="panel" Padding="24,32">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <TextBlock Text="📉" FontSize="34" HorizontalAlignment="Center" />
        <TextBlock Text="این بخش فعلاً خالی است" FontSize="17" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="محاسبهٔ قبلی برداشته شد. فرمولِ تازه به‌زودی این‌جا می‌نشیند."
                   Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </c:SectionPage>
</UserControl>
