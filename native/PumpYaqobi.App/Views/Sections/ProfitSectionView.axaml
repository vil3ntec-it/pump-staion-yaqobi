<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ProfitSectionView"
             x:DataType="vm:ProfitSectionViewModel">

  <!-- این بخش تا امروز بیرونِ قالبِ مشترک بود: نه سربرگِ کادر داشت نه عنوان،
       و محتوایش از لبهٔ پنجره شروع می‌شد. حالا مثلِ هفده بخشِ دیگر داخلِ
       ‎SectionPage‎ است تا خودبه‌خود همان کادر و سربرگ را بگیرد. -->
  <c:SectionPage Header="مفاد / ضرر / اتحادیه"
                 SubHeader="درآمدها منهای مصارف — نرخِ اتحادیه هم از همین‌جا به پارچه‌ها می‌رود">
          <StackPanel Spacing="12">

      <!-- ⚠️ همهٔ کارت‌های این صفحه تمام‌عرض‌اند و ‎calm‎ (سایهٔ بی‌محو):
           گزارشِ «مفاد/ضرر خیلی سنگین اسکرول می‌شود» (۱۴۰۵/۰۷/۱۳)؛ شرحش روی
           ‎Border.card.calm‎ در ‎Controls.axaml‎. -->
      <!-- ══ کادرِ بزرگِ «مفاد / ضرر خالص» ══════════════════════════════════
           همان ‎.pl-result‎: عنوان، عددِ بزرگ، جملهٔ حال و خطِ روند. -->
      <Border Classes="card calm" Padding="18,16" MinHeight="180">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="مفاد / ضرر خالص" Classes="label" FontSize="13" />
          <TextBlock Grid.Row="1" Text="{Binding NetText}" FontWeight="Bold" FontSize="34"
                     Margin="0,8,0,0"
                     Foreground="{Binding TrendBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
          <TextBlock Grid.Row="2" Text="{Binding NetCaption}" FontSize="13" Margin="0,4,0,0"
                     Foreground="{Binding TrendBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
          <c:SparkChart Grid.Row="3" ShowAxis="False" FlowDirection="LeftToRight" MinHeight="80"
                        Margin="0,10,0,0"
                        Values="{Binding TrendValues}"
                        LineBrush="{Binding TrendBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                        GridBrush="{DynamicResource Pump.GridLine}" />
        </Grid>
      </Border>

      <!-- ══ درآمدها و مصارف ══ -->
      <Grid ColumnDefinitions="*,12,*">
        <Border Grid.Column="0" Classes="card calm" Padding="16,14">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding IncomeTitle}" Classes="label" FontSize="13" />
            <TextBlock Text="{Binding IncomeText}" FontWeight="Bold" FontSize="24"
                       Foreground="{Binding IncomeBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card calm" Padding="16,14">
          <StackPanel Spacing="6">
            <TextBlock Text="💸 مصارف" Classes="label" FontSize="13" />
            <TextBlock Text="{Binding ExpenseText}" FontWeight="Bold" FontSize="24"
                       Foreground="{DynamicResource Pump.Danger}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══ نرخ اتحادیه ══════════════════════════════════════════════════
           گزارشِ صاحب ریپو: «دو کادرِ نرخ اتحادیه هم خیلی کوچک‌اند و هم رفتن
           یک بغل؛ وسط بیان و عالی باشن.»

           حق داشت و ریشه‌اش یک خط بود: ‎MaxWidth="420" HorizontalAlignment="Right"‎
           — کادرها را هم کوچک می‌کرد و هم به یک لبه می‌چسباند. حالا هر نرخ
           کارتِ خودش را دارد، وسطِ صفحه، با عددِ درشت و واحدِ نوشته‌شده. -->
      <Border Classes="card calm" Padding="18,16">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="🏛️ نرخ اتحادیه" Classes="h2" TextAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="520"
                       Text="نرخ روزِ اتحادیه را این‌جا بنویس؛ خودکار در کادر «فی لیتر (افغانی)» بخش پارچه‌ها (روز و شب) قرار می‌گیرد." />
          </StackPanel>

          <Grid ColumnDefinitions="*,16,*" MaxWidth="640" HorizontalAlignment="Center">
            <Border Grid.Column="0" Classes="panel" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Text="⛽ پطرول" FontWeight="ExtraBold" FontSize="14"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Accent}" />
                <TextBox Text="{Binding UnionPetrol}" Watermark="0"
                         FontSize="22" FontWeight="Bold" TextAlignment="Center"
                         MinHeight="52" Padding="10,8" />
                <TextBlock Text="افغانی در هر لیتر" Classes="muted" FontSize="11"
                           TextAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Text="🟤 دیزل" FontWeight="ExtraBold" FontSize="14"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Warn}" />
                <TextBox Text="{Binding UnionDiesel}" Watermark="0"
                         FontSize="22" FontWeight="Bold" TextAlignment="Center"
                         MinHeight="52" Padding="10,8" />
                <TextBlock Text="افغانی در هر لیتر" Classes="muted" FontSize="11"
                           TextAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ══ خرید عمده از مشتریان ═════════════════════════════════════════
           «اون‌ها رو هم بهتر کن، خیلی داغون استن.» شش کادر و یک دکمه در یک
           ‎WrapPanel‎ی با پهناهای دستی بودند، پس با هر پهنای پنجره جای
           دیگری می‌شکستند و «قابلِ پرداخت» زیرِ «نرخ بازار» می‌افتاد.

           حالا دو ردیفِ روشن: بالا چیزی که تایپ می‌کنی، پایین چیزی که
           برنامه حساب می‌کند — و دکمهٔ ثبت کنارِ همان نتیجه. -->
      <Border Classes="card calm" Padding="18,16">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="🛒 خرید عمده از مشتریان" Classes="h2" TextAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="560"
                       Text="یک نفر می‌خواهد تیلش را به تو بفروشد؛ تو عمده می‌گیری. درآمد اضافی = مقدار × (نرخ بازار − فی عمده)." />
          </StackPanel>

          <!-- ورودی‌ها -->
          <Grid ColumnDefinitions="*,12,*,12,*" MaxWidth="720" HorizontalAlignment="Center">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Text="مقدار تیل (لیتر)" Classes="label" TextAlignment="Center" />
              <TextBox Text="{Binding BulkQty}" Watermark="0" FontSize="16"
                       TextAlignment="Center" MinHeight="42" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="فی خرید عمده" Classes="label" TextAlignment="Center" />
              <TextBox Text="{Binding BulkBuy}" Watermark="0" FontSize="16"
                       TextAlignment="Center" MinHeight="42" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="5">
              <TextBlock Text="نرخ بازار" Classes="label" TextAlignment="Center" />
              <TextBox Text="{Binding BulkMarket}" Watermark="0" FontSize="16"
                       TextAlignment="Center" MinHeight="42" />
            </StackPanel>
          </Grid>

          <!-- نتیجه‌ها + ثبت -->
          <Grid ColumnDefinitions="*,12,*,12,Auto" MaxWidth="720" HorizontalAlignment="Center">
            <Border Grid.Column="0" Classes="panel" Padding="14,12">
              <StackPanel Spacing="4">
                <TextBlock Text="پول فروشنده (قابل پرداخت)" Classes="label"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BulkSellerText}" FontWeight="ExtraBold" FontSize="20"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Accent}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel" Padding="14,12">
              <StackPanel Spacing="4">
                <TextBlock Text="درآمد اضافی" Classes="label" TextAlignment="Center" />
                <TextBlock Text="{Binding BulkIncomeText}" FontWeight="ExtraBold" FontSize="20"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Ok}" />
              </StackPanel>
            </Border>
            <Button Grid.Column="4" Classes="accent" Content="ثبت" MinWidth="96" MinHeight="46"
                    VerticalAlignment="Center" Command="{Binding AddBulkCommand}" />
          </Grid>

          <TextBlock FontSize="12" TextAlignment="Center"
                     Foreground="{DynamicResource Pump.Muted}">
            <Run Text="جمله درآمد اضافی ثبت‌شده:" />
            <Run Text="{Binding BulkSumText}" FontWeight="Bold"
                 Foreground="{DynamicResource Pump.Ok}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- ══ درآمد و مصرف اضافی دستی ══ -->
      <Border Classes="card calm" Padding="16,14">
        <StackPanel Spacing="10">
          <TextBlock Text="✍️ درآمد و مصرف اضافی دستی" Classes="h2" TextAlignment="Center" />
          <!-- همان ایرادِ «کوچک و یک‌بغل» را داشت؛ با همان قاعده وسط آمد -->
          <Grid ColumnDefinitions="*,16,*" MaxWidth="640" HorizontalAlignment="Center">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Text="درآمد اضافی دستی" Classes="label" TextAlignment="Center" />
              <TextBox Text="{Binding ManualIncome}" Watermark="0" FontSize="16"
                       TextAlignment="Center" MinHeight="42" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="مصرف اضافی" Classes="label" TextAlignment="Center" />
              <TextBox Text="{Binding ManualExpense}" Watermark="0" FontSize="16"
                       TextAlignment="Center" MinHeight="42" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      </StackPanel>
    
  </c:SectionPage>
</UserControl>
