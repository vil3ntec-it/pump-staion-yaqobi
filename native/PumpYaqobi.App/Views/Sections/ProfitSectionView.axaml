<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:vmb="using:PumpYaqobi.App.ViewModels"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.ProfitSectionView"
             x:DataType="vm:ProfitSectionViewModel">

  <!-- این بخش تا امروز بیرونِ قالبِ مشترک بود: نه سربرگِ کادر داشت نه عنوان،
       و محتوایش از لبهٔ پنجره شروع می‌شد. حالا مثلِ هفده بخشِ دیگر داخلِ
       ‎SectionPage‎ است تا خودبه‌خود همان کادر و سربرگ را بگیرد. -->
  <!-- ══ یک قد، یک قلم، یک ترازِ برای همهٔ کادرهای این صفحه (۱۴۰۵/۰۷/۱۳) ══
       گزارشِ صاحب ریپو با عکس: «این سه تا خیلی ضایع دیده می‌شوند… مخصوصاً
       خرید عمده و نرخ بازار؛ هم برابر و تراز نیستند و هم ظاهر خیلی مشکل دارد.»

       ⛔ ریشه یک ویژگی بود، نه سلیقه: هر شبکهٔ ستاره‌ای این صفحه
       ‎HorizontalAlignment="Center"‎ داشت، و شبکهٔ وسط‌چین ستون‌های ستاره‌ای‌اش را
       از روی **محتوا** اندازه می‌گیرد — پس «مقدار تیل (لیتر)» پهن‌تر از
       «نرخ بازار» می‌شد و سه کادر سه پهنا داشتند. و ردیفِ نتیجه‌ها قالبِ
       ستونیِ دیگری (‎*,*,Auto‎) داشت، پس لبه‌هایش هیچ‌جا زیرِ کادرهای بالا
       نمی‌افتاد. قدها هم سه تا بود (۴۲ · ۴۶ · ۵۲) و قلم‌ها سه تا (۱۶ · ۲۰ · ۲۲).

       حالا: شبکه‌ها کشیده‌اند با سقفِ پهنا (در آوالونیا کشیده + سقف یعنی وسطِ
       جا، با پهنای کامل)، و هر کادرِ تایپ ‎plbox‎ است — یک قد و یک قلم.
       ⚠️ هیچ منطقی عوض نشد: همهٔ اتصال‌ها همان‌اند که بودند. -->
  <UserControl.Styles>
    <Style Selector="TextBox.plbox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.pllabel">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.plresult">
      <Setter Property="MinHeight" Value="76" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.plresult > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- ══ پرده: «بخش آزاد، عددها تار» (۱۴۰۵/۰۷/۱۶) ══════════════════════
         ⚠️ محو فقط وقتی پرده هست؛ بازش که شد هیچ اثری روی اسکرول ندارد.
         ⛔ و عددِ زیرِ پرده عددِ ساختگی است (‎NetShown‎…) — تار شدن تنها
         نگهبان نیست. -->
    <Style Selector="Panel.veilable > StackPanel.veiled">
      <Setter Property="Effect">
        <BlurEffect Radius="16" />
      </Setter>
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- ⛔ «لیتر اضافه داده شده»: کادرِ سرخ (۱۴۰۵/۰۷/۱۸) -->
    <Style Selector="TextBox.overliters">
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Danger}" />
    </Style>
    <Style Selector="Border.overliters">
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.overliters TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Danger}" />
    </Style>
    <Style Selector="Border.convrow">
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.convrow.loss">
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
    </Style>
    <Style Selector="Button.subcard">
      <Setter Property="Background" Value="{DynamicResource Pump.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="Button.veil">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.veil:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <c:SectionPage Header="مفاد / ضرر / اتحادیه"
                 SubHeader="درآمدها منهای مصارف — نرخِ اتحادیه هم از همین‌جا به پارچه‌ها می‌رود">

    <!-- ══ دوره: همهٔ زمان‌ها · یک سال · یک ماه ════════════════════════════
         خواستهٔ صاحب ریپو: «بخشِ مفاد و ضرر کادرِ کشوییِ ماه و سال ندارد… که
         آدم بفهمد برای ماه یا سال چقدر فایده بوده یا نبوده.» همان کشویِ سال +
         ماهِ دفترهای ماهانه (‎YearMonthPicker‎)؛ پیش‌فرض «همهٔ ماه‌ها» — یعنی
         همان عددی که تا امروز دیده می‌شد. -->
    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="دوره" Classes="label" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                  IsVisible="{Binding Picker.HasYears}"
                  c:PickerWidth.Stable="True" ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="120" />
        <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                  c:PickerWidth.Stable="True" ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="160" />
      </StackPanel>
    </c:SectionPage.Filters>

    <Panel>
      <!-- ══ صفحهٔ جدای «📋 از کجا آمد» (۱۴۰۵/۰۷/۱۸، دوم) — کادرش در صفحهٔ اصلی است ══ -->
      <StackPanel Spacing="12" IsVisible="{Binding SourcesPage}">
        <Button Classes="ghost" HorizontalAlignment="Left" Content="‹ برگشت به مفاد / ضرر"
                Command="{Binding CloseSourcesCommand}" />
        <Border Classes="card calm" Padding="16,14">
          <StackPanel Spacing="6">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="📋 از کجا آمد" Classes="label" FontSize="15" FontWeight="Bold" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding PeriodText}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource Pump.Ink.Info}" />
            </DockPanel>
            <TextBlock Text="{Binding SourcesNote}" FontSize="12" Classes="muted" />
            <TextBlock Text="{Binding SalesPetrolText}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SalesDieselText}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding OtherIncomeText}" FontSize="13.5" />
            <TextBlock Text="{Binding RateDiffText}" FontSize="13.5" />
            <TextBlock Text="{Binding ExpenseLineText}" FontSize="13.5" />
            <ItemsControl ItemsSource="{Binding Sources}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfitSourceLine">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12.5" Margin="12,0" Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="13" FontWeight="Bold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding MainPage}">

      <!-- ⚠️ همهٔ کارت‌های این صفحه تمام‌عرض‌اند و ‎calm‎ (سایهٔ بی‌محو):
           گزارشِ «مفاد/ضرر خیلی سنگین اسکرول می‌شود» (۱۴۰۵/۰۷/۱۳)؛ شرحش روی
           ‎Border.card.calm‎ در ‎Controls.axaml‎. -->
      <!-- ⛔ نمودار، مفاد و مصارف پشتِ یک پرده‌اند؛ زدن روی پرده رمز می‌خواهد -->
      <!-- ══ کادرهای ورود به صفحه‌های جدا (۱۴۰۵/۰۷/۱۸) ════════════════════════
           گزارشِ صاحب ریپو: «کادر و دکمهٔ ورود به صفحهٔ جداگانه درست کار نمی‌کند… با
           کلیک روی کادر صفحهٔ مربوطه باز شود.» تا امروز دو زیربخش فقط در کشوییِ «☰ کارها»
           بودند و روی صفحه هیچ کادری نبود. حالا هر کدام یک کادرِ کامل است و کلیک روی **هر
           جای** کادر همان ‎ShowSubCommand‎ِ همیشگی را می‌زند (همان در، همان قفل). -->
      <ItemsControl ItemsSource="{Binding SubSections}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vmb:SectionViewModel">
            <Button Classes="subcard" Margin="0,0,8,0" Padding="16,12"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((vmb:SectionViewModel)DataContext).ShowSubCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="باز کردنِ همین صفحه">
              <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding LinkTitle}" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="باز کن ‹" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pump.Ink.Accent}" />
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Panel Classes="veilable">
        <StackPanel Spacing="12" Classes.veiled="{Binding Veiled}">
      <!-- ══ کادرِ بزرگِ «مفاد / ضرر خالص» ══════════════════════════════════
               همان ‎.pl-result‎: عنوان، عددِ بزرگ، جملهٔ حال و خطِ روند.
               ⛔ (۱۴۰۵/۰۷/۱۸) کنارش کارتِ «💰 سودِ واقعی» — فروش جدا از سود. -->
          <!-- ⛔ (۱۴۰۵/۰۷/۱۸، دوم) «💰 سودِ واقعی» داخلِ همین کارت است، نه کنارش: دکمهٔ سربرگ
               نما را عوض می‌کند (‎ShowReal‎) و دوباره زدن همان نمودار را برمی‌گرداند. -->
          <Border Classes="card calm" Padding="18,16" MinHeight="200">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Grid.Row="0" LastChildFill="False">
                <!-- ⚠️ چپ/راست این‌جا منطقی است: در راست‌به‌چپ «Left» یعنی سمتِ راستِ چشم -->
                <TextBlock DockPanel.Dock="Left" Text="مفاد / ضرر خالص" Classes="label" FontSize="13"
                           VerticalAlignment="Center" />
                <!-- کدام دوره: «همهٔ زمان‌ها» · «سالِ 1405» · «میزان 1405» -->
                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="10,3" VerticalAlignment="Center"
                        Background="{DynamicResource Pump.Input}"
                        BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="1">
                  <TextBlock Text="{Binding PeriodText}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource Pump.Ink.Info}" />
                </Border>
                <Button x:Name="RealToggle" DockPanel.Dock="Right" Classes="ghost info" Margin="0,0,8,0"
                        Padding="10,3" FontSize="12" VerticalAlignment="Center"
                        Content="{Binding RealToggleText}" Command="{Binding ToggleRealCommand}"
                        ToolTip.Tip="سودِ واقعی (با قیمتِ خریدِ مخزن) ⇄ نمودارِ مفاد" />
              </DockPanel>

              <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding !ShowReal}">
                <TextBlock Grid.Row="0" Text="{Binding NetShown}" FontWeight="Bold" FontSize="34"
                           Margin="0,8,0,0"
                           Foreground="{Binding TrendBrushShown, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                <TextBlock Grid.Row="1" Text="{Binding NetCaptionShown}" FontSize="13" Margin="0,4,0,0"
                           Foreground="{Binding TrendBrushShown, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                <c:SparkChart x:Name="NetChart" Grid.Row="2" ShowAxis="False" FlowDirection="LeftToRight" MinHeight="80"
                              Margin="0,10,0,0"
                              Values="{Binding TrendShown}"
                              LineBrush="{Binding TrendBrushShown, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                              GridBrush="{DynamicResource Pump.GridLine}" />
              </Grid>

              <!-- ══ 💰 سودِ واقعی (۱۴۰۵/۰۷/۱۸، سوم): همان شکلِ نمودار — عددِ بزرگ = لیتر × فایدهٔ فی
                   لیتر (همان کادرِ پارچه)، دو جمله «فی لیتر · فایده در هر لیتر» و نمودارِ فایدهٔ فی
                   لیترِ هر روز. ⛔ هیچ مبلغِ فروش یا لیتری نوشته نمی‌شود؛ پشتِ همان پرده. ══ -->
              <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" IsVisible="{Binding ShowReal}">
                <TextBlock Grid.Row="0" Text="{Binding RealProfitShown}" FontWeight="Bold" FontSize="34"
                           Margin="0,8,0,0"
                           Foreground="{Binding RealProfitBrush, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                <TextBlock Grid.Row="1" Text="💰 فایده = مقدارِ فروخته‌شده × فایدهٔ فی لیتر (قیمتِ خرید از مخزن)"
                           FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource Pump.Muted}" />
                <TextBlock Grid.Row="2" Text="{Binding RealPetrolText}" FontSize="13.5" FontWeight="SemiBold"
                           Margin="0,8,0,0" Foreground="{DynamicResource Pump.Ink.Info}" />
                <TextBlock Grid.Row="3" Text="{Binding RealDieselText}" FontSize="13.5" FontWeight="SemiBold"
                           Margin="0,4,0,0" Foreground="{DynamicResource Pump.Ink.Warn}" />
                <c:SparkChart x:Name="RealChart" Grid.Row="5" ShowAxis="True" FlowDirection="LeftToRight" MinHeight="150"
                              Margin="0,10,0,0" Unit="افغانی" FirstName="پطرول" SecondName="دیزل"
                              Values="{Binding RealPetrolTrend}" SecondValues="{Binding RealDieselTrend}"
                              Labels="{Binding RealLabels}"
                              LineBrush="{DynamicResource Pump.Info}" SecondLineBrush="{DynamicResource Pump.Warn}"
                              GridBrush="{DynamicResource Pump.GridLine}" LabelBrush="{DynamicResource Pump.Muted}" />
                <TextBlock Grid.Row="4" Text="{Binding RealNote}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding RealNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource Pump.Ink.Danger}" />
              </Grid>
            </Grid>
          </Border>

          <!-- ══ درآمدها و مصارف ══ -->
          <Grid ColumnDefinitions="*,12,*">
            <Border Grid.Column="0" Classes="card calm" Padding="16,14">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding IncomeTitleShown}" Classes="label" FontSize="13" />
                <TextBlock Text="{Binding IncomeShown}" FontWeight="Bold" FontSize="24"
                           Foreground="{Binding IncomeBrushShown, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card calm" Padding="16,14">
              <StackPanel Spacing="6">
                <TextBlock Text="💸 مصارف" Classes="label" FontSize="13" />
                <TextBlock Text="{Binding ExpenseShown}" FontWeight="Bold" FontSize="24"
                           Foreground="{Binding ExpenseBrushShown, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- ══ «از کجا آمد» (۱۴۰۵/۰۷/۲۰) — صاحب ریپو: «یک بخش هم باشه توی مفاد و
               ضرر که این‌ها از کجا اومدن». جمعِ هر منبع، و هر شیفتِ هر ورق یک سطر. -->
          <!-- ⛔ (۱۴۰۵/۰۷/۱۸، دوم) فقط یک کادر؛ جزئیات در صفحهٔ جدا (‎OpenSourcesCommand‎) -->
          <Button x:Name="SourcesCard" Classes="subcard" Padding="16,12"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Command="{Binding OpenSourcesCommand}" ToolTip.Tip="جزئیات در صفحهٔ جدا">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="📋 از کجا آمد" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Left" Text="{Binding SourcesNote}" FontSize="12" Classes="muted"
                         Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="باز کن ‹" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource Pump.Ink.Accent}" />
            </DockPanel>
          </Button>
        </StackPanel>
        <Button Classes="veil" IsVisible="{Binding Veiled}" Command="{Binding RevealCommand}"
                ToolTip.Tip="برای دیدنِ مفاد و مصارف رمز بزنید">
          <Border CornerRadius="14" Padding="18,10"
                  Background="{DynamicResource Pump.Card}"
                  BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="1">
            <TextBlock Text="{Binding VeilText}"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>
        </Button>
      </Panel>
      <Button Classes="ghost" HorizontalAlignment="Center" Content="🔒 دوباره قفل کن"
              IsVisible="{Binding CanRelock}" Command="{Binding RelockCommand}" />

      <!-- ══ نرخ اتحادیه ══════════════════════════════════════════════════
           گزارشِ صاحب ریپو: «دو کادرِ نرخ اتحادیه هم خیلی کوچک‌اند و هم رفتن
           یک بغل؛ وسط بیان و عالی باشن.»

           حق داشت و ریشه‌اش یک خط بود: ‎MaxWidth="420" HorizontalAlignment="Right"‎
           — کادرها را هم کوچک می‌کرد و هم به یک لبه می‌چسباند. حالا هر نرخ
           کارتِ خودش را دارد، وسطِ صفحه، با عددِ درشت و واحدِ نوشته‌شده. -->
      <Border Classes="card calm" Padding="18,16">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="🏛️ نرخ اتحادیه" Classes="h2" TextAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="520"
                       Text="نرخ روزِ اتحادیه را این‌جا بنویس؛ خودکار در کادر «فی لیتر (افغانی)» بخش پارچه‌ها (روز و شب) قرار می‌گیرد." />
          </StackPanel>

          <Grid ColumnDefinitions="*,16,*" MaxWidth="720">
            <Border Grid.Column="0" Classes="panel" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Text="⛽ پطرول" FontWeight="ExtraBold" FontSize="14"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Ink.Accent}" />
                <TextBox Classes="plbox" Text="{Binding UnionPetrol}" Watermark="0" c:LiveFormat.Kind="number" />
                <TextBlock Text="افغانی در هر لیتر" Classes="muted" FontSize="11"
                           TextAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Text="🟤 دیزل" FontWeight="ExtraBold" FontSize="14"
                           TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Ink.Warn}" />
                <TextBox Classes="plbox" Text="{Binding UnionDiesel}" Watermark="0" c:LiveFormat.Kind="number" />
                <TextBlock Text="افغانی در هر لیتر" Classes="muted" FontSize="11"
                           TextAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ══ خرید عمده از مشتریان ═════════════════════════════════════════
           «اون‌ها رو هم بهتر کن، خیلی داغون استن.» شش کادر و یک دکمه در یک
           ‎WrapPanel‎ی با پهناهای دستی بودند، پس با هر پهنای پنجره جای
           دیگری می‌شکستند و «قابلِ پرداخت» زیرِ «نرخ بازار» می‌افتاد.

           حالا دو ردیفِ روشن: بالا چیزی که تایپ می‌کنی، پایین چیزی که
           برنامه حساب می‌کند — و دکمهٔ ثبت کنارِ همان نتیجه. -->
      <Border Classes="card calm" Padding="18,16">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="🛒 خرید عمده از مشتریان" Classes="h2" TextAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="560"
                       Text="یک نفر می‌خواهد تیلش را به تو بفروشد؛ تو عمده می‌گیری. درآمد اضافی = مقدار × (نرخ بازار − فی عمده)." />
          </StackPanel>

          <!-- ⛔ (۱۴۰۵/۰۷/۱۸) همهٔ کادرها **افقی، در یک ردیف** — خواستهٔ صاحب ریپو: «تمام
               کادرهای خرید عمده را افقی و در یک ردیف قرار بده، نه زیر یکدیگر.» یک شبکهٔ
               شش‌ستونه: سه کادرِ تایپ، دو نتیجه و دکمهٔ ثبت؛ برچسب‌ها ردیفِ بالای همان ستون.
               هیچ اتصالی عوض نشد. -->
          <Grid ColumnDefinitions="*,10,*,10,*,10,*,10,*,10,Auto" RowDefinitions="Auto,6,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="مقدار تیل (لیتر)" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="فی خرید عمده" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="نرخ بازار" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="پول فروشنده (قابل پرداخت)" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="8" Text="درآمد اضافی" Classes="label pllabel" VerticalAlignment="Bottom" />

            <TextBox Grid.Row="2" Grid.Column="0" Classes="plbox" Text="{Binding BulkQty}" Watermark="0" c:LiveFormat.Kind="number" />
            <TextBox Grid.Row="2" Grid.Column="2" Classes="plbox" Text="{Binding BulkBuy}" Watermark="0" c:LiveFormat.Kind="number" />
            <TextBox Grid.Row="2" Grid.Column="4" Classes="plbox" Text="{Binding BulkMarket}" Watermark="0" c:LiveFormat.Kind="number" />
            <Border Grid.Row="2" Grid.Column="6" Classes="panel" MinHeight="48" Padding="8,4">
              <TextBlock Text="{Binding BulkSellerText}" FontWeight="ExtraBold" FontSize="16"
                         TextAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Pump.Ink.Accent}" />
            </Border>
            <Border Grid.Row="2" Grid.Column="8" Classes="panel" MinHeight="48" Padding="8,4">
              <TextBlock Text="{Binding BulkIncomeText}" FontWeight="ExtraBold" FontSize="16"
                         TextAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Pump.Ink.Ok}" />
            </Border>
            <Button Grid.Row="2" Grid.Column="10" Classes="accent" Content="➕ ثبت"
                    VerticalAlignment="Stretch" MinWidth="90"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontSize="15" Command="{Binding AddBulkCommand}" />
          </Grid>

          <TextBlock FontSize="12" TextAlignment="Center"
                     Foreground="{DynamicResource Pump.Muted}">
            <Run Text="جمله درآمد اضافی ثبت‌شده:" />
            <Run Text="{Binding BulkSumText}" FontWeight="Bold"
                 Foreground="{DynamicResource Pump.Ink.Ok}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- ══ 🔁 تبدیلِ تیل — پطرول ⇄ دیزل (۱۴۰۵/۰۷/۱۸) ════════════════════════════
           ارزشِ مبدأ با قیمتِ خریدِ واقعیِ مخزن ⇐ تقسیم بر قیمتِ خریدِ مقصد ⇐ لیترِ مجاز.
           تحویلِ بیشتر از مجاز ⇒ کادرِ سرخ و «لیتر اضافه داده شده». فرمول: ‎FuelConversionService‎. -->
      <Border Classes="card calm" Padding="18,16">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="🔁 تبدیلِ تیل" Classes="h2" TextAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="640"
                       Text="ارزشِ تیلِ مبدأ = لیتر × قیمتِ خریدِ مخزن (نه نرخِ اتحادیه)؛ لیترِ مقصدِ قابلِ دریافت = ارزش ÷ قیمتِ خریدِ هر لیترِ مقصد." />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,10,*,10,*,10,*,10,*" RowDefinitions="Auto,6,Auto,4,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="نوعِ تبدیل" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ConvQtyLabel}" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding ConvFromPriceLabel}" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding ConvToPriceLabel}" Classes="label pllabel" VerticalAlignment="Bottom" />
            <TextBlock Grid.Row="0" Grid.Column="8" Text="{Binding ConvDeliveredLabel}" Classes="label pllabel" VerticalAlignment="Bottom" />

            <Button Grid.Row="2" Grid.Column="0" Classes="accent" MinHeight="48" MinWidth="170"
                    Content="{Binding ConvDirectionText}" Command="{Binding ToggleConvDirectionCommand}"
                    ToolTip.Tip="زدنش جهتِ تبدیل را عوض می‌کند (پطرول ⇄ دیزل)" />
            <TextBox Grid.Row="2" Grid.Column="2" Classes="plbox" Text="{Binding ConvQty}" Watermark="0" c:LiveFormat.Kind="number" />
            <TextBox Grid.Row="2" Grid.Column="4" Classes="plbox" Text="{Binding ConvFromPrice}" Watermark="0" c:LiveFormat.Kind="number" />
            <TextBox Grid.Row="2" Grid.Column="6" Classes="plbox" Text="{Binding ConvToPrice}" Watermark="0" c:LiveFormat.Kind="number" />
            <TextBox Grid.Row="2" Grid.Column="8" Classes="plbox" Classes.overliters="{Binding ConvOver}"
                     Text="{Binding ConvDelivered}" Watermark="همان مجاز" c:LiveFormat.Kind="number" />

            <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding ConvFromSourceText}" Classes="muted" FontSize="11" TextAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="6" Text="{Binding ConvToSourceText}" Classes="muted" FontSize="11" TextAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="*,10,*,10,2*,10,Auto">
            <Border Grid.Column="0" Classes="panel" Padding="10,8">
              <StackPanel Spacing="3">
                <TextBlock Text="ارزشِ کلِ تیلِ مبدأ" Classes="label pllabel" />
                <TextBlock Text="{Binding ConvValueText}" FontWeight="ExtraBold" FontSize="16" TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Ink.Accent}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel" Padding="10,8">
              <StackPanel Spacing="3">
                <TextBlock Text="لیترِ قابلِ دریافت (مجاز)" Classes="label pllabel" />
                <TextBlock Text="{Binding ConvAllowedText}" FontWeight="ExtraBold" FontSize="16" TextAlignment="Center"
                           Foreground="{DynamicResource Pump.Ink.Ok}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="panel" Classes.overliters="{Binding ConvOver}" Padding="10,8">
              <TextBlock Text="{Binding ConvResultText}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                         TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="6" Classes="accent" Content="➕ ثبتِ تبدیل" MinWidth="120" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding SaveConversionCommand}" />
          </Grid>

          <!-- ══ تاریخچهٔ تبدیل‌ها — دائمی، با صافیِ سال و ماه و تیل و جست‌وجو ══ -->
          <Border Classes="panel" Padding="12,10">
            <StackPanel Spacing="8">
              <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                  <Style Selector="WrapPanel > :is(Control)">
                    <Setter Property="Margin" Value="0,0,10,6" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </WrapPanel.Styles>
                <TextBlock Text="🕘 تاریخچهٔ تبدیل‌ها" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ConvPicker.Years}" SelectedItem="{Binding ConvPicker.Year}"
                          IsVisible="{Binding ConvPicker.HasYears}" c:PickerWidth.Stable="True"
                          ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="110" />
                <ComboBox ItemsSource="{Binding ConvPicker.Months}" SelectedItem="{Binding ConvPicker.Selected}"
                          c:PickerWidth.Stable="True" ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="150" />
                <ComboBox ItemsSource="{Binding ConvFuelFilters}" SelectedItem="{Binding ConvFuelFilter}" MinWidth="170" />
                <TextBox Classes="plbox" Text="{Binding ConvSearch}" Watermark="🔍 تاریخ، وضعیت…" MinWidth="170" />
                <Button Content="📄 PDF و 🖨 چاپ" Command="{Binding PdfConversionsCommand}" />
              </WrapPanel>
              <TextBlock Text="{Binding ConvSummary}" Classes="muted" FontSize="12" />
              <ItemsControl ItemsSource="{Binding ConvRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConversionRow">
                    <Border Classes="convrow" Classes.loss="{Binding IsLoss}" Padding="10,6" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="{Binding Source}" FontSize="12" />
                        <TextBlock Text="{Binding Target}" FontSize="12" />
                        <TextBlock Text="{Binding Result}" FontSize="12.5" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ══ درآمد و مصرف اضافی دستی ══ -->
      <Border Classes="card calm" Padding="16,14">
        <StackPanel Spacing="10">
          <TextBlock Text="✍️ درآمد و مصرف اضافی دستی" Classes="h2" TextAlignment="Center" />
          <!-- همان ایرادِ «کوچک و یک‌بغل» را داشت؛ حالا همان شبکهٔ کشیده با سقف -->
          <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,6,Auto" MaxWidth="720">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="درآمد اضافی دستی" Classes="label pllabel" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="مصرف اضافی" Classes="label pllabel" />
            <TextBox Grid.Row="2" Grid.Column="0" Classes="plbox" Text="{Binding ManualIncome}" Watermark="0" c:LiveFormat.Kind="number" />
            <TextBox Grid.Row="2" Grid.Column="2" Classes="plbox" Text="{Binding ManualExpense}" Watermark="0" c:LiveFormat.Kind="number" />
          </Grid>
        </StackPanel>
      </Border>
      </StackPanel>
    </Panel>
  </c:SectionPage>
</UserControl>
