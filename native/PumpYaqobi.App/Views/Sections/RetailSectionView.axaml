<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.RetailSectionView"
             x:DataType="vm:RetailSectionViewModel">

  <c:SectionPage Header="🧾 حساب‌های چکنه" SubHeader="فروش چکنه (نقدی/خرد) — هر ردیف: مقدار تیل × فی = مقدار بردگی، و الباقی = بردگی − رسید">

    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
        <!-- «🗓️ ماه جدید» — همتای ‎addChakanaMonth()‎ی سایت: جدولِ ماهِ بعد
             را باز می‌کند. بی این، ماهی که هنوز ردیفی ندارد در کشویی نیست. -->
        <Button Classes="ghost info" Content="ماه جدید" Margin="0,0,6,0"
                Command="{Binding NewMonthCommand}"
                ToolTip.Tip="جدولِ ماهِ بعد را باز می‌کند" />
        <Button Classes="ghost info" Content="PDF" Margin="0,0,6,0"
                Command="{Binding PdfCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
        <!-- ══ کشویِ «سال» + «ماه» — همتای ‎_ymSelectsHtml‎ی سایت ═══════════════
             گزارشِ صاحب ریپو: «کادرِ کشویی سال هم نیست.» هیچ بخشی نداشت و همهٔ
             ماه‌های همهٔ سال‌ها در یک فهرستِ بلند بودند.
             با انتخابِ هر سال، فقط ماه‌های همان سال در کشویِ ماه می‌آیند.
             ⚠️ آن‌چه دیده می‌شود برچسبِ خوانا است («سنبله ۱۴۰۵»)، نه کلیدِ
             خامِ «1405/06» که تا امروز نشان داده می‌شد. -->
        <!-- نقطهٔ سرخ روی کشوی سال/ماه و کنارِ ماهِ پیش (‎MonthDot‎) -->
        <Panel IsVisible="{Binding Picker.HasYears}">
          <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                    ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="110" />
          <Ellipse Classes="monthdot badge" IsVisible="{Binding Picker.HasYearDot}" />
        </Panel>
        <Panel>
          <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                    ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="140" />
          <Ellipse Classes="monthdot badge" IsVisible="{Binding Picker.HasMonthDot}" />
        </Panel>
      </StackPanel>
    </c:SectionPage.Filters>

    <!-- ردیفِ «جمله ماه» — همان tfootِ جدولِ نسخهٔ وب -->
    <c:SectionPage.Summary>
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="جمله ماه" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TotalBardagi, StringFormat=بردگی: {0}}" FontWeight="Bold"
                   VerticalAlignment="Center" Foreground="{DynamicResource Pump.Ink.Accent}" />
        <TextBlock Text="{Binding TotalRasid, StringFormat=رسید: {0}}" FontWeight="Bold"
                   VerticalAlignment="Center" Foreground="{DynamicResource Pump.Ink.Ok}" />
        <TextBlock Text="{Binding TotalAlbaqi, StringFormat=الباقی: {0}}" FontWeight="Bold"
                   VerticalAlignment="Center" Foreground="{DynamicResource Pump.Ink.Danger}" />
      </StackPanel>
    </c:SectionPage.Summary>

    <!-- جدول + ردیفِ «جمله»ی ته آن — همتای ‎<tfoot class="xls-foot">‎ی سایت -->
    <Grid RowDefinitions="*,Auto">
    <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False"
                RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteRowCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="Auto" c:Suggest.Key="debtor" />
        <DataGridTextColumn Header="مقدار تیل" Binding="{Binding LitersText}" Width="Auto" />
        <DataGridTextColumn Header="فی" Binding="{Binding PriceText}" Width="Auto" />
        <DataGridTextColumn Header="مقدار بردگی" Binding="{Binding BardagiText}" Width="Auto" />
        <DataGridTextColumn Header="رسید" Binding="{Binding RasidText}" Width="Auto" />
        <DataGridTextColumn Header="الباقی" Binding="{Binding AlbaqiText}" Width="Auto" IsReadOnly="True" />
      </DataGrid.Columns>
    </c:ExcelGrid>
    <c:TotalsBar Grid.Row="1" ItemsSource="{Binding TotalCells}" IsVisible="{Binding HasTotals}" />
    </Grid>
  </c:SectionPage>
</UserControl>
