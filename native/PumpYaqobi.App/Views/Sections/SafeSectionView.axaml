<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.SafeSectionView"
             x:DataType="vm:SafeSectionViewModel">

  <c:SectionPage Header="گاوصندوق" SubHeader="بردگی و ماندگی — افغانی و دالر هرگز با هم جمع نمی‌شوند">

    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <!-- «🗓️ ماه جدید» — همتای ‎addChakanaMonth()‎ی سایت: جدولِ ماهِ بعد
             را باز می‌کند. بی این، ماهی که هنوز ردیفی ندارد در کشویی نیست. -->
        <Button Classes="ghost info" Content="ماه جدید" Margin="0,0,6,0"
                Command="{Binding NewMonthCommand}"
                ToolTip.Tip="جدولِ ماهِ بعد را باز می‌کند" />
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
        <Button Classes="ghost" Content="ماه بعد" Margin="0,0,6,0" />
        <Button Classes="ghost info" Content="PDF این ماه" Margin="0,0,6,0"
                Command="{Binding PdfCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
        <!-- ══ کشویِ «سال» + «ماه» — همتای ‎_ymSelectsHtml‎ی سایت ═══════════════
             گزارشِ صاحب ریپو: «کادرِ کشویی سال هم نیست.» هیچ بخشی نداشت و همهٔ
             ماه‌های همهٔ سال‌ها در یک فهرستِ بلند بودند.
             با انتخابِ هر سال، فقط ماه‌های همان سال در کشویِ ماه می‌آیند.
             ⚠️ آن‌چه دیده می‌شود برچسبِ خوانا است («سنبله ۱۴۰۵»)، نه کلیدِ
             خامِ «1405/06» که تا امروز نشان داده می‌شد. -->
        <!-- نقطهٔ سرخ روی کشوی سال/ماه و کنارِ ماهِ پیش (‎MonthDot‎) -->
        <Panel IsVisible="{Binding Picker.HasYears}">
          <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                    ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="110" />
          <Ellipse Classes="monthdot badge" IsVisible="{Binding Picker.HasYearDot}" />
        </Panel>
        <Panel>
          <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                    ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="140" />
          <Ellipse Classes="monthdot badge" IsVisible="{Binding Picker.HasMonthDot}" />
        </Panel>
      </StackPanel>
    </c:SectionPage.Filters>

    <c:SectionPage.Summary>
      <Grid ColumnDefinitions="*,12,*,12,*">
        <Border Grid.Column="0" Classes="stat" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="🏛️ جمله ماندگی" Classes="label" />
            <TextBlock Text="{Binding MandagiAfn, StringFormat={}{0} افغانی}" Classes="num"
                       Foreground="{DynamicResource Pump.Ink.Info}" />
            <TextBlock Text="{Binding MandagiUsd, StringFormat={}{0} دالر}" Classes="num2" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="stat" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="💵 جمله بردگی" Classes="label" />
            <TextBlock Text="{Binding BardagiAfn, StringFormat={}{0} افغانی}" Classes="num"
                       Foreground="{DynamicResource Pump.Ink.Ok}" />
            <TextBlock Text="{Binding BardagiUsd, StringFormat={}{0} دالر}" Classes="num2" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="stat" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="🏦 موجودی خالص" Classes="label" />
            <TextBlock Text="{Binding NetAfn, StringFormat={}{0} افغانی}" Classes="num" />
            <TextBlock Text="{Binding NetUsd, StringFormat={}{0} دالر}" Classes="num2" />
          </StackPanel>
        </Border>
      </Grid>
    </c:SectionPage.Summary>

    <!-- جدول + ردیفِ «جمله»ی ته آن — همتای ‎<tfoot class="xls-foot">‎ی سایت -->
    <Grid RowDefinitions="*,Auto">
    <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False"
                RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteRowCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="تاریخ"  Binding="{Binding DateShamsi}" Width="Auto" />
        <DataGridTemplateColumn Header="نوع" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو-سه گزینه، ‎ComboBox‎ یک قالبِ کامل با
                         ‎Popup‎ی خودش می‌ساخت — و ‎ledgerperf‎ گرفتش: نزدیک به چهل درصدِ
                         وقتِ باز شدنِ گاوصندوقِ ۲۰۰ ردیفی مالِ همین ستون‌ها بود. خواستهٔ
                         صاحب ریپو هم همین بود: «اون علامتِ ▾ فقط جا گرفته» و «با تب یا
                         اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ ‎celltoggle‎ را می‌زند. -->
                      <DataTemplate>
                        <Button Classes="fuelchip celltoggle" Content="{Binding KindText}"
                                Command="{Binding ToggleKindCommand}"
                                Foreground="{Binding KindChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                                BorderBrush="{Binding KindChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                ToolTip.Tip="زدنش این ردیف را بردگی ⇄ ماندگی می‌کند" />
                      </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="نام"   Binding="{Binding Title}"  Width="Auto" />
        <DataGridTextColumn Header="مبلغ"  Binding="{Binding AmountText}" Width="Auto" />
        <DataGridTemplateColumn Header="واحد" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو-سه گزینه، ‎ComboBox‎ یک قالبِ کامل با
                         ‎Popup‎ی خودش می‌ساخت — و ‎ledgerperf‎ گرفتش: نزدیک به چهل درصدِ
                         وقتِ باز شدنِ گاوصندوقِ ۲۰۰ ردیفی مالِ همین ستون‌ها بود. خواستهٔ
                         صاحب ریپو هم همین بود: «اون علامتِ ▾ فقط جا گرفته» و «با تب یا
                         اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ ‎celltoggle‎ را می‌زند. -->
                      <DataTemplate>
                        <Button Classes="fuelchip celltoggle" Content="{Binding CurrencyText}"
                                Command="{Binding ToggleCurrencyCommand}"
                                Foreground="{Binding CurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                                BorderBrush="{Binding CurrencyChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                                ToolTip.Tip="زدنش واحد را افغانی ⇄ دالر می‌کند" />
                      </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" />
      </DataGrid.Columns>
    </c:ExcelGrid>
    <c:TotalsBar Grid.Row="1" ItemsSource="{Binding TotalCells}" IsVisible="{Binding HasTotals}" />
    </Grid>
  </c:SectionPage>
</UserControl>
