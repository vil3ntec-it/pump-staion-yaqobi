<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.SafeSectionView"
             x:DataType="vm:SafeSectionViewModel">

  <c:SectionPage Header="گاوصندوق" SubHeader="بردگی و ماندگی — افغانی و دالر هرگز با هم جمع نمی‌شوند">

    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <!-- «🗓️ ماه جدید» — همتای ‎addChakanaMonth()‎ی سایت: جدولِ ماهِ بعد
             را باز می‌کند. بی این، ماهی که هنوز ردیفی ندارد در کشویی نیست. -->
        <Button Classes="ghost info" Content="📅 ماه جدید" Margin="0,0,6,0"
                Command="{Binding NewMonthCommand}"
                ToolTip.Tip="جدولِ ماهِ بعد را باز می‌کند" />
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" />
        <Button Classes="ghost" Content="📅 ماه بعد" Margin="0,0,6,0" />
        <Button Classes="ghost info" Content="📄 PDF این ماه" Margin="0,0,6,0"
                Command="{Binding PdfCommand}" />
        <Button Classes="accent" Content="+ ردیف" Command="{Binding AddRowCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
        <!-- ══ کشویِ «سال» + «ماه» — همتای ‎_ymSelectsHtml‎ی سایت ═══════════════
             گزارشِ صاحب ریپو: «کادرِ کشویی سال هم نیست.» هیچ بخشی نداشت و همهٔ
             ماه‌های همهٔ سال‌ها در یک فهرستِ بلند بودند.
             با انتخابِ هر سال، فقط ماه‌های همان سال در کشویِ ماه می‌آیند.
             ⚠️ آن‌چه دیده می‌شود برچسبِ خوانا است («سنبله ۱۴۰۵»)، نه کلیدِ
             خامِ «1405/06» که تا امروز نشان داده می‌شد. -->
        <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                  IsVisible="{Binding Picker.HasYears}" MinWidth="110" />
        <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                  MinWidth="140" />
      </StackPanel>
    </c:SectionPage.Filters>

    <c:SectionPage.Summary>
      <Grid ColumnDefinitions="*,12,*,12,*">
        <Border Grid.Column="0" Classes="stat" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="🏛️ جمله ماندگی" Classes="label" />
            <TextBlock Text="{Binding MandagiAfn, StringFormat={}{0} افغانی}" Classes="num"
                       Foreground="{DynamicResource Pump.Info}" />
            <TextBlock Text="{Binding MandagiUsd, StringFormat={}{0} دالر}" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="stat" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="💵 جمله بردگی" Classes="label" />
            <TextBlock Text="{Binding BardagiAfn, StringFormat={}{0} افغانی}" Classes="num"
                       Foreground="{DynamicResource Pump.Ok}" />
            <TextBlock Text="{Binding BardagiUsd, StringFormat={}{0} دالر}" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Classes="stat" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="🏦 موجودی خالص" Classes="label" />
            <TextBlock Text="{Binding NetAfn, StringFormat={}{0} افغانی}" Classes="num" />
            <TextBlock Text="{Binding NetUsd, StringFormat={}{0} دالر}" Classes="muted" />
          </StackPanel>
        </Border>
      </Grid>
    </c:SectionPage.Summary>

    <!-- جدول + ردیفِ «جمله»ی ته آن — همتای ‎<tfoot class="xls-foot">‎ی سایت -->
    <Grid RowDefinitions="*,Auto">
    <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Rows}" GrowsOnEnter="True" x:CompileBindings="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="تاریخ"  Binding="{Binding DateShamsi}" Width="Auto" />
        <DataGridTemplateColumn Header="نوع" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SafeRowViewModel">
            <!-- ⚠️ کشویی همیشه پیداست و رشته می‌دهد، نه ‎ComboBoxItem‎.
                 دو باگ با هم بود:
                 ۱) با بچه‌های ‎ComboBoxItem‎، ‎SelectedItem‎ یک **شیء** است نه
                    رشته — پس نه سرِ بار مقدار می‌نشست و نه انتخابِ کاربر
                    برمی‌گشت («خودبه‌خود عوض می‌شود»).
                 ۲) داخلِ ‎CellEditingTemplate‎ بود، پس مقدارِ فعلی دیده نمی‌شد
                    و هر تغییر دو کلیک می‌خواست. در سایت این کادر
                    ‎<select class="xls-in">‎ی همیشه‌پیداست که ‎onchange‎ فوراً
                    ثبت می‌کند. -->
              <ComboBox ItemsSource="{Binding KindOptions}"
                        SelectedItem="{Binding KindText}"
                        Margin="4,1" MinHeight="0" Padding="7,2" FontSize="14" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="نام"   Binding="{Binding Title}"  Width="Auto" MinWidth="150" MaxWidth="320" />
        <DataGridTextColumn Header="مبلغ"  Binding="{Binding AmountText}" Width="Auto" />
        <DataGridTemplateColumn Header="واحد" Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SafeRowViewModel">
            <!-- ⚠️ کشویی همیشه پیداست و رشته می‌دهد، نه ‎ComboBoxItem‎.
                 دو باگ با هم بود:
                 ۱) با بچه‌های ‎ComboBoxItem‎، ‎SelectedItem‎ یک **شیء** است نه
                    رشته — پس نه سرِ بار مقدار می‌نشست و نه انتخابِ کاربر
                    برمی‌گشت («خودبه‌خود عوض می‌شود»).
                 ۲) داخلِ ‎CellEditingTemplate‎ بود، پس مقدارِ فعلی دیده نمی‌شد
                    و هر تغییر دو کلیک می‌خواست. در سایت این کادر
                    ‎<select class="xls-in">‎ی همیشه‌پیداست که ‎onchange‎ فوراً
                    ثبت می‌کند. -->
              <ComboBox ItemsSource="{Binding CurrencyOptions}"
                        SelectedItem="{Binding CurrencyText}"
                        Margin="4,1" MinHeight="0" Padding="7,2" FontSize="14" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" />
        <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SafeRowViewModel">
              <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                      Command="{Binding $parent[UserControl].DataContext.DeleteRowCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </c:ExcelGrid>
    <c:TotalsBar Grid.Row="1" ItemsSource="{Binding TotalCells}" IsVisible="{Binding HasTotals}" />
    </Grid>
  </c:SectionPage>
</UserControl>
