<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:th="using:PumpYaqobi.App.Themes"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.SettingsSectionView"
             x:DataType="vm:SettingsSectionViewModel">

  <c:SectionPage Header="تنظیمات">

    <c:SectionPage.Toolbar>
      <Button Classes="accent" Content="💾 ذخیرهٔ تنظیمات" Command="{Binding SaveCommand}" />
    </c:SectionPage.Toolbar>

          <StackPanel Spacing="14">

        <!-- مشخصاتِ پمپ -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="⛽ مشخصاتِ پمپ" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <UniformGrid Rows="1" Classes="stats" Margin="14">
              <StackPanel Classes="cell">
                <TextBlock Text="نامِ پمپ" Classes="label" />
                <TextBox Text="{Binding StationName}" />
              </StackPanel>
              <StackPanel Classes="cell">
                <TextBlock Text="آدرس" Classes="label" />
                <TextBox Text="{Binding StationAddress}" />
              </StackPanel>
              <StackPanel Classes="cell">
                <TextBlock Text="شمارهٔ تماس" Classes="label" />
                <TextBox Text="{Binding StationPhone}" />
              </StackPanel>
            </UniformGrid>

            <!-- ⚠️ دو نشانیِ **جدا**. در نسخهٔ وب هم جدا بودند و یکی گرفتنشان
                 همان اشتباهی است که کیو‌آر را از کار می‌اندازد:
                   • سرورِ داده  = جایی که برنامه داده می‌گیرد و می‌فرستد
                     (همتای SELF_HOST_URL؛ وب‌سوکت).
                   • صفحهٔ حساب = جایی که index.html سِرو می‌شود. کیو‌آر از
                     همین ساخته می‌شود، چون گوشیِ مشتری یک **صفحه** باز می‌کند
                     نه یک سرورِ داده. -->
            <StackPanel Margin="14,0,14,14" Spacing="10">
              <StackPanel Spacing="5">
                <TextBlock Text="🔄 نشانیِ سرورِ هم‌گام‌سازی (داده)" Classes="label" />
                <TextBox Text="{Binding ServerUrl}" Watermark="wss://api.example.com"
                         ToolTip.Tip="سرورِ خانگیِ خودتان. همین در لینکِ کیو‌آر هم می‌رود تا گوشیِ مشتری بداند به کجا وصل شود." />
              </StackPanel>

              <StackPanel Spacing="5">
                <TextBlock Text="🔑 رمزِ سرور (اگر دارد)" Classes="label" />
                <TextBox Text="{Binding SyncCode}" Watermark="خالی بگذارید اگر رمز ندارد" />
              </StackPanel>

              <StackPanel Spacing="5">
                <TextBlock Text="🌐 نشانیِ صفحهٔ حساب (برای کیو‌آر)" Classes="label" />
                <TextBox Text="{Binding ViewerUrl}" Watermark="https://pump.example.com"
                         ToolTip.Tip="جایی که index.html سِرو می‌شود. کیو‌آرِ هر قرض‌دار از این ساخته می‌شود." />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="⚠️ این با نشانیِ بالا یکی نیست. کد را به مشتری می‌دهید، اسکن می‌کند، گوشی‌اش این صفحه را باز می‌کند و صفحه خودش داده را از سرورِ بالا می‌گیرد. نشانیِ سرور و رمز هم خودکار داخلِ همان کیو‌آر می‌روند، وگرنه گوشیِ مشتری نمی‌داند به کجا وصل شود. اگر این کادر خالی بماند، کیو‌آر ساخته نمی‌شود." />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- نرخ‌ها -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="📈 نرخِ اتحادیه و آستانه‌ها" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <UniformGrid Rows="1" Classes="stats" Margin="14">
              <StackPanel Classes="cell">
                <TextBlock Text="نرخِ اتحادیه — پطرول" Classes="label" />
                <TextBox Text="{Binding UnionRatePetrol}" />
              </StackPanel>
              <StackPanel Classes="cell">
                <TextBlock Text="نرخِ اتحادیه — دیزل" Classes="label" />
                <TextBox Text="{Binding UnionRateDiesel}" />
              </StackPanel>
              <StackPanel Classes="cell">
                <TextBlock Text="آستانهٔ هشدارِ مخزن (لیتر)" Classes="label" />
                <TextBox Text="{Binding LowStockThreshold}" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- ظاهر -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="🎨 ظاهرِ برنامه" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <StackPanel Margin="14" Spacing="6" HorizontalAlignment="Right">
              <TextBlock Text="تم" Classes="label" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinWidth="240">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="th:PumpTheme">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="7"
                              Background="{Binding Accent, Converter={x:Static th:ColorToBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="چهار تم — نه بیشتر. «نور پس‌زمینه» برداشته شده است."
                         Classes="muted" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ══ ظاهرِ جدول‌ها ═══════════════════════════════════════════════
             خواستهٔ صریحِ صاحب ریپو: رنگ و ضخامتِ خطِ جدول جای سفت و سختِ
             داخلِ کد نباشد؛ همین‌جا باشد و روی همهٔ جدول‌های برنامه بنشیند.
             هر تغییری همان لحظه اعمال و ذخیره می‌شود. -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="🧾 ظاهرِ جدول‌ها" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <StackPanel Margin="14" Spacing="10">

              <StackPanel Spacing="6">
                <TextBlock Text="رنگِ خطِ جدول" Classes="label" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="34" Height="34" CornerRadius="8"
                          BorderThickness="1" BorderBrush="{DynamicResource Pump.Border}"
                          Background="{DynamicResource Pump.Table.Border}" />
                  <TextBox Text="{Binding TableBorderColor}" Width="150" Watermark="#3b4252" />
                  <Button Content="رنگِ تم" Command="{Binding UseThemeTableColorCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding TableColorNote}" Classes="muted" />
              </StackPanel>

              <UniformGrid Rows="1" Classes="stats">
                <StackPanel Classes="cell">
                  <TextBlock Text="ضخامتِ خطِ خانه‌ها" Classes="label" />
                  <ComboBox ItemsSource="{Binding LineSizes}" SelectedItem="{Binding TableLine}"
                            MinWidth="110" />
                </StackPanel>
                <StackPanel Classes="cell">
                  <TextBlock Text="ضخامتِ خطِ سربرگ" Classes="label" />
                  <ComboBox ItemsSource="{Binding LineSizes}" SelectedItem="{Binding TableHeadLine}"
                            MinWidth="110" />
                </StackPanel>
                <StackPanel Classes="cell">
                  <TextBlock Text="ضخامتِ خطِ ردیفِ جمله" Classes="label" />
                  <ComboBox ItemsSource="{Binding LineSizes}" SelectedItem="{Binding TableSumLine}"
                            MinWidth="110" />
                </StackPanel>
              </UniformGrid>

              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="این رنگ و ضخامت روی همهٔ جدول‌های برنامه می‌نشیند — خطِ افقی، خطِ عمودی، مرزِ خانه، مرزِ سربرگ و مرزِ ردیفِ «جمله». برای برگشتن به حالتِ اولیه: رنگ را خالی بگذارید و ضخامت‌ها را ۱ و ۲ و ۲ کنید." />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- به‌روزرسانی — بدونِ هیچ نشانی یا نامِ منبع -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="⬇️ به‌روزرسانیِ برنامه" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <StackPanel Margin="14" Spacing="10">
              <TextBlock Text="{Binding CurrentVersion, StringFormat=نسخهٔ فعلی: {0}}" />

              <!-- کجا نصب است و آیا خودش می‌تواند خودش را عوض کند -->
              <TextBlock Text="{Binding InstallDir, StringFormat=پوشهٔ نصب: {0}}" Classes="muted"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding InstallNote}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding InstallNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource Pump.Warn}" />

              <TextBlock Text="{Binding UpdateStatus}" Classes="muted"
                         IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- «به‌روزرسانیِ کوچک — ۲٫۱ مگابایت» یا «بستهٔ کامل — ۵۷ مگابایت» -->
              <TextBlock Text="{Binding PackageText}" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Ok}"
                         IsVisible="{Binding PackageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <!-- نتیجهٔ به‌روزرسانیِ دفعهٔ پیش — هر دو حالت گفته می‌شود.
                   «هیچ نگفتن» بدترین حالت بود: کاربر خیال می‌کرد به‌روز شده. -->
              <TextBlock Text="{Binding LastSuccess}" TextWrapping="Wrap" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Ok}"
                         IsVisible="{Binding LastSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <TextBlock Text="{Binding LastFailure}" TextWrapping="Wrap"
                         Foreground="{DynamicResource Pump.Danger}"
                         IsVisible="{Binding LastFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" Height="7"
                           IsVisible="{Binding Downloading}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="بررسیِ به‌روزرسانی" Command="{Binding CheckUpdateCommand}"
                        IsEnabled="{Binding !Checking}" />
                <Button Classes="accent" Content="گرفتنِ نسخهٔ تازه"
                        Command="{Binding DownloadUpdateCommand}"
                        IsVisible="{Binding UpdateAvailable}" IsEnabled="{Binding !Downloading}" />
                <Button Classes="accent" Content="نصب و راه‌اندازیِ دوباره"
                        Command="{Binding InstallUpdateCommand}"
                        IsVisible="{Binding ReadyToInstall}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ══ آوردنِ دادهٔ نسخهٔ وب ══════════════════════════════════════════
             سه ماه حسابِ کاربر در نسخهٔ وب است؛ بی این دکمه، برنامهٔ نیتیو
             برایش خالی است. -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="📥 آوردنِ حساب‌ها از نسخهٔ وب" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <StackPanel Margin="14" Spacing="9">
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="در نسخهٔ وب «دانلودِ بکاپ» را بزنید و فایلِ pump-backup-….json را این‌جا بدهید. پیش از هر نوشتنی یک بکاپِ کامل از دادهٔ فعلی گرفته می‌شود، و اگر شمارشِ رکوردها نخواند هیچ چیزی نوشته نمی‌شود." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="📂 انتخابِ فایلِ بکاپ"
                        Command="{Binding ImportLegacyCommand}"
                        IsEnabled="{Binding !ImportBusy}" />
              </StackPanel>
              <TextBlock Text="{Binding ImportStatus}" TextWrapping="Wrap" Classes="muted"
                         IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    
  </c:SectionPage>
</UserControl>
