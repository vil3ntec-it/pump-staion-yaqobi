<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.StaffShortSectionView"
             x:DataType="vm:StaffShortSectionViewModel">

  <c:SectionPage Header="کمبودی و اضافیِ کارمندان"
                 SubHeader="از خودِ ورق‌های روزانه — به هیچ ورقی دست زده نمی‌شود">

    <!-- ⛔ (۱۴۰۵/۰۷/۱۸) کشوی سال و ماه: فقط ورق‌ها و رسیدهای همان دوره — دوره‌ها قاطی نمی‌شوند -->
    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="دوره" Classes="label" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Picker.Years}" SelectedItem="{Binding Picker.Year}"
                  IsVisible="{Binding Picker.HasYears}"
                  c:PickerWidth.Stable="True" ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="120" />
        <ComboBox ItemsSource="{Binding Picker.Months}" SelectedItem="{Binding Picker.Selected}"
                  c:PickerWidth.Stable="True" ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="160" />
      </StackPanel>
    </c:SectionPage.Filters>

    <c:SectionPage.Toolbar>
      <Button Classes="ghost info" Content="PDF" Command="{Binding PdfCommand}" />
    </c:SectionPage.Toolbar>

    <StackPanel Spacing="10">

      <!-- راهنمای واضح: کاربر باید بداند با هر کدام چه کند -->
      <c:AutoFillPanel MinItemWidth="330" Gap="8">
        <Border Classes="panel" Padding="10,8">
          <StackPanel Spacing="3">
            <TextBlock Text="🔴 کمبودی = کارمند بدهکار است" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Danger}" />
            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="پول کم آورده — با «💵 رسید کمبودی» مبلغی که از او می‌گیرید را ثبت کنید تا باقی‌مانده کم شود." />
          </StackPanel>
        </Border>
        <Border Classes="panel" Padding="10,8">
          <StackPanel Spacing="3">
            <TextBlock Text="🟢 اضافی = پمپ بدهکار است" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Ok}" />
            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="پول زیاد داده — با «💸 پرداخت اضافی» مبلغی که به او برمی‌گردانید را ثبت کنید." />
          </StackPanel>
        </Border>
      </c:AutoFillPanel>

      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Classes="card-head">
            <TextBlock Text="کارمندان" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>

          <c:ExcelGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                       x:CompileBindings="False" IsReadOnly="True"
                       BorderThickness="0" CornerRadius="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="کارمند" Binding="{Binding Name}" Width="Auto" />
              <DataGridTextColumn Header="شیفت" Binding="{Binding ShiftsText}" Width="Auto" />
              <DataGridTemplateColumn Header="🔴 کمبودیِ مانده" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ShortText}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding ShortBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="🟢 اضافیِ مانده" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ExcessText}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding ExcessBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="عمل" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="ghost danger" Content="رسید کمبودی" Padding="8,3" FontSize="11"
                              IsVisible="{Binding CanSettleShort}"
                              Command="{Binding $parent[UserControl].DataContext.PickShortCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="ghost" Content="پرداخت اضافی" Padding="8,3" FontSize="11"
                              IsVisible="{Binding CanSettleExcess}"
                              Command="{Binding $parent[UserControl].DataContext.PickExcessCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Text="✅ تسویه شد" VerticalAlignment="Center" FontWeight="Bold"
                                 IsVisible="{Binding IsSettled}"
                                 Foreground="{DynamicResource Pump.Ink.Ok}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>

          <!-- ردیفِ «جمله» — همان نوارِ یکسانِ همهٔ جدول‌های برنامه -->
          <c:TotalsBar Grid.Row="2" ItemsSource="{Binding TotalCells}" />
        </Grid>
      </Border>

      <TextBlock Text="هنوز ورقی با کمبودی/اضافی ثبت نشده" Classes="label"
                 IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,10" />

      <!-- ثبتِ تسویه — می‌گوید برای کیست، کدام دوره و چقدر مانده (۱۴۰۵/۰۷/۱۸) -->
      <Border Classes="panel" Padding="12,10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SelectedTitle}" FontWeight="Bold" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="مبلغ:" Classes="label" VerticalAlignment="Center" />
            <TextBox x:Name="AmountBox" Text="{Binding Amount}" Width="130" HorizontalContentAlignment="Center" c:LiveFormat.Kind="number" />
            <Button Classes="danger" Content="رسید کمبودی گرفتم"
                    Command="{Binding SettleShortCommand}" />
            <Button Classes="accent" Content="اضافی را پرداخت کردم"
                    Command="{Binding SettleExcessCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- سهمِ هر ورق برای کارمندِ انتخاب‌شده — تاریخ، شیفت، دلیل و مبلغ -->
      <Border Classes="panel" Padding="12,10" IsVisible="{Binding HasSelected}">
        <StackPanel Spacing="6">
          <TextBlock Text="📋 از کجا آمد — ورق‌های همین کارمند در همین دوره" FontWeight="Bold"
                     Foreground="{DynamicResource Pump.Ink.Accent}" />
          <ItemsControl ItemsSource="{Binding SelectedLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StaffShortLineViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                  <TextBlock Grid.Column="1" Text="{Binding Reason}" Classes="muted" FontSize="12" Margin="12,0"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="Bold" FontSize="12.5"
                             Foreground="{Binding BrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- دفترِ تسویه‌ها -->
      <Border Classes="panel" Padding="0" IsVisible="{Binding HasSettles}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="card-head">
            <TextBlock Text="🧾 رسیدها و پرداخت‌های ثبت‌شده" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Ink.Accent}" />
          </Border>
          <c:ExcelGrid Grid.Row="1" ItemsSource="{Binding Settles}" x:CompileBindings="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0"
                      RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteSettleCommand}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="کارمند" Binding="{Binding Name}" Width="Auto" />
              <DataGridTemplateColumn Header="نوع" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding KindText}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding KindBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="Auto" />
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
              <DataGridTextColumn Header="دوره" Binding="{Binding ForText}" Width="Auto" />
              <DataGridTemplateColumn Header="رسید" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Classes="ghost info" Content="🧾 چاپ" Padding="8,3" FontSize="11"
                            Command="{Binding $parent[UserControl].DataContext.ReceiptCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>
        </Grid>
      </Border>
    </StackPanel>
  </c:SectionPage>
</UserControl>
