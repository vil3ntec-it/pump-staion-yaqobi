<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.StorageSectionView"
             x:DataType="vm:StorageSectionViewModel">
  <Panel>

  <c:SectionPage Header="مخزن">

    <c:SectionPage.Toolbar>
      <Button Content="{Binding FuelToggleText}" Command="{Binding ToggleFuelCommand}" />
    </c:SectionPage.Toolbar>

          <StackPanel Spacing="14">

        <!-- ══ کارتِ مخزن با نوارِ پرشدگی ══ -->
        <Border Classes="panel" Padding="16">
          <Grid ColumnDefinitions="Auto,18,*">

            <!-- نوارِ عمودیِ پرشدگی -->
            <Border Grid.Column="0" Width="118" Height="196" CornerRadius="12"
                    Background="{DynamicResource Pump.Dark}"
                    BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="1"
                    ClipToBounds="True">
              <Grid>
                <Border VerticalAlignment="Bottom" Background="{DynamicResource Pump.AccentGrad}"
                        Height="{Binding FillPercent, Converter={x:Static vm:PercentToHeightConverter.Instance}}" />
                <TextBlock Text="{Binding FillText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Pump.Text}" />
                <TextBlock Text="{Binding ThresholdText}" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Margin="0,0,0,7" FontSize="10"
                           Foreground="{DynamicResource Pump.OnAccent}" Opacity="0.8" />
              </Grid>
            </Border>

            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Text="{Binding TankTitle}" Classes="h2"
                         Foreground="{DynamicResource Pump.Accent}" />
              <TextBlock Text="{Binding Current}" FontSize="40" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
              <TextBlock Text="لیتر باقی‌مانده" Classes="muted" />
              <Border CornerRadius="9" Padding="10,4" HorizontalAlignment="Right" Margin="0,4,0,0"
                      Background="{DynamicResource Pump.Panel}"
                      BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="1">
                <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" />
              </Border>

              <!-- سه عددِ مخزن، پخش‌شده در تمامِ عرضِ کارت. پیش از این کنارِ
                   هم و چسبیده به راست بودند و وسطِ کارت خالی می‌ماند. -->
              <UniformGrid Rows="1" Classes="stats" Margin="0,10,0,0">
                <StackPanel Spacing="1" Margin="6,0">
                  <TextBlock Text="جمله ورودی" Classes="label" FontSize="11" />
                  <TextBlock Text="{Binding TotalIn, StringFormat={}{0} لیتر}" FontWeight="Bold"
                             Foreground="{DynamicResource Pump.Ok}" />
                </StackPanel>
                <StackPanel Spacing="1" Margin="6,0">
                  <TextBlock Text="جمله فروش" Classes="label" FontSize="11" />
                  <TextBlock Text="{Binding TotalOut, StringFormat={}{0} لیتر}" FontWeight="Bold"
                             Foreground="{DynamicResource Pump.Danger}" />
                </StackPanel>
                <StackPanel Spacing="1" Margin="6,0">
                  <TextBlock Text="ظرفیت مخزن (لیتر)" Classes="label" FontSize="11" />
                  <TextBox Text="{Binding Capacity}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </UniformGrid>

              <!-- «🕘 تاریخچهٔ خریدهای مخزن» برداشته شد: هیچ فرمانی نداشت و
                   خودِ فهرستِ خریدها همین پایین است. «ثبت خرید» حالا پنجرهٔ
                   کوچکِ سایت را باز می‌کند، نه یک ردیفِ خالی. -->
              <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="📏 ثبتِ میله‌زنی" Margin="0,0,8,8" Command="{Binding AddDipCommand}" />
                <Button Content="{Binding PdfText}" Margin="0,0,8,8" Command="{Binding PdfCommand}" />
                <Button Classes="accent" Content="{Binding AddBuyText}" Margin="0,0,8,8"
                        Command="{Binding OpenBuyCommand}" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ══ خلاصه پول‌ها ══ -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <TextBlock Text="{Binding MoneyTitle}" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>
            <UniformGrid Rows="1" Classes="stats" Margin="14">
              <Border Classes="stat" Margin="0,0,12,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="جمله کل (دالر)" Classes="label" />
                  <TextBlock Text="{Binding TotalUsd, StringFormat=$ {0}}" Classes="num" />
                </StackPanel>
              </Border>
              <Border Classes="stat" Margin="0,0,12,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="جمله کل (افغانی)" Classes="label" />
                  <TextBlock Text="{Binding TotalAfn}" Classes="num" />
                </StackPanel>
              </Border>
              <Border Classes="stat">
                <StackPanel Spacing="3">
                  <TextBlock Text="فی لیتر خرید (افغانی)" Classes="label" />
                  <TextBlock Text="{Binding PerLiter}" Classes="num" />
                  <TextBlock Text="{Binding LastBuyDate, StringFormat=آخرین خرید: {0}}" Classes="muted" />
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- ══ خریدها — هر خرید یک کارت، مثلِ خودِ برنامه ══ -->
        <ItemsControl ItemsSource="{Binding Purchases}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PurchaseRowViewModel">
              <Border Classes="panel" Margin="0,0,0,12" Padding="0">
                <StackPanel>
                  <Border Classes="card-head">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding HeadText}" FontWeight="Bold"
                                   Foreground="{DynamicResource Pump.Accent}" />
                        <TextBlock Text="{Binding DateShamsi, StringFormat=📅 {0}}" Classes="muted" />
                        <TextBlock Text="{Binding Seller, StringFormat=👤 {0}}"
                                   Foreground="{DynamicResource Pump.Info}" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="ghost danger" Content="🗑" Padding="9,2"
                              Command="{Binding $parent[ItemsControl].((vm:StorageSectionViewModel)DataContext).DeletePurchaseCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>

                  <!-- ══ ‎.pu-stats‎ — نُه کادرِ خواندنیِ سایت ═══════════════
                       گزارشِ صاحب ریپو: «ببین خریدها را این مدلی نشان می‌دهد با
                       همهٔ جزئیاتش.» در سایت هر خرید یک کارتِ **خواندنی** است،
                       نه نُه کادرِ تایپی. ویرایشِ خرید هم در سایت نیست: خریدِ
                       اشتباه پاک می‌شود و دوباره ثبت. -->
                  <c:AutoFillPanel MinItemWidth="150" Gap="8" Margin="14">
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="وزن (کگ)" Classes="label" />
                        <TextBlock Text="{Binding KgText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="وزن (تن)" Classes="label" />
                        <TextBlock Text="{Binding TonText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Info}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="ثقلت" Classes="label" />
                        <TextBlock Text="{Binding DensityText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="لیتر" Classes="label" />
                        <TextBlock Text="{Binding LitersText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Ok}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="فی تن ($)" Classes="label" />
                        <TextBlock Text="{Binding PriceTonText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="نرخ دالر" Classes="label" />
                        <TextBlock Text="{Binding UsdRateText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="کل (دالر)" Classes="label" />
                        <TextBlock Text="{Binding TotalUsdText, StringFormat={}{0} $}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Info}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="کل (افغانی)" Classes="label" />
                        <TextBlock Text="{Binding TotalAfnText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Accent}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="فی لیتر (افغانی)" Classes="label" />
                        <TextBlock Text="{Binding PerLiterText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Danger}" />
                      </StackPanel>
                    </Border>
                  </c:AutoFillPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ══ میله‌زنیِ مخزن ══ -->
        <Border Classes="panel" Padding="0" MinHeight="240">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Classes="card-head">
              <TextBlock Text="📏 میله‌زنیِ مخزن" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Accent}" />
            </Border>

            <!-- ══ محاسبهٔ زنده ══════════════════════════════════════════════
                 همان کاری که ‎dipLiveCalc‎ می‌کرد: کاربر هنوز چیزی ثبت نکرده،
                 ولی همان لحظه می‌بیند مخزن چقدر پر است، چقدر جا دارد، و چقدر
                 با دفتر فرق دارد. اگر فرق از حدِ مجاز بگذرد، هشدارِ قرمز. -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="14,12">
              <WrapPanel Orientation="Horizontal">
                <StackPanel Spacing="3" Width="150" Margin="0,0,10,6">
                  <TextBlock Text="لیترِ میله‌زنی" Classes="label" />
                  <TextBox Text="{Binding DipMeasured}" Watermark="0" />
                </StackPanel>
                <StackPanel Spacing="3" Width="150" Margin="0,0,10,6">
                  <TextBlock Text="موجودی دفتری" Classes="label" />
                  <TextBlock Text="{Binding TankBookText}" FontWeight="Bold" Margin="0,6,0,0"
                             Foreground="{DynamicResource Pump.Info}" />
                </StackPanel>
                <StackPanel Spacing="3" Width="170" Margin="0,0,10,6">
                  <TextBlock Text="ظرفیت کل" Classes="label" />
                  <TextBlock Text="{Binding TankCapacityText}" FontWeight="Bold" Margin="0,6,0,0"
                             Foreground="{DynamicResource Pump.Accent}" />
                </StackPanel>
                <StackPanel Spacing="3" Width="120" Margin="0,0,10,6" IsVisible="{Binding DipHasValue}">
                  <TextBlock Text="درصد پر بودن" Classes="label" />
                  <TextBlock Text="{Binding DipPercentText}" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Spacing="3" Width="170" Margin="0,0,10,6" IsVisible="{Binding DipHasValue}">
                  <TextBlock Text="🚚 قابل دریافت از تانکر" Classes="label" />
                  <TextBlock Text="{Binding DipEmptyText}" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Spacing="3" Width="150" Margin="0,0,10,6" IsVisible="{Binding DipHasValue}">
                  <TextBlock Text="اختلاف با دفتر" Classes="label" />
                  <TextBlock Text="{Binding DipDiffText}" FontWeight="Bold" Margin="0,6,0,0"
                             Foreground="{Binding DipDiffBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                </StackPanel>
                <StackPanel Spacing="3" Width="190" Margin="0,0,10,6">
                  <TextBlock Text=" " Classes="label" />
                  <CheckBox Content="دفتر برابرِ عددِ واقعی شود"
                            IsChecked="{Binding DipApplyToBook}" />
                </StackPanel>
              </WrapPanel>

              <TextBlock Text="{Binding DipWarnText}" TextWrapping="Wrap" FontWeight="Bold"
                         IsVisible="{Binding DipWarnVisible}"
                         Foreground="{DynamicResource Pump.Danger}" />
            </StackPanel>

            <c:ExcelGrid Grid.Row="2" ItemsSource="{Binding Dips}" x:CompileBindings="False"
                         BorderThickness="0" CornerRadius="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
                <DataGridTextColumn Header="اندازهٔ واقعی" Binding="{Binding MeasuredText}" Width="Auto" />
                <DataGridTextColumn Header="اندازهٔ دفتری" Binding="{Binding ExpectedText}" Width="Auto" />
                <DataGridTextColumn Header="اختلاف" Binding="{Binding DiffText}" Width="Auto" IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="دفتر برابر شود" Binding="{Binding ApplyToBook}" Width="Auto" />
                <DataGridTextColumn Header="رفته به دفتر" Binding="{Binding BookAdjustText}" Width="Auto" IsReadOnly="True" />
                <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" MinWidth="150" MaxWidth="320" />
                <DataGridTemplateColumn Header="" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                              Command="{Binding $parent[UserControl].DataContext.DeleteDipCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </c:ExcelGrid>

            <!-- ردیفِ «جمله»ی اندازه‌گیری‌ها -->
            <c:TotalsBar Grid.Row="3" ItemsSource="{Binding DipTotalCells}" />
          </Grid>
        </Border>
      </StackPanel>
    
  </c:SectionPage>

  <!-- ══════════════════════════════════════════════════════════════════════
       🛢️ پنجرهٔ «ثبت خرید» — ‎#addPurchaseModal‎
       صفحهٔ نسبتاً کوچکی که روی بخش می‌نشیند: بالا کادرهای تایپی، پایین
       عددهایی که همان لحظه حساب می‌شوند، و دو دکمه. تا هر چهار عددِ لازم پر
       نشوند، «ذخیره» چیزی ثبت نمی‌کند.
       ══════════════════════════════════════════════════════════════════ -->
  <Panel IsVisible="{Binding BuyOpen}" Background="#99000000">
    <Border Width="620" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
            CornerRadius="16" Padding="0" Background="{DynamicResource Pump.Card}"
            BorderBrush="{DynamicResource Pump.Accent}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="card-head">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding BuyTitle}" Classes="card-title"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost danger" Content="✕" Padding="10,2"
                    Command="{Binding CancelBuyCommand}" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="16">
          <StackPanel Spacing="12">

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="تاریخ" Classes="label" />
                <TextBox Text="{Binding BuyDate}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="نام فروشنده" Classes="label" />
                <TextBox Text="{Binding BuySeller}" Watermark="نام فروشنده"
                         ToolTip.Tip="خرید خودکار در حسابِ شرکتِ هم‌نامِ فروشنده هم ثبت می‌شود" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="وزن (کیلوگرم)" Classes="label" />
                <TextBox Text="{Binding BuyKg}" Watermark="مثلاً 5320" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="ثقلت (چگالی)" Classes="label" />
                <TextBox Text="{Binding BuyDensity}" Watermark="مثلاً 0.73" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="قیمت هر تن (دالر)" Classes="label" />
                <TextBox Text="{Binding BuyPriceTon}" Watermark="مثلاً 1200" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="نرخ دالر (افغانی)" Classes="label" />
                <TextBox Text="{Binding BuyUsdRate}" Watermark="مثلاً 65" />
              </StackPanel>
            </Grid>

            <!-- عددهای خودکار — همان ‎pu-r-*‎ی سایت -->
            <Border Classes="panel" Padding="14">
              <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,10">
                  <TextBlock Text="وزن به تن" Classes="label" />
                  <TextBlock Text="{Binding BuyTonText}" FontWeight="ExtraBold"
                             Foreground="{DynamicResource Pump.Info}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2" Margin="0,0,0,10">
                  <TextBlock Text="مقدار لیتر" Classes="label" />
                  <TextBlock Text="{Binding BuyLitersText}" FontWeight="ExtraBold"
                             Foreground="{DynamicResource Pump.Ok}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,0,10">
                  <TextBlock Text="پول کل (دالر)" Classes="label" />
                  <TextBlock Text="{Binding BuyUsdText}" FontWeight="ExtraBold"
                             Foreground="{DynamicResource Pump.Info}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="0,0,0,10">
                  <TextBlock Text="پول کل (افغانی)" Classes="label" />
                  <TextBlock Text="{Binding BuyAfnText}" FontWeight="ExtraBold"
                             Foreground="{DynamicResource Pump.Accent}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                  <TextBlock Text="قیمت هر لیتر (افغانی)" Classes="label" />
                  <TextBlock Text="{Binding BuyPerLiterText}" FontWeight="ExtraBold"
                             Foreground="{DynamicResource Pump.Danger}" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Spacing="4">
              <TextBlock Text="یادداشت" Classes="label" />
              <TextBox Text="{Binding BuyNote}" Watermark="..." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Pump.ChromeBorder}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Classes="accent" Content="✔ ذخیره" MinWidth="120"
                    Command="{Binding SaveBuyCommand}" />
            <Button Content="انصراف" MinWidth="100" Command="{Binding CancelBuyCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Panel>
  </Panel>
</UserControl>
