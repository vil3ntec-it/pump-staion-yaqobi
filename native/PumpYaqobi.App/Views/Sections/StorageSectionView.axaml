<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.StorageSectionView"
             x:DataType="vm:StorageSectionViewModel">
  <!-- یک قد برای چهار خانهٔ زیرِ عددِ مخزن — دو کادرِ تایپ و دو کادرِ خواندنی -->
  <UserControl.Styles>
    <Style Selector="Border.tankcard">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.ChromeBorder}" />
    </Style>
    <Style Selector="Border.tankactive">
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Ok}" />
    </Style>
    <Style Selector="Border.tanklow">
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Danger}" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Ink.Danger}" />
    </Style>
    <Style Selector="TextBox.tankbox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.calc.tankbox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="9,0" />
    </Style>
  </UserControl.Styles>
  <Panel>

  <c:SectionPage Header="مخزن">

    <!-- ⚠️ ‎SectionPage.Toolbar‎ یک محتوا می‌گیرد، نه چند تا: دو فرزندِ
         برهنه ‎AVLN3000‎ می‌دهد. پس هر جا بیش از یکی شد، یک ‎WrapPanel‎. -->
    <c:SectionPage.Toolbar>
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0" Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}" ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
        <Button Content="{Binding FuelToggleText}" Command="{Binding ToggleFuelCommand}" />
      </WrapPanel>
    </c:SectionPage.Toolbar>

          <StackPanel Spacing="14">

        <!-- ══ کارتِ مخزن با نقشهٔ مخزن ══ -->
        <Border Classes="panel" Padding="16">
          <Grid ColumnDefinitions="Auto,18,*">

            <!-- ══ نقشهٔ مخزن — به‌جای نوارِ عمودیِ پرشدگی (۱۴۰۵/۰۷/۱۳) ══
                 خواستهٔ صریحِ صاحب ریپو با تصویر: «اون نشانه‌گرِ مخزن که الان تو
                 برنامه هست رو بردار و این مدلِ جدید رو براش بزار… این همه
                 ریزکارهاش باید باشن.» مخزنِ افقی با تیل، پروب، شناورِ تیل،
                 پمپِ غوطه‌ور و درصدِ پرشدگی وسطش — همه داخلِ ‎c:TankGauge‎.
                 ⛔ ‎WaterPercent‎ عمداً بسته نشده: آب فقط وقتی دیده می‌شود که
                 دستگاهِ فیزیکی اندازه‌اش را بدهد، نه با عددِ حدسی.
                 ⛔ نوارِ عمودی (‎PercentToHeightConverter‎) برنمی‌گردد.
                 ⚠️ رنگِ بدنه و نوشته‌ها از خودِ تم می‌آید؛ تیل و آب رنگِ
                 خودشان را دارند (نارنجی و آبی) و با تم عوض نمی‌شوند. -->
            <c:TankGauge Grid.Column="0" Width="400" Height="250" VerticalAlignment="Center"
                         FillPercent="{Binding FillPercent}" FillText="{Binding FillText}"
                         ThresholdPercent="{Binding ThresholdPercent}" CaptionText="{Binding ThresholdText}"
                         BodyBrush="{DynamicResource Pump.Card}" BodyDeepBrush="{DynamicResource Pump.Input}"
                         RimBrush="{DynamicResource Pump.ChromeBorder}"
                         LabelBrush="{DynamicResource Pump.Text}" TextBrush="{DynamicResource Pump.Text}"
                         ThresholdBrush="{DynamicResource Pump.Danger}"
                         ToolTip.Tip="سطحِ تیل از موجودی ÷ ظرفیت است و خطِ نقطه‌چین آستانهٔ هشدار؛ پروب، پمپ، شناورها و نوارِ آب نقشه‌اند، نه اندازه" />

            <StackPanel Grid.Column="2" Spacing="6">
              <!-- ══ عنوان، عددِ درشت و حالِ مخزن — وسطِ کارت (۱۴۰۵/۰۷/۱۳) ══
                   گزارشِ صاحب ریپو با عکس: «آن نوشته‌اش که وسط نیست». هر چهار
                   تا به لبهٔ راست چسبیده بودند و سه عددِ زیرشان وسطِ ستون‌هایشان؛
                   پس چشم دو ترازِ مختلف روی یک کارت می‌دید. حالا همه وسط‌اند. -->
              <TextBlock Text="{Binding TankTitle}" Classes="h2" TextAlignment="Center"
                         HorizontalAlignment="Stretch"
                         Foreground="{DynamicResource Pump.Ink.Accent}" />
              <TextBlock Text="{Binding Current}" FontSize="40" FontWeight="Bold" TextAlignment="Center"
                         HorizontalAlignment="Stretch"
                         Foreground="{DynamicResource Pump.Ink.Accent}" />
              <TextBlock Text="لیتر باقی‌مانده" Classes="muted" TextAlignment="Center"
                         HorizontalAlignment="Stretch" />
              <Border CornerRadius="9" Padding="10,4" HorizontalAlignment="Center" Margin="0,4,0,0"
                      Background="{DynamicResource Pump.Panel}"
                      BorderBrush="{DynamicResource Pump.ChromeBorder}" BorderThickness="1">
                <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" />
              </Border>

              <!-- سه عددِ مخزن، پخش‌شده در تمامِ عرضِ کارت. پیش از این کنارِ
                   هم و چسبیده به راست بودند و وسطِ کارت خالی می‌ماند. -->
              <!-- ⛔ چهار خانه، یک شکل (۱۴۰۵/۰۷/۱۳): «جمله ورودی و جمله فروش کادر
                   ندارند… با ظرفیت مخزن و آستانهٔ هشدار یکی نیستند؛ برای آن‌ها هم
                   کادر بده، فقط‌خواندنی.» پس دو جملهٔ حساب‌شده هم کادر دارند —
                   ‎Border.calc‎، همان کادرِ «خودکار»ِ فرمِ پارچه — هم‌قد و هم‌پهنای
                   دو کادرِ تایپ. ⚠️ فقط‌خواندنی می‌مانند: ‎TextBox‎ نیستند، پس هیچ
                   تایپی به ‎TotalIn‎/‎TotalOut‎ نمی‌رسد و هیچ منطقی عوض نشد. -->
              <!-- ══ دو ردیفِ دوتایی، نه یک ردیفِ چهارتایی (۱۴۰۵/۰۷/۱۳) ══
                   نقشهٔ مخزن پهن‌تر از نوارِ قدیمی است و ستونِ نوشته تنگ‌تر؛
                   خواستهٔ صاحب ریپو با کادرِ زرد: «دو کادرِ جمله ورودی و جمله
                   فروش برن زیرِ اون دو کادرِ دیگه». پس ردیفِ اول ظرفیت و آستانه
                   (دو کادرِ تایپ)، ردیفِ دوم دو جملهٔ حساب‌شده — هم‌پهنا و
                   هم‌قد و ستون‌به‌ستون زیرِ هم. ⚠️ ترتیبِ فرزندانِ ‎UniformGrid‎
                   همان ترتیبِ چیدن است: ردیفِ اول، بعد ردیفِ دوم. -->
              <UniformGrid Rows="2" Columns="2" Classes="stats" Margin="0,10,0,0">
                <StackPanel Spacing="4" Margin="6,0">
                  <TextBlock Text="ظرفیت مخزن (لیتر)" Classes="label" FontSize="11"
                             TextAlignment="Center" HorizontalAlignment="Stretch" />
                  <TextBox Classes="tankbox" Text="{Binding Capacity}" HorizontalAlignment="Stretch" c:LiveFormat.Kind="number" c:Spot.Id="tank-capacity" />
                </StackPanel>
                <!-- از «تنظیمات» به این‌جا آمد (۱۴۰۵/۰۶/۲۸) — جای طبیعی‌اش
                     همین‌جاست، کنارِ ظرفیت. -->
                <StackPanel Spacing="4" Margin="6,0">
                  <TextBlock Text="آستانهٔ هشدار (لیتر)" Classes="label" FontSize="11"
                             TextAlignment="Center" HorizontalAlignment="Stretch" />
                  <TextBox Classes="tankbox" Text="{Binding LowStock}" HorizontalAlignment="Stretch" c:LiveFormat.Kind="number" />
                </StackPanel>
                <StackPanel Spacing="4" Margin="6,10,6,0">
                  <TextBlock Text="جمله ورودی" Classes="label" FontSize="11"
                             TextAlignment="Center" HorizontalAlignment="Stretch" />
                  <Border Classes="calc tankbox" ToolTip.Tip="حساب‌شده از خریدها — فقط خواندنی">
                    <TextBlock Text="{Binding TotalIn, StringFormat={}{0} لیتر}" FontWeight="Bold"
                               TextAlignment="Center" HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Pump.Ink.Ok}" />
                  </Border>
                </StackPanel>
                <StackPanel Spacing="4" Margin="6,10,6,0">
                  <TextBlock Text="جمله فروش" Classes="label" FontSize="11"
                             TextAlignment="Center" HorizontalAlignment="Stretch" />
                  <Border Classes="calc tankbox" ToolTip.Tip="حساب‌شده از پارچه‌ها — فقط خواندنی">
                    <TextBlock Text="{Binding TotalOut, StringFormat={}{0} لیتر}" FontWeight="Bold"
                               TextAlignment="Center" HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Pump.Ink.Danger}" />
                  </Border>
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ══ خلاصه پول‌ها ══ -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <!-- ══ دکمه‌های مخزن در سربرگِ همین کارت (۱۴۰۵/۰۷/۱۳) ══
                 خواستهٔ صاحب ریپو با کادرِ آبی: «میله‌زنی، PDF و ثبتِ خرید دقیق
                 برن اون‌جا که جا می‌گیرن» — یعنی سمتِ راستِ سربرگِ «خلاصه
                 پول‌ها»، که خالی بود. ردیفِ دکمه از زیرِ کادرهای مخزن برداشته
                 شد و همان چهار دکمه با همان فرمان‌ها این‌جا نشستند.
                 ⚠️ عنوان همچنان وسطِ **کلِ** سربرگ است: ستونِ سومِ شبکه یک
                 جای خالی هم‌پهنای دکمه‌هاست، وگرنه عنوان به‌اندازهٔ پهنای
                 دکمه‌ها به چپ می‌رفت. -->
            <Border Classes="card-head">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <WrapPanel x:Name="TankActions" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="📏 میله‌زنی" Margin="0,2,8,2" Command="{Binding OpenDipCommand}"
                          IsVisible="{Binding IsBuyListVisible}"
                          ToolTip.Tip="صفحهٔ میله‌زنیِ مخزن — جدا از فهرستِ خریدها" />
                  <Button Content="← بازگشت به خریدها" Margin="0,2,8,2"
                          Command="{Binding CloseDipCommand}" IsVisible="{Binding IsDipOpen}" />
                  <Button Content="{Binding PdfText}" Margin="0,2,8,2" Command="{Binding PdfCommand}" />
                  <Button Classes="accent" Content="{Binding AddBuyText}" Margin="0,2,8,2"
                          Command="{Binding OpenBuyCommand}" />
                </WrapPanel>
                <TextBlock Grid.Column="1" Text="{Binding MoneyTitle}" FontWeight="Bold"
                           TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pump.Ink.Accent}" />
                <Border Grid.Column="2" Width="{Binding #TankActions.Bounds.Width}" />
              </Grid>
            </Border>
            <UniformGrid Rows="1" Classes="stats" Margin="14">
              <Border Classes="stat" Margin="0,0,12,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="جمله کل (دالر)" Classes="label" />
                  <TextBlock Text="{Binding TotalUsd, StringFormat=$ {0}}" Classes="num" />
                </StackPanel>
              </Border>
              <Border Classes="stat" Margin="0,0,12,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="جمله کل (افغانی)" Classes="label" />
                  <TextBlock Text="{Binding TotalAfn}" Classes="num" />
                </StackPanel>
              </Border>
              <Border Classes="stat">
                <StackPanel Spacing="3">
                  <TextBlock Text="فی لیتر خرید (افغانی)" Classes="label" />
                  <TextBlock Text="{Binding PerLiter}" Classes="num" />
                  <TextBlock Text="{Binding LastBuyDate, StringFormat=آخرین خرید: {0}}" Classes="muted" />
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- ══ مخزن‌های شماره‌دار (۱۴۰۵/۰۷/۲۲) ══════════════════════════════════
             خرید میانِ مخزن‌ها تقسیم می‌شود و فروش از کوچک‌ترین شماره‌ای که تیل دارد
             کشیده می‌شود؛ تمام شد ⇒ مخزنِ بعدی. ⛔ موجودیِ کل همان کارتِ بالاست. -->
        <Border Classes="panel" Padding="0">
          <StackPanel>
            <Border Classes="card-head">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="🛢️ مخزن‌های شماره‌دار" FontWeight="Bold" FontSize="15" />
                  <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                             Text="خرید را با «🛢️» روی کارتِ هر خرید میانِ مخزن‌ها تقسیم کنید؛ فروش از کوچک‌ترین شماره کشیده می‌شود و وقتی تمام شد از مخزنِ بعدی." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBox Text="{Binding TankNewNum}" Width="64" Height="34" Watermark="شماره" HorizontalContentAlignment="Center" c:LiveFormat.Kind="number" ToolTip.Tip="شمارهٔ مخزن (ترتیبِ کشیدن)" />
                  <TextBox Text="{Binding TankNewCapacity}" Width="110" Height="34" Watermark="ظرفیت (لیتر)" HorizontalContentAlignment="Center" c:LiveFormat.Kind="number" />
                  <Button Classes="accent" Height="34" Content="＋ مخزن" Command="{Binding AddTankCommand}" />
                </StackPanel>
              </Grid>
            </Border>
            <Border IsVisible="{Binding TankAlert, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Margin="14,10,14,0" Padding="10,6" CornerRadius="8" Background="{DynamicResource Pump.Panel}"
                    BorderBrush="{DynamicResource Pump.Warn}" BorderThickness="1">
              <TextBlock Text="{Binding TankAlert}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <TextBlock IsVisible="{Binding !HasTanks}" Classes="muted" Margin="14,12" TextWrapping="Wrap"
                       Text="هنوز مخزنی ساخته نشده — تا آن وقت همهٔ تیلِ این نوع یک مخزن است، مثلِ همیشه." />
            <ItemsControl ItemsSource="{Binding Tanks}" Margin="10,10,10,12" IsVisible="{Binding HasTanks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TankCardViewModel">
                  <Border Classes="panel tankcard" Margin="4" Padding="10" Width="250"
                          Classes.tankactive="{Binding Active}" Classes.tanklow="{Binding IsLow}">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                          <Button Classes="ghost" Content="✏️" Padding="6,1" ToolTip.Tip="ظرفیت"
                                  Command="{Binding $parent[ItemsControl].((vm:StorageSectionViewModel)DataContext).EditTankCapacityCommand}" CommandParameter="{Binding}" />
                          <Button Classes="ghost danger" Content="🗑" Padding="6,1"
                                  Command="{Binding $parent[ItemsControl].((vm:StorageSectionViewModel)DataContext).DeleteTankCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                      <c:TankGauge Width="226" Height="130" FillPercent="{Binding FillPercent}" FillText="{Binding FillText}"
                                   BodyBrush="{DynamicResource Pump.Card}" BodyDeepBrush="{DynamicResource Pump.Input}"
                                   RimBrush="{DynamicResource Pump.ChromeBorder}"
                                   LabelBrush="{DynamicResource Pump.Text}" TextBrush="{DynamicResource Pump.Text}"
                                   ThresholdBrush="{DynamicResource Pump.Danger}" />
                      <TextBlock Text="{Binding CurrentText}" FontWeight="Bold" FontSize="16" TextAlignment="Center" HorizontalAlignment="Stretch" />
                      <TextBlock Text="{Binding CapacityText}" Classes="muted" FontSize="11" TextAlignment="Center" HorizontalAlignment="Stretch" />
                      <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- تقسیمِ یک خرید: یک کادر برای هر مخزن؛ باقی‌مانده به مخزنِ اول -->
            <Border IsVisible="{Binding SplitFor, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Margin="14,0,14,14" Padding="12" CornerRadius="10"
                    Background="{DynamicResource Pump.Panel}" BorderBrush="{DynamicResource Pump.Accent}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding SplitTitle}" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding SplitShares}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TankShareViewModel">
                      <StackPanel Spacing="3" Margin="0,0,10,4" Width="140">
                        <TextBlock Text="{Binding Label}" Classes="label" FontSize="11" />
                        <TextBox Text="{Binding Liters}" Height="34" Watermark="0" HorizontalContentAlignment="Center" c:LiveFormat.Kind="number" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SplitRemainText}" VerticalAlignment="Center" FontWeight="SemiBold"
                             Classes.danger="{Binding SplitOver}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="بستن" Command="{Binding CloseSplitCommand}" />
                    <Button Classes="accent" Content="✅ ثبتِ تقسیم" Command="{Binding SaveSplitCommand}" IsEnabled="{Binding !SplitOver}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ══ خریدها — هر خرید یک کارت، مثلِ خودِ برنامه ══
             ⛔ فهرست به ‎PurchaseCards‎ بسته است، نه ‎Purchases‎: فقط تازه‌ترین
             ‎StorageSectionViewModel.PurchasePage‎ کارت ساخته می‌شود و بقیه پشتِ
             دکمهٔ «خریدِ قدیمی‌تر» می‌مانند. با ‎Purchases‎ (فهرستِ کامل) پنج سال
             خرید یعنی صدها کارت و هزار کادرِ زنده در درخت — همان «مخزن لگ
             داره»ی ۱۴۰۵/۰۷/۱۳. شرحش روی خودِ ‎PurchaseCards‎. -->
        <StackPanel IsVisible="{Binding IsBuyListVisible}">
        <ItemsControl ItemsSource="{Binding PurchaseCards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PurchaseRowViewModel">
              <Border Classes="panel" Margin="0,0,0,12" Padding="0">
                <StackPanel>
                  <Border Classes="card-head">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding HeadText}" FontWeight="Bold"
                                   Foreground="{DynamicResource Pump.Ink.Accent}" />
                        <TextBlock Text="{Binding DateShamsi, StringFormat=📅 {0}}" Classes="muted" />
                        <TextBlock Text="{Binding Seller, StringFormat=👤 {0}}"
                                   Foreground="{DynamicResource Pump.Ink.Info}" />
                      </StackPanel>
                      <!-- ✏️ «بعد از ثبت هم بشه ویرایشش کرد… یک قلم بزار» (۱۴۰۵/۰۷/۱۶) -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Classes="ghost" Content="🛢️" Padding="9,2"
                                ToolTip.Tip="تقسیمِ این خرید میانِ مخزن‌های شماره‌دار"
                                Command="{Binding $parent[ItemsControl].((vm:StorageSectionViewModel)DataContext).OpenSplitCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost" Content="✏️" Padding="9,2"
                                ToolTip.Tip="ویرایشِ این خرید — قیمت، نرخ یا هر چیزِ دیگر"
                                Command="{Binding $parent[ItemsControl].((vm:StorageSectionViewModel)DataContext).EditPurchaseCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="ghost danger" Content="🗑" Padding="9,2"
                                Command="{Binding $parent[ItemsControl].((vm:StorageSectionViewModel)DataContext).DeletePurchaseCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- قیمت یا نرخ هنوز نوشته نشده — اختیاری است، ولی دیده شود -->
                  <Border IsVisible="{Binding MissingPrice}" Background="#1FF0952B"
                          Padding="14,8" Margin="14,10,14,0" CornerRadius="8">
                    <TextBlock Text="قیمتِ هر تن یا نرخِ دالرِ این خرید هنوز نوشته نشده — با ✏️ بنویسید؛ حسابِ شرکت هم همان لحظه به‌روز می‌شود."
                               TextWrapping="Wrap" Foreground="{DynamicResource Pump.Ink.Warn}" FontWeight="SemiBold" />
                  </Border>

                  <!-- ⚠️ خریدی که هزار برابر ثبت شده (کادرِ «تن»ِ ۳.۱.۱۰۶ تا ۳.۱.۱۶۳).
                       ⛔ خودکار درست نمی‌شود — دادهٔ کاربر است؛ فقط گفته می‌شود. -->
                  <Border IsVisible="{Binding Implausible}" Background="#1FE53E3E"
                          Padding="14,8" Margin="14,10,14,0" CornerRadius="8">
                    <TextBlock Text="⚠️ وزنِ این خرید بیش از ۳۰۰ تن است — احتمالاً کیلو در کادرِ «تن»ِ نسخهٔ قبل نوشته شده بود. این خرید را پاک کنید و دوباره ثبت کنید."
                               TextWrapping="Wrap" Foreground="{DynamicResource Pump.Ink.Danger}" FontWeight="SemiBold" />
                  </Border>

                  <!-- ══ ‎.pu-stats‎ — نُه کادرِ خواندنیِ سایت ═══════════════
                       گزارشِ صاحب ریپو: «ببین خریدها را این مدلی نشان می‌دهد با
                       همهٔ جزئیاتش.» در سایت هر خرید یک کارتِ **خواندنی** است،
                       نه نُه کادرِ تایپی. ویرایش با ✏️ی سربرگِ کارت است
                       (همان فرمِ ثبت — ۱۴۰۵/۰۷/۱۶). -->
                  <c:AutoFillPanel MinItemWidth="150" Gap="8" Margin="14">
                    <!-- ⛔ کادرِ «وزن (کگ)» برداشته شد — خواستهٔ صاحب ریپو:
                         «موقعِ خرید دو نوع اندازه است، یکی کیلو یکی تن؛ کیلو نباشد.»
                         ‎Kg‎ در داده می‌ماند (تن × ۱۰۰۰) تا فرمول‌ها و فایل‌های
                         کهنه دست نخورند. -->
                    <!-- ⛔ هم‌قدِ هفت کادرِ دیگر (صاحب ریپو، ۱۴۰۵/۰۷/۱۶): تن کنارِ برچسب
                         است، نه یک خطِ سوم که فقط این کادر را بلندتر می‌کرد. -->
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding TonText, StringFormat=وزن · {0} تن}" Classes="label" />
                        <TextBlock Text="{Binding KgShowText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Ink.Info}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="ثقلت" Classes="label" />
                        <TextBlock Text="{Binding DensityText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="لیتر" Classes="label" />
                        <TextBlock Text="{Binding LitersText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Ink.Ok}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="فی تن ($)" Classes="label" />
                        <TextBlock Text="{Binding PriceTonText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="نرخ دالر" Classes="label" />
                        <TextBlock Text="{Binding UsdRateText}" FontWeight="ExtraBold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="کل (دالر)" Classes="label" />
                        <TextBlock Text="{Binding TotalUsdText, StringFormat={}{0} $}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Ink.Info}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="کل (افغانی)" Classes="label" />
                        <TextBlock Text="{Binding TotalAfnText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Ink.Accent}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="stat" MinHeight="70">
                      <StackPanel Spacing="3">
                        <TextBlock Text="فی لیتر (افغانی)" Classes="label" />
                        <TextBlock Text="{Binding PerLiterText}" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Pump.Ink.Danger}" />
                      </StackPanel>
                    </Border>
                  </c:AutoFillPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="ghost info" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="16,8"
                IsVisible="{Binding HasHiddenPurchases}"
                Content="{Binding MorePurchasesText}"
                Command="{Binding ShowMorePurchasesCommand}"
                ToolTip.Tip="خریدهای قدیمی‌تر یک‌جا ساخته نمی‌شوند تا صفحه سبک بماند؛ هر بار همین‌قدر دیگر می‌آید" />
        </StackPanel>

        <!-- ══ میله‌زنیِ مخزن — صفحهٔ خودش ══════════════════════════════════
             خواستهٔ صریحِ صاحب ریپو: «اون میله‌زنی چرا تو لیستِ خریدهای دیزل و
             پطرول است؟ باید یک کادر و یک صفحهٔ جداگانه داشته باشد و این‌جا
             دیده نشود.» پس با دکمهٔ «📏 میله‌زنی» باز می‌شود و فهرستِ خریدها
             همان لحظه کنار می‌رود. -->
        <Border Classes="panel" Padding="0" MinHeight="240"
                IsVisible="{Binding IsDipOpen}">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Classes="card-head">
              <TextBlock Text="📏 میله‌زنیِ مخزن" FontWeight="Bold"
                         Foreground="{DynamicResource Pump.Ink.Accent}" />
            </Border>

            <!-- ══ محاسبهٔ زنده ══════════════════════════════════════════════
                 همان کاری که ‎dipLiveCalc‎ می‌کرد: کاربر هنوز چیزی ثبت نکرده،
                 ولی همان لحظه می‌بیند مخزن چقدر پر است، چقدر جا دارد، و چقدر
                 با دفتر فرق دارد. اگر فرق از حدِ مجاز بگذرد، هشدارِ قرمز. -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="14,12">
              <WrapPanel Orientation="Horizontal">
                <StackPanel Spacing="3" Width="150" Margin="0,0,10,6">
                  <TextBlock Text="لیترِ میله‌زنی" Classes="label" />
                  <TextBox Text="{Binding DipMeasured}" Watermark="0" c:LiveFormat.Kind="number" />
                </StackPanel>
                <StackPanel Spacing="3" Width="150" Margin="0,0,10,6">
                  <TextBlock Text="موجودی دفتری" Classes="label" />
                  <TextBlock Text="{Binding TankBookText}" FontWeight="Bold" Margin="0,6,0,0"
                             Foreground="{DynamicResource Pump.Ink.Info}" />
                </StackPanel>
                <StackPanel Spacing="3" Width="170" Margin="0,0,10,6">
                  <TextBlock Text="ظرفیت کل" Classes="label" />
                  <TextBlock Text="{Binding TankCapacityText}" FontWeight="Bold" Margin="0,6,0,0"
                             Foreground="{DynamicResource Pump.Ink.Accent}" />
                </StackPanel>
                <StackPanel Spacing="3" Width="120" Margin="0,0,10,6" IsVisible="{Binding DipHasValue}">
                  <TextBlock Text="درصد پر بودن" Classes="label" />
                  <TextBlock Text="{Binding DipPercentText}" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Spacing="3" Width="170" Margin="0,0,10,6" IsVisible="{Binding DipHasValue}">
                  <TextBlock Text="🚚 قابل دریافت از تانکر" Classes="label" />
                  <TextBlock Text="{Binding DipEmptyText}" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Spacing="3" Width="150" Margin="0,0,10,6" IsVisible="{Binding DipHasValue}">
                  <TextBlock Text="اختلاف با دفتر" Classes="label" />
                  <TextBlock Text="{Binding DipDiffText}" FontWeight="Bold" Margin="0,6,0,0"
                             Foreground="{Binding DipDiffBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                </StackPanel>
                <StackPanel Spacing="3" Width="190" Margin="0,0,10,6">
                  <TextBlock Text=" " Classes="label" />
                  <CheckBox Content="دفتر برابرِ عددِ واقعی شود"
                            IsChecked="{Binding DipApplyToBook}" />
                </StackPanel>
                <!-- ⚠️ دکمهٔ ثبت این‌جاست، نه در نوارِ بالای بخش: آن دکمه حالا
                     «صفحهٔ میله‌زنی را باز کن» است و اگر ثبت هم همان‌جا می‌ماند،
                     تنها راهِ ثبت از دست می‌رفت. -->
                <StackPanel Spacing="3" Margin="0,0,10,6" VerticalAlignment="Bottom">
                  <TextBlock Text=" " Classes="label" />
                  <Button Classes="accent" Content="✔ ثبتِ میله‌زنی"
                          Command="{Binding AddDipCommand}" />
                </StackPanel>
              </WrapPanel>

              <TextBlock Text="{Binding DipWarnText}" TextWrapping="Wrap" FontWeight="Bold"
                         IsVisible="{Binding DipWarnVisible}"
                         Foreground="{DynamicResource Pump.Ink.Danger}" />
            </StackPanel>

            <c:ExcelGrid Grid.Row="2" ItemsSource="{Binding Dips}" x:CompileBindings="False"
                         BorderThickness="0" CornerRadius="0"
                        RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeleteDipCommand}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
                <DataGridTextColumn Header="اندازهٔ واقعی" Binding="{Binding MeasuredText}" Width="Auto" />
                <DataGridTextColumn Header="اندازهٔ دفتری" Binding="{Binding ExpectedText}" Width="Auto" />
                <DataGridTextColumn Header="اختلاف" Binding="{Binding DiffText}" Width="Auto" IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="دفتر برابر شود" Binding="{Binding ApplyToBook}" Width="Auto" />
                <DataGridTextColumn Header="رفته به دفتر" Binding="{Binding BookAdjustText}" Width="Auto" IsReadOnly="True" />
                <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" />
              </DataGrid.Columns>
            </c:ExcelGrid>

            <!-- ردیفِ «جمله»ی اندازه‌گیری‌ها -->
            <c:TotalsBar Grid.Row="3" ItemsSource="{Binding DipTotalCells}" />
          </Grid>
        </Border>
      </StackPanel>
    
  </c:SectionPage>

  <!-- ══════════════════════════════════════════════════════════════════════
       🛢️ پنجرهٔ «ثبت خرید» — ‎#addPurchaseModal‎
       صفحهٔ نسبتاً کوچکی که روی بخش می‌نشیند: بالا کادرهای تایپی، پایین
       عددهایی که همان لحظه حساب می‌شوند، و دو دکمه. فقط وزن و ثقلت لازم‌اند؛
       قیمت و نرخ اختیاری و بعداً با ✏️ (همین پنجره، ‎EditPurchase‎).
       ══════════════════════════════════════════════════════════════════ -->
  <Panel x:Name="BuyOverlay" IsVisible="{Binding BuyOpen}" Background="#99000000">
    <!-- ⛔ ‎Classes="modal"‎: ناوبریِ کلیدهای جهت‌دار (‎FieldNavigation‎) از این قاب
         بیرون نمی‌رود، و ‎TabNavigation=Cycle‎ همان برای ‎Tab‎. گزارشِ صاحب ریپو
         (۱۴۰۵/۰۷/۱۶): «کلیدهای چپ و راست و بالا از داخلِ اون کادر میره بیرون».
         ‎MaxHeight‎ را کدِ پشت از بلندیِ دید می‌گذارد تا هیچ کادری نیمه نماند. -->
    <Border x:Name="BuyCard" Classes="modal" KeyboardNavigation.TabNavigation="Cycle"
            Width="720" MaxHeight="760" VerticalAlignment="Center" HorizontalAlignment="Center"
            CornerRadius="16" Padding="0" Background="{DynamicResource Pump.Card}"
            BorderBrush="{DynamicResource Pump.Accent}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="card-head">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding BuyTitle}" Classes="card-title"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost danger" Content="✕" Padding="10,2"
                    Command="{Binding CancelBuyCommand}" />
          </Grid>
        </Border>

        <!-- ⚠️ فاصله روی خودِ محتواست، نه ‎Padding‎ِ کادرِ لغزان: با ‎Padding‎ بلندیِ
             محتوا ۲۴ پیکسل کم شمرده می‌شد و تهِ «یادداشت» زیرِ پا می‌رفت. -->
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="10" Margin="16,12">

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="تاریخ" Classes="label" />
                <TextBox Text="{Binding BuyDate}" c:LiveFormat.Kind="date" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="نام فروشنده" Classes="label" />
                <TextBox Text="{Binding BuySeller}" Watermark="نام فروشنده"
                         ToolTip.Tip="خرید خودکار در حسابِ شرکتِ هم‌نامِ فروشنده هم ثبت می‌شود" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <!-- ⛔ کیلو، مثلِ سایت (‎pu-kg‎) — تن زیرِ فرم خودش حساب می‌شود -->
                <TextBlock Text="وزن (کیلو)" Classes="label" />
                <TextBox Text="{Binding BuyKg}" Watermark="مثلاً 5320" c:LiveFormat.Kind="number" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="ثقلت (چگالی)" Classes="label" />
                <!-- ⛔ «0730» خودش «0.730» می‌شود (۱۴۰۵/۰۷/۱۷) — ‎StorageSectionView.OnDensityTyped‎ -->
                <TextBox Name="BuyDensityBox" Text="{Binding BuyDensity}" Watermark="مثلاً 0730 ⇐ 0.730"
                         ToolTip.Tip="نقطه لازم نیست — ‹0730› خودش ‹0.730› می‌شود" />
              </StackPanel>
            </Grid>

            <!-- ⛔ این دو اختیاری‌اند (۱۴۰۵/۰۷/۱۶): «شاید شرکت نگفته باشه» — بعداً با ✏️ -->
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="قیمت هر تن (دالر) — اختیاری" Classes="label" />
                <TextBox Text="{Binding BuyPriceTon}" Watermark="مثلاً 1200 — بعداً هم می‌شود" c:LiveFormat.Kind="number" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="نرخ دالر (افغانی) — اختیاری" Classes="label" />
                <TextBox Text="{Binding BuyUsdRate}" Watermark="مثلاً 65 — بعداً هم می‌شود" c:LiveFormat.Kind="number" />
              </StackPanel>
            </Grid>

            <!-- ⛔ یادداشت پیش از عددهای خودکار — تهِ قاب «نیمه دیده می‌شد» (۱۴۰۵/۰۷/۱۶) -->
            <StackPanel Spacing="4">
              <TextBlock Text="یادداشت" Classes="label" />
              <TextBox Text="{Binding BuyNote}" Watermark="اختیاری" TextWrapping="Wrap" MinHeight="36" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ⛔ «پول کل» دالر و افغانی ته قاب، درشت و همیشه پیدا (۱۴۰۵/۰۷/۱۷):
             «اون پایین پول کل دالر و افغانی کمی بهتر دیده بشن». بیرونِ کادرِ لغزان
             است، پس با پایین رفتنِ فرم هم از چشم نمی‌افتد. -->
        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Pump.ChromeBorder}">
          <StackPanel Spacing="8">
            <!-- ⛔ پنج عددِ خودکار — یک اندازه و یک ظاهر (۱۴۰۵/۰۷/۱۷، دوم): «این‌ها همه همین
                 اندازه و هم ظاهر باشن، تفاوت نکنن». همه ته قاب، بیرونِ کادرِ لغزان. -->
            <UniformGrid Name="BuySums" Columns="5">
              <Border Classes="panel buysum" Margin="4,0" Padding="6,4" BorderThickness="2"
                      BorderBrush="{DynamicResource Pump.Info}">
                <StackPanel Spacing="2">
                  <TextBlock Text="وزن به تن" Classes="label" FontSize="12.5" FontWeight="Bold"
                             TextAlignment="Center" TextTrimming="None" />
                  <!-- عددِ بلند کوچک می‌شود، بریده نمی‌شود -->
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="28">
                    <TextBlock Text="{Binding BuyTonText}" FontWeight="Black" FontSize="20"
                               Foreground="{DynamicResource Pump.Ink.Info}" />
                  </Viewbox>
                </StackPanel>
              </Border>
              <Border Classes="panel buysum" Margin="4,0" Padding="6,4" BorderThickness="2"
                      BorderBrush="{DynamicResource Pump.Info}">
                <StackPanel Spacing="2">
                  <TextBlock Text="مقدار لیتر" Classes="label" FontSize="12.5" FontWeight="Bold"
                             TextAlignment="Center" TextTrimming="None" />
                  <!-- عددِ بلند کوچک می‌شود، بریده نمی‌شود -->
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="28">
                    <TextBlock Text="{Binding BuyLitersText}" FontWeight="Black" FontSize="20"
                               Foreground="{DynamicResource Pump.Ink.Info}" />
                  </Viewbox>
                </StackPanel>
              </Border>
              <Border Classes="panel buysum" Margin="4,0" Padding="6,4" BorderThickness="2"
                      BorderBrush="{DynamicResource Pump.Info}">
                <StackPanel Spacing="2">
                  <TextBlock Text="فی لیتر (افغانی)" Classes="label" FontSize="12.5" FontWeight="Bold"
                             TextAlignment="Center" TextTrimming="None" />
                  <!-- عددِ بلند کوچک می‌شود، بریده نمی‌شود -->
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="28">
                    <TextBlock Text="{Binding BuyPerLiterText}" FontWeight="Black" FontSize="20"
                               Foreground="{DynamicResource Pump.Ink.Info}" />
                  </Viewbox>
                </StackPanel>
              </Border>
              <Border Name="BuyUsdBox" Classes="panel buysum" Margin="4,0" Padding="6,4" BorderThickness="2"
                      BorderBrush="{DynamicResource Pump.Info}">
                <StackPanel Spacing="2">
                  <TextBlock Text="پول کل (دالر)" Classes="label" FontSize="12.5" FontWeight="Bold"
                             TextAlignment="Center" TextTrimming="None" />
                  <!-- عددِ بلند کوچک می‌شود، بریده نمی‌شود -->
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="28">
                    <TextBlock Text="{Binding BuyUsdText}" FontWeight="Black" FontSize="20"
                               Foreground="{DynamicResource Pump.Ink.Info}" />
                  </Viewbox>
                </StackPanel>
              </Border>
              <Border Name="BuyAfnBox" Classes="panel buysum" Margin="4,0" Padding="6,4" BorderThickness="2"
                      BorderBrush="{DynamicResource Pump.Info}">
                <StackPanel Spacing="2">
                  <TextBlock Text="پول کل (افغانی)" Classes="label" FontSize="12.5" FontWeight="Bold"
                             TextAlignment="Center" TextTrimming="None" />
                  <!-- عددِ بلند کوچک می‌شود، بریده نمی‌شود -->
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="28">
                    <TextBlock Text="{Binding BuyAfnText}" FontWeight="Black" FontSize="20"
                               Foreground="{DynamicResource Pump.Ink.Info}" />
                  </Viewbox>
                </StackPanel>
              </Border>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
              <Button Classes="accent" Content="ذخیره" MinWidth="120"
                      Command="{Binding SaveBuyCommand}" />
              <Button Content="انصراف" MinWidth="100" Command="{Binding CancelBuyCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Panel>
  </Panel>
</UserControl>
