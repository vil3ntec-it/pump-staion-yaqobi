<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.TankerSectionView"
             x:DataType="vm:TankerSectionViewModel">

  <c:SectionPage>
    <c:SectionPage.Header>تخلیهٔ تانکر</c:SectionPage.Header>
    <c:SectionPage.SubHeader>بارنامه در برابر تحویل — کم‌آمدِ راننده همین‌جا پیدا می‌شود</c:SectionPage.SubHeader>

    <StackPanel Spacing="10">

      <Border Classes="panel" Padding="12,10">
        <StackPanel Spacing="8">
          <WrapPanel Orientation="Horizontal">

            <StackPanel Spacing="3" Width="130" Margin="0,0,10,6">
              <TextBlock Text="نوع تیل" Classes="label" />
              <Button Content="{Binding FuelToggleText}" Command="{Binding ToggleFuelCommand}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="3" Width="140" Margin="0,0,10,6">
              <TextBlock Text="لیتر بارنامه" Classes="label" />
              <TextBox Text="{Binding Manifest}" Watermark="0" />
            </StackPanel>

            <StackPanel Spacing="3" Width="140" Margin="0,0,10,6">
              <TextBlock Text="لیتر تحویل" Classes="label" />
              <TextBox Text="{Binding Actual}" Watermark="0" />
            </StackPanel>

            <StackPanel Spacing="3" Width="150" Margin="0,0,10,6">
              <TextBlock Text="راننده" Classes="label" />
              <TextBox Text="{Binding Driver}" Watermark="اختیاری" />
            </StackPanel>

            <StackPanel Spacing="3" Width="200" Margin="0,0,10,6">
              <TextBlock Text="یادداشت" Classes="label" />
              <TextBox Text="{Binding Note}" Watermark="اختیاری" />
            </StackPanel>

            <StackPanel Spacing="3" Width="130" Margin="0,0,10,6">
              <TextBlock Text=" " Classes="label" />
              <Button Classes="accent" Content="🚚 ثبت تخلیه" Command="{Binding AddCommand}"
                      HorizontalAlignment="Stretch" />
            </StackPanel>
          </WrapPanel>

          <TextBlock Text="{Binding PreviewText}" FontWeight="Bold"
                     Foreground="{Binding PreviewBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Classes="card-head">
            <TextBlock Text="تخلیه‌های ثبت‌شده" FontWeight="Bold"
                       Foreground="{DynamicResource Pump.Accent}" />
          </Border>

          <c:ExcelGrid Grid.Row="1" ItemsSource="{Binding Rows}" x:CompileBindings="False"
                       IsReadOnly="True" BorderThickness="0" CornerRadius="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="Auto" />
              <DataGridTextColumn Header="تاریخ" Binding="{Binding DateShamsi}" Width="Auto" />
              <DataGridTextColumn Header="نوع تیل" Binding="{Binding FuelText}" Width="Auto" />
              <DataGridTextColumn Header="بارنامه" Binding="{Binding ManifestText}" Width="Auto" />
              <DataGridTextColumn Header="تحویل" Binding="{Binding ActualText}" Width="Auto" />
              <DataGridTemplateColumn Header="نتیجه" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DiffText}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding DiffBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="راننده" Binding="{Binding Driver}" Width="Auto" />
              <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" MinWidth="150" MaxWidth="320" />
              <DataGridTemplateColumn Header="" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                            Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </c:ExcelGrid>

          <!-- ردیفِ «جمله» — بارنامه، تحویل و جمعِ کم‌آمد -->
          <c:TotalsBar Grid.Row="2" ItemsSource="{Binding TotalCells}" />
        </Grid>
      </Border>

      <TextBlock Text="هنوز تخلیه‌ای ثبت نشده" Classes="label"
                 IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,10" />
    </StackPanel>
  </c:SectionPage>
</UserControl>
