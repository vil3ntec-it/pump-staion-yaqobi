<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.VipSectionView"
             x:DataType="vm:VipSectionViewModel">

  <!-- ══ اشتراک و پلن‌ها ═══════════════════════════════════════════════════
       خواستهٔ صاحب ریپو: «بخشِ وی‌آی‌پی را اعمال کن که من ببینم و تست کنم.»
       و ریمیکِ ۱۴۰۵/۰۷/۰۵: «برای اشتراک‌ها هم بهترین‌ها را درست کن.»

       آن‌چه عوض شد، فقط **دیدن** است:
         ۱) ماندهٔ اشتراک عددِ بزرگِ صفحه شد، نه یکی از سه خانهٔ هم‌وزن.
         ۲) پلن‌ها کنارِ هم‌اند، نه زیرِ هم — پلن را با پلن مقایسه می‌کنند.
         ۳) «دسترسی‌ها» ردیفِ خط‌دار شد تا ✅ و 🔒 با یک نگاه خوانده شوند.

       ⛔ ستونِ قیمت عمداً «—» است؛ خودِ صاحب ریپو بعداً پرش می‌کند، و این
       صفحه هیچ عددی از خودش نمی‌سازد. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.kvl">
      <Setter Property="Foreground" Value="{DynamicResource Pump.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.kvv">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- ردیفِ «چه چیزی باز است» — خطِ مویی زیرش، مثلِ برگهٔ مشخصات -->
    <Style Selector="Border.kvrow">
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="BorderBrush" Value="{DynamicResource Pump.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Styles>

  <c:SectionPage Header="اشتراک و پلن‌ها"
                 SubHeader="چه چیزی باز است، و هر پلن چه دارد">

    <StackPanel Spacing="14" MaxWidth="1040">

      <!-- ══ حالِ همین پمپ ═════════════════════════════════════════════════ -->
      <Border Classes="card" Padding="24,20">
        <Grid ColumnDefinitions="Auto,*">

          <!-- ماندهٔ اشتراک — عددِ اولِ صفحه -->
          <Border Grid.Column="0" Classes="stat" Padding="26,20" MinWidth="220"
                  VerticalAlignment="Center">
            <StackPanel Spacing="4">
              <TextBlock Text="⏳ ماندهٔ اشتراک" Classes="label" />
              <TextBlock Text="{Binding DaysText}" FontSize="34" FontWeight="Black"
                         Foreground="{DynamicResource Pump.Ink.Ok}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding StateText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="💎 حالِ اشتراکِ همین پمپ" Classes="card-title" FontSize="17" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="پلن:" Classes="kvl" />
              <TextBlock Text="{Binding PlanText}" FontSize="20" FontWeight="Black" />
            </StackPanel>
            <TextBlock Text="{Binding GraceText}" FontWeight="Bold" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource Pump.Ink.Warn}"
                       IsVisible="{Binding GraceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="دفترِ شما هیچ‌وقت قفل نمی‌شود — قرض‌داران، ورق، مخزن، گاوصندوق، چاپ، سطلِ زباله و بک‌اپِ محلی با تمام شدنِ اشتراک هم سرِ جایشان هستند. و اگر اینترنت نبود یا سرور جواب نداد، دو هفته ارفاق هست تا هیچ‌کس با یک خرابی بی‌کار نماند." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══ چه چیزی همین حالا باز است ═════════════════════════════════════ -->
      <Border Classes="card" Padding="22,18">
        <StackPanel Spacing="4">
          <TextBlock Text="🔑 دسترسی‌های همین حالا" Classes="card-title" FontSize="16" Margin="0,0,0,8" />

          <Border Classes="kvrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="اپِ کارمندان و ربات" Classes="kvv" />
              <TextBlock Grid.Column="1" Text="{Binding KarText}" Classes="kvv" />
            </Grid>
          </Border>
          <Border Classes="kvrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="کیو‌آرِ حسابِ مشتری" Classes="kvv" />
              <TextBlock Grid.Column="1" Text="{Binding QrText}" Classes="kvv" />
            </Grid>
          </Border>
          <Border Classes="kvrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="بک‌اپِ خودکار روی سرور" Classes="kvv" />
              <TextBlock Grid.Column="1" Text="{Binding BackupText}" Classes="kvv" />
            </Grid>
          </Border>
          <Border Classes="kvrow" BorderThickness="0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="چتِ پشتیبانی" Classes="kvv" />
              <TextBlock Grid.Column="1" Text="{Binding SupportText}" Classes="kvv"
                         Foreground="{DynamicResource Pump.Ink.Ok}" />
            </Grid>
          </Border>

          <Border Height="1" Background="{DynamicResource Pump.Border}" Margin="0,10" />

          <!-- ⚠️ کلیدِ آزمایش **فقط می‌بندد** و هیچ‌وقت باز نمی‌کند، و روی
               دیسک هم نمی‌نشیند — پس راهِ دور زدنِ اشتراک نیست. -->
          <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="seg" Classes.active="{Binding TestDeny}"
                    Content="🧪 آزمایشِ حالتِ بی‌اشتراک" MinHeight="40"
                    Command="{Binding ToggleTestCommand}" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="برای دیدنِ قفل‌ها با چشمِ خودتان. فقط می‌بندد و هیچ‌وقت باز نمی‌کند، و با بسته شدنِ برنامه خودش خاموش می‌شود." />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ══ پلن‌ها — کنارِ هم، تا مقایسه شوند ═══════════════════════════════ -->
      <TextBlock Text="پلن‌ها" Classes="card-title" FontSize="17" Margin="2,4,0,0" />

      <ItemsControl ItemsSource="{Binding Plans}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlanCard">
            <Border Classes="card" Width="244" Margin="0,0,12,12" Padding="0"
                    VerticalAlignment="Top">
              <StackPanel>
                <!-- سرِ کارت -->
                <Border Classes="card-head">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="card-title"
                                 TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Classes="pill" Padding="9,2"
                              Background="#FFD700" IsVisible="{Binding Current}"
                              VerticalAlignment="Center">
                        <TextBlock Text="پلنِ فعلی" FontSize="10.5" FontWeight="Black"
                                   Foreground="#1a1a1a" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Price}" FontSize="24" FontWeight="Black"
                               Foreground="{DynamicResource Pump.Ink.Info}" />
                  </StackPanel>
                </Border>

                <StackPanel Margin="16,14" Spacing="7">
                  <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                  <Border Height="1" Background="{DynamicResource Pump.Border}" />
                  <ItemsControl ItemsSource="{Binding Yes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding StringFormat=✅ {0}}" TextWrapping="Wrap"
                                   FontSize="12.5" Margin="0,3,0,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding No}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding StringFormat=🔒 {0}}" TextWrapping="Wrap"
                                   FontSize="12.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Pump.Muted}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Text="⛔ جای قیمت‌ها عمداً خالی است — خودِ صاحبِ برنامه بعداً پرش می‌کند." />

    </StackPanel>
  </c:SectionPage>
</UserControl>
