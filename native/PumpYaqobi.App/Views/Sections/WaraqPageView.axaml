<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:th="using:PumpYaqobi.App.Themes"
             x:Class="PumpYaqobi.App.Views.Sections.WaraqPageView"
             x:DataType="vm:WaraqPageViewModel">

  <!-- نوشتهٔ راهنمای کادرها سمتِ راست — شرحِ کامل در ‎ParchaSectionView.axaml‎.
       ⛔ نوشتهٔ تایپ‌شده همچنان وسط‌چین است؛ فقط راهنما راست می‌شود. -->
  <UserControl.Styles>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Styles>

  <c:SectionPage Header="{Binding Title}" SubHeader="پایه‌ها و ردیف‌های قرض و مصرفِ همین شیفت">

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- روز/شب: دو دکمهٔ رادیویی، نه ‎ToggleSwitch‎. گزارشِ صاحب ریپو: «کادرِ
             روز و شبش داغونه، با کلیک تغییر نمی‌کنه، یک کادرِ ولوم اومده.» -->
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="seg" Content="☀️ روز" Command="{Binding SetNightCommand}" CommandParameter="day" Classes.active="{Binding IsDay}" />
          <Button Classes="seg" Content="🌙 شب" Command="{Binding SetNightCommand}" CommandParameter="night" Classes.active="{Binding IsNight}" />
        </StackPanel>
        <Button Content="پایهٔ تازه" Command="{Binding AddPumpCommand}" />
        <Button Classes="ghost info" Content="PDF ورق" Command="{Binding PdfCommand}" />
        <Button Classes="accent" Content="بازگشت" Command="{Binding BackCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <!-- «کارمندِ شیفت» و «قرضِ پارچه» عمداً این‌جا نیستند: خواستهٔ صاحب ریپو —
         «این دو کادر اضافه‌اند و این‌ها تو بخشِ پارچه‌ها رسانده می‌شن.» داده‌شان
         در ویومدل می‌ماند (‎WorkerName‎/‎FabricDebt‎) و از پارچه‌ها پر می‌شود. -->

    <!-- ⚠️ این‌جا عمداً ‎SectionPage.Summary‎ نیست: شش کادرِ «خلاصه شیفت» در
         سایت زیرِ جدولِ تراکنش‌ها می‌نشینند، نه بالای صفحه (‎index.html‎ خط
         ۱۹۹۷۴). گزارشِ صاحب ریپو: «اون شش تا پایینِ این جدولِ تراکنش‌ها
         استن.» پس ته همین صفحه ساخته شده‌اند. -->


    <Grid RowDefinitions="*,Auto,10,*,Auto">
      <c:ExcelGrid GrowsToContent="True" KeepInside="True" WidthKey="waraq.pumps" Grid.Row="0" x:Name="PumpGrid" ItemsSource="{Binding Pumps}" x:CompileBindings="False"
                  RowDeleteCommand="{Binding $parent[UserControl].DataContext.DeletePumpCommand}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="پایه" Binding="{Binding Num}" Width="Auto" />
          <!-- ⛔ ستونِ «تاریخ» برداشته شد (۱۴۰۵/۰۷/۱۲) و برنمی‌گردد — خواستهٔ صاحب
               ریپو: «کادرِ تاریخ رو حذف کن چون بالای پارچه نوشته، بسه.» خودِ
               ‎PumpDate‎ در داده می‌ماند. -->
          <DataGridTextColumn Header="نام" Binding="{Binding Worker}" Width="Auto" c:Suggest.Key="staff" />
          <DataGridTemplateColumn Header="تیل" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <!-- ⚠️ کپسول، نه کشویی. با دو گزینه، ‎ComboBox‎ یک قالبِ کامل با ‎Popup‎ و
                     ‎ItemsPresenter‎ی خودش می‌ساخت — ده‌ها بصری در هر خانه — و سنجشِ ‎waraqperf‎
                     نشان داد بیشترِ وقتِ باز شدنِ ورقِ پُر همین است. خواستهٔ صاحب ریپو هم همین
                     بود: «اون فلش فقط جا گرفته» و «با تب یا اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ
                     ‎celltoggle‎ را با ‎Enter‎/‎Tab‎ می‌زند. -->
                <!-- ⛔ ردیفی که از پارچه آمده، تیلش همان‌جا تعیین شده و این‌جا عوض
                     نمی‌شود (خواستهٔ ۱۴۰۵/۰۷/۱۲: «این‌جا قابلِ تغییر نباشه که به مشکل
                     خورده می‌شه»). کپسول همان است، فقط دکمه نیست. ردیفِ دستیِ
                     «پایهٔ تازه» همچنان عوضش می‌کند. -->
                <Panel>
                  <Button Classes="fuelchip celltoggle" Content="{Binding FuelChipText}"
                          IsVisible="{Binding FuelEditable}"
                          Command="{Binding ToggleFuelCommand}"
                          Foreground="{Binding FuelChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                          BorderBrush="{Binding FuelChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                          ToolTip.Tip="زدنش نوعِ تیلِ همین ردیف را پطرول ⇄ دیزل می‌کند" />
                  <Border Classes="fuelchip locked" IsVisible="{Binding FromParcha}"
                          BorderBrush="{Binding FuelChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                          ToolTip.Tip="{Binding FuelLockTip}">
                    <TextBlock Text="{Binding FuelChipText}"
                               Foreground="{Binding FuelChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- ══ «همان کادر سرخ شود» (۱۴۰۵/۰۷/۱۲) ══════════════════════════════
               ستونِ جداگانهٔ «هشدار» برداشته شد. حالا خودِ خانهٔ «شروع» (شروعی که با
               ختمِ پایهٔ قبلی جور نیست) یا «ختم» (ختمِ کمتر از شروع) لبهٔ سرخ و یک
               مثلثِ کوچک می‌گیرد و پیامش بالای خودش می‌آید — ‎IssueTextColumn‎.
               برداشتنِ نشان: راست‌کلیک روی ردیف ⇐ «نشانِ سرخ را بردار». -->
          <c:IssueTextColumn Header="شروع" Binding="{Binding StartText}" Width="Auto" IssuePath="StartIssue" />
          <c:IssueTextColumn Header="ختم" Binding="{Binding EndText}" Width="Auto" IssuePath="EndIssue" />
          <DataGridTextColumn Header="لیتر" Binding="{Binding LitersText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="فی" Binding="{Binding PriceText}" Width="Auto" />
          <DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="قرضِ پایه" Binding="{Binding DebtText}" Width="Auto" />
          <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" />
        </DataGrid.Columns>
      </c:ExcelGrid>

      <!-- ردیفِ «جمله این شیفت» — همتای ‎<tfoot>‎ی جدولِ قرائت پمپ‌ها در سایت
           (‎index.html‎ خط ۱۹۹۲۹). ‎Grid‎ صریح داده شده چون در این صفحه سه
           جدول هست و نوار باید بداند مالِ کدام است. -->
      <c:TotalsBar Grid.Row="1" Title="🧮 جمله این شیفت"
                   Grid="{Binding #PumpGrid}" ItemsSource="{Binding TotalCells}" />

      <!-- ══ تراکنش‌ها — دو جدولِ هم‌شکل، کنارِ هم ══════════════════════════
           خواستهٔ صاحب ریپو: «توی ورق‌ها دو کادر دارد که شبیه هم است و آن
           بابتِ این است که بیشتر جا بشود، توی یک حساب قرض‌ها یا مصرف‌ها.»

           سایت هم همین است — ‎#wq-trans-tbl-left‎ و ‎#wq-trans-tbl-right‎ در یک
           ‎grid-template-columns:1fr 1fr‎، و ‎renderWaraqTransactions‎ نیمهٔ اول
           را در جدولِ اول و نیمهٔ دوم را در جدولِ دوم می‌ریزد.

           ستون‌ها هم مو‌به‌مو همان‌های سایت‌اند و به همان ترتیب:
               # │ نام │ مقدار تیل │ مبلغ │ نوع │ واحد
           («مبلغِ مؤثر» که پیش از این بود، در سایتِ این جدول نیست و برداشته
           شد؛ همان عدد در ردیفِ «جمله»ی ته صفحه دیده می‌شود.)

           ⚠️ ستونِ «واحد» (تیل/پول) سایت هنوز این‌جا نیست — چون در نیتیو
           تراکنش‌های ورق اصلاً به حسابِ قرض‌داران پست نمی‌شوند، و آن ستون
           تا وقتی پستی در کار نباشد چیزی را جابه‌جا نمی‌کند. -->
      <!-- ⚠️ این دو جدول تا وقتی کاربر به آن‌ها نرسیده ساخته نمی‌شوند.
           سنجشِ ‎waraqperf‎: خواندنِ ورق از دیتابیس ۲ میلی‌ثانیه و ساختنِ
           ویومدلش ۴، ولی هر پاسِ چیدمانِ صفحه ~۴۰۰ میلی‌ثانیه — چون صفحه هر
           سه جدولش را یک‌جا می‌ساخت. خواستهٔ صاحب ریپو هم همین بود: «تو همون
           بخش که رفت، با اسکرول جدول‌های پایین زود لود بشن.» -->
      <c:LazyBox Grid.Row="3" PlaceholderHeight="360" Content="{Binding}">
        <c:LazyBox.Deferred>
          <DataTemplate>
          <Grid ColumnDefinitions="*,8,*">
            <c:ExcelGrid GrowsToContent="True" KeepInside="True" WidthKey="waraq.txns" Grid.Column="0" ItemsSource="{Binding TxnsFirst}" x:CompileBindings="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*" />
                <!-- ⛔ ستونِ «نوع تیل» برداشته شد (۱۴۰۵/۰۷/۰۶) و برنمی‌گردد.
                     خواستهٔ صریحِ صاحب ریپو: «از داخلِ بخشِ ورق‌ها از تراکنش‌ها
                     نوعِ تیل رو حذف کن… ولی اگر توی نام پطرول یا دیزل نوشتم،
                     توی حسابِ یارو همان انتخاب بشه اتومات.»
                     ⚠️ خودِ ‎Fuel‎ی ردیف نرفت — فقط ستونش. نام که «دیزل» یا
                     «د» داشته باشد همان لحظه رویش می‌نشیند
                     (‎WaraqSectionViewModel.AutoFromName‎)، و ‎FuelChipText‎ و
                     ‎ToggleFuelCommand‎ سرِ جایشان‌اند چون جدولِ **پایه‌ها**ی
                     همین صفحه هم از آن‌ها می‌خواند. -->
                <DataGridTextColumn Header="مقدار تیل" Binding="{Binding LitersText}" Width="Auto" />
                <DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="Auto" />
                <DataGridTemplateColumn Header="نوع" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو گزینه، ‎ComboBox‎ یک قالبِ کامل با ‎Popup‎ و
                           ‎ItemsPresenter‎ی خودش می‌ساخت — ده‌ها بصری در هر خانه — و سنجشِ ‎waraqperf‎
                           نشان داد بیشترِ وقتِ باز شدنِ ورقِ پُر همین است. خواستهٔ صاحب ریپو هم همین
                           بود: «اون فلش فقط جا گرفته» و «با تب یا اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ
                           ‎celltoggle‎ را با ‎Enter‎/‎Tab‎ می‌زند. -->
                      <Button Classes="fuelchip celltoggle" Content="{Binding TypeText}"
                              Command="{Binding ToggleTypeCommand}"
                              Foreground="{Binding TypeChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                              BorderBrush="{Binding TypeChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                              ToolTip.Tip="زدنش این ردیف را قرض ⇄ مصرف می‌کند" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- ستونِ «واحد» — همان ستونِ سایت، با همان راهنمای خودش -->
                <DataGridTemplateColumn Header="واحد" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو گزینه، ‎ComboBox‎ یک قالبِ کامل با ‎Popup‎ و
                           ‎ItemsPresenter‎ی خودش می‌ساخت — ده‌ها بصری در هر خانه — و سنجشِ ‎waraqperf‎
                           نشان داد بیشترِ وقتِ باز شدنِ ورقِ پُر همین است. خواستهٔ صاحب ریپو هم همین
                           بود: «اون فلش فقط جا گرفته» و «با تب یا اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ
                           ‎celltoggle‎ را با ‎Enter‎/‎Tab‎ می‌زند. -->
                      <Button Classes="fuelchip celltoggle" Content="{Binding UnitText}"
                              Command="{Binding ToggleUnitCommand}"
                              Foreground="{Binding UnitChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                              BorderBrush="{Binding UnitChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                              ToolTip.Tip="ردیفِ قرض به کدام دفترِ حسابِ قرض‌دار برود: واحد تیل یا واحد پول — زدنش عوضش می‌کند" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </c:ExcelGrid>

            <c:ExcelGrid GrowsToContent="True" KeepInside="True" WidthKey="waraq.txns" Grid.Column="2" ItemsSource="{Binding TxnsSecond}" x:CompileBindings="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="مقدار تیل" Binding="{Binding LitersText}" Width="Auto" />
                <DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="Auto" />
                <DataGridTemplateColumn Header="نوع" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو گزینه، ‎ComboBox‎ یک قالبِ کامل با ‎Popup‎ و
                           ‎ItemsPresenter‎ی خودش می‌ساخت — ده‌ها بصری در هر خانه — و سنجشِ ‎waraqperf‎
                           نشان داد بیشترِ وقتِ باز شدنِ ورقِ پُر همین است. خواستهٔ صاحب ریپو هم همین
                           بود: «اون فلش فقط جا گرفته» و «با تب یا اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ
                           ‎celltoggle‎ را با ‎Enter‎/‎Tab‎ می‌زند. -->
                      <Button Classes="fuelchip celltoggle" Content="{Binding TypeText}"
                              Command="{Binding ToggleTypeCommand}"
                              Foreground="{Binding TypeChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                              BorderBrush="{Binding TypeChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                              ToolTip.Tip="زدنش این ردیف را قرض ⇄ مصرف می‌کند" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- ستونِ «واحد» — همان ستونِ سایت، با همان راهنمای خودش -->
                <DataGridTemplateColumn Header="واحد" Width="Auto">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <!-- ⚠️ کپسول، نه کشویی. با دو گزینه، ‎ComboBox‎ یک قالبِ کامل با ‎Popup‎ و
                           ‎ItemsPresenter‎ی خودش می‌ساخت — ده‌ها بصری در هر خانه — و سنجشِ ‎waraqperf‎
                           نشان داد بیشترِ وقتِ باز شدنِ ورقِ پُر همین است. خواستهٔ صاحب ریپو هم همین
                           بود: «اون فلش فقط جا گرفته» و «با تب یا اینتر عوض بشه». ‎ExcelGrid‎ کلاسِ
                           ‎celltoggle‎ را با ‎Enter‎/‎Tab‎ می‌زند. -->
                      <Button Classes="fuelchip celltoggle" Content="{Binding UnitText}"
                              Command="{Binding ToggleUnitCommand}"
                              Foreground="{Binding UnitChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}"
                              BorderBrush="{Binding UnitChipBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}}"
                              ToolTip.Tip="ردیفِ قرض به کدام دفترِ حسابِ قرض‌دار برود: واحد تیل یا واحد پول — زدنش عوضش می‌کند" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </c:ExcelGrid>
          </Grid>
          </DataTemplate>
        </c:LazyBox.Deferred>
      </c:LazyBox>

      <!-- ══ 📊 خلاصه شیفت ═══════════════════════════════════════════════
           مو‌به‌مو مثلِ سایت: عنوان، بعد شش کادر در یک شبکهٔ
           ‎repeat(auto-fill, minmax(140px, 1fr))‎ — همان کاری که
           ‎c:AutoFillPanel‎ می‌کند. ترتیب، نشانه‌ها، رنگ‌ها و واحدها هم از
           همان‌جا برداشته شده‌اند (‎index.html‎ خط ۱۹۹۷۴ تا ۱۹۹۸۱ و خط ۴۵۵۴۴
           تا ۴۵۵۶۵) — روز و شب هرگز با هم جمع نمی‌شوند. -->
      <StackPanel Grid.Row="4" Spacing="6" Margin="0,12,0,0">
        <TextBlock Text="{Binding SummaryTitle}" Classes="label" FontWeight="Bold"
                   Foreground="{DynamicResource Pump.Ink.Accent}" />
        <c:AutoFillPanel MinItemWidth="140" Gap="8">
          <Border Classes="stat">
            <StackPanel Spacing="3">
              <TextBlock Text="⛽ جمله پطرول" Classes="label" />
              <TextBlock Text="{Binding SumPetrol}" Classes="num"
                         Foreground="{DynamicResource Pump.Ink.Accent}" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="3">
              <TextBlock Text="🟤 جمله دیزل" Classes="label" />
              <TextBlock Text="{Binding SumDiesel}" Classes="num"
                         Foreground="{DynamicResource Pump.Ink.Diesel}" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="3">
              <TextBlock Text="🟣 جمله مصرف" Classes="label" />
              <TextBlock Text="{Binding SumExpenses}" Classes="num"
                         Foreground="{DynamicResource Pump.Ink.Purple}" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="3">
              <TextBlock Text="💳 جمله قرض" Classes="label" />
              <TextBlock Text="{Binding SumDebt}" Classes="num"
                         Foreground="{DynamicResource Pump.Ink.Danger}" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding ShortageBoxLabel}" Classes="label" />
              <TextBlock Text="{Binding SumShortage}" Classes="num"
                         Foreground="{Binding ShortageBrushKey, Converter={x:Static th:ResourceKeyToBrushConverter.Instance}, ConverterParameter=ink}" />
            </StackPanel>
          </Border>
          <Border Classes="stat">
            <StackPanel Spacing="3">
              <TextBlock Text="📊 جمله فروش" Classes="label" />
              <TextBlock Text="{Binding SumSales}" Classes="num"
                         Foreground="{DynamicResource Pump.Ink.Ok}" />
            </StackPanel>
          </Border>
        </c:AutoFillPanel>
      </StackPanel>
    </Grid>
  </c:SectionPage>
</UserControl>
