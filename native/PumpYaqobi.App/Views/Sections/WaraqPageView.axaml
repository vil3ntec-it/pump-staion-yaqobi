<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:c="using:PumpYaqobi.App.Controls"
             x:Class="PumpYaqobi.App.Views.Sections.WaraqPageView"
             x:DataType="vm:WaraqPageViewModel">

  <c:SectionPage Header="{Binding Title}" SubHeader="پایه‌ها و ردیف‌های قرض و مصرفِ همین شیفت">

    <c:SectionPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ToggleSwitch OnContent="شب" OffContent="روز" IsChecked="{Binding IsNight}" />
        <Button Content="پایهٔ تازه" Command="{Binding AddPumpCommand}" />
        <Button Content="ردیفِ تازه" Command="{Binding AddTxnCommand}" />
        <Button Classes="ghost info" Content="📄 PDF ورق" Command="{Binding PdfCommand}" />
        <Button Classes="accent" Content="بازگشت" Command="{Binding BackCommand}" />
      </StackPanel>
    </c:SectionPage.Toolbar>

    <c:SectionPage.Filters>
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <StackPanel Spacing="3" Width="200">
          <TextBlock Text="کارمندِ شیفت" Classes="label" />
          <TextBox Text="{Binding WorkerName}" />
        </StackPanel>
        <StackPanel Spacing="3" Width="150">
          <TextBlock Text="قرضِ پارچه" Classes="label" />
          <TextBox Text="{Binding FabricDebtText}" />
        </StackPanel>
      </StackPanel>
    </c:SectionPage.Filters>

    <c:SectionPage.Summary>
      <!-- ‎Rows="1"‎ یعنی «همه در یک ردیف، با عرضِ مساوی» — کادرها تا لبه پخش
           می‌شوند به‌جای آن‌که راست جمع شوند و کنارشان خالی بماند. -->
      <UniformGrid Rows="1" Classes="stats">
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="پطرول (لیتر)" Classes="label" />
            <TextBlock Text="{Binding PetrolLiters}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="دیزل (لیتر)" Classes="label" />
            <TextBlock Text="{Binding DieselLiters}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="فروش" Classes="label" />
            <TextBlock Text="{Binding Sales}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="قرض" Classes="label" />
            <TextBlock Text="{Binding Debt}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="مصرف" Classes="label" />
            <TextBlock Text="{Binding Expenses}" Classes="num" />
          </StackPanel>
        </Border>
        <Border Classes="stat">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding ShortageLabel}" Classes="label" />
            <TextBlock Text="{Binding Shortage}" Classes="num" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </c:SectionPage.Summary>

    <Grid RowDefinitions="*,10,*,Auto">
      <c:ExcelGrid Grid.Row="0" ItemsSource="{Binding Pumps}" x:CompileBindings="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="پایه" Binding="{Binding Num}" Width="Auto" />
          <DataGridTextColumn Header="تاریخ" Binding="{Binding PumpDate}" Width="Auto" />
          <DataGridTextColumn Header="نام" Binding="{Binding Worker}" Width="Auto" />
          <DataGridTemplateColumn Header="تیل" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding FuelText}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <ComboBox SelectedItem="{Binding FuelText}">
                  <ComboBoxItem Content="پطرول" /><ComboBoxItem Content="دیزل" />
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="شروع" Binding="{Binding StartText}" Width="Auto" />
          <DataGridTextColumn Header="ختم" Binding="{Binding EndText}" Width="Auto" />
          <DataGridTextColumn Header="لیتر" Binding="{Binding LitersText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="فی" Binding="{Binding PriceText}" Width="Auto" />
          <DataGridTextColumn Header="فروش" Binding="{Binding SalesText}" Width="Auto" IsReadOnly="True" />
          <DataGridTextColumn Header="قرضِ پایه" Binding="{Binding DebtText}" Width="Auto" />
          <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="Auto" MinWidth="150" MaxWidth="320" />
          <DataGridTemplateColumn Header="" Width="Auto" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Classes="ghost danger" Content="حذف" Padding="8,3" FontSize="11"
                        Command="{Binding $parent[UserControl].DataContext.DeletePumpCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </c:ExcelGrid>

      <!-- ══ تراکنش‌ها — دو جدولِ هم‌شکل، کنارِ هم ══════════════════════════
           خواستهٔ صاحب ریپو: «توی ورق‌ها دو کادر دارد که شبیه هم است و آن
           بابتِ این است که بیشتر جا بشود، توی یک حساب قرض‌ها یا مصرف‌ها.»

           سایت هم همین است — ‎#wq-trans-tbl-left‎ و ‎#wq-trans-tbl-right‎ در یک
           ‎grid-template-columns:1fr 1fr‎، و ‎renderWaraqTransactions‎ نیمهٔ اول
           را در جدولِ اول و نیمهٔ دوم را در جدولِ دوم می‌ریزد.

           ستون‌ها هم مو‌به‌مو همان‌های سایت‌اند و به همان ترتیب:
               # │ نام │ نوع تیل │ مقدار تیل │ مبلغ │ نوع
           («مبلغِ مؤثر» که پیش از این بود، در سایتِ این جدول نیست و برداشته
           شد؛ همان عدد در ردیفِ «جمله»ی ته صفحه دیده می‌شود.)

           ⚠️ ستونِ «واحد» (تیل/پول) سایت هنوز این‌جا نیست — چون در نیتیو
           تراکنش‌های ورق اصلاً به حسابِ قرض‌داران پست نمی‌شوند، و آن ستون
           تا وقتی پستی در کار نباشد چیزی را جابه‌جا نمی‌کند. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,8,*">
        <c:ExcelGrid Grid.Column="0" ItemsSource="{Binding TxnsFirst}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="Auto" IsReadOnly="True" />
            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*" MinWidth="130" />
            <DataGridTemplateColumn Header="نوع تیل" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding FuelText}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding FuelText}">
                    <ComboBoxItem Content="پطرول" /><ComboBoxItem Content="دیزل" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="مقدار تیل" Binding="{Binding LitersText}" Width="Auto" />
            <DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="Auto" />
            <DataGridTemplateColumn Header="نوع" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding TypeText}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding TypeText}">
                    <ComboBoxItem Content="قرض" /><ComboBoxItem Content="مصرف" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <!-- ستونِ «واحد» — همان ستونِ سایت، با همان راهنمای خودش -->
            <DataGridTemplateColumn Header="واحد" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding UnitText}" VerticalAlignment="Center" Margin="6,0"
                             ToolTip.Tip="ردیفِ قرض به کدام دفترِ حسابِ قرض‌دار برود: واحد تیل یا واحد پول" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding UnitText}">
                    <ComboBoxItem Content="تیل" /><ComboBoxItem Content="پول" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </c:ExcelGrid>

        <c:ExcelGrid Grid.Column="2" ItemsSource="{Binding TxnsSecond}" x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="Auto" IsReadOnly="True" />
            <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*" MinWidth="130" />
            <DataGridTemplateColumn Header="نوع تیل" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding FuelText}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding FuelText}">
                    <ComboBoxItem Content="پطرول" /><ComboBoxItem Content="دیزل" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="مقدار تیل" Binding="{Binding LitersText}" Width="Auto" />
            <DataGridTextColumn Header="مبلغ" Binding="{Binding AmountText}" Width="Auto" />
            <DataGridTemplateColumn Header="نوع" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding TypeText}" VerticalAlignment="Center" Margin="6,0" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding TypeText}">
                    <ComboBoxItem Content="قرض" /><ComboBoxItem Content="مصرف" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <!-- ستونِ «واحد» — همان ستونِ سایت، با همان راهنمای خودش -->
            <DataGridTemplateColumn Header="واحد" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding UnitText}" VerticalAlignment="Center" Margin="6,0"
                             ToolTip.Tip="ردیفِ قرض به کدام دفترِ حسابِ قرض‌دار برود: واحد تیل یا واحد پول" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox SelectedItem="{Binding UnitText}">
                    <ComboBoxItem Content="تیل" /><ComboBoxItem Content="پول" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </c:ExcelGrid>
      </Grid>

      <!-- ردیفِ «جمله»ی همین شیفت — روز و شب با هم جمع نمی‌شوند -->
      <c:TotalsBar Grid.Row="3" ItemsSource="{Binding TotalCells}" />
    </Grid>
  </c:SectionPage>
</UserControl>
