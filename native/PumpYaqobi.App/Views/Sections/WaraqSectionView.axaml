<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:d="using:PumpYaqobi.Domain.Entities"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:v="using:PumpYaqobi.App.Views.Sections"
             x:Class="PumpYaqobi.App.Views.Sections.WaraqSectionView"
             x:DataType="vm:WaraqSectionViewModel">
  <Panel>

    <c:SectionPage IsVisible="{Binding IsListVisible}"
                   Header="ورق‌های روزانه"
                   SubHeader="یک ورق برای هر روز — ورقِ تکراریِ همان تاریخ ساخته نمی‌شود">

      <c:SectionPage.Toolbar>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <!-- ⚠️ این دکمه تا امروز «تاریخچهٔ پایه‌ها» نام داشت و **هیچ فرمانی
               نداشت** — زده می‌شد و هیچ اتفاقی نمی‌افتاد. حالا همان دکمهٔ
               «🕘 تاریخچه»ی مشترکِ همهٔ بخش‌هاست. (تاریخچهٔ خودِ پایه‌ها، با
               شروع و ختمِ هر شیفت، در بخشِ «پارچه‌ها» است.) -->
          <Button Classes="ghost info" Content="🕘 تاریخچه" Margin="0,0,6,0"
                  Command="{Binding OpenHistoryCommand}" IsVisible="{Binding HasHistory}"
                  ToolTip.Tip="تاریخچهٔ همین بخش با تاریخ و روزِ هفته" />
          <Button Classes="accent" Content="اضافه کردن" Command="{Binding NewSheetCommand}" />
        </WrapPanel>
      </c:SectionPage.Toolbar>

      <c:SectionPage.Filters>
        <!-- ══ سال و ماه ═══════════════════════════════════════════════════
             گزارشِ صاحب ریپو: «بخشِ ورق‌ها ماه و سال ندارد.» کشویی بود ولی
             کلیدِ خامِ «1405/06» را نشان می‌داد. حالا سال جداست و ماه نامِ
             خودش را دارد. -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="سال" Classes="label" VerticalAlignment="Center" />
          <!-- نقطهٔ سرخ روی کشوی سال/ماه و کنارِ ماهِ پیش (‎MonthDot‎) -->
          <Panel>
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding YearItem}"
                      ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="100" />
            <Ellipse Classes="monthdot badge" IsVisible="{Binding HasYearDot}" />
          </Panel>
          <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
          <Panel>
            <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}"
                      ItemTemplate="{StaticResource Pump.MonthDotItem}" MinWidth="150" />
            <Ellipse Classes="monthdot badge" IsVisible="{Binding HasMonthDot}" />
          </Panel>
        </StackPanel>
      </c:SectionPage.Filters>

              <Panel>
          <TextBlock Text="{Binding EmptyText}"
                     Classes="muted" HorizontalAlignment="Center" Margin="0,40,0,0"
                     IsVisible="{Binding IsEmpty}" />
          <ItemsRepeater ItemsSource="{Binding Cards}">
            <ItemsRepeater.Layout>
              <!-- ══ کارت‌ها: هم‌اندازه، شش تا هشت تا در هر ردیف ══════════════
                   گزارشِ صاحب ریپو با عکس: «کادرهایشان برابرِ هم نیستند، یکی
                   کوچک یکی بزرگ، یا خیلی فاصله دارند … در هر صفحه شش تا هشت تا
                   جا بشود، نه با فاصلهٔ زیاد، برابر و استاندارد.»

                   دو چیز کم بود:
                   • ‎MinItemHeight‎ نبود، پس هر کارت به قدِ محتوای خودش بود —
                     کارتی که «اتمام پول» داشت بلندتر از بقیه می‌شد و ردیف
                     ناهموار می‌ماند. حالا همه یک قد دارند و کارت هم عمودی
                     کِش می‌آید تا قابش پر شود.
                   • ‎MaximumRowsOrColumns‎ نبود، پس روی نمایشگرِ پهن ‎ItemsStretch‎
                     کارت‌ها را بی‌جهت پهن می‌کرد. حالا سقفِ هشت‌تا دارد و
                     ‎MinItemWidth‎ی ۲۰۰ روی باریک‌ترین صفحه هم شش‌تا می‌دهد. -->
              <!-- ⛔ کمی بلندتر (۲۰۰ ⇐ ۲۳۰): خواستهٔ صاحب ریپو با عکس، ۱۴۰۵/۰۷/۱۳ -->
              <UniformGridLayout MinItemWidth="200" MinItemHeight="230"
                                 MaximumRowsOrColumns="8" ItemsStretch="Fill"
                                 MinColumnSpacing="10" MinRowSpacing="10" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:WaraqCardViewModel">
                <Button Classes="card-shell" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        Command="{Binding $parent[ItemsRepeater].((vm:WaraqSectionViewModel)DataContext).OpenCardCommand}"
                        CommandParameter="{Binding}">
                  <Border Classes="person-card">
                    <!-- ⚠️ ردیفِ آخر ‎Auto‎ است و ردیفِ خالیِ پیش از آن ‎*‎: فضای اضافه در
                         ردیفِ خالی جذب می‌شود و کفِ کارت پایین می‌چسبد، ولی اگر
                         جا کم بیاید هیچ محتوایی ناپدید نمی‌شود. (ردیفِ ‎*‎ِ
                         محتوادار وقتی جا کم بیاید تا صفر جمع می‌شود — همان
                         «دیزل و پطرول زیرِ کادر گم شدند».) -->
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                      <!-- همان زبانِ کارتِ قرض‌دار و شرکت‌ها و امانت: تاریخِ ورق
                           سرِ خط، عددِ فروش درشت، سطرِ ریز، خطِ نازک، و کفِ کارت. -->
                      <Button Grid.Row="0" Classes="card-x" Content="✕" HorizontalAlignment="Left"
                              Margin="10,9,0,0"
                              Command="{Binding $parent[ItemsRepeater].((vm:WaraqSectionViewModel)DataContext).DeleteCardCommand}"
                              CommandParameter="{Binding}" />

                      <TextBlock Grid.Row="1" Text="{Binding Title}" Classes="pname" />
                      <TextBlock Grid.Row="2" Text="{Binding SubText}" Classes="card-sub" />

                      <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding SalesText}" Classes="cmp-fig"
                                   Foreground="{DynamicResource Pump.Danger}" />
                        <TextBlock Text="فروشِ ورق · افغانی" Classes="card-sub" />
                        <Border Classes="card-rule" Margin="11,10,11,0" />
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="11,8,7,9">
                          <TextBlock Grid.Column="0" Text="{Binding DebtText}" FontWeight="Bold" FontSize="12"
                                     Foreground="{DynamicResource Pump.Danger}" />
                          <TextBlock Grid.Column="1" Text="{Binding ExpenseText}" FontWeight="Bold" FontSize="12"
                                     Margin="12,0,0,0" Foreground="{DynamicResource Pump.Accent}" />
                          <Button Grid.Column="3" Classes="qr-link" Content="PDF"
                                  Foreground="{DynamicResource Pump.Ok}"
                                  Command="{Binding $parent[ItemsRepeater].((vm:WaraqSectionViewModel)DataContext).PdfCardCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Panel>
      
    </c:SectionPage>

    <Panel IsVisible="{Binding !IsListVisible}">
      <v:WaraqPageView DataContext="{Binding Page}" />
    </Panel>
  </Panel>
</UserControl>
