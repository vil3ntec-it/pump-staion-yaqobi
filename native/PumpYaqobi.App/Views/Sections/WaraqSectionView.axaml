<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PumpYaqobi.App.ViewModels.Sections"
             xmlns:d="using:PumpYaqobi.Domain.Entities"
             xmlns:c="using:PumpYaqobi.App.Controls"
             xmlns:v="using:PumpYaqobi.App.Views.Sections"
             x:Class="PumpYaqobi.App.Views.Sections.WaraqSectionView"
             x:DataType="vm:WaraqSectionViewModel">
  <Panel>

    <c:SectionPage IsVisible="{Binding IsListVisible}"
                   Header="ورق‌های روزانه"
                   SubHeader="یک ورق برای هر روز — ورقِ تکراریِ همان تاریخ ساخته نمی‌شود">

      <c:SectionPage.Toolbar>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Classes="ghost" Content="🕘 تاریخچهٔ پایه‌ها" Margin="0,0,6,0"
                  Foreground="{DynamicResource Pump.Ok}" BorderBrush="{DynamicResource Pump.Ok}" />
          <Button Classes="accent" Content="➕ اضافه کردن" Command="{Binding NewSheetCommand}" />
        </WrapPanel>
      </c:SectionPage.Toolbar>

      <c:SectionPage.Filters>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="ماه" Classes="label" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" MinWidth="140" />
        </StackPanel>
      </c:SectionPage.Filters>

              <Panel>
          <TextBlock Text="هیچ ورقی ثبت نشده — از دکمهٔ بالا ورق جدید اضافه کنید"
                     Classes="muted" HorizontalAlignment="Center" Margin="0,40,0,0"
                     IsVisible="{Binding IsEmpty}" />
          <ItemsRepeater ItemsSource="{Binding Cards}">
            <ItemsRepeater.Layout>
              <!-- ══ کارت‌ها: هم‌اندازه، شش تا هشت تا در هر ردیف ══════════════
                   گزارشِ صاحب ریپو با عکس: «کادرهایشان برابرِ هم نیستند، یکی
                   کوچک یکی بزرگ، یا خیلی فاصله دارند … در هر صفحه شش تا هشت تا
                   جا بشود، نه با فاصلهٔ زیاد، برابر و استاندارد.»

                   دو چیز کم بود:
                   • ‎MinItemHeight‎ نبود، پس هر کارت به قدِ محتوای خودش بود —
                     کارتی که «اتمام پول» داشت بلندتر از بقیه می‌شد و ردیف
                     ناهموار می‌ماند. حالا همه یک قد دارند و کارت هم عمودی
                     کِش می‌آید تا قابش پر شود.
                   • ‎MaximumRowsOrColumns‎ نبود، پس روی نمایشگرِ پهن ‎ItemsStretch‎
                     کارت‌ها را بی‌جهت پهن می‌کرد. حالا سقفِ هشت‌تا دارد و
                     ‎MinItemWidth‎ی ۲۰۰ روی باریک‌ترین صفحه هم شش‌تا می‌دهد. -->
              <UniformGridLayout MinItemWidth="200" MinItemHeight="232"
                                 MaximumRowsOrColumns="8" ItemsStretch="Fill"
                                 MinColumnSpacing="10" MinRowSpacing="10" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:WaraqCardViewModel">
                <Button Classes="card-shell" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        Command="{Binding $parent[ItemsRepeater].((vm:WaraqSectionViewModel)DataContext).OpenCardCommand}"
                        CommandParameter="{Binding}">
                  <Border Classes="person-card">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                      <Button Grid.Row="0" Classes="card-x" Content="✕" HorizontalAlignment="Left"
                              Command="{Binding $parent[ItemsRepeater].((vm:WaraqSectionViewModel)DataContext).DeleteCardCommand}"
                              CommandParameter="{Binding}" />

                      <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                 TextAlignment="Center" Margin="0,6,0,0" />
                      <TextBlock Grid.Row="2" Text="{Binding SubText}" Classes="muted" FontSize="11.5"
                                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />

                      <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="7" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SalesText}" Classes="cmp-fig"
                                   Foreground="{DynamicResource Pump.Danger}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                          <TextBlock Text="{Binding DebtText}" FontWeight="Bold" FontSize="12"
                                     Foreground="{DynamicResource Pump.Danger}" />
                          <TextBlock Text="{Binding ExpenseText}" FontWeight="Bold" FontSize="12"
                                     Foreground="{DynamicResource Pump.Accent}" />
                        </StackPanel>
                        <Button Classes="qr" Content="📄 PDF" HorizontalAlignment="Stretch"
                                Foreground="{DynamicResource Pump.Ok}"
                                BorderBrush="{DynamicResource Pump.Ok}"
                                Command="{Binding $parent[ItemsRepeater].((vm:WaraqSectionViewModel)DataContext).PdfCardCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Panel>
      
    </c:SectionPage>

    <Panel IsVisible="{Binding !IsListVisible}">
      <v:WaraqPageView DataContext="{Binding Page}" />
    </Panel>
  </Panel>
</UserControl>
