<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PumpYaqobi.App.ViewModels"
        x:Class="PumpYaqobi.App.Views.VoiceTeachWindow"
        x:DataType="vm:VoiceTeachViewModel"
        Title="آموزش صدا" Width="620" Height="640"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{DynamicResource Pump.Dark}"
        Foreground="{DynamicResource Pump.Text}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14">

    <TextBlock Grid.Row="0" Text="🎓 آموزش صدا" FontWeight="Bold" FontSize="17" Margin="0,0,0,6" />

    <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="جلوی هر نام دکمهٔ 🎤 را بزنید و همان نام را یک‌بار بگویید. از آن به بعد جستجوی صوتی برای آن نام بدون اینترنت و بدون سرور کار می‌کند. اگر نامی را دو-سه بار (با صداهای مختلف) ثبت کنید، بهتر می‌شناسد." />

    <TextBox Grid.Row="2" Text="{Binding Search}" Watermark="🔍 جستجوی نام..." Margin="0,0,0,10" />

    <Border Grid.Row="3" Classes="panel" Padding="0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VoiceTeachRowViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="10,7">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted"
                           VerticalAlignment="Center" Margin="10,0" />
                <Button Grid.Column="2" Classes="ghost danger" Content="🗑️" Padding="8,2"
                        Command="{Binding ForgetCommand}" IsVisible="{Binding HasVoice}"
                        ToolTip.Tip="پاک کردنِ صداهای این نام" />
                <Button Grid.Column="3" Classes="accent" Content="{Binding MicText}" Padding="10,2"
                        Margin="6,0,0,0" Command="{Binding TeachCommand}" ToolTip.Tip="ضبط صدا" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
      <Button Classes="ghost" Content="✕ بستن" Click="OnClose" />
      <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
